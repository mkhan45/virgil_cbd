type X86Val {
    case Reg(r: X86_64Gpr);
    case Vsp(i: int);
    case ImmU32(x: u32);

    def is_reg() -> bool {
        match (this) {
            Reg => return true;
            _ => return false;
        }
    }

    def forceReg() -> X86_64Gpr {
        match (this) {
            Reg(r) => return r;
            _ => return null;
        }
    }

    def forceVsp() -> int {
        match (this) {
            Vsp(i) => return i;
            _ => return 0xdead;
        }
    }
}

class CBDFastIntGen extends X86_64InterpreterGen {
    var DISPATCH_TABLE: Array<void -> void>;
    var op_sp: int;

    def trapUnreachable();
    def trap();

    new(ic: X86_64InterpreterCode, w: DataWriter) super(ic, w) {
        DISPATCH_TABLE = build_dispatch_table();
        op_sp = 0;
    }

    def reset() {
        op_sp = 0;
    }

    // def genOpcodeHandlers() {
    //     // X86_64InterpreterGen.!(this).genOpcodeHandlers(); // XXX: how to easily call the super method?
    // }

    def gen(range: MemoryRange) {
        // copy pasted from superclass but added genCBDHandlers()

		// Record code start
		ic.header.codeStart = w.atEnd().pos; // XXX: don't make dispatch tables executable

		// Reserve the type tag table.
		genTypeTagTable();
		// Reserve space for the dispatch tables.
		reserveDispatchTables();
		// Begin code generation
		genHostCallStub();
		genInterpreterEntry();
		genOpcodeHandlers();
        genCBDHandlers();
		handlerEndOffset = w.atEnd().pos;
		// Generate out-of-line code
		genOutOfLineLEBs();
		genTraps();
    }

    // this func should be generated
    def genCBDHandlers() {
        bindHandler(Opcode.I32_CONST);
        reset();
        I32_CONST();
        adjustVsp(1); // stack delta
        endHandler();

        bindHandler(Opcode.I32_ADD);
        reset();
        I32_ADD();
        adjustVsp(-1);
        endHandler();

        bindHandler(Opcode.I32_EQZ);
        reset();
        I32_EQZ();
        endHandler();
    }
    
    // puts in reg0 if not already in reg
    def ensureReg(val: X86Val) -> X86_64Gpr {
        match (val) {
            Reg(r) => return r;
            Vsp(i) => {
                asm.movd_r_m(r_tmp0, vsph[i].value);
                return r_tmp0;
            }
            ImmU32(x) => {
                asm.movd_r_i(r_tmp1, int.view(x));
                return r_tmp1;
            }
        }
    }

    def imm_readULEB32() -> X86Val {
        genReadUleb32(r_tmp1);
        return X86Val.Reg(r_tmp1);
    }

    def imm_readILEB32() -> X86Val {
        genReadSleb32_inline(r_tmp1);
        return X86Val.Reg(r_tmp1);
    }

    def push_u32(val: X86Val) {
        genTagPush(BpTypeCode.I32.code);
        def reg = ensureReg(val);

        asm.movq_m_r(vsph[op_sp].value, reg);
        op_sp += 1;
    }

    def pop_u32() -> X86Val {
        op_sp -= 1;
        return X86Val.Vsp(op_sp);
    }

    def U32_plus(a: X86Val, b: X86Val) -> X86Val {
        if (a.is_reg() && b.is_reg()) {
            asm.d.add_r_r(a.forceReg(), b.forceReg());
            return a;
        } else if (!a.is_reg() && !b.is_reg()) {
            def a_reg = ensureReg(a);
            asm.d.add_r_m(a_reg, vsph[b.forceVsp()].value);
            return X86Val.Reg(a_reg);
        } else {
            def stack_val = vsph[if(a.is_reg(), b, a).forceVsp()];
            def reg_val = if(a.is_reg(), a, b).forceReg();
            asm.d.add_r_m(reg_val, stack_val.value);
            return X86Val.Reg(reg_val);
        }
    }

    def rtcast_u32(x: u32) -> X86Val => X86Val.ImmU32(x);

    def U32_equals(a: X86Val, b: X86Val) -> X86Val {
        if (b == X86Val.ImmU32(0u)) {
            asm.d.test_m_i(vsph[-1].value, -1);
            asm.set_r(X86_64Conds.Z, r_tmp0);
            return X86Val.Reg(r_tmp0);
        } else {
            trap();
        }

        return X86Val.ImmU32(0xdead);
    }

    def choose_u(cond: X86Val, left: X86Val, right: X86Val) -> X86Val {
        if (left == X86Val.ImmU32(1u) && right == X86Val.ImmU32(0u)) {
            def reg = ensureReg(cond);
            asm.movbzx_r_r(reg, reg);
            return X86Val.Reg(reg);
        } else {
            trap();
        }

        return X86Val.ImmU32(0xdead);
    }
}
