class CBDFastIntGen extends X86_64InterpreterGen {
    var DISPATCH_TABLE: Array<void -> void>;
    var op_sp: int;

    var last_cond: X86_64Cond;
    var else_label: X86_64Label;
    var end_label: X86_64Label;

    var reg_i: int;

    def trapUnreachable();
    def trap();

    def reg_alloc() -> X86_64Gpr {
        reg_i += 1;
        if (reg_i == 1) return r_tmp1;
        if (reg_i == 2) return r_tmp2;
        if (reg_i == 3) return r_tmp3;
        if (reg_i == 4) return r_tmp4;
        return null;
    }

    new(ic: X86_64InterpreterCode, w: DataWriter) super(ic, w) {
        DISPATCH_TABLE = build_dispatch_table();
        op_sp = 0;
        reg_i = 0;
    }

    def reset() {
        op_sp = 0;
        reg_i = 0;
        last_cond = null;
    }

    def gen(range: MemoryRange) {
        // copy pasted from superclass but added genCBDHandlers()

		// Record code start
		ic.header.codeStart = w.atEnd().pos; // XXX: don't make dispatch tables executable

		// Reserve the type tag table.
		genTypeTagTable();
		// Reserve space for the dispatch tables.
		reserveDispatchTables();
		// Begin code generation
		genHostCallStub();
		genInterpreterEntry();
		genOpcodeHandlers();
        genCBDHandlers();
		handlerEndOffset = w.atEnd().pos;
		// Generate out-of-line code
		genOutOfLineLEBs();
		genTraps();
    }

    def imm_readU8() -> X86_64Gpr {
        def reg = reg_alloc();
        asm.movbzx_r_m(reg, ip_ptr);
        asm.q.inc_r(r_ip);
        return reg;
    }

    def imm_readULEB32() -> X86_64Gpr {
        def reg = reg_alloc();
        genReadUleb32(reg);
        return reg;
    }

    def imm_readILEB32() -> X86_64Gpr {
        def reg = reg_alloc();
        genReadSleb32_inline(reg);
        return reg;
    }

    def push_u32(reg: X86_64Gpr) {
        genTagPush(BpTypeCode.I32.code);
        asm.movq_m_r(vsph[op_sp].value, reg);
        op_sp += 1;
    }

    def pop_u32() -> X86_64Gpr {
        op_sp -= 1;
        def reg = reg_alloc();
        asm.movq_r_m(reg, vsph[op_sp].value);
        return reg;
    }

    def U32_plus(a: X86_64Gpr, b: X86_64Gpr) -> X86_64Gpr {
        asm.d.add_r_r(a, b);
        return a;
    }

    def U32_minus(a: X86_64Gpr, b: X86_64Gpr) -> X86_64Gpr {
        asm.d.sub_r_r(a, b);
        return a;
    }

    def rtcast_u32(x: u32) -> X86_64Gpr {
        def reg = reg_alloc();
        asm.d.movq_r_i(reg, int.view(x));
        return reg;
    }

    def U32_equals(a: X86_64Gpr, b: X86_64Gpr) -> X86_64Cond {
        asm.d.cmp_r_r(a, b);
        return X86_64Conds.Z;
    }

    def U32_not_equals(a: X86_64Gpr, b: X86_64Gpr) -> X86_64Cond {
        asm.d.cmp_r_r(a, b);
        return X86_64Conds.NZ;
    }

    def f_getLabel(depth: X86_64Gpr) -> () { }

    def doFallthru() {
        genSkipSidetableEntry();
    }
    
    def doBranch(label: ()) {
        asm.jmp_rel_far(controlTransferLabel);
    }

    def startCond(cond: X86_64Cond) {
        else_label = X86_64Label.new();
        end_label = X86_64Label.new();
        last_cond = cond;

        asm.d.jc_rel_near(cond, else_label);
    }

    def startElse() {
        asm.d.jmp_rel_near(end_label);
        asm.bind(else_label);
        last_cond = null;
    }

    def endCond() {
        asm.bind(end_label);
        last_cond = null;
    }
}
