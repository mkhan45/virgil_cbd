def execBoth(cond: string, a: SSAD, b: SSAD, ctx: SSADCtx) -> SSAD {
    def afx = Vector<CBDEffect>.new();
    def bfx = Vector<CBDEffect>.new();
    ctx.collectEffects(a, afx);
    ctx.collectEffects(b, bfx);

    def a_res = CBDEffects.run_fx(afx);
    def b_res = CBDEffects.run_fx(bfx);
    // assert fx equal

    var res = SSAD.LetApp("effStartCond", "startCond", [cond], a)
                .appended(SSAD.LetApp("effStartElse", "startElse", [], b))
                .appended(SSAD.LetApp("effEndCond", "endCond", [], SSAD.Void));

    ctx.getStatic(res);
    ctx.getTypes(res);
    return res;
}

def flatten_ifs(node: SSAD.If, transformer: SSATransformer) -> SSAD {
    def c = node.cond, t = node.then, e = node.els, rest = node.rest;
    def phis = node.phis;
    def ctx = transformer.ctx;

    def t_transform = transformer.transform(t);
    def e_transform = transformer.transform(e);
    def r_transform = transformer.transform(rest);

    if (!ctx.static[c]) {
        return execBoth(
                    c, 
                    t_transform,
                    e_transform,
                    ctx
                ).appended(r_transform);
    } else {
        return SSAD.If(c, t_transform, e_transform, phis, r_transform);
    }
}

def cbd_opcodes : Array<string> = [
    "BR_IF", "I32_CONST", "I32_ADD", "I32_SUB", "I32_EQZ"
];

class FastIntCBDDef extends CBDDef {
    def stack_delta: int;
    new(opcode: string, body: SSAD, stack_delta: int) super(opcode, body) {}
}

def transformDef(opcode: string, stmt: VirgilStmt) -> CBDDef {
    var is_cbd_op = false;
    for (op in cbd_opcodes) if (Strings.equal(op, opcode)) is_cbd_op = true;
    if (!is_cbd_op) return null;

    def ir = SSAD_IR.from_virgil(stmt);
    def ssa = SSAD_IR.ssa(ir);
    def analysis = SSADCtx.new(ssa);

    def fx = Vector<CBDEffect>.new();
    analysis.collectEffects(ssa, fx);
    def eff_ctx = CBDEffects.run_fx(fx);

    def transformer = SSATransformer.new(analysis);
    transformer.onIf = flatten_ifs;
    transformer.onLetApp = TB(SSAD_IR.removeViews).then(SSAD_IR.overloadOps).then(SSAD_IR.addCasts).then(SSAT.transformChildren).f;

    def transformed = transformer.transform(ssa);
    def processed = analysis.DCE(analysis.id_propagate(transformed, Strings.newMap<string>()));

    return FastIntCBDDef.new(opcode, processed, eff_ctx.stack_delta);
}

def main(args: Array<string>) {
    def sexpr_file = args[0];
    def v3file = args[1];

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);
    def fi_intrinsics = IntrinsicTypes.getIntrinsicTypes("fast-int/Intrinsics.v3");
    fi_intrinsics.apply(IntrinsicTypes.add_def);

    def defs: Array<CBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);

    def genHandlerBuilder = StringBuilder.new();
    genHandlerBuilder.puts("def genCBDHandlers() {\n");
    for (d in defs) if (d != null) {
        def stack_delta = FastIntCBDDef.!(d).stack_delta;
        genHandlerBuilder
            .put1("\tbindHandler(Opcode.%s);\n", d.opcode)
            .puts("\treset();\n")
            .put1("\t%s();\n", d.opcode)
            .put1("\tadjustVsp(%d);\n", stack_delta)
            .puts("\tendHandler();\n")
            .ln();
    }
    genHandlerBuilder.puts("}");

    def dispatch_table = TierGen.buildDispatch(defs, CBDDef.!<CBDDef>(_));

    def template_filename = args[2];
    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY FastIntGen.v3\n");
    final_code_builder.puts(Arrays.range(template_code, 0, template_code.length - 2)).ln();
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts(genHandlerBuilder.toString()).ln();
    final_code_builder.puts("}\n");

    System.puts(final_code_builder.toString());
}
