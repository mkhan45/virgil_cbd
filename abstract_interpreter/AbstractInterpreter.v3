def m_isMemory64(memory_index: SV.U32) -> bool;
def m_isTable64(memory_index: SV.U32) -> bool;
def m_getFuncSignature(func_index: SV.U32) -> SigDecl {
    return null; // already in CBDFunction, TODO: refactor
}
def m_getSignature(sig_index: SV.U32) -> SigDecl;

// Instance context.
def i_getTableFunction64(table_index: SV.U32, sig: SigDecl, func_index: SV.U64) -> CBDFunction;
def i_getTableFunction32(table_index: SV.U32, sig: SigDecl, func_index: SV.U32) -> CBDFunction;
def i_getFunction(func_index: SV.U32) -> CBDFunction {
    return functions[int.!(func_index)];
}

// Control flow.
def doCall(sig: SigDecl, target: CBDFunction) {
    def new_frame = Frame.new(current_frame, target);
    current_frame = new_frame;
    current_frame.codeptr.iterate_local_codes(push_locals);
}

def doBranch(label: ()) {
    // doCtlXfer
    def ste = current_frame.sidetable.getBrEntry(current_frame.stp);
    
    // Create new frame with updated code pointer and sidetable pointer
    def new_frame = Frame(current_frame.parent, current_frame.fp, current_frame.sidetable, 
                         current_frame.stp + ste.dstp, current_frame.codeptr, current_frame.num_rets);
    new_frame.codeptr.at(current_frame.codeptr.pos + ste.dpc);
    
    // Handle stack adjustments
    if (ste.popcount > 0) {
        if (ste.valcount > 0) copyVals(ste.valcount, stack.top - int.!(ste.popcount + ste.valcount));
        else stack.top -= ste.popcount;
    }
    
    // Add continuation to worklist and break inner loop
    worklist.push(Cont(new_frame, stack.copy(), globals.copy()));
    should_break_inner_loop = true;
}

def doFallthru() {
    current_frame.stp += 4;
}

// Machine intrinsics.
def mach_readStructField_i8(obj: Object, offset: FieldOffset) -> i8;
def mach_readStructField_u8(obj: Object, offset: FieldOffset) -> u8;
