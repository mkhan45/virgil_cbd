def mach_readStructField_f64(obj: Object, offset: FieldOffset) -> double;
def mach_readStructField_v128(obj: Object, offset: FieldOffset) -> v128;
def mach_readStructField_Object(obj: Object, offset: FieldOffset) -> Object;

def mach_readMemory64_u32(memory_index: u32, index: u64, offset: u64) -> u32;
def mach_readMemory32_u32(memory_index: u32, index: u32, offset: u32) -> u32;

def mach_readTable64(table_index: u32, index: u64) -> Object;
def mach_readTable32(table_index: u32, index: u32) -> Object;

def mach_writeTable64(table_index: u32, index: u64, val: Object);
def mach_writeTable32(table_index: u32, index: u32, val: Object);

// Traps.
def invalid(); // should never occur
def trapNull();
def trapUnreachable();
def trapDivideByZero();
def trapDivideUnrepresentable();

def doBlock(bt: (Array<ValueType>, Array<ValueType>)) {
}

def doLoop(bt: (Array<ValueType>, Array<ValueType>)) {
}

def doIf(bt: (Array<ValueType>, Array<ValueType>)) {
}

def doEnd() {
    // CBD calls doReturn if at end
}

def doReturn() {
    def count = current_frame.num_rets;
    def dest = current_frame.fp;
    copyVals(count, dest);
    current_frame = current_frame.parent;
}

def doTry(bt: (Array<ValueType>, Array<ValueType>)) {
    return;
}

def f_isAtEnd() -> bool {
    return current_frame.codeptr.pos >= current_frame.codeptr.data.length;
}

def push_locals(count: u32, vtc: ValueTypeCode) {
    var val: Value;
    match (vtc.toConcreteValueKind(null)) {
        I32 => val = StaticnessEval.I32_0;
        I64 => val = StaticnessEval.I64_0;
        F32 => val = StaticnessEval.F32_0;
        F64 => val = StaticnessEval.F64_0;
        V128 => val = StaticnessEval.V128_0;
        REF => val = StaticnessEval.REF_NULL;
    }
    stack.pushn(val, int.!(count));
}

component Interpreter {
    def init(new_module: Module, args: Array<int>) {
        module = new_module;

        var main_idx = -1;
        for (i < module.exports.length) {
            if (Strings.equal(module.exports[i].0, "main")) main_idx = FuncDecl.!(module.exports[i].1).func_index;
        }

        functions = Vector<CBDFunction>.new();
        for (i < module.functions.length) functions.put(CBDFunction.new(module.functions[i]));

        Validator.init(module, args);
        
        for (i < functions.length) {
            def fn = functions[i];
            Validator.init_function(fn.code, fn.locals.copy(), fn.rets.copy());
            Validator.dispatch();
            fn.sidetable = Validator.build_sidetable();
            System.puts("validated ");
            System.puti(i);
            System.ln();
        }

        stack = ArrayStack<Value>.new();
        for (arg in args) stack.push(Value.I32(u32.view(arg)));
        current_frame = Frame.new(null, functions[main_idx]);
        
        worklist = ArrayStack<Cont>.new();
        
        globals = Vector.new();
        for (i < module.globals.length) {
            def module_global = module.globals[i];
            // TODO: full eval initexpr
            match (module_global.init) {
                I32(v) => globals.put(StaticnessEval.box_i(v));
                _ => globals.put(Value.I32(0));
            }
        }
    }

    def dispatch() {
        // Initialize the worklist with the starting state
        current_frame.codeptr.iterate_local_codes(push_locals);
        worklist.push(Cont(current_frame, stack.copy(), globals.copy()));
        
        // Outer loop: process continuations from worklist
        while (!worklist.empty()) {
            def cont = worklist.pop();
            current_frame = cont.frame;
            stack = cont.stack;
            globals = cont.globals;
            should_break_inner_loop = false;
            
            // Inner loop: process instructions until branch/return/end
            while (current_frame != null && current_frame.codeptr.pos < current_frame.codeptr.data.length && !should_break_inner_loop) {
                def op = current_frame.codeptr.read_opcode();
                // print_stack();
                // System.puts(op.mnemonic);
                // System.ln();
                DISPATCH_TABLE[op.code]();
            }
        }
    }

    def get_stack() -> ArrayStack<Value> {
        return stack;
    }

    def print_stack() {
        System.puts("[");
        for (i < stack.top) {
            match (stack.elems[i]) {
                I32(i) => System.puti(i32.!(i));
                _ => {}
            }
            if (i < stack.top - 1) System.puts(" ");
        }
        System.puts("]\n");
    }
}
