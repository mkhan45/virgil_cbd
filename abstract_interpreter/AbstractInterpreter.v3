  return DISPATCH_TABLE;
}
class Frame {
    var parent: Frame;
    var fp: int;
    var sidetable: Sidetable;
    var stp: int;
    var codeptr: CodePtr;
    var num_rets: int;

    new(parent: Frame, fn: CBDFunction) {
        fp = stack.top - fn.args.length;
        sidetable = fn.sidetable;
        stp = 0;
        codeptr = CodePtr.new(fn.code);
        num_rets = fn.rets.length;
    }
}

var module: Module;
var functions: Vector<CBDFunction>;

var current_frame: Frame;
var DISPATCH_TABLE: Array<void -> void> = build_dispatch_table();
var stack: ArrayStack<Value>;
var globals: Vector<Value>;

type Cont(frame: Frame, stack: ArrayStack<Value>; globals: Vector<Value>);
var worklist: ArrayStack<Cont>;
var should_break_inner_loop: bool;

class AbstractEval<I32, I64, U32, U64, F32, F64, REF> {
    def I32_equals(lhs: I32, rhs: I32) -> I32;
    def I32_div(lhs: I32, rhs: I32) -> I32;
    def I32_and(lhs: I32, rhs: I32) -> I32;
    def U32_equals(lhs: U32, rhs: U32) -> U32;
    def U32_not_equals(lhs: U32, rhs: U32) -> U32;
    def U32_plus(lhs: U32, rhs: U32) -> U32;
    def U32_minus(lhs: U32, rhs: U32) -> U32;
    def U32_div(lhs: U32, rhs: U32) -> U32;
    def U32_lt(lhs: U32, rhs: U32) -> U32;
    def U32_lte(lhs: U32, rhs: U32) -> U32;
    def U32_gt(lhs: U32, rhs: U32) -> U32;
    def U32_times(lhs: U32, rhs: U32) -> U32;
    def U32_and(lhs: U32, rhs: U32) -> U32;
    def rtcast_i32(i: i32) -> I32;
    def rtcast_u32(u: u32) -> U32;
}

class AbstractVal<I32, I64, U32, U64, F32, F64, REF> {
    def unbox_i() -> I32;
    def unbox_l() -> I64;
    def unbox_u() -> U32;
    def unbox_w() -> U64;
    def unbox_f() -> F32;
    def unbox_d() -> F64;
    def unbox_r() -> REF;
    
    def box_i(v: I32) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_l(v: I64) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_u(v: U32) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_w(v: U64) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_f(v: F32) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_d(v: F64) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def box_r(v: REF) -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    
    def I32_0() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def I64_0() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def F32_0() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def F64_0() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def V128_0() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
    def REF_NULL() -> AbstractVal<I32, I64, U32, U64, F32, F64, REF>;
}

def copyVals(count: int, dest: int) {
    def sp = stack.top - count;
    if (sp != dest) {
        var e = stack.elems;
        for (i < count) e[dest + i] = e[sp + i];
    }
    stack.top = dest + count;
}


def HAS_MEM_INDEX = 0x40u8;

def imm_readULEB32() -> u32 {
    return current_frame.codeptr.read_uleb32();
}

def imm_readILEB32() -> i32 {
    return i32.!(current_frame.codeptr.read_uleb32());
}

def imm_readULEB64() -> u64 {
    return current_frame.codeptr.read_uleb64();
}

def imm_readILEB64() -> i64 {
    return i64.!(current_frame.codeptr.read_uleb64());
}

def imm_readU8() -> u8 {
    return current_frame.codeptr.read1();
}

def imm_readBlockType() -> (Array<ValueType>, Array<ValueType>) {
    def bt = current_frame.codeptr.read_BlockTypeCode();
    return bt.toAbstractBlockType(module);
}

def pop_i32() -> SV.I32 {
    return StaticnessEval.unbox_i(stack.pop());
}
def pop_u32() -> SV.U32 {
    return StaticnessEval.unbox_u(stack.pop());
}
def pop_i64() -> SV.I64 {
    return StaticnessEval.unbox_l(stack.pop());
}
def pop_u64() -> SV.U64 {
    return StaticnessEval.unbox_w(stack.pop());
}
def pop_f32() -> SV.F32 {
    return StaticnessEval.unbox_f(stack.pop());
}
def pop_f64() -> SV.F64 {
    return StaticnessEval.unbox_d(stack.pop());
}
def pop_v128() -> SV.V128;
def pop_Object() -> SV.REF {
    return StaticnessEval.unbox<SV.REF>(stack.pop());
}
def pop_Value(tv: ()) -> Value {
    return stack.pop();
}

def push_i32(v: SV.I32) {
    stack.push(StaticnessEval.box_i(v));
}
def push_u32(v: SV.U32) {
    stack.push(StaticnessEval.box_u(v));
}
def push_i64(v: SV.I64) {
    stack.push(StaticnessEval.box_l(v));
}
def push_u64(v: SV.U64) {
    stack.push(StaticnessEval.box_w(v));
}
def push_f32(v: SV.F32) {
    stack.push(StaticnessEval.box_f(v));
}
def push_f64(v: SV.F64) {
    stack.push(StaticnessEval.box_d(v));
}
def push_v128(v: V128);
def push_Object(v: Object) {
    stack.push(StaticnessEval.box<Object>(v));
}
def push_Value(tv: (), v: Value) {
    stack.push(v);
}

// Local variables.
def getLocal(tv: (), index: SV.U32) -> Value {
    return stack.elems[current_frame.fp + int.!(index)];
}
def setLocal(tv: (), index: SV.U32, v: Value) {
    stack.elems[current_frame.fp + int.!(index)] = v;
}

// Global variables.
def getGlobal(tv: (), index: SV.U32) -> Value {
    return globals[int.!(index)];
}
def setGlobal(tv: (), index: SV.U32, v: Value) {
    globals[int.!(index)] = v;
}

