// i think basic blocks also need to track block args
class BasicBlock<AST> {
    var state: State<AST>;
    var cond: AST;
    var then: int;
    var els: int;

    new(state: State<AST>) {
        then = -1;
        els = -1;
    }

    def print() {
        System.puts("block ");
        System.puti(then);
        System.puts(" ");
        System.puti(els);
        System.ln();
    }
}

class CFGStateMgr<AST> extends StateManager<AST, AST, AST, AST, AST, AST> {
    var states: Vector<Vector<BasicBlock<AST>>>; // [function][pc]
    var shouldBreak: bool;
    var nullAST: void -> AST;

    // probably need a stack here for nested control flow?
    var inIf: bool;
    var inElse: bool;

    var currentBB: int;

    var currentFun: int;

    def init(frame: Frame, state: State<AST>) {
        current_frame = frame;
        currentBB = frame.codeptr.pos;
        def state = State<AST>.new(ArrayStack.new(), Vector.new(), ArrayStack.new(), Vector.new());
        states[current_frame.fn_idx][currentBB] = BasicBlock.new(state);
    }

    def startBB() {
        // TODO: only keep block args and globals
        def old_bb = states[current_frame.fn_idx][currentBB];
        def state = old_bb.state.dup();
        currentBB = current_frame.codeptr.pos;
        states[current_frame.fn_idx][currentBB] = BasicBlock.new(state);
    }

    new(module: Module) {
        states = Vector.new();
        for (i < module.functions.length) {
            states.put(Vector.new());
            def codelen = module.functions[i].orig_bytecode.length;
            for (j < codelen) states[i].put(null);
        }
        shouldBreak = false;
        currentFun = -1;
    }

    def branch(state: State<AST>) {
        def ste = current_frame.sidetable.getBrEntry(current_frame.stp);
        def new_pos = current_frame.codeptr.pos + ste.dpc;
        if (inIf) states[current_frame.fn_idx][currentBB].then = new_pos;
        if (inElse) states[current_frame.fn_idx][currentBB].els = new_pos;
    }
    def fallthru(state: State<AST>) {
        if (inIf) states[current_frame.fn_idx][currentBB].then = current_frame.codeptr.pos;
        if (inElse) states[current_frame.fn_idx][currentBB].els = current_frame.codeptr.pos;
    }
    def call(target: CBDFunctionI, state: State<AST>) {
        // do nothing, doesn't affect fn CFG
    }
    def block(bt: (Array<ValueType>, Array<ValueType>), state: State<AST>) {
    }
    def loop(bt: (Array<ValueType>, Array<ValueType>), state: State<AST>) {
        startBB();
    }
    def end(state: State<AST>) {
        startBB();
    }
    def ret(state: State<AST>) {
        shouldBreak = true;
    }

    def startCBDIf(cond: AST) {
        states[current_frame.fn_idx][currentBB].cond = cond;
        inIf = true;
        inElse = false;
    }
    def startCBDElse() {
        inIf = false;
        inElse = true;
    }
    def endCond() {
        inIf = false;
        inElse = false;
    }

    def hasNextCont() -> bool => currentFun < ai.module.functions.length - 1;
    def startNextCont() {
        currentFun += 1;
        shouldBreak = false;
        def new_frame = Frame.new(null, currentFun).init(ai.functions[currentFun]);
        init(new_frame, State<AST>.new(ArrayStack.new(), Vector.new(), ArrayStack.new(), Vector.new()));
        current_frame.codeptr.iterate_local_codes(ai.push_locals);
    }
    def shouldFinishCont() => shouldBreak;
}
