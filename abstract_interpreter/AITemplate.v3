// frames don't track fp, assume their own separate stack
class Frame {
    var parent: Frame;
    var sidetable: Sidetable;
    var stp: int;
    var codeptr: CodePtr;
    var num_rets: int;
    var fn_idx: int;

    new(parent: Frame, fn_idx: int) { }

    def init(fn: CBDFunctionI) -> this {
        sidetable = fn.sidetable;
        stp = 0;
        codeptr = CodePtr.new(fn.code);
        num_rets = fn.rets.length;
        fn_idx = fn.fn_idx;
    }

    def dup() -> Frame {
        def f = Frame.new(parent, fn_idx); 
        f.sidetable = sidetable;
        f.stp = stp;
        f.codeptr = codeptr.dup();
        f.num_rets = num_rets;
        return f;
    }
}

class State<V>(stack: ArrayStack<V>, globals: Vector<V>, stack_types: ArrayStack<TypeVar>, global_types: Vector<TypeVar>) {
    // should maybe be inheritable?
    def dup() -> State<V> {
        def new_stack = ArrayStack<V>.new();
        for (i < stack.top) new_stack.push(stack.elems[i]);
        def new_sts = ArrayStack<TypeVar>.new();
        for (i < stack_types.top) new_sts.push(stack_types.elems[i]);
        def new_globals = Vector<V>.new();
        for (i < globals.length) new_globals.put(globals[i]);
        def new_gts = Vector<TypeVar>.new();
        for (i < global_types.length) new_gts.put(global_types[i]);
        return State<V>.new(new_stack, new_globals, new_sts, new_gts);
    }
}
class StateManager<V, U32, U64, F32, F64, REF> {
    var current_frame: Frame;
    var ai: AI<V, U32, U64, F32, F64, REF>;

    def init(frame: Frame, state: State<V>);
    def branch(state: State<V>);
    def fallthru(state: State<V>);
    def call(target: CBDFunctionI, state: State<V>);
    def ret(state: State<V>);
    def block(bt: (Array<ValueType>, Array<ValueType>), state: State<V>);
    def loop(bt: (Array<ValueType>, Array<ValueType>), state: State<V>);
    def startIf(bt: (Array<ValueType>, Array<ValueType>), state: State<V>);
    def startElse(state: State<V>);
    def end(state: State<V>);
    def hasNextCont() -> bool;
    def startNextCont();
    def shouldFinishCont() -> bool;
}
class AI<V, U32, U64, F32, F64, REF> {
    var HAS_MEM_INDEX: U32; // XXX: i think this should be an intrinsic
    var module: Module;
    var functions: Vector<CBDFunctionI>;

    var DISPATCH_TABLE: Array<void -> void>;

    // maybe should be owned by state_manager?
    // it feels like they should be observed but not changed by state manager
    var stack: ArrayStack<V>;
    var stack_types: ArrayStack<TypeVar>;
    var globals: Vector<V>;
    var global_types: Vector<TypeVar>;
    def current_state() => State<V>.new(stack, globals, stack_types, global_types);
    def set_current_state(s: State<V>) {
        stack = s.stack;
        stack_types = s.stack_types;
        globals = s.globals;
        global_types = s.global_types;
    }

    var state_manager: StateManager<V, U32, U64, F32, F64, REF>;
    def current_frame() => state_manager.current_frame;

    new(module: Module, state_manager, args: Array<int>) {
        state_manager.ai = this;
        DISPATCH_TABLE = build_dispatch_table();

        functions = Vector<CBDFunctionI>.new();
        for (i < module.functions.length) functions.put(CBDFunctionI.new(module.functions[i], i));

        Validator.init(module, args);
        
        for (i < functions.length) {
            def fn = functions[i];
            Validator.init_function(fn.code, fn.args.copy(), fn.locals.copy(), fn.rets.copy());
            Validator.dispatch();
            fn.sidetable = Validator.build_sidetable();
            System.puts("validated ");
            System.puti(i);
            System.ln();
        }

        HAS_MEM_INDEX = rtcast_u32(0x40u);

        stack = ArrayStack<V>.new();
        stack_types = ArrayStack<TypeVar>.new();
        for (arg in args) stack.push(box_i(rtcast_u32(arg)));
        for (arg in args) stack_types.push(TypeVar.U32);

        var main_idx = -1;
        for (i < module.exports.length) {
            if (Strings.equal(module.exports[i].0, "main")) main_idx = FuncDecl.!(module.exports[i].1).func_index;
        }

        globals = Vector<V>.new();
        global_types = Vector<TypeVar>.new();
        for (i < module.globals.length) {
            def module_global = module.globals[i];
            // TODO: full eval initexpr
            match (module_global.init) {
                I32(v) => globals.put(box_i(rtcast_u32(v)));
                _ => globals.put(box_i(rtcast_u32(0)));
            }
            global_types.put(TypeVar.U32);
        }

        state_manager.init(Frame.new(null, main_idx).init(functions[main_idx]), current_state());
        current_frame().codeptr.iterate_local_codes(push_locals);
        
    }

    def dispatch() {
        while (state_manager.hasNextCont()) {
            state_manager.startNextCont();

            while (
                    current_frame() != null &&
                    current_frame().codeptr.pos < current_frame().codeptr.data.length && 
                    !state_manager.shouldFinishCont()
            ) {
                def op = current_frame().codeptr.read_opcode();
                print_stack();
                System.puti(current_frame().codeptr.pos);
                System.puts(" ");
                System.puts(op.mnemonic);
                System.ln();
                DISPATCH_TABLE[op.tag]();
            }
        }
        print_stack();
    }

    def print_stack() {}

    def U32_equals(lhs: U32, rhs: U32) -> U32;
    def U32_not_equals(lhs: U32, rhs: U32) -> U32;
    def U32_plus(lhs: U32, rhs: U32) -> U32;
    def U32_minus(lhs: U32, rhs: U32) -> U32;
    def U32_div(lhs: U32, rhs: U32) -> U32;
    def U32_lt(lhs: U32, rhs: U32) -> U32;
    def U32_lte(lhs: U32, rhs: U32) -> U32;
    def U32_gt(lhs: U32, rhs: U32) -> U32;
    def U32_times(lhs: U32, rhs: U32) -> U32;
    def U32_and(lhs: U32, rhs: U32) -> U32;

    def U32_maybeTrue(i: U32) -> bool;
    def U32_maybeFalse(i: U32) -> bool;

    def F32_equals(lhs: F32, rhs: F32) -> U32;
    def F32_not_equals(lhs: F32, rhs: F32) -> U32;
    def F32_plus(lhs: F32, rhs: F32) -> F32;
    def F32_minus(lhs: F32, rhs: F32) -> F32;
    def F32_div(lhs: F32, rhs: F32) -> F32;
    def F32_lt(lhs: F32, rhs: F32) -> U32;
    def F32_lte(lhs: F32, rhs: F32) -> U32;
    def F32_gt(lhs: F32, rhs: F32) -> U32;
    def F32_times(lhs: F32, rhs: F32) -> F32;
    def F32_sqrt(lhs: F32) -> F32;

    def unbox_i(v: V) -> U32;
    def unbox_l(v: V) -> U64;
    def unbox_f(v: V) -> F32;
    def unbox_d(v: V) -> F64;
    def unbox_r(v: V) -> REF;

    def U32_abs_eq(lhs: U32, rhs: U32) -> bool;
    def U64_abs_eq(lhs: U64, rhs: U64) -> bool;
    def F32_abs_eq(lhs: F32, rhs: F32) -> bool;
    def F64_abs_eq(lhs: F64, rhs: F64) -> bool;
    def REF_abs_eq(lhs: REF, rhs: REF) -> bool;
    def val_abs_eq(tv: TypeVar, lhs: V, rhs: V) -> bool {
        match (tv) {
            U32 => return U32_abs_eq(unbox_i(lhs), unbox_i(rhs));
            U64 => return U64_abs_eq(unbox_l(lhs), unbox_l(rhs));
            F32 => return F32_abs_eq(unbox_f(lhs), unbox_f(rhs));
            F64 => return F64_abs_eq(unbox_d(lhs), unbox_d(rhs));
            _ => {
                invalid();
                return false;
            }
        }
    }
    def state_abs_eq(lhs: State<V>, rhs: State<V>) -> bool {
        for (i < lhs.stack.top) {
            def tv = lhs.stack_types.elems[i];
            if (!val_abs_eq(tv, lhs.stack.elems[i], rhs.stack.elems[i])) return false;
        }
        for (i < lhs.globals.length) {
            def tv = lhs.global_types[i];
            if (!val_abs_eq(tv, lhs.globals[i], rhs.globals[i])) return false;
        }
        return true;
    }

    def merge_i(lhs: U32, rhs: U32) -> U32;
    def merge_l(lhs: U64, rhs: U64) -> U64;
    def merge_f(lhs: F32, rhs: F32) -> F32;
    def merge_d(lhs: F64, rhs: F64) -> F64;
    def merge_r(lhs: REF, rhs: REF) -> REF;
    def merge_val(tv: TypeVar, lhs: V, rhs: V) -> V {
        match (tv) {
            U32 => return box_i(merge_i(unbox_i(lhs), unbox_i(rhs)));
            U64 => return box_l(merge_l(unbox_l(lhs), unbox_l(rhs)));
            F32 => return box_f(merge_f(unbox_f(lhs), unbox_f(rhs)));
            F64 => return box_d(merge_d(unbox_d(lhs), unbox_d(rhs)));
            _ => {
                invalid();
                return lhs;
            }
        }
    }

    // TODO: return whether or not there was a change
    def merge_into(dst: State<V>, src: State<V>) {
        for (i < dst.stack.top) {
            def tv = dst.stack_types.elems[i];
            dst.stack.elems[i] = merge_val(tv, dst.stack.elems[i], src.stack.elems[i]);
        }
        for (i < dst.globals.length) {
            def tv = dst.global_types[i];
            dst.globals[i] = merge_val(tv, dst.globals[i], src.globals[i]);
        }
    }

    def box_i(v: U32) -> V;
    def box_l(v: U64) -> V;
    def box_f(v: F32) -> V;
    def box_d(v: F64) -> V;
    def box_ref(v: REF) -> V;
    def rtcast_u32(i: u32) -> U32;
    def rtcast_u64(i: u64) -> U64;
    def rtcast_f32(f: float) -> F32;
    def rtcast_f64(f: double) -> F64;
    def ref_null() -> REF;

    def f32_reinterpret_u32(i: U32) -> F32;
    def f64_reinterpret_u64(i: U64) -> F64;
    def u32_reinterpret_f32(f: F32) -> U32;
    def u64_reinterpret_f64(f: F64) -> U64;

    // only for V3Compiler
    def emitFwdU32() -> U32;
    def emitIf(c: U32);
    def emitElse();
    def emitIfStatic(c: bool);
    def emitEnd();

    def copyVals(count: int, dest: int) {
        def sp = stack.top - count;
        if (sp != dest) {
            var e = stack.elems;
            for (i < count) e[dest + i] = e[sp + i];
        }
        stack.top = dest + count;
    }

    def imm_readILEB32() -> u32 {
        return u32.!(current_frame().codeptr.read_uleb32());
    }

    def imm_readILEB64() -> u64 {
        return u64.!(current_frame().codeptr.read_uleb64());
    }

    def imm_readU8() -> u8 {
        return current_frame().codeptr.read1();
    }

    def imm_readBlockType() -> (Array<ValueType>, Array<ValueType>) {
        def bt = current_frame().codeptr.read_BlockTypeCode();
        return bt.toAbstractBlockType(module);
    }

    def pop_u32() -> U32 {
        return unbox_i(stack.pop());
    }
    def pop_u64() -> U64 {
        return unbox_l(stack.pop());
    }
    def pop_f32() -> F32 {
        return unbox_f(stack.pop());
    }
    def pop_f64() -> F64 {
        return unbox_d(stack.pop());
    }
    def pop_v128() -> ();
    def pop_Object() -> REF {
        return unbox_r(stack.pop());
    }
    def pop_Value(tv: TypeVar) -> V {
        return stack.pop();
    }

    def push_u32(v: U32) {
        stack.push(box_i(v));
        stack_types.push(TypeVar.U32);
    }
    def push_u64(v: U64) {
        stack.push(box_l(v));
        stack_types.push(TypeVar.U64);
    }
    def push_f32(v: F32) {
        stack.push(box_f(v));
        stack_types.push(TypeVar.F32);
    }
    def push_f64(v: F64) {
        stack.push(box_d(v));
        stack_types.push(TypeVar.F64);
    }
    def push_v128(v: ());
    def push_Object(v: REF) {
        stack.push(box_ref(v));
    }
    def push_Value(tv: TypeVar, v: V) {
        stack.push(v);
        stack_types.push(tv);
    }

    // Local variables.
    def getLocal(tv: TypeVar, index: u32) -> V {
        return stack.elems[index];
    }
    def setLocal(tv: TypeVar, index: u32, v: V) {
        stack.elems[index] = v;
    }

    // Global variables.
    def getGlobal(tv: TypeVar, index: u32) -> V {
        return globals[index];
    }
    def setGlobal(tv: TypeVar, index: u32, v: V) {
        globals[index] = v;
    }

    // CBDFunction context.
    def f_getLabel(depth: u32) -> () {
        return ();
    }

    def f_getLocalType(index: u32) -> TypeVar {
        return stack_types.elems[index];
    }

    def f_getTopOfStackType() -> TypeVar {
        return stack_types.peek();
    }

    // Module context.
    def m_getGlobalType(index: u32) -> TypeVar {
        return global_types[index];
    }
    def m_getFieldKind(struct_index: u32, field_index: u32) -> FieldKind;
    def m_getFieldOffset(struct_index: u32, field_index: u32) -> FieldOffset;
    def m_isMemory64(memory_index: u32) -> bool;
    def m_isTable64(memory_index: u32) -> bool;
    def m_getFuncSignature(func_index: u32) -> SigDecl {
        return null; // already in CBDFunction, TODO: refactor
    }
    def m_getSignature(sig_index: u32) -> HeapTypeDecl;

    // Instance context.
    def i_getTableFunction64(table_index: u32, sig: HeapTypeDecl, func_index: U64) -> CBDFunctionI;
    def i_getTableFunction32(table_index: u32, sig: HeapTypeDecl, func_index: U32) -> CBDFunctionI;
    def i_getFunction(func_index: u32) -> CBDFunctionI {
        return functions[int.view(func_index)];
    }

    // Control flow.
    def doCall(sig: SigDecl, target: CBDFunctionI) {
        state_manager.call(target, current_state());
        current_frame().codeptr.iterate_local_codes(push_locals);
    }
    def doReturnCall(sig: SigDecl, target: CBDFunctionI) => doCall(sig, target);

    def doBranch(label: ()) {
        def ste = current_frame().sidetable.getBrEntry(current_frame().stp);
        
        if (ste.popcount > 0) {
            if (ste.valcount > 0) copyVals(ste.valcount, stack.top - int.!(ste.popcount + ste.valcount));
            else stack.top -= ste.popcount;
        }
        
        state_manager.branch(current_state());
    }

    def doFallthru() {
        state_manager.fallthru(current_state());
    }

    // Machine intrinsics.
    def mach_readStructField_u8(obj: REF, offset: FieldOffset) -> U32;
    def mach_readStructField_u16(obj: REF, offset: FieldOffset) -> U32;
    def mach_readStructField_u32(obj: REF, offset: FieldOffset) -> U32;
    def mach_readStructField_u64(obj: REF, offset: FieldOffset) -> U64;
    def mach_readStructField_f32(obj: REF, offset: FieldOffset) -> F32;
    def mach_readStructField_f64(obj: REF, offset: FieldOffset) -> F64;
    def mach_readStructField_v128(obj: REF, offset: FieldOffset) -> ();
    def mach_readStructField_Object(obj: REF, offset: FieldOffset) -> REF;

    def mach_readMemory64_u8(memory_index: u32, index: U64, offset: u64) -> U32;
    def mach_readMemory32_u8(memory_index: u32, index: U32, offset: u32) -> U32;
    def mach_readMemory64_u16(memory_index: u32, index: U64, offset: u64) -> U32;
    def mach_readMemory32_u16(memory_index: u32, index: U32, offset: u32) -> U32;
    def mach_readMemory64_u32(memory_index: u32, index: U64, offset: u64) -> U32;
    def mach_readMemory32_u32(memory_index: u32, index: U32, offset: u32) -> U32;
    def mach_readMemory64_u64(memory_index: u32, index: U64, offset: u64) -> U64;
    def mach_readMemory32_u64(memory_index: u32, index: U32, offset: u32) -> U64;
    def mach_readMemory64_f32(memory_index: u32, index: U64, offset: u64) -> F32;
    def mach_readMemory32_f32(memory_index: u32, index: U32, offset: u32) -> F32;
    def mach_readMemory64_f64(memory_index: u32, index: U64, offset: u64) -> F64;
    def mach_readMemory32_f64(memory_index: u32, index: U32, offset: u32) -> F64;

    def mach_writeMemory64_u8(memory_index: u32, index: U64, offset: u64, val: U32);
    def mach_writeMemory32_u8(memory_index: u32, index: U32, offset: u32, val: U32);
    def mach_writeMemory64_u16(memory_index: u32, index: U64, offset: u64, val: U32);
    def mach_writeMemory32_u16(memory_index: u32, index: U32, offset: u32, val: U32);
    def mach_writeMemory64_u32(memory_index: u32, index: U64, offset: u64, val: U32);
    def mach_writeMemory32_u32(memory_index: u32, index: U32, offset: u32, val: U32);
    def mach_writeMemory64_u64(memory_index: u32, index: U64, offset: u64, val: U64);
    def mach_writeMemory32_u64(memory_index: u32, index: U32, offset: u32, val: U64);
    def mach_writeMemory64_f32(memory_index: u32, index: U64, offset: u64, val: F32);
    def mach_writeMemory32_f32(memory_index: u32, index: U32, offset: u32, val: F32);
    def mach_writeMemory64_f64(memory_index: u32, index: U64, offset: u64, val: F64);
    def mach_writeMemory32_f64(memory_index: u32, index: U32, offset: u32, val: F64);

    def mach_readTable64(table_index: u32, index: U64) -> REF;
    def mach_readTable32(table_index: u32, index: U32) -> REF;

    def mach_writeTable64(table_index: u32, index: U64, val: REF);
    def mach_writeTable32(table_index: u32, index: U32, val: REF);

    def object_Null() -> REF;
    def object_isNull(o: REF) -> U32;
    def object_New(sig: HeapTypeDecl) -> REF;

    // Traps.
    def invalid(); // should never occur
    def trapNull();
    def trapUnreachable();
    def trapDivideByZero();
    def trapDivideUnrepresentable();

    def doBlock(bt: (Array<ValueType>, Array<ValueType>)) {
        state_manager.block(bt, current_state());
    }

    def doLoop(bt: (Array<ValueType>, Array<ValueType>)) {
        state_manager.loop(bt, current_state());
    }

    def doIf(bt: (Array<ValueType>, Array<ValueType>)) {
        state_manager.startIf(bt, current_state());
    }
    def doElse() {
        state_manager.startElse(current_state());
    }

    def doEnd() {
        state_manager.end(current_state());
    }

    def doReturn() {
        state_manager.ret(current_state());
    }

    def doTry(bt: (Array<ValueType>, Array<ValueType>)) {
        return;
    }

    def f_isAtEnd() -> bool {
        return current_frame().codeptr.pos >= current_frame().codeptr.data.length;
    }

    def U32_div_s(lhs: U32, rhs: U32) -> U32;
    def U32_lt_s(lhs: U32, rhs: U32) -> U32;
    def U32_le_s(lhs: U32, rhs: U32) -> U32;

    def push_locals(count: u32, vtc: ValueTypeCode) {
        var val: V;
        match (vtc.toConcreteValueKind(null)) {
            I32 => val = box_i(rtcast_u32(0));
            I64 => val = box_l(rtcast_u64(0));
            F32 => val = box_f(rtcast_f32(0.0f));
            F64 => val = box_d(rtcast_f64(0.0));
            REF => val = box_ref(ref_null());
            _ => val = box_i(rtcast_u32(0));
        }
        stack.pushn(val, int.!(count));
    } // remove last brace for easier templating
