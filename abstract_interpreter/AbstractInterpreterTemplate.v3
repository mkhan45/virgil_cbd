class Frame {
    var parent: Frame;
    var fp: int;
    var sidetable: Sidetable;
    var stp: int;
    var codeptr: CodePtr;
    var num_rets: int;

    new(parent: Frame, stack_top: int, fn: CBDFunction) {
        fp = stack_top - fn.args.length;
        sidetable = fn.sidetable;
        stp = 0;
        codeptr = CodePtr.new(fn.code);
        num_rets = fn.rets.length;
    }
}

def main(args: Array<string>) {
    def filename = args[0];
    def file_bytes = System.fileLoad(filename);

    var interpreter_args: Array<int> = Array.new(args.length - 1);
    for (i = 1; i < args.length; i += 1) interpreter_args[i - 1] = Ints.parseDecimal(args[i], 0).1;

    def extensions = Extension.set.all;
    def limits = Limits.new().set(extensions);
    def err = ErrorGen.new(filename);

    def bp = BinParser.new(extensions, limits, err, filename);

    def module = bp.push(file_bytes, 0, file_bytes.length).finish();

    def i = AIRunner.init(module, interpreter_args);
    i.dispatch();
    AIRunner.on_finish(module, i);
}

type Cont<V>(frame: Frame, stack: ArrayStack<V>, globals: Vector<V>);
class AI<V, I32, I64, U32, U64, F32, F64, REF> {
    var module: Module;
    var functions: Vector<CBDFunction>;

    var current_frame: Frame; // maybe should be current cont
    var DISPATCH_TABLE: Array<void -> void>;
    var stack: ArrayStack<V>;
    var globals: Vector<V>;

    var worklist: ArrayStack<Cont<V>>;
    var should_break_inner_loop: bool;

    new(module: Module, args: Array<int>) {
        DISPATCH_TABLE = build_dispatch_table();

        var main_idx = -1;
        for (i < module.exports.length) {
            if (Strings.equal(module.exports[i].0, "main")) main_idx = FuncDecl.!(module.exports[i].1).func_index;
        }

        functions = Vector<CBDFunction>.new();
        for (i < module.functions.length) functions.put(CBDFunction.new(module.functions[i]));

        Validator.init(module, args);
        
        for (i < functions.length) {
            def fn = functions[i];
            Validator.init_function(fn.code, fn.locals.copy(), fn.rets.copy());
            Validator.dispatch();
            fn.sidetable = Validator.build_sidetable();
            System.puts("validated ");
            System.puti(i);
            System.ln();
        }

        stack = ArrayStack<V>.new();
        for (arg in args) stack.push(box_i(rtcast_i32(arg)));
        current_frame = Frame.new(null, stack.top, functions[main_idx]);
        
        worklist = ArrayStack<Cont<V>>.new();
        
        globals = Vector<V>.new();
        for (i < module.globals.length) {
            def module_global = module.globals[i];
            // TODO: full eval initexpr
            match (module_global.init) {
                I32(v) => globals.put(box_i(rtcast_i32(v)));
                _ => globals.put(box_i(rtcast_i32(0)));
            }
        }
    }

    def dispatch() {
        // Initialize the worklist with the starting state
        current_frame.codeptr.iterate_local_codes(push_locals);
        def new_stack = ArrayStack<V>.new();
        for (i < stack.top) new_stack.push(stack.elems[i]);
        def new_globals = Vector<V>.new();
        new_globals.array = globals.copy();
        new_globals.length = globals.length;
        worklist.push(Cont<V>(current_frame, new_stack, new_globals));
        
        // Outer loop: process continuations from worklist
        while (!worklist.empty()) {
            def cont = worklist.pop();
            current_frame = cont.frame;
            stack = cont.stack;
            globals = cont.globals;
            should_break_inner_loop = false;
            
            // Inner loop: process instructions until branch/return/end
            while (current_frame != null && current_frame.codeptr.pos < current_frame.codeptr.data.length && !should_break_inner_loop) {
                def op = current_frame.codeptr.read_opcode();
                // print_stack();
                // System.puts(op.mnemonic);
                // System.ln();
                DISPATCH_TABLE[op.code]();
            }
        }
    }

    def I32_equals(lhs: I32, rhs: I32) -> I32;
    def I32_div(lhs: I32, rhs: I32) -> I32;
    def I32_and(lhs: I32, rhs: I32) -> I32;
    def U32_equals(lhs: U32, rhs: U32) -> U32;
    def U32_not_equals(lhs: U32, rhs: U32) -> U32;
    def U32_plus(lhs: U32, rhs: U32) -> U32;
    def U32_minus(lhs: U32, rhs: U32) -> U32;
    def U32_div(lhs: U32, rhs: U32) -> U32;
    def U32_lt(lhs: U32, rhs: U32) -> U32;
    def U32_lte(lhs: U32, rhs: U32) -> U32;
    def U32_gt(lhs: U32, rhs: U32) -> U32;
    def U32_times(lhs: U32, rhs: U32) -> U32;
    def U32_and(lhs: U32, rhs: U32) -> U32;

    def I32_maybeTrue(i: I32) -> bool;
    def U32_maybeTrue(u: U32) -> bool;

    def unbox_i(v: V) -> I32;
    def unbox_l(v: V) -> I64;
    def unbox_u(v: V) -> U32;
    def unbox_w(v: V) -> U64;
    def unbox_f(v: V) -> F32;
    def unbox_d(v: V) -> F64;
    def unbox_r(v: V) -> REF;

    def box_i(v: I32) -> V;
    def box_u(v: U32) -> V;
    def box_l(v: I64) -> V;
    def box_w(v: U64) -> V;
    def box_f(v: F32) -> V;
    def box_d(v: F64) -> V;
    def box_ref(v: REF) -> V;
    def rtcast_i32(i: i32) -> I32;
    def rtcast_i64(i: i64) -> I64;
    def rtcast_u32(u: u32) -> U32;
    def rtcast_f32(f: float) -> F32;
    def rtcast_f64(f: double) -> F64;
    def ref_null() -> REF;

    def copyVals(count: int, dest: int) {
        def sp = stack.top - count;
        if (sp != dest) {
            var e = stack.elems;
            for (i < count) e[dest + i] = e[sp + i];
        }
        stack.top = dest + count;
    }

    def imm_readULEB32() -> u32 {
        return current_frame.codeptr.read_uleb32();
    }

    def imm_readILEB32() -> i32 {
        return i32.!(current_frame.codeptr.read_uleb32());
    }

    def imm_readULEB64() -> u64 {
        return current_frame.codeptr.read_uleb64();
    }

    def imm_readILEB64() -> i64 {
        return i64.!(current_frame.codeptr.read_uleb64());
    }

    def imm_readU8() -> u8 {
        return current_frame.codeptr.read1();
    }

    def imm_readBlockType() -> (Array<ValueType>, Array<ValueType>) {
        def bt = current_frame.codeptr.read_BlockTypeCode();
        return bt.toAbstractBlockType(module);
    }

    def pop_i32() -> I32 {
        return unbox_i(stack.pop());
    }
    def pop_u32() -> U32 {
        return unbox_u(stack.pop());
    }
    def pop_i64() -> I64 {
        return unbox_l(stack.pop());
    }
    def pop_u64() -> U64 {
        return unbox_w(stack.pop());
    }
    def pop_f32() -> F32 {
        return unbox_f(stack.pop());
    }
    def pop_f64() -> F64 {
        return unbox_d(stack.pop());
    }
    def pop_v128() -> ();
    def pop_Object() -> REF {
        return unbox_r(stack.pop());
    }
    def pop_Value(tv: ()) -> V {
        return stack.pop();
    }

    def push_i32(v: I32) {
        stack.push(box_i(v));
    }
    def push_u32(v: U32) {
        stack.push(box_u(v));
    }
    def push_i64(v: I64) {
        stack.push(box_l(v));
    }
    def push_u64(v: U64) {
        stack.push(box_w(v));
    }
    def push_f32(v: F32) {
        stack.push(box_f(v));
    }
    def push_f64(v: F64) {
        stack.push(box_d(v));
    }
    def push_v128(v: ());
    def push_Object(v: REF) {
        stack.push(box_ref(v));
    }
    def push_Value(tv: (), v: V) {
        stack.push(v);
    }

    // Local variables.
    def getLocal(tv: (), index: u32) -> V {
        return stack.elems[current_frame.fp + int.!(index)];
    }
    def setLocal(tv: (), index: u32, v: V) {
        stack.elems[current_frame.fp + int.!(index)] = v;
    }

    // Global variables.
    def getGlobal(tv: (), index: u32) -> V {
        return globals[int.!(index)];
    }
    def setGlobal(tv: (), index: u32, v: V) {
        globals[int.!(index)] = v;
    }

    // CBDFunction context.
    def f_getLabel(depth: u32) -> () {
        return ();
    }

    def f_getLocalType(index: u32) -> () {
        return ();
    }

    def f_getTopOfStackType() -> () {
        return ();
    }

    // Module context.
    def m_getGlobalType(index: u32) -> () {
        return ();
    }
    def m_getFieldKind(struct_index: u32, field_index: u32) -> FieldKind;
    def m_getFieldOffset(struct_index: u32, field_index: u32) -> FieldOffset;
    def m_isMemory64(memory_index: u32) -> bool;
    def m_isTable64(memory_index: u32) -> bool;
    def m_getFuncSignature(func_index: u32) -> SigDecl {
        return null; // already in CBDFunction, TODO: refactor
    }
    def m_getSignature(sig_index: u32) -> SigDecl;

    // Instance context.
    def i_getTableFunction64(table_index: u32, sig: SigDecl, func_index: U64) -> CBDFunction;
    def i_getTableFunction32(table_index: u32, sig: SigDecl, func_index: U32) -> CBDFunction;
    def i_getFunction(func_index: u32) -> CBDFunction {
        return functions[int.!(func_index)];
    }

    // Control flow.
    def doCall(sig: SigDecl, target: CBDFunction) {
        def new_frame = Frame.new(current_frame, stack.top, target);
        current_frame = new_frame;
        current_frame.codeptr.iterate_local_codes(push_locals);
    }

    def doBranch(label: ()) {
        // TODO: merge current state into label

        // doCtlXfer
        def ste = current_frame.sidetable.getBrEntry(current_frame.stp);
        
        // Create new frame with updated code pointer and sidetable pointer
        // TODO: change frame constructor?
        def new_frame = Frame.new(current_frame.parent, stack.top, functions[0]);
        new_frame.fp = current_frame.fp;
        new_frame.sidetable = current_frame.sidetable;
        new_frame.stp = current_frame.stp + ste.dstp;
        new_frame.codeptr = current_frame.codeptr.dup();
        new_frame.codeptr.at(current_frame.codeptr.pos + ste.dpc);
        new_frame.num_rets = current_frame.num_rets;
        
        // Handle stack adjustments
        if (ste.popcount > 0) {
            if (ste.valcount > 0) copyVals(ste.valcount, stack.top - int.!(ste.popcount + ste.valcount));
            else stack.top -= ste.popcount;
        }
        
        // Add continuation to worklist and break inner loop
        def new_stack = ArrayStack<V>.new();
        for (i < stack.top) new_stack.push(stack.elems[i]);
        def new_globals = Vector<V>.new();
        new_globals.array = globals.copy();
        new_globals.length = globals.length;
        worklist.push(Cont(new_frame, new_stack, new_globals));
        should_break_inner_loop = true;
    }

    def doFallthru() {
        current_frame.stp += 4;
    }

    // Machine intrinsics.
    def mach_readStructField_u32(obj: REF, offset: FieldOffset) -> U32;
    def mach_readStructField_u64(obj: REF, offset: FieldOffset) -> U64;
    def mach_readStructField_f32(obj: REF, offset: FieldOffset) -> F32;
    def mach_readStructField_f64(obj: REF, offset: FieldOffset) -> F64;
    def mach_readStructField_v128(obj: REF, offset: FieldOffset) -> v128;
    def mach_readStructField_Object(obj: REF, offset: FieldOffset) -> REF;

    def mach_readMemory64_u32(memory_index: u32, index: U64, offset: u64) -> U32;
    def mach_readMemory32_u32(memory_index: u32, index: U32, offset: u32) -> U32;

    def mach_readTable64(table_index: u32, index: U64) -> REF;
    def mach_readTable32(table_index: u32, index: U32) -> REF;

    def mach_writeTable64(table_index: u32, index: U64, val: REF);
    def mach_writeTable32(table_index: u32, index: U32, val: REF);

    // Traps.
    def invalid(); // should never occur
    def trapNull();
    def trapUnreachable();
    def trapDivideByZero();
    def trapDivideUnrepresentable();

    def doBlock(bt: (Array<ValueType>, Array<ValueType>)) {
    }

    def doLoop(bt: (Array<ValueType>, Array<ValueType>)) {
    }

    def doIf(bt: (Array<ValueType>, Array<ValueType>)) {
    }

    def doEnd() {
        // CBD calls doReturn if at end
    }

    def doReturn() {
        def count = current_frame.num_rets;
        def dest = current_frame.fp;
        copyVals(count, dest);
        current_frame = current_frame.parent;
    }

    def doTry(bt: (Array<ValueType>, Array<ValueType>)) {
        return;
    }

    def f_isAtEnd() -> bool {
        return current_frame.codeptr.pos >= current_frame.codeptr.data.length;
    }

    def push_locals(count: u32, vtc: ValueTypeCode) {
        var val: V;
        match (vtc.toConcreteValueKind(null)) {
            I32 => val = box_i(rtcast_i32(0));
            I64 => val = box_l(rtcast_i64(0));
            F32 => val = box_f(rtcast_f32(0.0f));
            F64 => val = box_d(rtcast_f64(0.0));
            REF => val = box_ref(ref_null());
            _ => val = box_i(rtcast_i32(0));
        }
        stack.pushn(val, int.!(count));
    } // remove last brace for easier templating
