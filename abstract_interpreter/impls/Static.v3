type SV {
    case I32(static: bool, val: i32);
    case I64(static: bool, val: i64);
    case F32(static: bool, val: float);
    case F64(static: bool, val: double);
    case REF(static: bool);

    def toString() -> string {
        match (this) {
            I32(s, v) => return if(s, StringBuilder.new().putd(v).toString(), "I32");
            I64(s, v) => return if(s, StringBuilder.new().putd(v).toString(), "I64");
            F32(s, v) => return if(s, "static float", "F32");
            F64(s, v) => return if(s, "static double", "F64");
            REF(s)    => return if(s, "static ref", "REF");
        }
    }
}

class StaticnessEval extends AI<SV, SV.I32, SV.I64, SV.F32, SV.F64, SV.REF> {
    new(module: Module, args: Array<int>) super(module, ContextInsensitiveStateMgr.new(module), args) {
        if (args[0] == -1) stack.elems[0] = SV.I32(false, 0);
    }

    def print_stack() {
        System.puts("[");
        for (i < stack.top) {
            System.puts(stack.elems[i].toString());
            if (i + 1 < stack.top) System.puts(", ");
        }
        System.puts("]\n");
    }

    def I32_equals(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, if(lhs.val == rhs.val, 1, 0));
        else return SV.I32(false, 0);
    }

    def I32_not_equals(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, if(lhs.val != rhs.val, 1, 0));
        else return SV.I32(false, 0);
    }

    def I32_plus(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, lhs.val + rhs.val);
        else return SV.I32(false, 0);
    }

    def I32_minus(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, lhs.val - rhs.val);
        else return SV.I32(false, 0);
    }

    def I32_div(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static && rhs.val != 0) return SV.I32(true, lhs.val / rhs.val);
        else return SV.I32(false, 0);
    }

    def I32_lt(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, if(lhs.val < rhs.val, 1, 0));
        else return SV.I32(false, 0);
    }

    def I32_lte(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, if(lhs.val <= rhs.val, 1, 0));
        else return SV.I32(false, 0);
    }

    def I32_gt(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, if(lhs.val > rhs.val, 1, 0));
        else return SV.I32(false, 0);
    }

    def I32_times(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, lhs.val * rhs.val);
        else return SV.I32(false, 0);
    }

    def I32_and(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static) return SV.I32(true, lhs.val & rhs.val);
        else return SV.I32(false, 0);
    }

    def I32_maybeTrue(i: SV.I32)  -> bool { return (i.val == 1) || (!i.static); }
    def I32_maybeFalse(i: SV.I32) -> bool { return (i.val == 0) || (!i.static); }

    def merge_i(lhs: SV.I32, rhs: SV.I32) -> SV.I32 {
        if (lhs.static && rhs.static && lhs.val == rhs.val) return lhs;
        else return SV.I32(false, 0);
    }

    def unbox_i(v: SV) -> SV.I32 {
        if (SV.I32.?(v)) return SV.I32.!(v);
        else return SV.I32(false, 0);
    }
    // def unbox_w(v: SV) -> SV.U64 { return SV.U64.!(v); } // TODO: v3c internal error
    // def unbox_l(v: SV) -> SV.I64 { return SV.I64.!(v); }
    // def unbox_f(v: SV) -> SV.F32 { return SV.F32.!(v); }
    // def unbox_d(v: SV) -> SV.F64 { return SV.F64.!(v); }
    // def unbox_r(v: SV) -> SV.REF { return SV.REF.!(v); }
    def unbox_l(v: SV) -> SV.I64 {
        if (SV.I64.?(v)) return SV.I64.!(v); 
        else return SV.I64(false, 0);
    }
    def unbox_f(v: SV) -> SV.F32 { 
        if (SV.F32.?(v)) return SV.F32.!(v); 
        else return SV.F32(false, 0.0f);
    }
    def unbox_d(v: SV) -> SV.F64 { 
        if (SV.F64.?(v)) return SV.F64.!(v); 
        else return SV.F64(false, 0.0d);
    }
    def unbox_r(v: SV) -> SV.REF { 
        if (SV.REF.?(v)) return SV.REF.!(v); 
        else return SV.REF(false);
    }

    def box_i(i: SV.I32) -> SV {
        return i;
    }

    def I32_abs_eq(lhs: SV.I32, rhs: SV.I32) -> bool {
        return (lhs.static && rhs.static && lhs.val == rhs.val)
            || (!lhs.static && !rhs.static);
    }

    def rtcast_i32(i: i32) -> SV.I32 {
        return SV.I32(true, i);
    }
}

component AIRunner {
    def init(m: Module, args: Array<int>) -> AI<SV, SV.I32, SV.I64, SV.F32, SV.F64, SV.REF> {
        return StaticnessEval.new(m, args);
    }

    def on_finish(m: Module, i: AI<SV, SV.I32, SV.I64, SV.F32, SV.F64, SV.REF>) {
        def i = StaticnessEval.!(i);
        def ctx = ContextInsensitiveStateMgr<
            SV, SV.I32, SV.I64, SV.F32, SV.F64, SV.REF
        >.!(i.state_manager);
        def state = ctx.ret_state(0);
        i.set_current_state(state);
        i.print_stack();
        System.ln();
    }
}
