// TODO: properly handle pops
def execBoth(a: SSAD, b: SSAD, ctx: SSADCtx) -> SSAD {
    def afx = Vector<CBDEffect>.new();
    def bfx = Vector<CBDEffect>.new();
    ctx.collectEffects(a, afx);
    ctx.collectEffects(b, bfx);

    def a_res = CBDEffects.run_fx(afx);
    def b_res = CBDEffects.run_fx(bfx);
    // assert fx equal

    def a_pushes = Vector<string>.new();
    def b_pushes = Vector<string>.new();
    def a_nopush = collectPushes(a, a_pushes, ctx);
    def b_nopush = collectPushes(b, b_pushes, ctx);
    // assert a_pushes.length == b_pushes.length

    // TODO: consider other effects to be filtered,
    // e.g. locals, globals, memory
    var res = a_nopush.appended(b_nopush);
    for (i < a_pushes.length) {
        def stack_merge = SSAD_IR.uidl("stack_merge");
        def eff = SSAD_IR.uidl("eff");
        def tp = ctx.types[a_pushes[i]];
        def merge_fn = Strings.format1("merge_%s", tp.toStringShort());
        def push_fn = Strings.format1("push_%s", tp.toString());
        res = res.appended(
                SSAD.LetApp(stack_merge, merge_fn, [a_pushes[i], b_pushes[i]],
                    SSAD.LetApp(eff, push_fn, [stack_merge], SSAD.Void)));
    }

    return res;
}

def collectPushes(s: SSAD, pushBuf: Vector<string>, ctx: SSADCtx) -> SSAD {
    match (s) {
        Void => return s;
        Final(_) => return s;
        Injected(inj, rest) => return SSAD.Injected(inj, collectPushes(rest, pushBuf, ctx));
        LetLit(n, l, t, rest) => return SSAD.LetLit(n, l, t, collectPushes(rest, pushBuf, ctx));
        // I we can defer this to recursion in transformSSA
        If(c, t, e, phis, rest) => return SSAD.If(c, t, e, phis, collectPushes(rest, pushBuf, ctx));
        LetApp(n, f, args, rest) => {
            if (ctx.effects[n] == CBDEffect.Push) {
                // one arg, value being pushed
                pushBuf.put(args[0]);
                return rest;
            } else {
                return s;
            }
        }
    }
}

def transformSSA(ssa: SSAD, ctx: SSADCtx) -> SSAD {
    // return ssa;
    match (ssa) {
        Void => return ssa;
        Final(_) => return ssa;
        Injected(inj, rest) => return SSAD.Injected(inj, transformSSA(rest, ctx));
        LetLit(n, l, t, rest) => return SSAD.LetLit(n, l, t, transformSSA(rest, ctx));
        If(c, t, e, phis, rest) => {
            // TODO: could check for returns and choose not to execute a branch
            // TODO: have to do stack phis
            if (!ctx.static[c]) {
                def fvTrue = SSAD_IR.uidl("condTrue");
                def fvFalse = SSAD_IR.uidl("condFalse");
                def fvBoth = SSAD_IR.uidl("condBoth");
                def tp = ctx.types[c];
                var tp_str = tp.toString();
                if (tp != CBDType.Bot) tp_str = Arrays.replace<u8>(tp_str, 0, tp_str[0] - 32u8);
                def fnTrue = Strings.format1("%s_maybeTrue", tp_str);
                def fnFalse = Strings.format1("%s_maybeFalse", tp_str);
                ctx.static[fvTrue] = false;
                ctx.static[fvFalse] = false;
                return SSAD.LetApp(fvTrue, fnTrue, [c],
                        SSAD.LetApp(fvFalse, fnFalse, [c],
                            SSAD.LetApp(fvBoth, "bool.&&", [fvTrue, fvFalse],
                                SSAD.If(fvBoth,
                                    execBoth(t, e, ctx),
                                    SSAD.If(fvTrue, 
                                        transformSSA(t, ctx), 
                                        transformSSA(e, ctx), // else must be true (issue #11)
                                        [],
                                        SSAD.Void
                                    ),
                                    phis,
                                    transformSSA(rest, ctx)))));
            } else {
                return SSAD.If(c, transformSSA(t, ctx), transformSSA(e, ctx), phis, rest);
            }
        }
        LetApp(n, f, args, rest) => {
            var is_op = false;
            for (c in f) if (c == '.') is_op = true;
            def is_rt = !ctx.static[n];
            if (is_op && is_rt) {
                def tp = ctx.types[n];
                def tp_str = tp.toString();
                var prefix: string;
                // there is a weird case for this, in Virgil test ops
                // return booleans but in Wasm they don't. So e.g. i32.==
                // returns a boolean but then we can't use i32.&, but it's
                // still an i32 in wasm and we want to validator to know that.
                // Luckily, all testops necessarily get DCE'd since the 
                // validator executes every path. So sometimes Bot will occur
                // here but get DCE'd out.
                match (tp) {
                    Void => prefix = "TypeVar";
                    Bot => prefix = "V";
                    _ => prefix = Arrays.replace<u8>(tp_str, 0, tp_str[0] - 32u8);
                }

                var op: string = Strings.format1("UNHANDLED_OP_%s", f);
                if (Strings.endsWith(f, "==")) op = "equals";
                if (Strings.endsWith(f, "!=")) op = "not_equals";
                if (Strings.endsWith(f, "/")) op = "div";
                if (Strings.endsWith(f, "&&")) op = "and";
                if (Strings.endsWith(f, "&")) op = "and";
                if (Strings.endsWith(f, "+")) op = "plus";
                if (Strings.endsWith(f, "-")) op = "minus";
                if (Strings.endsWith(f, "<")) op = "lt";
                if (Strings.endsWith(f, "<=")) op = "lte";
                if (Strings.endsWith(f, ">")) op = "gt";
                if (Strings.endsWith(f, "*")) op = "times";

                def new_f = Strings.format2("%s_%s", prefix, op);
                ctx.effects[n] = CBDEffect.None;
                return transformSSA(SSAD.LetApp(n, new_f, args, rest), ctx);
            }

            def intrinsic_static = IntrinsicTypes.intrinsic_static(f);
            def intrinsic_type = IntrinsicTypes.intrinsic_type(f);
            def args_static = intrinsic_static.0;
            def args_types = intrinsic_type.0;
            var rtcasts: SSAD = SSAD.Void;
            def new_args = Arrays.dup(args);
            if (args_static != null) {
                for (i < args_static.length) {
                    def is_runtime = !ctx.static[args[i]];
                    def should_be_runtime = !args_static[i];
                    if (!is_runtime && should_be_runtime) {
                        def fv = SSAD_IR.uidl("rtcast");
                        def tp = if(args_types[i] != CBDType.Bot, args_types[i], ctx.types[args[i]]);
                        def rtcast_f = Strings.format1("rtcast_%s", tp.toString());
                        ctx.static[fv] = false;
                        ctx.types[fv] = ctx.types[args[i]];
                        ctx.effects[fv] = CBDEffect.None;
                        new_args[i] = fv;
                        rtcasts = SSAD.LetApp(fv, rtcast_f, [args[i]], rtcasts);
                    }
                }
            }

            return rtcasts.appended(SSAD.LetApp(n, f, new_args, transformSSA(rest, ctx)));
        }
    }
}

def transformDef(opcode: string, stmt: VirgilStmt) -> CBDDef {
    def ir = SSAD_IR.from_virgil(stmt);
    SSAD_IR.counter = 0;
    def ssa = SSAD_IR.ssa(ir);
    def analysis = SSADCtx.new(ssa);
    def transformed = transformSSA(ssa, analysis);
    def processed = analysis.DCE(analysis.id_propagate(transformed, HashMap<string, string>.new(Strings.hash, Strings.equal)));
    return CBDDef.new(opcode, processed);
}

def main(args: Array<string>) {
    def sexpr_file = args[0];
    def v3file = args[1];

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);
    def ai_intrinsics = IntrinsicTypes.getIntrinsicTypes("abstract_interpreter/Intrinsics.v3");
    ai_intrinsics.apply(IntrinsicTypes.add_def);

    def defs: Array<CBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);
    def dispatch_table = TierGen.buildDispatch(defs, CBDDef.!<CBDDef>(_));

    def template_filename = args[2];
    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY InterpreterGen.v3\n");
    final_code_builder.puts(template_code);
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts("}");

    System.puts(final_code_builder.toString());
}
