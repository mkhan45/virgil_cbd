        stack = ArrayStack<V>.new();
        stack_types = ArrayStack<TypeVar>.new();
        for (arg in args) stack.push(box_i(rtcast_i32(arg)));
        for (arg in args) stack_types.push(TypeVar.I32);

        var main_idx = -1;
        for (i < module.exports.length) {
