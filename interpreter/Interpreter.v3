}

// Control flow.
def doCall(sig: SigDecl, target: CBDFunction) {
    def new_frame = Frame.new(current_frame, target);
    current_frame = new_frame;
    current_frame.codeptr.iterate_local_codes(push_locals);
}

def doBranch(label: ()) {
    // doCtlXfer
    def ste = current_frame.sidetable.getBrEntry(current_frame.stp);
    current_frame.codeptr.at(current_frame.codeptr.pos + ste.dpc);
    current_frame.stp += ste.dstp;
    if (ste.popcount > 0) {
        if (ste.valcount > 0) copyVals(ste.valcount, stack.top - int.!(ste.popcount + ste.valcount));
        else stack.top -= ste.popcount;
    }
}

def doFallthru() {
    current_frame.stp += 4;
}

