def build_dispatch_table() -> Array<void -> void> {
  DISPATCH_TABLE = Array.new(0xE5 + 1);
  DISPATCH_TABLE[Opcode.UNREACHABLE.code] = UNREACHABLE;
  DISPATCH_TABLE[Opcode.NOP.code] = NOP;
  DISPATCH_TABLE[Opcode.LOCAL_GET.code] = LOCAL_GET;
  DISPATCH_TABLE[Opcode.LOCAL_SET.code] = LOCAL_SET;
  DISPATCH_TABLE[Opcode.LOCAL_TEE.code] = LOCAL_TEE;
  DISPATCH_TABLE[Opcode.GLOBAL_GET.code] = GLOBAL_GET;
  DISPATCH_TABLE[Opcode.GLOBAL_SET.code] = GLOBAL_SET;
  DISPATCH_TABLE[Opcode.TABLE_GET.code] = TABLE_GET;
  DISPATCH_TABLE[Opcode.TABLE_SET.code] = TABLE_SET;
  DISPATCH_TABLE[Opcode.CALL.code] = CALL;
  DISPATCH_TABLE[Opcode.CALL_INDIRECT.code] = CALL_INDIRECT;
  DISPATCH_TABLE[Opcode.DROP.code] = DROP;
  DISPATCH_TABLE[Opcode.SELECT.code] = SELECT;
  DISPATCH_TABLE[Opcode.I32_CONST.code] = I32_CONST;
  DISPATCH_TABLE[Opcode.I32_ADD.code] = I32_ADD;
  DISPATCH_TABLE[Opcode.I32_SUB.code] = I32_SUB;
  DISPATCH_TABLE[Opcode.I32_MUL.code] = I32_MUL;
  DISPATCH_TABLE[Opcode.I32_DIV_S.code] = I32_DIV_S;
  DISPATCH_TABLE[Opcode.I32_DIV_U.code] = I32_DIV_U;
  DISPATCH_TABLE[Opcode.I32_EQZ.code] = I32_EQZ;
  DISPATCH_TABLE[Opcode.I32_EQ.code] = I32_EQ;
  DISPATCH_TABLE[Opcode.I32_NE.code] = I32_NE;
  DISPATCH_TABLE[Opcode.I32_LT_U.code] = I32_LT_U;
  DISPATCH_TABLE[Opcode.I32_LE_S.code] = I32_LE_S;
  DISPATCH_TABLE[Opcode.I32_GT_U.code] = I32_GT_U;
  DISPATCH_TABLE[Opcode.I32_AND.code] = I32_AND;
  DISPATCH_TABLE[Opcode.BR.code] = BR;
  DISPATCH_TABLE[Opcode.BR_IF.code] = BR_IF;
  DISPATCH_TABLE[Opcode.BLOCK.code] = BLOCK;
  DISPATCH_TABLE[Opcode.LOOP.code] = LOOP;
  DISPATCH_TABLE[Opcode.TRY.code] = TRY;
  DISPATCH_TABLE[Opcode.IF.code] = IF;
  DISPATCH_TABLE[Opcode.ELSE.code] = ELSE;
  DISPATCH_TABLE[Opcode.END.code] = END;
  DISPATCH_TABLE[Opcode.RETURN.code] = RETURN;
  return DISPATCH_TABLE;
}
class Frame {
    var parent: Frame;
    var fp: int;
    var sidetable: Sidetable;
    var stp: int;
    var codeptr: CodePtr;
    var num_rets: int;

    new(parent: Frame, fn: CBDFunction) {
        fp = stack.top - fn.args.length;
        sidetable = fn.sidetable;
        stp = 0;
        codeptr = CodePtr.new(fn.code);
        num_rets = fn.rets.length;
    }
}

var module: Module;
var functions: Vector<CBDFunction>;

var current_frame: Frame;
var DISPATCH_TABLE: Array<void -> void> = build_dispatch_table();
var stack: ArrayStack<Value>;
var globals: Vector<Value>;

def copyVals(count: int, dest: int) {
    def sp = stack.top - count;
    if (sp != dest) {
        var e = stack.elems;
        for (i < count) e[dest + i] = e[sp + i];
    }
    stack.top = dest + count;
}


def HAS_MEM_INDEX = 0x40u8;

def imm_readULEB32() -> u32 {
    return current_frame.codeptr.read_uleb32();
}

def imm_readILEB32() -> i32 {
    return i32.!(current_frame.codeptr.read_uleb32());
}

def imm_readULEB64() -> u64 {
    return current_frame.codeptr.read_uleb64();
}

def imm_readILEB64() -> i64 {
    return i64.!(current_frame.codeptr.read_uleb64());
}

def imm_readU8() -> u8 {
    return current_frame.codeptr.read1();
}

def imm_readBlockType() -> (Array<ValueType>, Array<ValueType>) {
    def bt = current_frame.codeptr.read_BlockTypeCode();
    return bt.toAbstractBlockType(module);
}

def pop_i32() -> i32 {
    return Values.unbox_i(stack.pop());
}
def pop_u32() -> u32 {
    return Values.unbox_u(stack.pop());
}
def pop_i64() -> i64 {
    return Values.unbox_l(stack.pop());
}
def pop_u64() -> u64 {
    return Values.unbox_w(stack.pop());
}
def pop_f32() -> float {
    return Values.unbox_f(stack.pop());
}
def pop_f64() -> double {
    return Values.unbox_d(stack.pop());
}
def pop_v128() -> v128;
def pop_Object() -> Object {
    return Values.unbox<Object>(stack.pop());
}
def pop_Value(tv: ()) -> Value {
    return stack.pop();
}

def push_i32(v: i32) {
    stack.push(Values.box_i(v));
}
def push_u32(v: u32) {
    stack.push(Values.box_u(v));
}
def push_i64(v: i64) {
    stack.push(Values.box_l(v));
}
def push_u64(v: u64) {
    stack.push(Values.box_w(v));
}
def push_f32(v: float) {
    stack.push(Values.box_f(v));
}
def push_f64(v: double) {
    stack.push(Values.box_d(v));
}
def push_v128(v: v128);
def push_Object(v: Object) {
    stack.push(Values.box<Object>(v));
}
def push_Value(tv: (), v: Value) {
    stack.push(v);
}

// Local variables.
def getLocal(tv: (), index: u32) -> Value {
    return stack.elems[current_frame.fp + int.!(index)];
}
def setLocal(tv: (), index: u32, v: Value) {
    stack.elems[current_frame.fp + int.!(index)] = v;
}

// Global variables.
def getGlobal(tv: (), index: u32) -> Value {
    return globals[int.!(index)];
}
def setGlobal(tv: (), index: u32, v: Value) {
    globals[int.!(index)] = v;
}

