}
def m_getFieldKind(struct_index: i32, field_index: i32) -> FieldKind;
def m_getFieldOffset(struct_index: i32, field_index: i32) -> FieldOffset;
def m_isMemory64(memory_index: i32) -> bool;
def m_isTable64(memory_index: i32) -> bool;
def m_getFuncSignature(func_index: i32) -> SigDecl {
    return null; // already in CBDFunction, TODO: refactor
}
def m_getSignature(sig_index: i32) -> SigDecl;

// Instance context.
def i_getTableFunction64(table_index: i32, sig: SigDecl, func_index: i64) -> CBDFunction;
def i_getTableFunction32(table_index: i32, sig: SigDecl, func_index: i32) -> CBDFunction;
def i_getFunction(func_index: i32) -> CBDFunction {
    return functions[int.!(func_index)];
}

// Control flow.
def doCall(sig: SigDecl, target: CBDFunction) {
    def new_frame = Frame.new(current_frame, target);
    current_frame = new_frame;
    current_frame.codeptr.iterate_local_codes(push_locals);
}

def doBranch(label: SidetableBrEntry) {
    // doCtlXfer
    current_frame.codeptr.at(current_frame.codeptr.pos + label.dpc);
    current_frame.stp += label.dstp;
    if (label.popcount > 0) {
        if (label.valcount > 0) copyVals(label.valcount, stack.top - int.!(label.popcount + label.valcount));
        else stack.top -= label.popcount;
    }
}

def doFallthru() {
    current_frame.stp += 4;
}

