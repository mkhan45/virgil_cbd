def TYPE_DEF_FILE: string = "./wizard-engine/src/bytecode/Intrinsics.v3";

def filterVars(vars: Range<string>) -> (SSAD -> bool) {
    return fun (node: SSAD) -> bool {
        match (node) {
            LetApp(n, _, _, _) => {
                for (v in vars) if (Strings.startsWith(n, v)) return false;
                return true;
            }
            _ => return true;
        }
    };
}

def replace_st_vars(st_vars: Range<string>, node: SSAD.LetApp, transformer: SSATransformer) -> SSAD {
    var field_idx = -1;
    for (i < st_vars.length) if (Strings.startsWith(node.n, st_vars[i])) field_idx = i;
    if (field_idx == -1) {
        return node;
    } else {
        return SSAD.LetApp(node.n, "id", [Strings.format1("sidetable_entry.%s", st_vars[field_idx])], node.rest);
    }
}

def transformDef(opcode: string, stmt: VirgilStmt) -> CBDDef {
    def st_field_buf = VirgilStmts.getSidetableFields(stmt);
    def st_field_vars = Array<string>.new(st_field_buf.length);
    for (i < st_field_buf.length) {
        def field = st_field_buf[i].0;
        st_field_vars[i] = field;
    }

    def ir = SSAD_IR.from_virgil(stmt);
    // SSAD_IR.counter = 0;
    var ssa = SSAD_IR.ssa(ir);
    def analysis = SSADCtx.new(ssa);
    def transformer = SSATransformer.new(analysis);
    transformer.onLetApp = TB(replace_st_vars(st_field_vars, _, _)).then(SSAT.transformChildren).f;
    ssa = transformer.transform(ssa);
    if (st_field_buf.length > 0) {
        ssa = SSAD.LetApp("sidetable_entry", Strings.format1("get_st_entry_%s", opcode), [], ssa);
    }
    analysis.effects["sidetable_entry"] = CBDEffect.Ctl;
    def processed = analysis.DCE(analysis.id_propagate(ssa, HashMap<string, string>.new(Strings.hash, Strings.equal)));

    return CBDDef.new(opcode, processed);
}

def main(args: Array<string>) {
    def sexpr_file = args[0];
    def v3file = args[1];

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);

    def defs: Array<CBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);
    def dispatch_table = TierGen.buildDispatch(defs, CBDDef.!<CBDDef>(_));

    def template_filename = args[2];
    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY InterpreterGen.v3\n");
    final_code_builder.puts(Arrays.range(template_code, 0, template_code.length - 2)).ln();
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts("}\n");

    System.puts(final_code_builder.toString());
}
