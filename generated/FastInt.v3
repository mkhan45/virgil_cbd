// GENERATED BY FastIntGen.v3
type X86Val {
    case Reg(r: X86_64Gpr);
    case Vsp(i: int);
    case ImmU32(x: u32);

    def is_reg() -> bool {
        match (this) {
            Reg => return true;
            _ => return false;
        }
    }

    def forceReg() -> X86_64Gpr {
        match (this) {
            Reg(r) => return r;
            _ => return null;
        }
    }

    def forceVsp() -> int {
        match (this) {
            Vsp(i) => return i;
            _ => return 0xdead;
        }
    }
}

class CBDFastIntGen extends X86_64InterpreterGen {
    var DISPATCH_TABLE: Array<void -> void>;
    var op_sp: int;

    var last_cond: X86_64Cond;

    def trapUnreachable();
    def trap();

    new(ic: X86_64InterpreterCode, w: DataWriter) super(ic, w) {
        DISPATCH_TABLE = build_dispatch_table();
        op_sp = 0;
    }

    def reset() {
        op_sp = 0;
        last_cond = null;
    }

    // def genOpcodeHandlers() {
    //     // X86_64InterpreterGen.!(this).genOpcodeHandlers(); // XXX: how to easily call the super method?
    // }

    def gen(range: MemoryRange) {
        // copy pasted from superclass but added genCBDHandlers()

		// Record code start
		ic.header.codeStart = w.atEnd().pos; // XXX: don't make dispatch tables executable

		// Reserve the type tag table.
		genTypeTagTable();
		// Reserve space for the dispatch tables.
		reserveDispatchTables();
		// Begin code generation
		genHostCallStub();
		genInterpreterEntry();
		genOpcodeHandlers();
        genCBDHandlers();
		handlerEndOffset = w.atEnd().pos;
		// Generate out-of-line code
		genOutOfLineLEBs();
		genTraps();
    }

    // this func should be generated
    def genCBDHandlers() {
        bindHandler(Opcode.I32_CONST);
        reset();
        I32_CONST();
        adjustVsp(1); // stack delta
        endHandler();

        bindHandler(Opcode.I32_ADD);
        reset();
        I32_ADD();
        adjustVsp(-1);
        endHandler();

        bindHandler(Opcode.I32_EQZ);
        reset();
        I32_EQZ();
        endHandler();

        bindHandler(Opcode.BR_IF);
        reset();
        BR_IF();
        adjustVsp(-1);
        endHandler();
    }
    
    // puts in reg0 if not already in reg
    def ensureReg(val: X86Val) -> X86_64Gpr {
        match (val) {
            Reg(r) => return r;
            Vsp(i) => {
                asm.movd_r_m(r_tmp0, vsph[i].value);
                return r_tmp0;
            }
            ImmU32(x) => {
                asm.movd_r_i(r_tmp1, int.view(x));
                return r_tmp1;
            }
        }
    }

    def imm_readULEB32() -> X86Val {
        genReadUleb32(r_tmp1);
        return X86Val.Reg(r_tmp1);
    }

    def imm_readILEB32() -> X86Val {
        genReadSleb32_inline(r_tmp1);
        return X86Val.Reg(r_tmp1);
    }

    def push_u32(val: X86Val) {
        genTagPush(BpTypeCode.I32.code);
        def reg = ensureReg(val);

        asm.movq_m_r(vsph[op_sp].value, reg);
        op_sp += 1;
    }

    def pop_u32() -> X86Val {
        op_sp -= 1;
        return X86Val.Vsp(op_sp);
    }

    def U32_plus(a: X86Val, b: X86Val) -> X86Val {
        if (a.is_reg() && b.is_reg()) {
            asm.d.add_r_r(a.forceReg(), b.forceReg());
            return a;
        } else if (!a.is_reg() && !b.is_reg()) {
            def a_reg = ensureReg(a);
            asm.d.add_r_m(a_reg, vsph[b.forceVsp()].value);
            return X86Val.Reg(a_reg);
        } else {
            def stack_val = vsph[if(a.is_reg(), b, a).forceVsp()];
            def reg_val = if(a.is_reg(), a, b).forceReg();
            asm.d.add_r_m(reg_val, stack_val.value);
            return X86Val.Reg(reg_val);
        }
    }

    def rtcast_u32(x: u32) -> X86Val => X86Val.ImmU32(x);

    def U32_equals(a: X86Val, b: X86Val) -> X86_64Cond {
        if (b == X86Val.ImmU32(0u)) {
            asm.d.test_m_i(vsph[-1].value, -1);
            return X86_64Conds.Z;
        } else {
            trap();
            return X86_64Conds.Z;
        }
    }

    def U32_not_equals(a: X86Val, b: X86Val) -> X86_64Cond {
        if (b == X86Val.ImmU32(0u)) {
            asm.d.test_m_i(vsph[-1].value, -1);
            return X86_64Conds.NZ;
        } else {
            trap();
            return X86_64Conds.NZ;
        }
    }

    def choose_u(cond: X86_64Cond, left: X86Val, right: X86Val) -> X86Val {
        def cond_reg = r_tmp3;
        asm.set_r(cond, cond_reg);
        asm.movbzx_r_r(cond_reg, cond_reg);

        // ugly
        if (left == X86Val.ImmU32(1u) && right == X86Val.ImmU32(0u)) {
            return X86Val.Reg(cond_reg);
        } else {
            trap();
        }

        return X86Val.ImmU32(0xdead);
    }

    def f_getLabel(depth: X86Val) -> () {
    }

    def doFallthru() {
        if (last_cond != null) {
            asm.jc_rel_far(last_cond, controlFallThruLabel);
            last_cond = null;
        } else {
            asm.jmp_rel_far(controlFallThruLabel);
        }
    }
    
    def doBranch(label: ()) {
        if (last_cond != null) {
            asm.jc_rel_far(last_cond, controlTransferLabel);
            last_cond = null;
        } else {
            asm.jmp_rel_far(controlTransferLabel);
        }
    }

    def startCond(cond: X86_64Cond) {
        last_cond = cond;
    }

    def startElse() {
        last_cond = null;
    }

    def endCond() {
        last_cond = null;
    }

def I32_CONST() {
	def x = imm_readILEB32();
	push_u32(x);
}
def I32_ADD() {
	def b = pop_u32();
	def a = pop_u32();
	push_u32(U32_plus(a, b));
}
def I32_EQZ() {
	def a = pop_u32();
	startCond(U32_equals(a, rtcast_u32(0)));
	startElse();
	def phi = choose_u(U32_equals(a, rtcast_u32(0)), rtcast_u32(1), rtcast_u32(0));
	push_u32(phi);
	endCond();
}
def BR_IF() {
	def depth = imm_readULEB32();
	def label = f_getLabel(depth);
	def cond = pop_u32();
	def cond1 = U32_not_equals(cond, rtcast_u32(0));
	startCond(cond1);
	doBranch(label);
	startElse();
	doFallthru();
	endCond();
}
def build_dispatch_table() -> Array<void -> void> {
  DISPATCH_TABLE = Array.new(0xE5 + 1);
  for (i < 0xE5 + 1) DISPATCH_TABLE[i] = trapUnreachable;
  DISPATCH_TABLE[Opcode.I32_CONST.tag] = I32_CONST;
  DISPATCH_TABLE[Opcode.I32_ADD.tag] = I32_ADD;
  DISPATCH_TABLE[Opcode.I32_EQZ.tag] = I32_EQZ;
  DISPATCH_TABLE[Opcode.BR_IF.tag] = BR_IF;
  return DISPATCH_TABLE;
}
}
