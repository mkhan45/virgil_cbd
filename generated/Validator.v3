	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
	}
	def cond = m_isMemory64(0u);
	def offset = imm_readULEB64();
	def index = pop_u64();
	def val = mach_readMemory64_u8(0u, index, offset);
	push_u32(val);
}
def I32_LOAD16_S() {
	def flags = imm_readU8();
	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
	}
	def cond = m_isMemory64(0u);
	def offset = imm_readULEB64();
	def index = pop_u64();
	def val = mach_readMemory64_u16(0u, index, offset);
	push_u32(val);
}
def I64_LOAD() {
	def flags = imm_readU8();
	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
	}
	def cond = m_isMemory64(0u);
	def offset = imm_readULEB64();
	def index = pop_u64();
	def val = mach_readMemory64_u64(0u, index, offset);
	push_u64(val);
}
def F32_LOAD() {
	def flags = imm_readU8();
	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
