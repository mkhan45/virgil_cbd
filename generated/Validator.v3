	def cond = m_isMemory64(0u);
	def offset = imm_readULEB64();
	def index = pop_u64();
	def val = mach_readMemory64_f32(0u, index, offset);
	push_f32(val);
}
def F64_LOAD() {
	def flags = imm_readU8();
	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
	}
	def cond = m_isMemory64(0u);
	def offset = imm_readULEB64();
	def index = pop_u64();
	def val = mach_readMemory64_f64(0u, index, offset);
	push_f64(val);
}
def I32_STORE() {
	def val = pop_u32();
	def flags = imm_readU8();
	var memindex: u8;
	if (to_true(U32_equals(U32_and(flags, 0x40u8), 0))) {
		memindex = imm_readULEB32();
	}
	def cond = m_isMemory64(0u);
	def index = pop_u64();
	def offset = imm_readULEB64();
	mach_writeMemory32_u32(0u, index, offset, val);
}
def I32_STORE8() {
