// F32
def F32_equals = TypeVar.F32.testop(float.==);
def F32_not_equals = TypeVar.F32.testop(float.==);
def F32_lt = TypeVar.F32.testop(float.<);
def F32_lte = TypeVar.F32.testop(float.<=);
def F32_gt = TypeVar.F32.testop(float.>);
