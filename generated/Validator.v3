	def is64 = m_isTable64(table_index);
	if (is64) {
		def func_index = pop_u64();
		def target = i_getTableFunction64(table_index, sig, func_index);
		doCall(sig, target);
	} else {
		def func_index = pop_u32();
		def target = i_getTableFunction32(table_index, sig, func_index);
		doCall(sig, target);
	}
	if (is64) {
