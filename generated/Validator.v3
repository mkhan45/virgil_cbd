		memindex = imm_readULEB32();
	} else {
		memindex = 0u;
	}
	def cond = m_isMemory64(memindex);
	if (cond) {
		def offset = imm_readULEB64();
		def index = pop_u64();
		mach_writeMemory64_u8(memindex, index, offset, val);
	} else {
		def offset = imm_readULEB32();
		def index = pop_u32();
		mach_writeMemory32_u8(memindex, index, offset, val);
	}
}
