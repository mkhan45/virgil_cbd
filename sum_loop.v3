def bb_start(n: int, acc: int) -> int {
    return bb_loop(n, acc);
}

def bb_loop(n: int, acc: int) -> int {
    def z = 0;
    def cond = n == z;
    var stack_phi: int;
    if (cond) {
        stack_phi = 1;
    } else {
        stack_phi = 0;
    }
    if (stack_phi != z) {
        return bb_block_end(n, acc);
    }
    def s = n + acc;
    acc = s;
    def o = 1;
    def nxt = n - o;
    n = nxt;
    return bb_loop(n, acc);
}

def bb_block_end(n: int, acc: int) -> int {
    return acc;
}

def main() {
    def res = bb_start(100000, 0);
    System.puti(res);
}
