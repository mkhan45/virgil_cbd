def transformDef(opcode: string, stmt: VirgilStmt) -> CBDDef {
    var ir = SSAD_IR.from_virgil(stmt);

    var sea_info = Seas.ofSSADWithInfo(ir);
    var sea = sea_info.0;
    var ssad_sea_info = sea_info.1;
    sea.apply(void, SeaTransforms.id_propagate);

    // sea.scheduleExp();

    def raw_mermaid = sea.toMermaid();
    CBDTrace.addGraph(opcode, "raw", sea);

    // sea.apply(void, SeaTransforms.removeViews);
    sea.apply(void, SeaTransforms.overloadOps);
    CBDTrace.addGraph(opcode, "overloadOps", sea);
    sea.apply(void, SeaTransforms.addAbstractions);
    CBDTrace.addGraph(opcode, "addAbstractions", sea);

    def scheduler = Scheduler.of_full_sea_info(sea, ssad_sea_info);
    scheduler.opcode = opcode;
    scheduler.schedule();
    def scheduler_mermaid = scheduler.toMermaid();
    CBDTrace.addString(opcode, "schedulerMermaid", "graph", scheduler_mermaid);

    scheduler.reify_conds = true;
    def scheduler_ssad_info = scheduler.bottom_block.toSSADSeaInfo();
    def scheduler_ssad = scheduler_ssad_info.0;
    def scheduler_sea_info = scheduler_ssad_info.1;
    CBDTrace.addCode(opcode, "scheduler_ssad", scheduler_ssad.toString(0));
    CBDTrace.addCode(opcode, "scheduler_ssad_pretty", scheduler_ssad.toStringPrettyWithSeaInfo(0, scheduler_sea_info));

    return CBDDef.new(opcode, scheduler_ssad, scheduler_sea_info);
}

def main(args: Array<string>) {
    def sexpr_file = "./wizard-engine/src/bytecode/CanonicalDefs.v3.sexp";
    def v3file = "./wizard-engine/src/bytecode/CanonicalDefs.v3";
    def template_filename = "./tiers/validator/ValidatorTemplate.v3";

    CBDTrace.init("docs/traces.js");
    CBDInfo.init_with_file(CBDTrace.writer.out_file);

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);
    // def v_intrinsics = IntrinsicTypes.getIntrinsicTypes("./tiers/validator/Intrinsics.v3");
    // v_intrinsics.apply(IntrinsicTypes.add_def);

    IntrinsicTypes.intrinsic_types["doFallthru"].reads |= StateComponent.Codeptr;

    def defs: Array<CBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);
    def dispatch_table = TierGen.buildDispatch(defs, fun (x: CBDDef) => x);

    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY IntrinsicCompilerGen.v3\n");
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts(template_code);

    System.puts(final_code_builder.toString());
}
