  DISPATCH_TABLE[Opcode.I32_EQZ.code] = I32_EQZ;
  DISPATCH_TABLE[Opcode.I32_EQ.code] = I32_EQ;
  DISPATCH_TABLE[Opcode.I32_NE.code] = I32_NE;
  DISPATCH_TABLE[Opcode.I32_LT_U.code] = I32_LT_U;
  DISPATCH_TABLE[Opcode.I32_LE_S.code] = I32_LE_S;
  DISPATCH_TABLE[Opcode.I32_GT_U.code] = I32_GT_U;
  DISPATCH_TABLE[Opcode.BR.code] = BR;
  DISPATCH_TABLE[Opcode.BR_IF.code] = BR_IF;
  DISPATCH_TABLE[Opcode.BLOCK.code] = BLOCK;
  DISPATCH_TABLE[Opcode.LOOP.code] = LOOP;
  DISPATCH_TABLE[Opcode.TRY.code] = TRY;
  DISPATCH_TABLE[Opcode.IF.code] = IF;
  DISPATCH_TABLE[Opcode.ELSE.code] = ELSE;
  DISPATCH_TABLE[Opcode.END.code] = END;
  DISPATCH_TABLE[Opcode.RETURN.code] = RETURN;
  return DISPATCH_TABLE;
}
class STBuilder {
    var is64: int;
    var label: int;
}
type STEntry {
    case Is64(
        is64: int
    );
    case Label(
        label: int
    );
}
var module: Module;
var codeptr: CodePtr;
var DISPATCH_TABLE: Array<void -> void> = build_dispatch_table();
var local_types: Vector<TypeVar>;
var stack: ArrayStack<TypeVar>;
var globals: Vector<TypeVar>;
var rets: Array<TypeVar>;

// this is mainly to lift sidetable vars out of conditionals,
// probably a lot of ways to dodge that
var st_builder: STBuilder;
var st_entries: Vector<STEntry>;
var st_controls: Vector<int>; // ctl idx of target

def assert(b: bool) {
    if (!b) {
        System.puts("assert fail :(\n");
        return [][1];
    }
}

type CtlEntry {
    case Block(end_pc: int, cont_stp: int);
    case Loop(start_pc: int, end_pc: int, cont_stp: int);
    case None;
}
var ctls: Array<CtlEntry>;
var ctl_stack: ArrayStack<int>;

// Constants
def HAS_MEM_INDEX = 0x40u8;

// Types.
type v128(low: u64, high: u64);
type Label(depth: u32);
// class Object { }
type TypeVar {
    case I32 {
        def plus(lhs: TypeVar.I32, rhs: TypeVar.I32) -> TypeVar.I32 { return TypeVar.I32; }
        def minus(lhs: TypeVar.I32, rhs: TypeVar.I32) -> TypeVar.I32 { return TypeVar.I32; }
        def equals(lhs: TypeVar.I32, rhs: TypeVar.I32) -> TypeVar.I32 { return TypeVar.I32; }
        def times(lhs: TypeVar.I32, rhs: TypeVar.I32) -> TypeVar.I32 { return TypeVar.I32; }
        def div(lhs: TypeVar.I32, rhs: TypeVar.I32) -> TypeVar.I32 { return TypeVar.I32; }
    }
    case U32 {
        def plus(lhs: TypeVar.U32, rhs: TypeVar.U32) -> TypeVar.U32 { return TypeVar.U32; }
        def minus(lhs: TypeVar.U32, rhs: TypeVar.U32) -> TypeVar.U32 { return TypeVar.U32; }
        def equals(lhs: TypeVar.U32, rhs: TypeVar.U32) -> TypeVar.U32 { return TypeVar.U32; }
        def times(lhs: TypeVar.U32, rhs: TypeVar.U32) -> TypeVar.U32 { return TypeVar.U32; }
        def div(lhs: TypeVar.U32, rhs: TypeVar.U32) -> TypeVar.U32 { return TypeVar.U32; }
    }
    case I64;
    case U64;
    case F32;
    case F64;
    case V128;
    case Object;
    case Err;
    case Bot;

    def unbox_i32() -> TypeVar.I32 {
        if (TypeVar.I32.?(this) || TypeVar.U32.?(this)) return TypeVar.I32;
        return invalid_t(TypeVar.I32);
    }

    def unbox_u32() -> TypeVar.U32 {
        if (TypeVar.U32.?(this) || TypeVar.I32.?(this)) return TypeVar.U32;
        return invalid_t(TypeVar.U32);
    }
    
    def unbox_i64() -> TypeVar.I64 {
        if (TypeVar.I64.?(this)) return TypeVar.I64;
        return invalid_t(TypeVar.I64);
    }
    
    def unbox_u64() -> TypeVar.U64 {
        if (TypeVar.U64.?(this)) return TypeVar.U64;
        return invalid_t(TypeVar.U64);
    }
    
    def unbox_f32() -> TypeVar.F32 {
        if (TypeVar.F32.?(this)) return TypeVar.F32;
        return invalid_t(TypeVar.F32);
    }
    
    def unbox_f64() -> TypeVar.F64 {
        if (TypeVar.F64.?(this)) return TypeVar.F64;
        return invalid_t(TypeVar.F64);
    }
    
    def unbox_v128() -> TypeVar.V128 {
        if (TypeVar.V128.?(this)) return TypeVar.V128;
        return invalid_t(TypeVar.V128);
    }
    
    def unbox_Object() -> TypeVar.Object {
        if (TypeVar.Object.?(this)) return TypeVar.Object;
        return invalid_t(TypeVar.Object);
    }
    
    def matches(other: TypeVar) -> bool {
        if (this == other) return true;
        // I32/U32 compatibility
        // maybe i32 and u32 should be the same typevar?
        return (TypeVar.I32.?(this) && TypeVar.U32.?(other)) || (TypeVar.U32.?(this) && TypeVar.I32.?(other));
    }
}

def invalid_t<T>(t: T) -> T {
    invalid();
    return t;
}

def rtcast_i32(x: i32) -> TypeVar.I32 {
    return TypeVar.I32;
}
def rtcast_u32(x: u32) -> TypeVar.U32 {
    return TypeVar.U32;
}

type FieldOffset;
enum FieldKind {
    U8, U16, I32, I64, F32, F64, V128, REF
}

def imm_readULEB32() -> u32 {
    return codeptr.read_uleb32();
}

def imm_readILEB32() -> i32 {
    return i32.!(codeptr.read_uleb32());
}

def imm_readULEB64() -> u64 {
    return codeptr.read_uleb64();
}

def imm_readILEB64() -> i64 {
    return i64.!(codeptr.read_uleb64());
}

def imm_readU8() -> u8 {
    return codeptr.read1();
}

def imm_readBlockType() -> () {
    def bt = codeptr.read_BlockTypeCode();
    return ();
}

def pop_i32() -> TypeVar.I32 {
    return stack.pop().unbox_i32();
}
def pop_u32() -> TypeVar.U32 {
    return stack.pop().unbox_u32();
}
def pop_i64() -> TypeVar.I64 {
    return stack.pop().unbox_i64();
}
def pop_u64() -> TypeVar.U64 {
    return stack.pop().unbox_u64();
}
def pop_f32() -> TypeVar.F32 {
    return stack.pop().unbox_f32();
}
def pop_f64() -> TypeVar.F64 {
    return stack.pop().unbox_f64();
}
def pop_v128() -> TypeVar.V128 {
    return stack.pop().unbox_v128();
}
def pop_Object() -> TypeVar.Object {
    return stack.pop().unbox_Object();
}
def pop_Value(tv: TypeVar) -> TypeVar {
    def actual = stack.pop();
    if (tv.matches(actual)) return tv;
    return invalid_t(tv);
}

def push_i32(v: TypeVar.I32) {
    stack.push(v);
}
def push_u32(v: TypeVar.U32) {
    stack.push(TypeVar.U32);
}
def push_i64(v: i64) {
    stack.push(TypeVar.I64);
}
def push_u64(v: u64) {
    stack.push(TypeVar.U64);
}
def push_f32(v: float) {
    stack.push(TypeVar.F32);
}
def push_f64(v: double) {
    stack.push(TypeVar.F64);
}
def push_v128(v: v128) {
    stack.push(TypeVar.V128);
}
def push_Object(v: TypeVar.Object) {
    stack.push(v);
}
def push_Value(tv: TypeVar, v: TypeVar) {
    if (!tv.matches(v)) invalid();
    stack.push(tv);
}

// Local variables.
def getLocal(tv: TypeVar, index: u32) -> TypeVar {
    return stack.elems[index];
}
def setLocal(tv: TypeVar, index: u32, v: TypeVar) {
    if (!tv.matches(v)) invalid();
    stack.elems[index] = tv;
}

// Global variables.
def getGlobal(tv: TypeVar, index: u32) -> TypeVar {
    return globals[int.!(index)];
}
def setGlobal(tv: TypeVar, index: u32, v: TypeVar) {
    globals[int.!(index)] = v;
}

// Function context.
def f_getLabel(depth: u32) -> int {
    return int.!(depth);
}

def f_getLocalType(index: u32) -> TypeVar {
    return local_types[int.!(index)];
}

def f_getTopOfStackType() -> TypeVar {
    return stack.peek();
}

// Module context.
def m_getGlobalType(index: u32) -> TypeVar {
    return globals[int.!(index)];
}
def m_getFieldKind(struct_index: u32, field_index: u32) -> FieldKind;
def m_getFieldOffset(struct_index: u32, field_index: u32) -> FieldOffset;
def m_isMemory64(memory_index: u32) -> bool;
def m_isTable64(memory_index: u32) -> bool;
def m_getFuncSignature(func_index: u32) -> SigDecl {
    return null;
}
def m_getSignature(sig_index: u32) -> SigDecl;

// Instance context.
def i_getTableFunction64(table_index: u32, sig: SigDecl, func_index: TypeVar.U64) -> CBDFunction;
def i_getTableFunction32(table_index: u32, sig: SigDecl, func_index: TypeVar.U32) -> CBDFunction;
def i_getFunction(func_index: u32) -> CBDFunction {
    return null;
}

// Control flow.
def doCall(sig: SigDecl, target: CBDFunction) {
    return; // TODO
}

def doBranch(label: int) {
    def ctl_idx = ctl_stack.elems[ctl_stack.top - 1 - label];
    st_controls.put(ctl_idx);
}

def doFallThru() {
}

// Machine intrinsics.
def mach_readStructField_i8(obj: Object, offset: FieldOffset) -> i8;
def mach_readStructField_u8(obj: Object, offset: FieldOffset) -> u8;
def mach_readStructField_i16(obj: Object, offset: FieldOffset) -> i16;
def mach_readStructField_u16(obj: Object, offset: FieldOffset) -> u16;
def mach_readStructField_u32(obj: Object, offset: FieldOffset) -> u32;
def mach_readStructField_u64(obj: Object, offset: FieldOffset) -> u64;
def mach_readStructField_f32(obj: Object, offset: FieldOffset) -> float;
def mach_readStructField_f64(obj: Object, offset: FieldOffset) -> double;
def mach_readStructField_v128(obj: Object, offset: FieldOffset) -> v128;
def mach_readStructField_Object(obj: Object, offset: FieldOffset) -> TypeVar.Object;

def mach_readMemory64_u32(memory_index: u32, index: u64, offset: u64) -> u32;
def mach_readMemory32_u32(memory_index: u32, index: u32, offset: u32) -> u32;

def mach_readTable64(table_index: u32, index: TypeVar.U64) -> TypeVar.Object;
def mach_readTable32(table_index: u32, index: TypeVar.U32) -> TypeVar.Object;

def mach_writeTable64(table_index: u32, index: TypeVar.U64, val: TypeVar.Object);
def mach_writeTable32(table_index: u32, index: TypeVar.U32, val: TypeVar.Object);

// Traps.
def invalid();
def trapNull();
def trapUnreachable();

def doBlock(bt: ()) {
    if (ctls[codeptr.pos] == CtlEntry.None) ctls[codeptr.pos] = CtlEntry.Block(-1, -1);
    ctl_stack.push(codeptr.pos);
}

def doLoop(bt: ()) {
    if (ctls[codeptr.pos] == CtlEntry.None) ctls[codeptr.pos] = CtlEntry.Loop(codeptr.pos, -1, st_entries.length);
    ctl_stack.push(codeptr.pos);
}

def doEnd() {
    def ctl_idx = ctl_stack.pop();
    match (ctls[ctl_idx]) {
        Block(end_pc, cont_stp) =>
        if (end_pc == -1) ctls[ctl_idx] = CtlEntry.Block(codeptr.pos, st_entries.length - 1);
        Loop(start_pc, end_pc, cont_stp) => 
        if (end_pc == -1) ctls[ctl_idx] = CtlEntry.Loop(start_pc, codeptr.pos, cont_stp);
        None => doReturn();
    }
}

def doReturn() {
    for (i = rets.length - 1; i >= 0; i -= 1) pop_Value(rets[i]);
}

def doTry(bt: ()) {
    return;
}

def f_isAtEnd() -> bool {
    return codeptr.pos >= codeptr.data.length;
}

def push_locals(count: u32, vtc: ValueTypeCode) {
    var tv: TypeVar;
    match (vtc.code) {
        BpTypeCode.I32.val => tv = TypeVar.I32;
        BpTypeCode.I64.val => tv = TypeVar.I64;
        BpTypeCode.F32.val => tv = TypeVar.F32;
        BpTypeCode.F64.val => tv = TypeVar.F64;
        BpTypeCode.V128.val => tv = TypeVar.V128;
        BpTypeCode.FUNCREF.val => tv = TypeVar.Object;
        BpTypeCode.EXTERNREF.val => tv = TypeVar.Object;
        BpTypeCode.ANYREF.val => tv = TypeVar.Object;
        BpTypeCode.EQREF.val => tv = TypeVar.Object;
        BpTypeCode.I31REF.val => tv = TypeVar.Object;
        BpTypeCode.STRUCTREF.val => tv = TypeVar.Object;
        BpTypeCode.ARRAYREF.val => tv = TypeVar.Object;
        _ => tv = TypeVar.Object; // default to Object for unknown ref types
    }
    
    for (i < count) local_types.put(tv);
}

component Validator {
    def init(new_module: Module, args: Array<int>) {
        module = new_module;
        
        globals = Vector.new();
        for (i < module.globals.length) {
            def module_global = module.globals[i];
            var global_type: TypeVar;
            match (module_global.valtype) {
                I32 => global_type = TypeVar.I32;
                I64 => global_type = TypeVar.I64;
                F32 => global_type = TypeVar.F32;
                F64 => global_type = TypeVar.F64;
                V128 => global_type = TypeVar.V128;
                _ => global_type = TypeVar.I32; // TODO: handle ref types
            }
            globals.put(global_type);
        }
    }
    
    def init_function(code: Array<byte>, args: Array<TypeVar>, ret: Array<TypeVar>) {
        codeptr = CodePtr.new(code);
        local_types = Vector.new();
        stack = ArrayStack.new();

        ctls = Array.new(code.length);
        for (i < code.length) ctls[i] = CtlEntry.None;
        ctl_stack = ArrayStack.new();

        for (a in args) local_types.put(TypeVar.I32);
        for (a in args) stack.push(a);

        st_builder = STBuilder.new();
        st_entries = Vector.new();
        st_controls = Vector.new();
        rets = ret;
    }

    def dispatch() {
        codeptr.iterate_local_codes(push_locals);
        while (codeptr.pos < codeptr.data.length) {
            def op = codeptr.read_opcode();
            System.puts(op.mnemonic);
            System.ln();
            DISPATCH_TABLE[op.code]();
        }
    }

    // for other sidetable entries, do we need a post processing phase?
    def build_sidetable() -> (Vector<STEntry>, Vector<(int, int)>) {
        def reified_st_controls = Vector<(int, int)>.new();
        for (i < st_controls.length) {
            def target_ctl = ctls[st_controls[i]];
            var target_stp = -1;
            var target_pc = -1;
            match (target_ctl) {
                Block(epc, cstp) => {
                    target_pc = epc;
                    target_stp = cstp;
                }
                Loop(spc, epc, cstp) => {
                    target_pc = spc;
                    target_stp = cstp;
                }
                None => invalid();
            }
            reified_st_controls.put(target_pc, target_stp);
        }
        return (st_entries, reified_st_controls);
    }
}
