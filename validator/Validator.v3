def I32_LOAD() {
	// memindex721 -- static: yes, type: i32, effect: none
// cond714727 -- static: no, type: <bottom>, effect: none
// val735 -- static: no, type: i32, effect: none
// eff703737 -- static: no, type: <bottom>, effect: push
// arg704736 -- static: no, type: i32, effect: none
// arg710742 -- static: yes, type: i32, effect: none
// index731 -- static: no, type: i64, effect: pop
// val743 -- static: no, type: i32, effect: none
// arg711741 -- static: no, type: i32, effect: none
// arg717724 -- static: no, type: <bottom>, effect: none
// arg705734 -- static: yes, type: i32, effect: none
// offset730 -- static: yes, type: i64, effect: read
// arg712740 -- static: yes, type: i32, effect: none
// arg718723 -- static: yes, type: <bottom>, effect: none
// arg706733 -- static: no, type: i64, effect: none
// flags720 -- static: yes, type: <bottom>, effect: read
// arg719722 -- static: no, type: <bottom>, effect: none
// arg707732 -- static: yes, type: i64, effect: none
// eff708745 -- static: no, type: <bottom>, effect: push
// arg709744 -- static: no, type: i32, effect: none
// index739 -- static: no, type: i32, effect: pop
// arg713728 -- static: yes, type: i32, effect: none
// cond702729 -- static: yes, type: <bottom>, effect: none
// left715725 -- static: no, type: <bottom>, effect: none
// right716726 -- static: yes, type: i32, effect: none
// offset738 -- static: yes, type: i32, effect: read

	def flags = imm_readU8();
	def offset = imm_readILEB64();
	def index = pop_i64();
	def val = mach_readMemory64_i32(0, index, offset);
	push_i32(val);
	def offset1 = imm_readILEB32();
	def index1 = pop_i32();
	def val1 = mach_readMemory32_i32(0, index1, offset1);
	push_i32(val1);
}
def build_dispatch_table() -> Array<void -> void> {
  DISPATCH_TABLE = Array.new(0xE5 + 1);
  DISPATCH_TABLE[Opcode.UNREACHABLE.code] = UNREACHABLE;
  DISPATCH_TABLE[Opcode.NOP.code] = NOP;
  DISPATCH_TABLE[Opcode.LOCAL_GET.code] = LOCAL_GET;
  DISPATCH_TABLE[Opcode.LOCAL_SET.code] = LOCAL_SET;
  DISPATCH_TABLE[Opcode.LOCAL_TEE.code] = LOCAL_TEE;
  DISPATCH_TABLE[Opcode.GLOBAL_GET.code] = GLOBAL_GET;
  DISPATCH_TABLE[Opcode.GLOBAL_SET.code] = GLOBAL_SET;
  DISPATCH_TABLE[Opcode.TABLE_GET.code] = TABLE_GET;
  DISPATCH_TABLE[Opcode.TABLE_SET.code] = TABLE_SET;
  DISPATCH_TABLE[Opcode.CALL.code] = CALL;
  DISPATCH_TABLE[Opcode.CALL_INDIRECT.code] = CALL_INDIRECT;
  DISPATCH_TABLE[Opcode.DROP.code] = DROP;
  DISPATCH_TABLE[Opcode.SELECT.code] = SELECT;
  DISPATCH_TABLE[Opcode.I32_CONST.code] = I32_CONST;
  DISPATCH_TABLE[Opcode.I32_ADD.code] = I32_ADD;
  DISPATCH_TABLE[Opcode.I32_SUB.code] = I32_SUB;
  DISPATCH_TABLE[Opcode.I32_MUL.code] = I32_MUL;
  DISPATCH_TABLE[Opcode.I32_DIV_S.code] = I32_DIV_S;
  DISPATCH_TABLE[Opcode.I32_DIV_U.code] = I32_DIV_U;
  DISPATCH_TABLE[Opcode.I32_EQZ.code] = I32_EQZ;
  DISPATCH_TABLE[Opcode.I32_EQ.code] = I32_EQ;
  DISPATCH_TABLE[Opcode.I32_NE.code] = I32_NE;
  DISPATCH_TABLE[Opcode.I32_LT_U.code] = I32_LT_U;
  DISPATCH_TABLE[Opcode.I32_LE_S.code] = I32_LE_S;
  DISPATCH_TABLE[Opcode.I32_GT_U.code] = I32_GT_U;
  DISPATCH_TABLE[Opcode.I32_AND.code] = I32_AND;
  DISPATCH_TABLE[Opcode.F32_CONST.code] = F32_CONST;
  DISPATCH_TABLE[Opcode.F32_ADD.code] = F32_ADD;
  DISPATCH_TABLE[Opcode.F32_SUB.code] = F32_SUB;
  DISPATCH_TABLE[Opcode.F32_MUL.code] = F32_MUL;
  DISPATCH_TABLE[Opcode.F32_DIV.code] = F32_DIV;
  DISPATCH_TABLE[Opcode.F32_EQ.code] = F32_EQ;
  DISPATCH_TABLE[Opcode.F32_NE.code] = F32_NE;
  DISPATCH_TABLE[Opcode.F32_LT.code] = F32_LT;
  DISPATCH_TABLE[Opcode.F32_LE.code] = F32_LE;
  DISPATCH_TABLE[Opcode.F32_GT.code] = F32_GT;
  DISPATCH_TABLE[Opcode.BR.code] = BR;
  DISPATCH_TABLE[Opcode.BR_IF.code] = BR_IF;
  DISPATCH_TABLE[Opcode.BLOCK.code] = BLOCK;
  DISPATCH_TABLE[Opcode.LOOP.code] = LOOP;
  DISPATCH_TABLE[Opcode.TRY.code] = TRY;
  DISPATCH_TABLE[Opcode.IF.code] = IF;
  DISPATCH_TABLE[Opcode.ELSE.code] = ELSE;
  DISPATCH_TABLE[Opcode.END.code] = END;
  DISPATCH_TABLE[Opcode.RETURN.code] = RETURN;
  DISPATCH_TABLE[Opcode.STRUCT_GET.code] = STRUCT_GET;
  DISPATCH_TABLE[Opcode.STRUCT_GET_S.code] = STRUCT_GET_S;
  DISPATCH_TABLE[Opcode.STRUCT_GET_U.code] = STRUCT_GET_U;
  DISPATCH_TABLE[Opcode.I32_LOAD.code] = I32_LOAD;
  return DISPATCH_TABLE;
}
type STEntry {
    case Is64(
        is64: int
    );
    case Label(
        label: int
    );
    case KindOffset(
        kind: int,
        offset: int
    );
}
var module: Module;
var codeptr: CodePtr;
var opcode: Opcode;
var opcode_pos: int; // not used much, because interpreter uses codeptr.pos
var DISPATCH_TABLE: Array<void -> void> = build_dispatch_table();
var local_types: Vector<TypeVar>;
var stack: ArrayStack<TypeVar>;
var globals: Vector<TypeVar>;
var rets: Array<TypeVar>;

// steal sidetable stuff from existing validator,
// to support custom sidetable stuff I think we can keep ControlEntry but replace SidetableBuilder
var ctl_stack: ArrayStack<ControlEntry>;
var ctlxfer: SidetableBuilder;
var ctl_top: ControlEntry;

// stolen from CodeValidator.v3
def pushControl(opcode: u16, params: Array<ValueType>, results: Array<ValueType>, val_stack_top: int) -> ControlEntry {
    var ctl = ctl_stack.next();
    if (ctl != null) { // FAST: reuse previous ControlEntry object
        ctl_stack.top++;
    } else { // allocate and cache new ControlEntry object
        ctl = ControlEntry.new();
        ctl_stack.push(ctl);
    }
    ctl_top = ctl;
    ctl.start_pos = codeptr.pos;
    ctl.delegate_pos = codeptr.pos;
    ctl.start_opcode = opcode;
    ctl.sidetable_pos = -1;
    ctl.params = params;
    ctl.results = results;
    ctl.val_stack_top = val_stack_top;
    ctl.reachable = true;
    ctl.first_ref = -1;
    ctl.else_ref = -1;
    ctl.undo_init_list = null;
    return ctl;
}

def popTypes(ts: Array<ValueType>) {
    for (i = ts.length - 1; i >= 0; i -= 1) pop_Value(typeVarFromValType(ts[i]));
}

def pushTypes(ts: Array<ValueType>) {
    for (i < ts.length) push_Value(typeVarFromValType(ts[i]), typeVarFromValType(ts[i]));
}

// Constants
def HAS_MEM_INDEX = 0x40u8;

// Types.
type v128(low: u64, high: u64);

// goofy way to avoid having to impl every operator
// but still specialize type and show the called operator in the generated code
def gen_binop<C, R>(op: (C, C) -> C) -> (R, R) -> R { 
    return fun (lhs: R, rhs: R) => lhs; 
}
def gen_testop<C, R>(op: (C, C) -> bool) -> (R, R) -> R { 
    return fun (lhs: R, rhs: R) => lhs; 
}
type TypeVar {
    case I32 {
        def binop(op: (i32, i32) -> i32) => gen_binop<i32, TypeVar.I32>(op);
        def testop(op: (i32, i32) -> bool) => gen_testop<i32, TypeVar.I32>(op);
    }
    case I64 {
        def binop(op: (i64, i64) -> i64) => gen_binop<i64, TypeVar.I64>(op);
        def testop(op: (i64, i64) -> bool) => gen_testop<i64, TypeVar.I64>(op);
    }
    case F32 {
        def binop(op: (float, float) -> float) => gen_binop<float, TypeVar.F32>(op);
        def testop(op: (float, float) -> bool) => gen_testop<float, TypeVar.F32>(op);
    }
    case F64 {
        def binop(op: (double, double) -> double) => gen_binop<double, TypeVar.F64>(op);
        def testop(op: (double, double) -> bool) => gen_testop<double, TypeVar.F64>(op);
    }
    case V128 {
        def binop(op: (v128, v128) -> v128) => gen_binop<v128, TypeVar.V128>(op);
        def testop(op: (v128, v128) -> bool) => gen_testop<v128, TypeVar.V128>(op);
    }
    case Object {
        def binop(op: (Object, Object) -> Object) => gen_binop<Object, TypeVar.Object>(op);
        def testop(op: (Object, Object) -> bool) => gen_testop<Object, TypeVar.Object>(op);
    }
    case Err;
    case Bot;

    def unbox_i32() -> TypeVar.I32 {
        if (TypeVar.I32.?(this)) return TypeVar.I32;
        return invalid_t(TypeVar.I32);
    }

    def unbox_i64() -> TypeVar.I64 {
        if (TypeVar.I64.?(this)) return TypeVar.I64;
        return invalid_t(TypeVar.I64);
    }
    
    def unbox_f32() -> TypeVar.F32 {
        if (TypeVar.F32.?(this)) return TypeVar.F32;
        return invalid_t(TypeVar.F32);
    }
    
    def unbox_f64() -> TypeVar.F64 {
        if (TypeVar.F64.?(this)) return TypeVar.F64;
        return invalid_t(TypeVar.F64);
    }
    
    def unbox_v128() -> TypeVar.V128 {
        if (TypeVar.V128.?(this)) return TypeVar.V128;
        return invalid_t(TypeVar.V128);
    }
    
    def unbox_Object() -> TypeVar.Object {
        if (TypeVar.Object.?(this)) return TypeVar.Object;
        return invalid_t(TypeVar.Object);
    }
    
    def matches(other: TypeVar) -> bool {
        return this == other;
    }

    def short_str() -> string {
        match (this) {
            I32 => return "i";
            I64 => return "l";
            F32 => return "f";
            F64 => return "d";
            V128 => return "v";
            Object => return "r";
            Err => return "err";
            Bot => return "V";
        }
    }

    def long_str() -> string {
        match (this) {
            I32 => return "i32";
            I64 => return "i64";
            F32 => return "f32";
            F64 => return "f64";
            V128 => return "v128";
            Object => return "Ref";
            Err => return "Err";
            Bot => return "Value";
        }
    }
}

def typeVarFromValType(vt: ValueType) -> TypeVar {
    match (vt) {
        I32 => return TypeVar.I32;
        I64 => return TypeVar.I64;
        F32 => return TypeVar.F32;
        F64 => return TypeVar.F64;
        V128 => return TypeVar.V128;
        Ref => return TypeVar.Object;
        Host => return TypeVar.Object;
        BOTTOM => return TypeVar.Bot;
    }
}

def valTypeFromTypeVar(tv: TypeVar) -> ValueType {
    match (tv) {
        I32 => return ValueType.I32;
        I64 => return ValueType.I64;
        F32 => return ValueType.F32;
        F64 => return ValueType.F64;
        V128 => return ValueType.V128;
        Object => return ValueTypes.ANYREF;
        Err => return ValueType.BOTTOM;
        Bot => return ValueType.BOTTOM;
    }
}

def invalid_t<T>(t: T) -> T {
    invalid();
    return t;
}

def rtcast_i32(x: i32) -> TypeVar.I32 {
    return TypeVar.I32;
}
def rtcast_f32(x: float) -> TypeVar.F32 {
    return TypeVar.F32;
}

type FieldOffset;
enum FieldKind {
    U8, U16, I32, I64, F32, F64, V128, REF
}

def imm_readILEB32() -> i32 {
    return codeptr.read_sleb32();
}

def imm_readILEB64() -> i64 {
    return codeptr.read_sleb64();
}

def imm_readU8() -> u8 {
    return codeptr.read1();
}

def imm_readBlockType() -> (Array<ValueType>, Array<ValueType>) {
    def bt = codeptr.read_BlockTypeCode();
    return bt.toAbstractBlockType(module);
}

def pop_i32() -> TypeVar.I32 {
    return stack.pop().unbox_i32();
}
def pop_i64() -> TypeVar.I64 {
    return stack.pop().unbox_i64();
}
def pop_f32() -> TypeVar.F32 {
    return stack.pop().unbox_f32();
}
def pop_f64() -> TypeVar.F64 {
    return stack.pop().unbox_f64();
}
def pop_v128() -> TypeVar.V128 {
    return stack.pop().unbox_v128();
}
def pop_Object() -> TypeVar.Object {
    return stack.pop().unbox_Object();
}
def pop_Value(tv: TypeVar) -> TypeVar {
    def actual = stack.pop();
    if (tv.matches(actual)) return tv;
    return invalid_t(tv);
}

def push_i32(v: TypeVar.I32) {
    stack.push(v);
}
def push_i64(v: i64) {
    stack.push(TypeVar.I64);
}
def push_f32(v: TypeVar.F32) {
    stack.push(TypeVar.F32);
}
def push_f64(v: double) {
    stack.push(TypeVar.F64);
}
def push_v128(v: v128) {
    stack.push(TypeVar.V128);
}
def push_Object(v: TypeVar.Object) {
    stack.push(v);
}
def push_Value(tv: TypeVar, v: TypeVar) {
    if (!tv.matches(v)) invalid();
    stack.push(tv);
}

// Local variables.
def getLocal(tv: TypeVar, index: i32) -> TypeVar {
    return stack.elems[index];
}
def setLocal(tv: TypeVar, index: i32, v: TypeVar) {
    if (!tv.matches(v)) invalid();
    stack.elems[index] = tv;
}

// Global variables.
def getGlobal(tv: TypeVar, index: i32) -> TypeVar {
    return globals[index];
}
def setGlobal(tv: TypeVar, index: i32, v: TypeVar) {
    globals[index] = v;
}

// Function context.
def f_getLabel(depth: i32) -> ControlEntry {
    return ctl_stack.elems[ctl_stack.top - depth - 1];
}

def f_getLocalType(index: i32) -> TypeVar {
    return local_types[index];
}

def f_getTopOfStackType() -> TypeVar {
    return stack.peek();
}

// Module context.
def m_getGlobalType(index: i32) -> TypeVar {
    return globals[index];
}
def m_getFieldKind(struct_index: i32, field_index: i32) -> FieldKind;
def m_getFieldOffset(struct_index: i32, field_index: i32) -> FieldOffset;
def m_isMemory64(memory_index: i32) -> bool;
def m_isTable64(memory_index: i32) -> bool;
def m_getFuncSignature(func_index: i32) -> SigDecl {
    return null;
}
def m_getSignature(sig_index: i32) -> SigDecl;

// Instance context.
def i_getTableFunction64(table_index: i32, sig: SigDecl, func_index: TypeVar.I64) -> CBDFunction;
def i_getTableFunction32(table_index: i32, sig: SigDecl, func_index: TypeVar.I32) -> CBDFunction;
def i_getFunction(func_index: i32) -> CBDFunction {
    return null;
}

// Control flow.
def doCall(sig: SigDecl, target: CBDFunction) {
    return; // TODO
}

def doBranch(label: ControlEntry) {
    ctlxfer.refS(label, codeptr.pos, stack.top);
    def args = if(label.start_opcode == Opcode.LOOP.code, label.params, label.results);
    popTypes(args);
    pushTypes(args);
}

def doFallthru() {
}

// Machine intrinsics.
def mach_readStructField_i8(obj: Object, offset: FieldOffset) -> i8;
def mach_readStructField_u8(obj: Object, offset: FieldOffset) -> u8;
def mach_readStructField_i16(obj: Object, offset: FieldOffset) -> i16;
def mach_readStructField_u16(obj: Object, offset: FieldOffset) -> u16;
