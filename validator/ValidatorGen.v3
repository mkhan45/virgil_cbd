class ValidatorCBDDef extends CBDDef {
    def field_bitset: long;

    new(opcode: string, body: SSAD, field_bitset: long) super(opcode, body) {}
}

class SidetableEntry(fields: Array<(string, string)>) {
    def field_bitset() -> long {
        return 0; // TODO
    }
}

var graph_output_buf: StringBuilder;
def transformDef(opcode: string, stmt: VirgilStmt) -> ValidatorCBDDef {
    // if (!Strings.equal(opcode, "I32_DIV_S")) return null;
    // (name, type) -- we should have that VirgilStmt names align w/ SSA names,
    // so we can use this the same
    def st_field_buf = VirgilStmts.getSidetableFields(stmt);
    def bs = STFieldMgr.putEntry(st_field_buf);
    def sb = StringBuilder.new();

    var ir = SSAD_IR.from_virgil(stmt);
    var analysis = SSADCtx.new(ir);
    var stbuilder_call: SSAD = SSAD.Void;
    if (bs != 0) {
        // insert call to sidetable builder
        // since the validator is straight line and always reaches the end, we can just
        // stick the call at the end.
        // the SSA translation preserves varnames from the Virgil AST so it's chill
        def st_args = Array<string>.new(st_field_buf.length);
        for (i < st_field_buf.length) st_args[i] = st_field_buf[i].0;
        def stbuilder_fn = Strings.format1("ctlxfer.put_%s", opcode);
        stbuilder_call = SSAD.LetApp(SSAD_IR.uidl("eff_st_put"), stbuilder_fn, st_args, SSAD.Void);
        for (arg in st_args) analysis.effects[arg] = CBDEffect.Table;
    }

    var ctx = SSADCtx.new(ir);
    //var sea_ir = ctx.id_propagate(ir, Strings.newMap<string>());
    var sea_ir = ir;
    var sea = Seas.ofSSAD(sea_ir);
    sea.apply(void, fun (node: IRNode, sea: Sea, u: void) => node.id_propagate(sea));
    // System.puts("===="); System.puts(opcode);  System.puts("====\n");
    // System.puts(ir.toString(1));
    // System.ln();
    def raw_mermaid = sea.toMermaid();
    graph_output_buf.put1("## %s", opcode).ln();
    graph_output_buf.puts("```mermaid\n");
    graph_output_buf.puts(raw_mermaid);
    graph_output_buf.puts("```\n");

    ir = ir.appended(stbuilder_call);
    sea_ir = ir;
    sea = Seas.ofSSAD(sea_ir);
    sea.apply(void, fun (node: IRNode, sea: Sea, u: void) => node.id_propagate(sea));
    // sea.apply(IRNode.removeViews);
    sea.apply(void, fun (node: IRNode, sea: Sea, u: void) => node.overloadOps(sea));
    sea.apply(void, fun (node: IRNode, sea: Sea, u: void) => node.addAbstractions(sea));
    def state = HashMap<IRNode, (IRNode, Vector<IRNode>)>.new(IRNode.hash, IRNode.eq);
    sea.apply(state, IRNode.unLEM);
    sea.apply(void, fun (node: IRNode, sea: Sea, u: void) => node.constUnLEM(sea));
    def mermaid = sea.toMermaid();

    // System.puts("----SSAD----\n");
    // System.puts(sea_ir.toString(0));
    // System.puts("----MERMAID----\n");
    // System.puts(mermaid);
    // System.puts("------SPLIT MERMAID------\n");
    // def mbuf = StringBuilder.new();
    // mbuf.puts("---").ln();
    // mbuf.puts("config:").ln();
    // mbuf.puts("  layout: elk").ln();
    // mbuf.puts("---").ln();
    // mbuf.puts("graph TD").ln();
    // mbuf.puts("subgraph CODEPTR").ln();
    // def codeptr_sea = sea.subgraph(sea.finish.state_deps[StateComponent.Codeptr.tag]);
    // mbuf.putq(codeptr_sea.toMermaidExt("c", _));
    // mbuf.puts("end").ln();
    // mbuf.puts("subgraph STACK").ln();
    // def stack_sea = sea.subgraph(sea.finish.state_deps[StateComponent.Stack.tag]);
    // mbuf.putq(stack_sea.toMermaidExt("s", _));
    // mbuf.puts("end").ln();
    // System.puts(mbuf.toString());
    // System.puts("------");

    def scheduled = sea.schedule();
    ctx = SSADCtx.new(scheduled);
    ctx.getPhis();
    // System.puts("======\n");
    var pretty = Pretty_IR.fromSSAD(scheduled, ctx);
    // System.puts("----Scheduled----\n");
    // System.puts(scheduled.toString(0));
    // System.puts("----Pretty----\n");
    // pretty = Pretty_IR.inlineLets(pretty, Pretty_IR.defaultInlinePredicate, ctx, Strings.newMap<PrettyExpr>());
    // pretty = Pretty_IR.removeUselessAssigns(pretty, ctx);
    // pretty = Pretty_IR.simplifyVarNums(pretty, Strings.newMap<int>(), Strings.newMap<string>(), ctx);
    // System.puts(pretty.toString(0, ctx));
    // System.puts("====\n");

    // sb.puts("/**\n");
    // sb.puts("----input ir----\n");
    // sb.puts(sea_ir.toString(1));
    // sb.puts("\n----scheduled----\n");
    // sb.puts(scheduled.toString(1));
    // sb.puts("\n----pretty scheduled----\n");
    // sb.puts(pretty.toString(0, ctx));
    sb.puts("\n----mermaid---- {\n");
    sb.puts(mermaid);
    sb.puts("\n}\n");
    sb.puts("\t**/\n");

    def transform_ctx = SSADCtx.new(scheduled);
    analysis = transform_ctx;
    // def transform_ctx = analysis;
    def transformer = SSATransformer.new(transform_ctx);
    // transformer.onLetApp = TB(SSAD_IR.removeViews).then(SSAD_IR.overloadOps).then(SSAD_IR.addCasts).then(SSAT.transformChildren).f;
    // transformer.onLetApp = TB(SSAD_IR.addCasts).then(SSAT.transformChildren).f;
    // transformer.onIf = TB(flatten_ifs).then(SSAT.transformChildren).f;
    var transformed = transformer.transform(scheduled);

    // def transformer = SSATransformer.new(analysis);
    // transformer.onLetApp = TB(SSAD_IR.removeViews).then(SSAD_IR.overloadOps).then(SSAD_IR.addCasts).then(SSAT.transformChildren).f;
    // transformer.onIf = TB(flatten_ifs).f;
    // var transformed = transformer.transform(ssa);

    def processed = transformed;

    def vars = Maps.keyList(analysis.static);
    for (v = vars; v != null; v = v.tail) {
        sb.puts("// ").puts(v.head).puts(" -- ");
        sb.puts("static: ").puts(if(analysis.static[v.head], "yes", "no")).puts(", ");
        sb.puts("type: ").puts(analysis.types[v.head].long_str()).puts(", ");
        sb.puts("effect: ").puts(analysis.effects[v.head].toString());
        sb.ln();
    }
    var instSsa = processed;
    // instSsa = SSAD.Injected(sb.toString(), processed);

    return ValidatorCBDDef.new(opcode, instSsa, bs);
}

def main(args: Array<string>) {
    def sexpr_file = args[0];
    def v3file = args[1];

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);
    def v_intrinsics = IntrinsicTypes.getIntrinsicTypes("validator/Intrinsics.v3");
    v_intrinsics.apply(IntrinsicTypes.add_def);

    IntrinsicTypes.intrinsic_types["doFallthru"].reads |= StateComponent.Codeptr;

    graph_output_buf = StringBuilder.new();
    def defs: Array<ValidatorCBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);
    def dispatch_table = TierGen.buildDispatch(defs, CBDDef.!<ValidatorCBDDef>(_));

    def template_filename = args[2];
    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY ValidatorGen.v3\n");
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts(template_code);

    def graphs_file = System.fileOpen("generated/graphs.md", false);
    System.write(graphs_file, graph_output_buf.toString());

    System.puts(final_code_builder.toString());
}
