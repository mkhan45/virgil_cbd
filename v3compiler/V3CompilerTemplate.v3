type CBDExpr {
    case Call(f: string, args: Array<CBDExpr>);
    case If(cond: CBDExpr, lhs: CBDExpr, rhs: CBDExpr);
    case Prim(s: string);
    case WasmCall(idx: int, args: Array<CBDExpr>);

    def toString() -> string => StringBuilder.new().putq(this.render).toString();

    def render(buf: StringBuilder) -> StringBuilder {
        match (this) {
            Call(fn, args) => {
                if (fn == null) return buf.puts("nullcall");
                buf.puts(fn).puts("(");
                for (i < args.length) {
                    args[i].render(buf);
                    if (i != args.length - 1) buf.puts(", ");
                }
                buf.puts(")");
            }
            If(cond, lhs, rhs) => 
                buf.puts("if(").putq(cond.render).puts(", ").putq(lhs.render).puts(", ").putq(rhs.render);
            Prim(s) => buf.puts(s);
            WasmCall(idx, args) => {} // TODO
        }
        return buf;
    }
}

class ASTEval extends AI<
    CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr
> {
    var merge_cond: CBDExpr;

    new(module: Module, args: Array<int>) super(module, CFGStateMgr.new(module), args) {
        CFGStateMgr<CBDExpr>.!(state_manager).localAST = fun i => CBDExpr.Prim(Strings.format1("local_%d", i));
    }

    def I32_equals(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_equals", [lhs, rhs]);
    def I32_not_equals(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_not_equals", [lhs, rhs]);
    def I32_plus(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_plus", [lhs, rhs]);
    def I32_minus(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_minus", [lhs, rhs]);
    def I32_div(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_div", [lhs, rhs]);
    def I32_lt(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_lt", [lhs, rhs]);
    def I32_lte(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_lte", [lhs, rhs]);
    def I32_gt(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_gt", [lhs, rhs]);
    def I32_times(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_times", [lhs, rhs]);
    def I32_and(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("I32_and", [lhs, rhs]);

    def I32_maybeTrue(i: CBDExpr) -> bool => true;
    def I32_maybeFalse(i: CBDExpr) -> bool => true;

    def F32_equals(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_equals", [lhs, rhs]);
    def F32_not_equals(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_not_equals", [lhs, rhs]);
    def F32_plus(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_plus", [lhs, rhs]);
    def F32_minus(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_minus", [lhs, rhs]);
    def F32_div(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_div", [lhs, rhs]);
    def F32_lt(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_lt", [lhs, rhs]);
    def F32_lte(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_lte", [lhs, rhs]);
    def F32_gt(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_gt", [lhs, rhs]);
    def F32_times(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.Call("F32_times", [lhs, rhs]);

    def unbox_i(v: CBDExpr) -> CBDExpr => v;
    def unbox_l(v: CBDExpr) -> CBDExpr => v;
    def unbox_f(v: CBDExpr) -> CBDExpr => v;
    def unbox_d(v: CBDExpr) -> CBDExpr => v;
    def unbox_r(v: CBDExpr) -> CBDExpr => v;

    def box_i(v: CBDExpr) -> CBDExpr => v;
    def box_l(v: CBDExpr) -> CBDExpr => v;
    def box_f(v: CBDExpr) -> CBDExpr => v;
    def box_d(v: CBDExpr) -> CBDExpr => v;
    def box_r(v: CBDExpr) -> CBDExpr => v;

    def merge_i(lhs: CBDExpr, rhs: CBDExpr) -> CBDExpr => CBDExpr.If(merge_cond, lhs, rhs);

    def rtcast_i32(i: i32) -> CBDExpr => CBDExpr.Prim(StringBuilder.new().putd_i32(i).toString());
    def rtcast_f32(f: float) -> CBDExpr => CBDExpr.Prim("0.0"); // TODO

    def print_stack() {
        def sb = StringBuilder.new();
        def s = current_state().stack;
        for (i < s.top) {
            sb.putq(s.elems[i].render).puts(", ");
        }
        System.puts(sb.puts("\n").toString());
    }
    
    def emitIf(cond: CBDExpr) {
        merge_cond = cond;
        CFGStateMgr<CBDExpr>.!(state_manager).startCBDIf(cond);
    }
    def emitIfStatic(cond: bool) {
        CFGStateMgr<CBDExpr>.!(state_manager).startCBDIf(CBDExpr.Prim(StringBuilder.new().putz(cond).toString()));
    }
    def emitElse() {
        CFGStateMgr<CBDExpr>.!(state_manager).startCBDElse();
    }
    def emitEnd() {
        CFGStateMgr<CBDExpr>.!(state_manager).endCond();
    }
    def doCall(sig: SigDecl, target: CBDFunctionI) {
        // TODO: pop args, make a WasmCall
    }
}

component AIRunner {
    def init(m: Module, args: Array<int>) -> AI<CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr> {
        return ASTEval.new(m, args);
    }

    def on_finish(m: Module, i: AI<CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr, CBDExpr>) {
        def i = ASTEval.!(i);
        def ctx = CFGStateMgr<CBDExpr>.!(i.state_manager);
        for (fn < ctx.states.length) {
            System.puts("fn ");
            System.puti(fn);
            System.ln();
            def cbdfn = i.functions[fn];
            def nlocals = cbdfn.locals.length;
            def bbs = Vector<(BasicBlock<CBDExpr>, int)>.new();
            for (pc < ctx.states[fn].length) if (ctx.states[fn][pc] != null) {
                System.puti(pc); System.puts(": ");
                ctx.states[fn][pc].print();
                bbs.put((ctx.states[fn][pc], pc));
            }
            for (bbi < bbs.length) {
                def bb = bbs[bbi].0;
                def bb_pc = bbs[bbi].1;
                def st = bb.state;
                def args_strb = StringBuilder.new();
                for (i < nlocals) {
                    args_strb.puts("local_").putd(i).puts(": int");
                    if (i + 1 < nlocals) args_strb.puts(", ");
                }
                System.puts(Strings.format2("def bb_%d(%s) {\n", bb_pc, args_strb.toString()));

                def bb_end = if(bbi + 1 < bbs.length, bbs[bbi+1].1-4, cbdfn.code.length);
                if (bb_pc > bb_end) {
                    System.puts("}\n");
                    continue;
                }
                def bb_code = Arrays.range(cbdfn.code, bb_pc, bb_end);
                Compiler.init(bb_code, cbdfn.locals.copy(), []);
                Compiler.dispatch();
                System.puts(Compiler.getCode());

                // for (i < nlocals) {
                //     System.puts(Strings.format1("\tlocal_%d = ", i));
                //     System.puts(st.stack.elems[i].toString());
                //     System.puts(";\n");
                // }

                def call_args_b = StringBuilder.new();
                for (i < nlocals) {
                    call_args_b.puts("local_").putd(i);
                    if (i + 1 < nlocals) call_args_b.puts(", ");
                }
                def arg_str = call_args_b.toString();
                if (bb.then == -1) {
                    if (bbi + 1 < bbs.length) {
                        System.puts(Strings.format2("\treturn bb_%d(%s);\n", bbs[bbi+1].1, arg_str));
                    } else {
                        // def ret = st.stack.peek().toString();
                        // System.puts(Strings.format1("\treturn %s;\n", ret));
                    }
                } else {
                    def cond = bb.cond.toString();
                    def t_call = Strings.format2("bb_%d(%s)", bb.then, arg_str);
                    def e_call = Strings.format2("bb_%d(%s)", bb.els, arg_str);
                    System.puts(Strings.format3("\tif(%s) return %s;\n\telse return %s;\n", cond, t_call, e_call));
                }
                System.puts("}\n");
            }
        }
    }
}
