def SYNTHETIC_V3   = "./tests/SyntheticDefs.v3";
def SYNTHETIC_SEXP = "./tests/SyntheticDefs.v3.sexp";
def CANONICAL_V3   = "./wizard-engine/src/bytecode/CanonicalDefs.v3";
def CANONICAL_SEXP = "./wizard-engine/src/bytecode/CanonicalDefs.v3.sexp";
def TRACES_FILE    = "docs/traces.js";

def renderPhase0(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def buf = StringBuilder.new();
    buf.puts("=== ").puts(opcode).puts(" [phase0 ").puts(phase).puts("] ===\n");
    scheduler.renderPhase0(buf);
    buf.ln();
    System.puts(buf.toString());
    CBDTrace.addString(opcode, "instanced_phase0_cfg", "graph", scheduler.toMermaidICFG());
}

def renderResolveHomes(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def buf = StringBuilder.new();
    buf.puts("=== ").puts(opcode).puts(" [resolve_home ").puts(phase).puts("] ===\n");

    for (i < scheduler.site_frames.length) {
        def frame = scheduler.site_frames[i];
        for (j < frame.site.phis.length) {
            def phi = frame.site.phis[j];
            buf.puts("site#").putd(frame.site.id).puts(" phi=").putq(phi.render).puts("\n");

            if (phi.value_deps.length > 0 && phi.value_deps[0] != null)
                ISRender.renderResolveHome(scheduler, phi.value_deps[0], frame.parent_partition, UseRole.PhiCond, buf);
            if (phi.value_deps.length > 1 && phi.value_deps[1] != null)
                ISRender.renderResolveHome(scheduler, phi.value_deps[1], frame.left_partition, UseRole.PhiLeft, buf);
            if (phi.value_deps.length > 2 && phi.value_deps[2] != null)
                ISRender.renderResolveHome(scheduler, phi.value_deps[2], frame.right_partition, UseRole.PhiRight, buf);
        }
    }

    buf.ln();
    System.puts(buf.toString());
    CBDTrace.addString(opcode, "instanced_phase0_cfg", "graph", scheduler.toMermaidICFG());
}

def renderInstances(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def buf = StringBuilder.new();
    buf.puts("=== ").puts(opcode).puts(" [instances ").puts(phase).puts("] ===\n");
    scheduler.discover_instances();
    scheduler.renderInstances(buf);
    buf.ln();
    System.puts(buf.toString());
    CBDTrace.addString(opcode, "instanced_phase0_cfg", "graph", scheduler.toMermaidICFG());
}

def renderPlacement(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def buf = StringBuilder.new();
    buf.puts("=== ").puts(opcode).puts(" [placement ").puts(phase).puts("] ===\n");
    scheduler.discover_instances();
    scheduler.place_instances();
    scheduler.renderPlacement(buf);
    buf.ln();
    System.puts(buf.toString());
    CBDTrace.addString(opcode, "instanced_placement_cfg", "graph", scheduler.toMermaidICFG());
}

def renderCheckResults(opcode: string, phase: string, errors: Vector<InstancedScheduleError>, buf: StringBuilder) {
    buf.puts("=== ").puts(opcode).puts(" [check ").puts(phase).puts("] ===\n");
    if (errors.length == 0) buf.puts("ok\n");
    else for (i < errors.length) {
        buf.putd(i).puts(": ");
        errors[i].render(buf).puts("\n");
    }
}

def renderCheck(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def errors = scheduler.check_schedule();
    def buf = StringBuilder.new();
    renderCheckResults(opcode, phase, errors, buf);
    buf.ln();
    System.puts(buf.toString());
    CBDTrace.addString(opcode, "instanced_placement_cfg", "graph", scheduler.toMermaidICFG());
}

def renderLowered(opcode: string, phase: string, scheduler: InstancedSeaScheduler) {
    def errors = scheduler.check_schedule();
    def lowered = scheduler.toSSADSeaInfo();
    def ssad = lowered.0;
    def sea_info = lowered.1;
    def raw = ssad.toString(0);
    def pretty = ssad.toStringPrettyWithSeaInfo(0, sea_info);

    def buf = StringBuilder.new();
    renderCheckResults(opcode, phase, errors, buf);
    buf.puts("=== ").puts(opcode).puts(" [lowered ").puts(phase).puts("] raw SSAD ===\n");
    buf.puts(raw).ln();
    buf.puts("=== ").puts(opcode).puts(" [lowered ").puts(phase).puts("] pretty SSAD ===\n");
    buf.puts(pretty).ln();
    System.puts(buf.toString());

    CBDTrace.addString(opcode, "instanced_placement_cfg", "graph", scheduler.toMermaidICFG());
    CBDTrace.addCode(opcode, "instanced_lowered_ssad", raw);
    CBDTrace.addCode(opcode, "instanced_lowered_pretty", pretty);
}

def testOpcode(opcode: string, stmt: VirgilStmt, use_unlem: bool,
                render_resolve: bool, render_instances: bool,
                render_placement: bool, render_lowered: bool,
                render_check: bool) -> CBDDef {
    def ir = SSAD_IR.from_virgil(stmt);
    def sea_info = Seas.ofSSADWithInfo(ir);
    def sea = sea_info.0;

    sea.apply(void, SeaTransforms.id_propagate);
    if (use_unlem) {
        def state = NodeMap<(IRNode, Vector<IRNode>)>.new();
        sea.apply(state, SeaTransforms.unLEM);
    }

    def scheduler = InstancedScheduler.of_full_sea_info(sea, sea_info.1);
    def phase = if(use_unlem, "unLEM", "raw");
    if (render_lowered) renderLowered(opcode, phase, scheduler);
    else if (render_check) renderCheck(opcode, phase, scheduler);
    else if (render_placement) renderPlacement(opcode, phase, scheduler);
    else if (render_instances) renderInstances(opcode, phase, scheduler);
    else if (render_resolve) renderResolveHomes(opcode, phase, scheduler);
    else renderPhase0(opcode, phase, scheduler);
    return CBDDef.new(opcode, ir, sea_info.1);
}

def main(args: Array<string>) {
    CBDTrace.init(TRACES_FILE);
    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);

    var use_canonical = false;
    var use_unlem = false;
    var render_resolve = false;
    var render_instances = false;
    var render_placement = false;
    var render_lowered = false;
    var render_check = false;
    def opcode_args = Vector<string>.new();
    var i = 0;
    while (i < args.length) {
        def arg = args[i];
        if (Strings.equal(arg, "--canonical")) use_canonical = true;
        else if (Strings.equal(arg, "--unlem")) use_unlem = true;
        else if (Strings.equal(arg, "--resolve-home")) render_resolve = true;
        else if (Strings.equal(arg, "--instances")) render_instances = true;
        else if (Strings.equal(arg, "--placement")) render_placement = true;
        else if (Strings.equal(arg, "--lowered")) render_lowered = true;
        else if (Strings.equal(arg, "--check")) render_check = true;
        else opcode_args.put(arg);
        i += 1;
    }

    def filter_args = opcode_args.copy();

    def filterInstrs(all_instrs: Array<string>) -> Array<string> {
        if (filter_args.length == 0) return all_instrs;
        def filtered = Vector<string>.new();
        for (arg in filter_args) {
            for (name in all_instrs) {
                if (Strings.equal(name, arg)) {
                    filtered.put(name);
                    break;
                }
            }
        }
        return filtered.copy();
    }

    def runDefs(v3file: string, sexpfile: string) {
        def v3bytes = System.fileLoad(v3file);
        if (v3bytes == null) {
            System.puts(Strings.format1("Error reading %s\n", v3file));
            return;
        }

        def sexp_bytes = System.fileLoad(sexpfile);
        if (sexp_bytes == null) {
            System.puts(Strings.format1("Error reading %s\n", sexpfile));
            return;
        }

        def instrs = filterInstrs(TierGen.extractInstrNames(v3bytes));
        TierGen.extractDefs(instrs, sexpfile, sexp_bytes,
            fun (opcode: string, stmt: VirgilStmt) -> CBDDef {
                return testOpcode(opcode, stmt, use_unlem, render_resolve, render_instances, render_placement, render_lowered, render_check);
            });
    }

    runDefs(SYNTHETIC_V3, SYNTHETIC_SEXP);
    if (use_canonical) runDefs(CANONICAL_V3, CANONICAL_SEXP);
}
