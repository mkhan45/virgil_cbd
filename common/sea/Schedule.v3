var sched_id: int = 0;
def fresh_id() -> int {
    sched_id += 1;
    return sched_id;
}

def trap();

class SeaScheduler {
    var sea: Sea;
    var opcode: string = "";
    var bottom_block: ScheduleNode;
    var live = NodeSet.new();
    var done: NodeSet;
    var q: Vector<IRNode>;
    var q_idx: int;

    new(sea) {
        bottom_block = ScheduleBlock.new(fresh_id(), this);
        sea.apply(live, this.collectLiveAux);
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        def visited = HashMap<int, void>.new(int.!<int>, int.==);
        buf.puts("graph TD").ln();
        bottom_block.toMermaid(buf, visited);
        buf.ln();
        return buf.toString();
    }

    def collectLiveAux(node: IRNode, sea: Sea, state: NodeSet) -> Range<IRNode> {
        state.put(node);
        return node.deps();
    }

    def schedule() {
        q = Vector<IRNode>.new();
        q.put(sea.finish);

        done = NodeSet.new();

        q_idx = 0;
        while (q_idx < q.length) {
            def node = q[q_idx];
            q_idx += 1;

            // traverse existing schedule, put node in first available spot
	    def dest_block = bottom_block.schedule(node);
            if (dest_block != null) {
		if (Strings.equal(opcode, "IF")) {
		    // System.puts(Strings.format2("Scheduled %q into %d\n", node.render, dest_block.id));
		    // CBDTrace.addString(opcode, Strings.format1("sched %q", node.render), "graph", toMermaid());
		}
                for (d in node.deps()) q.put(d);
            } else {
                q.put(node);
            }
        }

        bottom_block.finalize();
    }
}

class ScheduleNode(id: int, scheduler: SeaScheduler) {
    var dominants: DomGraph = DomGraph.new(); // set of the IRNodes dominated by this node

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder;
    def linkPrependedBlock(block: ScheduleBlock);

    def subgraphName(buf: StringBuilder) -> StringBuilder {
        match (this) {
            block: ScheduleBlock => buf.puts("block_").putd(id);
            branch: ScheduleBranch => buf.puts("branch_").putd(id);
            phi: SchedulePhi => buf.puts("phi_").putd(id);
        }
        return buf;
    }

    def schedule(node: IRNode) -> ScheduleNode {
        if (dominants.has(node)) return this;
        // if (scheduler.done.has(node)) return scheduler.bottom_block;

	// System.puts("attempting to schedule ");
	// System.puts(Strings.format3("%q into %d\n\tdoms: %q\n", node.render, id, dominants.render));

        var ready = true;
        for (i < node.children.length) {
            def child = node.children[i];
            def live = scheduler.live.has(child);
            if (!live) continue;
	    if (child.id == node.id) continue; // XXX: why does this happen?

	    // if(!dominants.has(child)) System.puts(Strings.format1("Missing: %q\n", child.render));
            ready &= dominants.has(child);
        }

        if (ready) {
            // System.puts(Strings.format3("%q ready in %d\n\tdoms: %q\n", node.render, id, dominants.render));
            if (IROp.Phi.?(node.op) || IROp.StatePhi.?(node.op)) {
                return scheduleReadyPhi(node);
            } else {
                match (this) {
                    block: ScheduleBlock => {
                        block.nodes.put(node);
                        block.dominants.addLocal(node);
                        scheduler.done.put(node);
                        return block;
                    }
                    cond: ScheduleBranch => {
                        def dest_block = if(cond.prev != null, 
					cond.prev.schedule(node),
					cond.prependScheduleBlock(node));
                        return dest_block;
                    }
                    phi: SchedulePhi => {
                        var dest_block = phi.l_source.schedule(node);
                        if (dest_block == null) dest_block = phi.r_source.schedule(node);
                        if (dest_block == null) dest_block = phi.source_branch.schedule(node);
			return dest_block;
                    }
                    _ => return null; // unreachable
                }
            }
        } else {
            // System.puts(Strings.format2("%q NOT ready in %d\n", node.render, id));
            match (this) {
                block: ScheduleBlock => {
                    return if(block.prev != null, block.prev.schedule(node));
                }
                cond: ScheduleBranch => {
                    // dest_block remains null if schedules fail
                    return if(cond.prev != null, cond.prev.schedule(node));
                }
                phi: SchedulePhi => {
                    // not sure if we would ever have to schedule into branches from here
                    var dest_block = phi.l_source.schedule(node);
                    if (dest_block == null) dest_block = phi.r_source.schedule(node);
                    if (dest_block == null) dest_block = phi.source_branch.schedule(node);
                    return dest_block;
                }
                _ => return null; // unreachable
            }
        }
    }

    def scheduleReadyPhi(phi: IRNode) -> ScheduleNode {
        match (this) {
            block: ScheduleBlock => return if(block.prev == null, block.prependScheduleBranch(phi), block.prev.scheduleReadyPhi(phi));
            cond: ScheduleBranch => {
                return if (cond.prev == null, cond.prependScheduleBranch(phi), cond.prev.scheduleReadyPhi(phi));
            }
            phi_node: SchedulePhi => {
                def phi_cond = phi.value_deps[0];
                if (phi_node.source_branch.condition.id == phi_cond.id) {
                    return phi_node.fuseReadyPhi(phi);
                } else {
                    var dest_block = phi_node.l_source.schedule(phi);
                    if (dest_block == null) dest_block = phi_node.r_source.schedule(phi);
                    if (dest_block == null) dest_block = phi_node.source_branch.schedule(phi);
                    return dest_block;
                }
            }
            _ => return null; // unreachable
        }
    }

    def prependScheduleBlock(node: IRNode) -> ScheduleBlock {
        def block = ScheduleBlock.new(fresh_id(), scheduler);

        var prev: ScheduleNode;
        match (this) {
            b: ScheduleBlock => prev = b.prev;
            b: ScheduleBranch => prev = b.prev;
            _ => {}
        }
        match (prev) {
            prev_block: ScheduleBlock => prev_block.next = block;
            prev_phi: SchedulePhi => prev_phi.next = block;
            prev_branch: ScheduleBranch => {
                if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = block;
                if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = block;
            }
        }

        linkPrependedBlock(block);

        block.dominants = dominants.newChild();
        block.dominants.addLocal(node);

        block.nodes.put(node);
        scheduler.done.put(node);

        return block;
    }

    // traverses schedule graph and reverses all blocks
    def finalize() {
        match (this) {
            block: ScheduleBlock => {
                if (!block.forward) block.reverse();
                if (block.prev != null) block.prev.finalize();
            }
            branch: ScheduleBranch => if (branch.prev != null) branch.prev.finalize();
            phi: SchedulePhi => {
                phi.source_branch.finalize();
                phi.l_source.finalize();
                phi.r_source.finalize();
            }
        }
    }

    def getSinglePrev() -> ScheduleNode {
        match (this) {
            block: ScheduleBlock => return block.prev;
            branch: ScheduleBranch => return branch.prev;
            _ => trap();
        }
        return null;
    }

    def setSinglePrev(newPrev: ScheduleNode) -> this {
        match (this) {
            block: ScheduleBlock => block.prev = newPrev;
            branch: ScheduleBranch => branch.prev = newPrev;
            _ => trap();
        }
    }

    def prependScheduleBranch(phi: IRNode) -> SchedulePhi {
        //               prev
        //                |
        //              branch     (dominants all below)
        //             /      \
        //           left    right (dominants = this.dominants + phi + nodes in each branch)
        //             \      /
        //             phi_node (dominants = this.dominants)
        //                |
        //               this
        def cond = phi.value_deps[0], l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];
        def branch = ScheduleBranch.new(fresh_id(), scheduler);
        def phi_node = SchedulePhi.new(fresh_id(), scheduler);

        phi_node.next = this;
        phi_node.source_branch = branch;

        def prev = getSinglePrev();
        if (prev != null) {
            match (prev) {
                block: ScheduleBlock => block.next = branch;
                phi: SchedulePhi => phi.next = branch;
                branch: ScheduleBranch => {
                    if (branch.l_branch.id == this.id) branch.l_branch = branch;
                    if (branch.r_branch.id == this.id) branch.r_branch = branch;
                }
            }
        }

        branch.prev = prev;
        branch.condition = cond;

        setSinglePrev(phi_node);

        phi_node.dominants = dominants.newChild();

        def left = ScheduleBlock.new(fresh_id(), scheduler);
        def right = ScheduleBlock.new(fresh_id(), scheduler);

        left.prev = right.prev = branch;
        phi_node.l_source = branch.l_branch = left;
        phi_node.r_source = branch.r_branch = right;
	phi_node.dominants.addLocal(phi);

        left.dominants = phi_node.dominants.newChild();
        right.dominants = phi_node.dominants.newChild();
        branch.dominants = phi_node.dominants.newChild().withParent(left.dominants).withParent(right.dominants);

	def move_true = scheduler.sea.mkNode(IROp.Move(true), Array.new(10), [cond]);
	def move_false = scheduler.sea.mkNode(IROp.Move(false), Array.new(10), [cond]);
	l_branch.children.put(move_true);
	r_branch.children.put(move_false);
	scheduler.live.put(move_true);
	scheduler.live.put(move_false);
	left.dominants.addLocal(move_true);
	right.dominants.addLocal(move_false);

        phi_node.phis = List.new(phi, null);

	scheduler.q.put(l_branch);
	scheduler.q.put(r_branch);

        return phi_node;
    }
}

class ScheduleBlock(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var nodes: Vector<IRNode> = Vector.new(); // we build these backwards, so they have to be reversed.
    var forward: bool = false;
    var prev: ScheduleNode = null;
    var next: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph block_").putd(id).puts("[\"Block ").putd(id).puts("\"]").ln();
        buf.tab().puts("direction TB").ln(); // works in interactive but not with cdn
        // Render IRNodes linearly within this block
        for (i < nodes.length) {
            def node = nodes[i];
            node.toMermaidNode(buf, Strings.format1("b%d_", id));
        }
        // Connect nodes linearly
        for (i < nodes.length) {
            if (i + 1 < nodes.length) {
                buf.tab();
                if (!forward) {
                    buf.puts("b").putd(id).puts("_").putd(nodes[i + 1].id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(id).puts("_").putd(nodes[i].id).ln();
                } else {
                    buf.puts("b").putd(id).puts("_").putd(nodes[i].id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(id).puts("_").putd(nodes[i + 1].id).ln();
                }
            }
        }
        buf.puts("end").ln();
        // Edge to prev
        if (prev != null) {
            prev.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via prev
        if (prev != null) prev.toMermaid(buf, visited);
        return buf;
    }

    def reverse() {
         forward = !forward;
         nodes.reverse();
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
}

class ScheduleBranch(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var condition: IRNode;
    var l_branch: ScheduleNode = null;
    var r_branch: ScheduleNode = null;
    var prev: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph branch_").putd(id).puts("[\"Branch ").putd(id).puts("\"]").ln();
        // Render the condition node
        if (condition != null) {
            condition.toMermaidNode(buf, Strings.format1("br%d_", id));
        }
        buf.ln().puts("end").ln();
        // Edge to prev
        if (prev != null) {
            prev.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via prev
        if (prev != null) prev.toMermaid(buf, visited);
        return buf;
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
 }

class SchedulePhi(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var source_branch: ScheduleBranch;
    var l_source: ScheduleNode = null;
    var r_source: ScheduleNode = null;
    var next: ScheduleNode = null;
    var phis: List<IRNode> = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph phi_").putd(id).puts("[\"Phi ").putd(id).puts("\"]").ln();
        // Render phi nodes
        for (cur = phis; cur != null; cur = cur.tail) {
            def phi = cur.head;
            phi.toMermaidNode(buf, Strings.format1("p%d_", id));
        }
        buf.puts("end").ln();
        // Edges from l_source and r_source to this phi
        if (l_source != null) {
            l_source.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        if (r_source != null) {
            r_source.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via l_source and r_source
        if (l_source != null) l_source.toMermaid(buf, visited);
        if (r_source != null) r_source.toMermaid(buf, visited);
        // Also recurse via source_branch
        if (source_branch != null) source_branch.toMermaid(buf, visited);
        return buf;
    }

    def fuseReadyPhi(phi: IRNode) -> this {
        def cond = phi.value_deps[0], l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];

        dominants.addLocal(phi);

	def move_true = scheduler.sea.mkNode(IROp.Move(true), Array.new(10), [cond]);
	def move_false = scheduler.sea.mkNode(IROp.Move(false), Array.new(10), [cond]);

	scheduler.live.put(move_true);
	scheduler.live.put(move_false);

	l_branch.children.put(move_true);
	r_branch.children.put(move_false);

	l_source.dominants.addLocal(move_true);
	r_source.dominants.addLocal(move_false);

        phis = List.new(phi, phis);
        scheduler.done.put(phi);

        scheduler.q.put(l_branch);
        scheduler.q.put(r_branch);
    }
 }

def dedup(arr: Array<IRNode>) -> Array<IRNode> {
    def res = Vector<IRNode>.new();
    for (n in arr) {
        if (n == null) continue;
        var dup = false;
        for (i < res.length) dup |= res[i].id == n.id;
        if (!dup) res.put(n);
    }
    return res.copy();
}

// Dom graph with mutable set nodes
class DomGraph {
    var parents: Vector<DomGraph> = Vector.new();
    var local_nodes: NodeSet = NodeSet.new();

    def has(node: IRNode) -> bool {
        if (local_nodes.has(node)) return true;
        for (i < parents.length) if (parents[i].has(node)) return true;
        return false;
    }
    def addLocal(node: IRNode) => local_nodes.put(node);

    def newChild() -> DomGraph => DomGraph.new().withParent(this);
    def withParent(parent: DomGraph) -> this {
        parents.put(parent);
    }

    def render(buf: StringBuilder) -> StringBuilder {
        buf.puts("[");
        def nodes = Vector<IRNode>.new();
        local_nodes.apply(fun n => void(nodes.put(n)));
        for (i < nodes.length) {
            def node = nodes[i];
            if (i > 0) buf.puts(", ");
            buf.putq(node.render).put1(" (%d)", node.id);
        }

        for (i < parents.length) {
            buf.puts("; ");
            parents[i].render(buf);
        }

        buf.puts("]");

        return buf;
    }
}
