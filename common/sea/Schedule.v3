var sched_id: int = 0;
def fresh_id() -> int {
    sched_id += 1;
    return sched_id;
}

def trap();

class BranchLattice {
    var sea: Sea;
    var abstract_site: Site;
    var parent_realized: BranchLattice;
    var parent_region: Region;
    var left_region: Region;
    var right_region: Region;
    var condition: IRNode;
    var planning_left_roots: Vector<IRNode>;
    var planning_right_roots: Vector<IRNode>;
    var frontier: ImmNodeSet;
    var l_subgraph: ImmNodeSet;
    var r_subgraph: ImmNodeSet;
    var phis: Vector<IRNode>;
    var unscheduled_phi_child_count: int;
    var id: int;

    new(sea, condition, frontier, l_subgraph, r_subgraph, phis) {
        id = fresh_id();
    }

    def can_merge_branches(phi: IRNode) -> bool {
        def left = phi.value_deps[1], right = phi.value_deps[2];
        for (i < phis.length)
            if (sea.isDescendant(phi, phis[i]) || sea.isDescendant(phis[i], phi)) return false;

        return true;
    }

    def add_phi(phi: IRNode, partition: BranchPartition) -> this {
        phis.put(phi);
        frontier = frontier.union(partition.frontier);
        l_subgraph = l_subgraph.union(partition.l_subgraph).withoutAll(frontier);
        r_subgraph = r_subgraph.union(partition.r_subgraph).withoutAll(frontier);
    }
}

class SeaScheduler {
    var sea: Sea;
    var orig_sea: Sea;
    var ssad_sea_info: SSADSeaInfo = null;
    var mapping: NodeMap<IRNode>;
    var opcode: string = "";
    var live: NodeSet;
    var q: VecDeque<IRNode>;

    var top_node: IRNode;
    var bottom_node: IRNode;

    var bottom_block: CFGNode;
    var top_block: CFGNode;

    var branch_lattices: Vector<BranchLattice> = Vector.new();
    var branch_lattice_map: NodeMap<BranchLattice> = NodeMap<BranchLattice>.new();
    var scope_root: Region = null;
    var merge_site_map: NodeMap<Site> = NodeMap<Site>.new();
    var move_site_map: NodeMap<Site> = NodeMap<Site>.new();
    var move_side_map: NodeMap<ParentSide> = NodeMap<ParentSide>.new();

    var reify_conds = false;

    var trace_full: bool = false;
    var lowBounds: NodeMap<CFGNode> = NodeMap<CFGNode>.new();
    var clone_to_orig: NodeMap<IRNode> = NodeMap<IRNode>.new();
    new(orig_sea, orig_top_node: IRNode, orig_bottom_node: IRNode) {
        def clone = Seas.clone(orig_sea);
        sea = clone.0;
        mapping = clone.1;
        mapping.apply(fun (orig: IRNode, neu: IRNode) {
            clone_to_orig[neu] = orig;
        });

        sea.apply(void, SeaTransforms.addMoves);

        top_node = mapping[orig_top_node];
        bottom_node = mapping[orig_bottom_node];

        live = Seas.live(sea);
    }

    def rootNode(node: IRNode) -> IRNode {
        if (node == null) return null;
        def root = clone_to_orig[node];
        if (root != null) return root;
        return node;
    }

    def isPrimaryClone(node: IRNode) -> bool {
        if (node == null) return false;
        def root = rootNode(node);
        if (root == null) return false;
        def primary = mapping[root];
        if (primary != null) return primary.id == node.id;
        return root.id == node.id;
    }

    def add_unique_node(buf: Vector<IRNode>, node: IRNode) {
        if (node == null) return;
        for (i < buf.length) if (buf[i].id == node.id) return;
        buf.put(node);
    }

    def add_unique_region(buf: Vector<Region>, region: Region) {
        if (region == null) return;
        for (i < buf.length) if (buf[i].id == region.id) return;
        buf.put(region);
    }

    def region_parent(region: Region) -> Region {
        if (region == null || region.parent_site == null) return null;
        return region.parent_site.parent_region;
    }

    def region_depth(region: Region) -> int {
        var depth = 0;
        var cur = region;
        while (cur != null) {
            depth += 1;
            cur = region_parent(cur);
        }
        return depth;
    }

    def region_contains(ancestor: Region, node_region: Region) -> bool {
        var cur = node_region;
        while (cur != null) {
            if (cur.id == ancestor.id) return true;
            cur = region_parent(cur);
        }
        return false;
    }

    def common_region(lhs: Region, rhs: Region) -> Region {
        if (lhs == null) return rhs;
        if (rhs == null) return lhs;
        var l = lhs;
        var r = rhs;
        var ld = region_depth(l);
        var rd = region_depth(r);
        while (ld > rd) {
            l = region_parent(l);
            ld -= 1;
        }
        while (rd > ld) {
            r = region_parent(r);
            rd -= 1;
        }
        while (l != null && r != null && l.id != r.id) {
            l = region_parent(l);
            r = region_parent(r);
        }
        return l;
    }

    def common_region_all(regions: Vector<Region>) -> Region {
        if (regions == null || regions.length == 0) return null;
        var cur = regions[0];
        for (i = 1; i < regions.length; i++) cur = common_region(cur, regions[i]);
        return cur;
    }

    def logical_deps(node: IRNode) -> Array<IRNode> {
        if (node == null) return Array<IRNode>.new(0);
        if (node.is_move()) {
            def deps = Vector<IRNode>.new();
            def payload = ScopeState.move_payload(node);
            add_unique_node(deps, payload);
            return deps.copy();
        }

        def deps = Vector<IRNode>.new();
        for (i < node.value_deps.length) add_unique_node(deps, node.value_deps[i]);
        for (i < node.state_deps.length) add_unique_node(deps, node.state_deps[i]);
        return deps.copy();
    }

    def move_child_region(node: IRNode) -> Region {
        def site = move_site_map[node];
        if (site == null) return scope_root;
        return if (ParentSide.Left.?(move_side_map[node]), site.left_region, site.right_region);
    }

    def move_parent_region(node: IRNode) -> Region {
        def site = move_site_map[node];
        return if (site != null, site.parent_region, scope_root);
    }

    def logical_edge_uses_value(parent: IRNode, child: IRNode) -> bool {
        for (i < child.value_deps.length) {
            def dep = child.value_deps[i];
            if (dep == null || dep.id != parent.id) continue;
            match (child.op) {
                StatePhi(_) => {
                    if (i != 1 && i != 2) return true;
                }
                Move(_) => {
                    if (i != 0) return true;
                }
                _ => return true;
            }
        }
        return false;
    }

    def exposed_interface(node: IRNode, cache: NodeMap<ImmNodeSet>) -> ImmNodeSet {
        if (node == null) return ImmNodeSets.empty();
        def cached = cache[node];
        if (cached.bits != null) return cached;

        var result = ImmNodeSets.empty();
        if (node.is_move()) {
            result = exposed_interface(ScopeState.move_payload(node), cache);
        } else {
            match (node.op) {
                StatePhi => {
                    result = ImmNodeSets.single(node);
                }
                Phi => {
                    if (transparent_pure_phi(node, cache)) {
                        result = exposed_interface(node.value_deps[0], cache)
                            .union(exposed_interface(node.value_deps[1], cache)
                                .intersection(exposed_interface(node.value_deps[2], cache)));
                    } else {
                        result = ImmNodeSets.single(node);
                    }
                }
                _ => {
                    result = ImmNodeSets.single(node);
                    def deps = logical_deps(node);
                    for (i < deps.length) result = result.union(exposed_interface(deps[i], cache));
                }
            }
        }

        cache[node] = result;
        return result;
    }

    def transparent_pure_phi(phi: IRNode, cache: NodeMap<ImmNodeSet>) -> bool {
        if (phi == null || !IROp.Phi.?(phi.op)) return false;
        return exposed_interface(phi.value_deps[1], cache).eq(exposed_interface(phi.value_deps[2], cache));
    }

    def expose_common_arms(left: IRNode, right: IRNode,
                           seen: NodeSet, evidence: NodeSet,
                           cache: NodeMap<ImmNodeSet>) {
        def common = exposed_interface(left, cache).intersection(exposed_interface(right, cache));
        common.apply(sea, fun (n: IRNode) {
            expose_node(n, seen, evidence, cache);
        });
    }

    def expose_node(node: IRNode, seen: NodeSet, evidence: NodeSet,
                    cache: NodeMap<ImmNodeSet>) {
        if (node == null || seen.has(node)) return;
        if (!live.has(node) && !node.is_move()) return;
        seen.put(node);

        if (node.is_move()) {
            expose_node(ScopeState.move_payload(node), seen, evidence, cache);
            return;
        }

        match (node.op) {
            StatePhi => {
                evidence.put(node);
                return;
            }
            Phi => {
                if (transparent_pure_phi(node, cache)) {
                    evidence.put(node);
                    expose_node(node.value_deps[0], seen, evidence, cache);
                    expose_common_arms(node.value_deps[1], node.value_deps[2], seen, evidence, cache);
                } else {
                    evidence.put(node);
                }
                return;
            }
            _ => {
                def deps = logical_deps(node);
                for (i < deps.length) expose_node(deps[i], seen, evidence, cache);
            }
        }
    }

    def exposed_site_evidence(region: Region) -> NodeSet {
        def seen = NodeSet.new();
        def evidence = NodeSet.new();
        def cache = NodeMap<ImmNodeSet>.new();

        for (i < region.boundary_values.length)
            expose_node(region.boundary_values[i], seen, evidence, cache);
        for (i < region.state_frontier.length)
            expose_node(region.state_frontier[i], seen, evidence, cache);

        return evidence;
    }

    def canonicalize_sites(region: Region, evidence: NodeSet) -> Vector<Site> {
        def sites = Vector<Site>.new();
        evidence.apply(fun (n: IRNode) {
            if (!n.is_phi()) return;
            def cond = n.value_deps[0];
            var dest: Site = null;
            for (i < sites.length) {
                def site = sites[i];
                if (site.predicate != null && cond != null && site.predicate.id == cond.id) {
                    dest = site;
                    break;
                }
            }
            if (dest == null) {
                dest = Site.new(region, cond, Vector<IRNode>.new(), IROp.StatePhi.?(n.op));
                sites.put(dest);
            }
            dest.merge_nodes.put(n);
            if (IROp.StatePhi.?(n.op)) dest.forced = true;
        });
        return sites;
    }

    def derive_child_region(parent: Region, site: Site, left_side: bool) -> Region {
        def frontier = Arrays.dup(parent.state_frontier);
        def boundary = Vector<IRNode>.new();
        for (i < site.merge_nodes.length) {
            def phi = site.merge_nodes[i];
            add_unique_node(boundary, if(left_side, phi.value_deps[1], phi.value_deps[2]));
            match (phi.op) {
                StatePhi(statecomps) => {
                    for (sc in statecomps)
                        frontier[sc.tag] = if(left_side,
                            ScopeState.left_state_pred(phi, sc),
                            ScopeState.right_state_pred(phi, sc));
                }
                _ => ;
            }
        }
        return Region.new(site,
            if(left_side, ParentSide.Left, ParentSide.Right),
            frontier,
            boundary);
    }

    def discover_region(region: Region) {
        region.sites = canonicalize_sites(region, exposed_site_evidence(region));
        for (i < region.sites.length) {
            def site = region.sites[i];
            site.left_region = derive_child_region(region, site, true);
            site.right_region = derive_child_region(region, site, false);
            discover_region(site.left_region);
            discover_region(site.right_region);
        }
    }

    def infer_scope_tree() -> Region {
        def boundary = Vector<IRNode>.new();
        for (i < bottom_node.value_deps.length) add_unique_node(boundary, bottom_node.value_deps[i]);
        def root = Region.new(null, ParentSide.Root, Arrays.dup(bottom_node.state_deps), boundary);
        discover_region(root);
        return root;
    }

    def index_scope_tree(region: Region) {
        if (region == null) return;
        for (i < region.sites.length) {
            def site = region.sites[i];
            for (j < site.merge_nodes.length) {
                def phi = site.merge_nodes[j];
                merge_site_map[phi] = site;
                if (phi.value_deps.length > 1 && phi.value_deps[1] != null) {
                    move_site_map[phi.value_deps[1]] = site;
                    move_side_map[phi.value_deps[1]] = ParentSide.Left;
                }
                if (phi.value_deps.length > 2 && phi.value_deps[2] != null) {
                    move_site_map[phi.value_deps[2]] = site;
                    move_side_map[phi.value_deps[2]] = ParentSide.Right;
                }
            }
            index_scope_tree(site.left_region);
            index_scope_tree(site.right_region);
        }
    }

    def can_merge_group(group: Vector<IRNode>, phi: IRNode) -> bool {
        for (i < group.length)
            if (sea.isDescendant(phi, group[i]) || sea.isDescendant(group[i], phi)) return false;
        return true;
    }

    def site_ordered_members(site: Site, ordered_phis: Array<IRNode>) -> Vector<IRNode> {
        def members = Vector<IRNode>.new();
        for (i < ordered_phis.length) {
            def phi = ordered_phis[i];
            def owner = merge_site_map[phi];
            if (owner != null && owner.id == site.id) members.put(phi);
        }
        return members;
    }

    def build_realized_sites(region: Region, ordered_phis: Array<IRNode>, parent_realized: BranchLattice) {
        if (region == null) return;
        for (i < region.sites.length) {
            def site = region.sites[i];
            def members = site_ordered_members(site, ordered_phis);
            var first_realized: BranchLattice = null;
            def groups = Vector<Vector<IRNode>>.new();

            for (j < members.length) {
                def phi = members[j];
                var placed = false;
                for (k < groups.length) {
                    if (can_merge_group(groups[k], phi)) {
                        groups[k].put(phi);
                        placed = true;
                        break;
                    }
                }
                if (!placed) {
                    def group = Vector<IRNode>.new();
                    group.put(phi);
                    groups.put(group);
                }
            }

            for (j < groups.length) {
                def group = groups[j];
                def left_roots = Vector<IRNode>.new();
                def right_roots = Vector<IRNode>.new();
                for (k < group.length) {
                    add_unique_node(left_roots, group[k].value_deps[1]);
                    add_unique_node(right_roots, group[k].value_deps[2]);
                }

                def bl = BranchLattice.new(sea, site.predicate,
                    ImmNodeSets.empty(), ImmNodeSets.empty(), ImmNodeSets.empty(), group);
                bl.abstract_site = site;
                bl.parent_realized = parent_realized;
                bl.parent_region = site.parent_region;
                bl.left_region = site.left_region;
                bl.right_region = site.right_region;
                bl.planning_left_roots = left_roots;
                bl.planning_right_roots = right_roots;
                branch_lattices.put(bl);
                for (k < group.length) branch_lattice_map[group[k]] = bl;
                if (first_realized == null) first_realized = bl;
            }

            build_realized_sites(site.left_region, ordered_phis, if(first_realized != null, first_realized, parent_realized));
            build_realized_sites(site.right_region, ordered_phis, if(first_realized != null, first_realized, parent_realized));
        }
    }

    def finalize_realized_sites() {
        sea.rebuildChildren();
        live = Seas.live(sea);
        sea.clearDepsCache();

        def realized = Vector<BranchLattice>.new();
        branch_lattice_map = NodeMap<BranchLattice>.new();
        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            def live_phis = Vector<IRNode>.new();
            var frontier = ImmNodeSets.empty();
            var lsg = ImmNodeSets.empty();
            var rsg = ImmNodeSets.empty();
            for (j < bl.phis.length) {
                def phi = bl.phis[j];
                if (!live.has(phi)) continue;
                live_phis.put(phi);
                def part = sea.branch_partition(phi);
                frontier = frontier.union(part.frontier);
                lsg = lsg.union(part.l_subgraph);
                rsg = rsg.union(part.r_subgraph);
                branch_lattice_map[phi] = bl;
            }
            if (live_phis.length == 0) continue;
            bl.phis = live_phis;
            bl.frontier = frontier;
            bl.l_subgraph = lsg.withoutAll(frontier);
            bl.r_subgraph = rsg.withoutAll(frontier);
            realized.put(bl);
        }
        branch_lattices = realized;
    }

    def add_request(reqs: NodeMap<Vector<Region>>, node: IRNode, region: Region) {
        if (node == null || region == null) return;
        var regions = reqs[node];
        if (regions == null) {
            regions = Vector<Region>.new();
            reqs[node] = regions;
        }
        add_unique_region(regions, region);
    }

    def live_topological_order() -> Vector<IRNode> {
        def live_nodes = Vector<IRNode>.new();
        live.apply(fun (n: IRNode) {
            live_nodes.put(n);
        });

        def dep_count = NodeMap<int>.new();
        def dependents = NodeMap<Vector<IRNode>>.new();
        def queue = Vector<IRNode>.new();
        def result = Vector<IRNode>.new();

        for (i < live_nodes.length) {
            def node = live_nodes[i];
            def deps = logical_deps(node);
            var count = 0;
            for (j < deps.length) {
                def dep = deps[j];
                if (dep == null || !live.has(dep)) continue;
                count += 1;
                var ds = dependents[dep];
                if (ds == null) {
                    ds = Vector<IRNode>.new();
                    dependents[dep] = ds;
                }
                ds.put(node);
            }
            dep_count[node] = count;
            if (count == 0) queue.put(node);
        }

        var qi = 0;
        while (qi < queue.length) {
            def node = queue[qi];
            qi += 1;
            result.put(node);
            def ds = dependents[node];
            if (ds == null) continue;
            for (i < ds.length) {
                def user = ds[i];
                dep_count[user] -= 1;
                if (dep_count[user] == 0) queue.put(user);
            }
        }

        for (i < live_nodes.length)
            if (dep_count[live_nodes[i]] > 0) result.put(live_nodes[i]);

        return result;
    }

    def seed_requests(reqs: NodeMap<Vector<Region>>) {
        for (i < scope_root.boundary_values.length)
            add_request(reqs, scope_root.boundary_values[i], scope_root);
        for (i < scope_root.state_frontier.length)
            add_request(reqs, scope_root.state_frontier[i], scope_root);

        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            add_request(reqs, bl.condition, bl.parent_region);
            for (j < bl.planning_left_roots.length)
                add_request(reqs, bl.planning_left_roots[j], bl.left_region);
            for (j < bl.planning_right_roots.length)
                add_request(reqs, bl.planning_right_roots[j], bl.right_region);
        }
    }

    def predicate_support_region(node: IRNode, region: Region) -> Region {
        var support = region;
        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            if (bl.condition == null || node == null || bl.condition.id != node.id) continue;
            if (!region_contains(bl.left_region, region) && !region_contains(bl.right_region, region)) continue;
            if (support == null || region_depth(bl.parent_region) > region_depth(support))
                support = bl.parent_region;
        }
        return support;
    }

    def propagate_dep_requests(node: IRNode, region: Region, reqs: NodeMap<Vector<Region>>) {
        if (node == null || region == null) return;

        if (node.is_move()) {
            add_request(reqs, ScopeState.move_payload(node), region);
            return;
        }

        if (node.is_phi()) {
            def site = merge_site_map[node];
            if (site == null) return;
            add_request(reqs, node.value_deps[0], site.parent_region);
            add_request(reqs, node.value_deps[1], site.left_region);
            add_request(reqs, node.value_deps[2], site.right_region);
            return;
        }

        def deps = logical_deps(node);
        def dep_region = predicate_support_region(node, region);
        for (i < deps.length) add_request(reqs, deps[i], dep_region);
    }

    def propagate_requests(reqs: NodeMap<Vector<Region>>, topo: Vector<IRNode>) {
        for (i = topo.length - 1; i >= 0; i--) {
            def node = topo[i];
            def regions = reqs[node];
            if (regions == null) continue;
            for (j < regions.length)
                propagate_dep_requests(node, regions[j], reqs);
        }
    }

    def minimal_request_owners(requests: Vector<Region>) -> Vector<Region> {
        if (requests == null || requests.length == 0) return Vectors.of1(scope_root);
        def owners = Vector<Region>.new();
        for (i < requests.length) add_unique_region(owners, requests[i]);

        def minimal = Vector<Region>.new();
        for (i < owners.length) {
            def region = owners[i];
            var covered = false;
            for (j < owners.length) {
                if (i == j) continue;
                if (region_contains(owners[j], region)) {
                    covered = true;
                    break;
                }
            }
            if (!covered) minimal.put(region);
        }
        return minimal;
    }

    def region_has_visible_owner(dep: IRNode, region: Region,
                                 plan: NodeMap<Vector<Region>>) -> bool {
        def owners = plan[dep];
        if (owners == null) return false;
        for (i < owners.length)
            if (region_contains(owners[i], region)) return true;
        return false;
    }

    def deps_visible_in_region(node: IRNode, region: Region,
                               plan: NodeMap<Vector<Region>>) -> bool {
        def deps = logical_deps(node);
        for (i < deps.length) {
            def dep = deps[i];
            if (dep == null) continue;
            if (!region_has_visible_owner(dep, region, plan)) return false;
        }
        return true;
    }

    def requests_served_by_owners(owners: Vector<Region>, requests: Vector<Region>) -> bool {
        if (requests == null) return true;
        for (i < requests.length) {
            def req = requests[i];
            var served = false;
            for (j < owners.length) {
                if (region_contains(owners[j], req)) {
                    served = true;
                    break;
                }
            }
            if (!served) return false;
        }
        return true;
    }

    def compatible_phi_escape(node: IRNode, child: IRNode,
                              owners: Vector<Region>) -> bool {
        if (child == null || !child.is_phi()) return false;
        def site = merge_site_map[child];
        if (site == null) return false;
        if (child.value_deps.length > 1 && child.value_deps[1] != null && child.value_deps[1].id == node.id)
            return requests_served_by_owners(owners, Vectors.of1(site.left_region));
        if (child.value_deps.length > 2 && child.value_deps[2] != null && child.value_deps[2].id == node.id)
            return requests_served_by_owners(owners, Vectors.of1(site.right_region));
        return false;
    }

    def owners_legal(node: IRNode, owners: Vector<Region>,
                     reqs: NodeMap<Vector<Region>>,
                     plan: NodeMap<Vector<Region>>) -> bool {
        for (i < owners.length)
            if (!deps_visible_in_region(node, owners[i], plan)) return false;
        if (!has_writes(node)) return true;

        for (i < node.children.length) {
            def child = node.children[i];
            if (child == null || child.id == node.id) continue;
            if (!live.has(child) && !child.is_move()) continue;
            if (!logical_edge_uses_value(node, child)) continue;
            if (compatible_phi_escape(node, child, owners)) continue;
            if (!requests_served_by_owners(owners, reqs[child])) return false;
        }
        return true;
    }

    def choose_owner_regions(node: IRNode, requests: Vector<Region>,
                             reqs: NodeMap<Vector<Region>>,
                             plan: NodeMap<Vector<Region>>) -> Vector<Region> {
        if (node == null) return Vector<Region>.new();

        if (node.is_phi()) return Vectors.of1(merge_site_map[node].parent_region);
        if (node.is_move() && move_site_map[node] != null) return Vectors.of1(move_child_region(node));

        def natural = minimal_request_owners(requests);
        if (natural.length <= 1) return natural;

        if (!has_writes(node)) {
            def shared = common_region_all(natural);
            if (shared != null && deps_visible_in_region(node, shared, plan))
                return Vectors.of1(shared);
            return natural;
        }

        if (owners_legal(node, natural, reqs, plan)) return natural;
        var shared = common_region_all(natural);
        while (shared != null) {
            def collapsed = Vectors.of1(shared);
            if (owners_legal(node, collapsed, reqs, plan)) return collapsed;
            shared = region_parent(shared);
        }
        return Vectors.of1(scope_root);
    }

    def compute_owner_plan(reqs: NodeMap<Vector<Region>>, topo: Vector<IRNode>) -> NodeMap<Vector<Region>> {
        def plan = NodeMap<Vector<Region>>.new();
        for (i < topo.length) {
            def node = topo[i];
            plan[node] = choose_owner_regions(node, reqs[node], reqs, plan);
        }
        return plan;
    }

    def get_instance(instances: NodeMap<Vector<(Region, IRNode)>>,
                     node: IRNode, region: Region) -> IRNode {
        def entries = instances[node];
        if (entries == null || region == null) return null;
        for (i < entries.length)
            if (entries[i].0.id == region.id) return entries[i].1;
        return null;
    }

    def put_instance(instances: NodeMap<Vector<(Region, IRNode)>>,
                     node: IRNode, region: Region, inst: IRNode) {
        var entries = instances[node];
        if (entries == null) {
            entries = Vector<(Region, IRNode)>.new();
            instances[node] = entries;
        }
        entries.put((region, inst));
    }

    def clone_empty_instance(node: IRNode) -> IRNode {
        def clone = IRNode.new(node.op, sea.id_count);
        sea.nodes_by_id.put(clone);
        sea.id_count += 1;
        clone.state_deps = Array<IRNode>.new(node.state_deps.length);
        clone.value_deps = Array<IRNode>.new(node.value_deps.length);
        if (node.var_data != null) {
            clone.var_data = VarData.new(
                Seas.uidl(node.var_data.sourceName),
                node.var_data.tipe,
                node.var_data.stage);
        }
        clone_to_orig[clone] = rootNode(node);
        return clone;
    }

    def visible_instance(dep: IRNode, region: Region,
                         plan: NodeMap<Vector<Region>>,
                         instances: NodeMap<Vector<(Region, IRNode)>>) -> IRNode {
        if (dep == null) return null;
        def owners = plan[dep];
        if (owners == null) return dep;

        var best: Region = null;
        for (i < owners.length) {
            def owner = owners[i];
            if (!region_contains(owner, region)) continue;
            if (best == null || region_contains(best, owner)) best = owner;
        }
        if (best == null) best = owners[0];
        return get_instance(instances, dep, best);
    }

    def wire_instance(inst: IRNode, orig: IRNode, region: Region,
                      plan: NodeMap<Vector<Region>>,
                      instances: NodeMap<Vector<(Region, IRNode)>>) {
        if (inst == null || orig == null) return;

        if (orig.is_phi()) {
            def site = merge_site_map[orig];
            inst.value_deps[0] = visible_instance(orig.value_deps[0], site.parent_region, plan, instances);
            inst.value_deps[1] = visible_instance(orig.value_deps[1], site.left_region, plan, instances);
            inst.value_deps[2] = visible_instance(orig.value_deps[2], site.right_region, plan, instances);
            return;
        }

        if (orig.is_move()) {
            def child_region = move_child_region(orig);
            def parent_region = move_parent_region(orig);
            inst.value_deps[0] = visible_instance(orig.value_deps[0], parent_region, plan, instances);
            if (orig.value_deps.length > 1)
                inst.value_deps[1] = visible_instance(orig.value_deps[1], child_region, plan, instances);
            for (i < orig.state_deps.length)
                if (orig.state_deps[i] != null)
                    inst.state_deps[i] = visible_instance(orig.state_deps[i], child_region, plan, instances);
            return;
        }

        for (i < orig.value_deps.length)
            inst.value_deps[i] = visible_instance(orig.value_deps[i], region, plan, instances);
        for (i < orig.state_deps.length)
            inst.state_deps[i] = visible_instance(orig.state_deps[i], region, plan, instances);
    }

    def materialize(plan: NodeMap<Vector<Region>>, topo: Vector<IRNode>) {
        def instances = NodeMap<Vector<(Region, IRNode)>>.new();
        for (i < topo.length) {
            def node = topo[i];
            def owners = plan[node];
            if (owners == null || owners.length == 0) continue;
            put_instance(instances, node, owners[0], node);
            for (j = 1; j < owners.length; j++)
                put_instance(instances, node, owners[j], clone_empty_instance(node));
        }

        for (i < topo.length) {
            def node = topo[i];
            def owners = plan[node];
            if (owners == null) continue;
            for (j < owners.length)
                wire_instance(get_instance(instances, node, owners[j]), node, owners[j], plan, instances);
        }

        sea.rebuildChildren();
        live = Seas.live(sea);
        sea.clearDepsCache();
    }

    def render_regions(regions: Vector<Region>) -> string {
        if (regions == null) return "[]";
        def buf = StringBuilder.new();
        buf.putc('[');
        for (i < regions.length) {
            if (i > 0) buf.puts(", ");
            buf.putc('R').putd(regions[i].id);
        }
        buf.putc(']');
        return buf.toString();
    }

    def trace_instance_plan(reqs: NodeMap<Vector<Region>>, plan: NodeMap<Vector<Region>>, topo: Vector<IRNode>) {
        if (!trace_full) return;
        System.puts("=== scope sites ===\n");
        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            def buf = StringBuilder.new();
            buf.puts("  cond=").putq(bl.condition.render)
                .puts(" parent=R").putd(bl.parent_region.id)
                .puts(" left=R").putd(bl.left_region.id)
                .puts(" right=R").putd(bl.right_region.id)
                .puts(" phis=").putd(bl.phis.length).ln();
            System.puts(buf.toString());
        }
        System.puts("=== requests / owners ===\n");
        for (i < topo.length) {
            def node = topo[i];
            if (!has_writes(node) && !node.is_phi()) continue;
            System.puts(Strings.format3("  %q req=%s own=%s\n",
                node.render,
                render_regions(reqs[node]),
                render_regions(plan[node])));
            if (has_writes(node)) {
                for (j < node.children.length) {
                    def child = node.children[j];
                    if (child == null || !logical_edge_uses_value(node, child)) continue;
                    System.puts(Strings.format3("    child %q req=%s own=%s\n",
                        child.render,
                        render_regions(reqs[child]),
                        render_regions(plan[child])));
                }
            }
        }
    }

    // Compute a depth ordering of phis: outermost phis first.
    // Phi A is "inside" phi B if A is in B's l_subgraph or r_subgraph.
    // Returns phis sorted so that enclosing phis come before nested phis.
    def sorted_phis_by_depth() -> (Array<IRNode>, NodeMap<BranchPartition>) {
        // Collect all live phis and their partitions
        def phis = Vector<IRNode>.new();
        def partitions = NodeMap<BranchPartition>.new();
        live.apply(fun (n: IRNode) {
            if (!n.is_phi()) return;
            phis.put(n);
            partitions[n] = sea.branch_partition(n);
        });

        def n = phis.length;
        if (n == 0) return (Array<IRNode>.new(0), partitions);

        // Build containment graph: edge from outer -> inner (outer must come first)
        // dep_count[i] = number of phis that contain phi[i] (in-degree)
        def dep_count = Array<int>.new(n);
        def dependents = Array<Vector<int>>.new(n);
        for (i < n) dependents[i] = Vector.new();

        for (outer_idx < n) {
            def outer = phis[outer_idx];
            def p = partitions[outer];
            def subgraph = p.l_subgraph.union(p.r_subgraph);
            for (inner_idx < n) {
                if (outer_idx == inner_idx) continue;
                if (subgraph.has(phis[inner_idx])) {
                    dep_count[inner_idx]++;
                    dependents[outer_idx].put(inner_idx);
                }
            }
        }

        // Kahn's algorithm: process outermost phis first
        def result = Vector<IRNode>.new();
        def queue = Vector<int>.new();
        for (i < n) if (dep_count[i] == 0) queue.put(i);

        var idx = 0;
        while (idx < queue.length) {
            def cur = queue[idx];
            idx++;
            result.put(phis[cur]);
            for (k < dependents[cur].length) {
                def dep = dependents[cur][k];
                dep_count[dep]--;
                if (dep_count[dep] == 0) queue.put(dep);
            }
        }

        // Append any remaining (cyclic) phis
        for (i < n) if (dep_count[i] > 0) result.put(phis[i]);

        return (result.extract(), partitions);
    }

    def find_branch_lattices() {
        sea.clearDepsCache();
        def sorted = sorted_phis_by_depth();
        def sorted_phis = sorted.0;
        def partitions = sorted.1;

        for (idx < sorted_phis.length) {
            def n = sorted_phis[idx];
            if (branch_lattice_map[n] != null) continue;
            def cond = n.value_deps[0];

            def partition = partitions[n];
            def frontier = partition.frontier, lsg = partition.l_subgraph, rsg = partition.r_subgraph;

            var dest_bl: BranchLattice = null;
            for (i < branch_lattices.length) {
                def bl = branch_lattices[i];
                if (bl.condition.id != cond.id) continue;

                if (bl.can_merge_branches(n) && same_scope(n, bl)) {
                    dest_bl = bl;
                    break;
                }
            }

            if (dest_bl != null) {
                dest_bl.add_phi(n, partition);
            } else {
                dest_bl = BranchLattice.new(sea, cond, frontier, lsg, rsg, Vectors.of1(n));
                branch_lattices.put(dest_bl);
            }
            branch_lattice_map[n] = dest_bl;
        }
    }

    // Check that phi and the existing phis in bl are in the same scope:
    // they must not be on opposite sides of any already-formed BranchLattice.
    def same_scope(phi: IRNode, bl: BranchLattice) -> bool {
        for (i < branch_lattices.length) {
            def other = branch_lattices[i];
            if (other.id == bl.id) continue;

            def phi_in_l = other.l_subgraph.has(phi);
            def phi_in_r = other.r_subgraph.has(phi);
            if (!phi_in_l && !phi_in_r) continue;
            // If phi is in both subgraphs, it's shared (will be cloned by
            // this lattice) — not truly on one side, so skip.
            if (phi_in_l && phi_in_r) continue;

            for (j < bl.phis.length) {
                def existing = bl.phis[j];
                def ex_in_l = other.l_subgraph.has(existing);
                def ex_in_r = other.r_subgraph.has(existing);
                if (ex_in_l && ex_in_r) continue;
                if (phi_in_l != ex_in_l) return false;
                if (phi_in_r != ex_in_r) return false;
            }
        }
        return true;
    }

    def toMermaid() -> string => SeaRender.toMermaidScheduler(this);

    def schedule() {
        // if (opcode != null && Strings.startsWith(opcode, "I32_DIV_S_ul")) trace_full = true;
        if (opcode != null) CBDTrace.addGraph(opcode, "scheduler_start", sea);
        if (opcode != null && trace_full) CBDInfo.addString(opcode, "info_start", "", SeaRender.renderScheduler(this, StringBuilder.new()).toString());

        untangle();
        if (opcode != null) CBDTrace.addGraph(opcode, "untangled", sea);
        if (opcode != null && trace_full) CBDInfo.addString(opcode, "info_untangled", "", SeaRender.renderSchedulerUntangled(this, StringBuilder.new()).toString());

        compute_use_counts();
        q = VecDeque<IRNode>.new();
        q.enqueue(bottom_node);

        while (!q.empty()) {
            // max successful idx 
            // - for CBD (I32/I64_DIV_S): 30
            // - for SPLIT_BRANCHES: 122
            // - for EFFECT_LIFT_OVER_PARENT_COND: 434
            // if (q_idx > 500) {
            //     System.puts(Strings.format1("ERROR: Scheduling %s reached limit\n", opcode));
            //     break;
            // }

            var node = q.dequeue();

            if (node.is_move()) {
                def lb = lowBounds[node];
                node.applyDeps(fun (d: IRNode) {
                    if (lb != null && d.id != node.value_deps[0].id) {
                        trace_print(fun => Strings.format3("  Move %q sets lowBound[%q] = %d\n", node.render, d.render, lb.id));
                        lowBounds[d] = lb;
                    }
                    enqueue_dep(node, d);
                });
                continue;
            }

            trace_print(fun => Strings.format2("Node: %q, q length: %d\n", node.render, q.length));

            // traverse existing schedule, put node in first available spot
            def lower_bound = if(lowBounds[node] != null, lowBounds[node], bottom_block);
            // def lower_bound = bottom_block;
            if (node.is_phi()) trace_print(fun => Strings.format2("  lowBound: %d (bottom=%d)\n", lower_bound.id, bottom_block.id));
            def dest_block = lower_bound.schedule(node, null);
            if (dest_block != null) {
                node.applyDeps(fun (d: IRNode) {
                    lowBounds[d] = dest_block;
                    enqueue_dep(node, d);
                });
            } else {
                // q.enqueue(node);
            }
        }

        bottom_block.finalize();
        // check(); // check using ./scripts/schedule_test.sh
        if (opcode != null && trace_full) {
            def info_buf = SeaRender.renderSchedulerFinal(this, StringBuilder.new());
            info_buf.puts("\n=== scheduled_ssad_pretty ===\n");
            def ssad_info = bottom_block.toSSADSeaInfo();
            info_buf.puts(ssad_info.0.toStringPrettyWithSeaInfo(0, ssad_info.1));
            CBDInfo.addString(opcode, "info_final", "", info_buf.toString());
        }
    }

    def isReady(node: IRNode, schedule_node: CFGNode) -> bool {
        var ready = true;

        var children = node.children;

        // phis aren't ready until every use of branch lattice scheduled
        if (branch_lattice_map.has(node)) {
            def group = branch_lattice_map[node];
            children = Vector.new();

            for (i < group.phis.length)
                children.putv(group.phis[i].children);
        }

        for (i < children.length) {
            def child = children[i];
            if (child.id == node.id) continue;
            def live_flag = live.has(child);
            if (!live_flag && !child.is_move()) continue;
            if (child.is_move() && child.value_deps[0].id == node.id) continue;

            def has = schedule_node.dominants.has(child);
            trace_print(fun =>
                    Strings.format3("%s, have %s : %s\n", 
                        Strings.format1("Block %d", schedule_node.id),
                        Strings.format2("%q (%d)", child.render, child.id),
                        if(has, "YES", "NO"))
            );
            ready &= has;
        }

        return ready;
    }

    def topo_sort_lattices() -> Vector<BranchLattice> {
        def n = branch_lattices.length;
        def dep_count = Array<int>.new(n);
        def dependents = Array<Vector<int>>.new(n);
        for (i < n) dependents[i] = Vector.new();

        // Build dependency graph: A depends on B if any of B's phis are in A's l_subgraph or r_subgraph
        for (i < n) {
            def a = branch_lattices[i];
            for (j < n) {
                if (i == j) continue;
                def b = branch_lattices[j];
                var depends = false;
                for (k < b.phis.length) {
                    def phi = b.phis[k];
                    if (a.l_subgraph.has(phi) || a.r_subgraph.has(phi)) {
                        depends = true;
                        break;
                    }
                }
                if (depends) {
                    dep_count[i]++;
                    dependents[j].put(i);
                }
            }
        }

        def result = Vector<BranchLattice>.new();
        def queue = Vector<int>.new();
        for (i < n) if (dep_count[i] == 0) queue.put(i);

        var idx = 0;
        while (idx < queue.length) {
            def cur = queue[idx];
            idx++;
            result.put(branch_lattices[cur]);
            for (k < dependents[cur].length) {
                def dep = dependents[cur][k];
                dep_count[dep]--;
                if (dep_count[dep] == 0) queue.put(dep);
            }
        }

        for (i < n) if (dep_count[i] > 0) result.put(branch_lattices[i]);

        return result;
    }

    def has_writes(node: IRNode) -> bool {
        match (node.op) {
            Intrinsic(defn) => {
                for (sc in defn.writes) return true;
            }
            _ => ;
        }
        return false;
    }

    def lattice_contains_phi(bl: BranchLattice, phi: IRNode) -> bool {
        for (i < bl.phis.length) if (bl.phis[i].id == phi.id) return true;
        return false;
    }

    // This edge will be rewritten by untangle when cloning this lattice,
    // so it should not count as an escaping use of dep.
    def rewired_phi_use(dep: IRNode, child: IRNode, bl: BranchLattice,
                        lsg: ImmNodeSet, rsg: ImmNodeSet) -> bool {
        if (child == null || !child.is_phi()) return false;
        if (!lattice_contains_phi(bl, child)) return false;

        if (child.value_deps.length > 1 && child.value_deps[1] != null &&
            child.value_deps[1].id == dep.id && lsg.has(dep)) return true;

        if (child.value_deps.length > 2 && child.value_deps[2] != null &&
            child.value_deps[2].id == dep.id && rsg.has(dep)) return true;

        return false;
    }

    // Nodes in (lsg ∪ rsg) that still have live uses outside the cloned
    // domain after accounting for phi-edge rewrites.
    def escaping_clone_nodes(bl: BranchLattice,
                             lsg: ImmNodeSet, rsg: ImmNodeSet) -> NodeSet {
        def domain = lsg.union(rsg);
        def escaping = NodeSet.new();
        def wl = Vector<IRNode>.new();

        for (n in domain.toArray(sea)) {
            var escapes = false;
            for (i < n.children.length) {
                def child = n.children[i];
                if (child == null || child.id == n.id) continue;
                if (!live.has(child) && !child.is_move()) continue;

                // Move's condition edge is bookkeeping and does not represent
                // a real consuming use.
                if (child.is_move() && child.value_deps.length > 0 &&
                    child.value_deps[0] != null && child.value_deps[0].id == n.id) continue;

                if (domain.has(child)) continue;
                if (rewired_phi_use(n, child, bl, lsg, rsg)) continue;

                escapes = true;
                break;
            }
            if (escapes && !escaping.has(n)) {
                escaping.put(n);
                wl.put(n);
            }
        }

        // If a node escapes, all deps needed to build that escaping node
        // also escape.
        var wi = 0;
        while (wi < wl.length) {
            def node = wl[wi];
            wi += 1;
            node.applyDeps(fun (dep: IRNode) {
                if (dep == null || !domain.has(dep) || escaping.has(dep)) return;
                escaping.put(dep);
                wl.put(dep);
            });
        }

        return escaping;
    }

    // Writes that still escape the clone domain cannot be safely duplicated.
    // Remove them from clone sets; the remaining nodes are clone-safe.
    def filtered_clone_subgraphs(bl: BranchLattice) -> (ImmNodeSet, ImmNodeSet) {
        var lsg = bl.l_subgraph;
        var rsg = bl.r_subgraph;

        while (true) {
            def escaping = escaping_clone_nodes(bl, lsg, rsg);
            def remove = Vector<IRNode>.new();
            escaping.apply(fun (n: IRNode) {
                if (has_writes(n) && (lsg.has(n) || rsg.has(n))) remove.put(n);
            });
            if (remove.length == 0) break;

            def remove_set = ImmNodeSets.of_vec(remove);
            lsg = lsg.withoutAll(remove_set);
            rsg = rsg.withoutAll(remove_set);
        }

        return (lsg, rsg);
    }

    def filter_branch_lattices_clone_domains() {
        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            def filtered = filtered_clone_subgraphs(bl);
            bl.l_subgraph = filtered.0;
            bl.r_subgraph = filtered.1;
        }
    }

    def untangle() {
        branch_lattice_map = NodeMap<BranchLattice>.new();
        branch_lattices = Vector.new();
        merge_site_map = NodeMap<Site>.new();
        move_site_map = NodeMap<Site>.new();
        move_side_map = NodeMap<ParentSide>.new();
        live = Seas.live(sea);
        sea.rebuildChildren();
        sea.clearDepsCache();

        scope_root = infer_scope_tree();
        index_scope_tree(scope_root);

        def sorted = sorted_phis_by_depth();
        build_realized_sites(scope_root, sorted.0, null);

        def topo = live_topological_order();
        def reqs = NodeMap<Vector<Region>>.new();
        seed_requests(reqs);
        propagate_requests(reqs, topo);
        def plan = compute_owner_plan(reqs, topo);
        trace_instance_plan(reqs, plan, topo);
        materialize(plan, topo);
        finalize_realized_sites();
    }

    def compute_use_counts() {
        sea.nodes_by_id.apply(fun(n: IRNode) {
            n.unscheduled_use_count = 0;
        });

        for (i < branch_lattices.length)
            branch_lattices[i].unscheduled_phi_child_count = 0;

        for (i < branch_lattices.length) {
            def bl = branch_lattices[i];
            def seen = NodeSet.new();
            for (j < bl.phis.length) {
                def phi = bl.phis[j];
                for (k < phi.children.length) {
                    def child = phi.children[k];
                    if (child.id == phi.id) continue;
                    if (!live.has(child) && !child.is_move()) continue;
                    if (child.is_move() && child.value_deps[0].id == phi.id) continue;
                    if (seen.has(child)) continue;
                    seen.put(child);
                    bl.unscheduled_phi_child_count++;
                }
            }
        }

        sea.nodes_by_id.apply(fun(n: IRNode) {
            if (!live.has(n) && !n.is_move()) return;
            if (n.is_phi()) return;
            for (i < n.children.length) {
                def child = n.children[i];
                if (child.id == n.id) continue;
                if (!live.has(child) && !child.is_move()) continue;
                if (child.is_move() && child.value_deps[0].id == n.id) continue;
                n.unscheduled_use_count += 1;
            }
        });
    }

    def enqueue_dep(user: IRNode, dep: IRNode) {
        if (user.id == dep.id) return;
        if (!live.has(user) && !user.is_move()) return;
        if (user.is_move() && user.value_deps[0].id == dep.id) return;

        def seen_groups = Vector<int>.new();
        if (dep.is_phi()) {
            def bl = branch_lattice_map[dep];
            for (i < seen_groups.length) if (seen_groups[i] == bl.id) return;
            seen_groups.put(bl.id);
            bl.unscheduled_phi_child_count--;
            if (bl.unscheduled_phi_child_count == 0) {
                for (i < bl.phis.length) q.enqueue(bl.phis[i]);
            }
            return;
        }

        dep.unscheduled_use_count -= 1;
        if (dep.unscheduled_use_count <= 0) q.enqueue(dep);
    }

    def check() {
        def sc = ScheduleChecker.new(top_block, bottom_block, orig_sea, sea, mapping, clone_to_orig);
        sc.check();
        def errors = sc.errors;
        if (errors.length > 0) {
            System.puts(Strings.format1("ERROR: Invalid schedule for %s\n", opcode));
            for (i < errors.length) System.puts(Strings.format2("%d: %q\n", i, errors[i].render));
        }
    }

    def trace_print(s: void -> string) #inline {
        if (trace_full) System.puts(s());
    }
}

component Scheduler {
    def of_full_sea(sea: Sea) -> SeaScheduler {
        return of_full_sea_info(sea, null);
    }

    def of_full_sea_info(sea: Sea, sea_info: SSADSeaInfo) -> SeaScheduler {
        sea.rebuildChildren();
        def s = SeaScheduler.new(sea, sea.start, sea.finish);
        s.ssad_sea_info = sea_info;
        def b = CFGBlock.new(fresh_id(), s);
        s.bottom_block = b;
        s.top_block = b;
        return s;
    }
}

class CFGNode(id: int, scheduler: SeaScheduler) {
    var dominants: DomGraph = DomGraph.new(id); // set of the IRNodes dominated by this node

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder;
    def linkPrependedBlock(block: CFGBlock);

    def toSSAD() -> SSAD;
    def toSSADWithSeaInfo(sea_info: SSADSeaInfo) -> SSAD => toSSAD();

    def toSSADSeaInfo() -> (SSAD, SSADSeaInfo) {
        def sea_info = if (scheduler.ssad_sea_info != null, scheduler.ssad_sea_info.copy(), SSADSeaInfo.new());
        return (toSSADWithSeaInfo(sea_info), sea_info);
    }

    def subgraphName(buf: StringBuilder) -> StringBuilder => SeaRender.subgraphNameCFGNode(this, buf);

    def schedule(node: IRNode, upper_limit: CFGNode) -> CFGNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(node)) return this;

        trace_print(fun => "attempting to schedule ");
        trace_print(fun => Strings.format3("%q into %d\n\tdoms: %q\n", node.render, id, dominants.render));

        def ready = scheduler.isReady(node, this);
        if (ready) {
            trace_print(fun => Strings.format3("%q ready in %d\n\tdoms: %q\n", node.render, id, dominants.render));
        } else {
            trace_print(fun => Strings.format2("%q NOT ready in %d\n\n", node.render, id));
        }

        if (ready && node.is_phi()) return scheduleReadyPhi(node, upper_limit);

        match (this) {
            block: CFGBlock => {
                if (ready) {
                    block.prims.put(node);
                    block.dominants.addLocal(node);
                    if (scheduler.trace_full) {
                        System.puts(Strings.format2("Scheduled %q into %d\n\n", node.render, block.id));
                        CBDTrace.addString(scheduler.opcode, 
                                        Strings.format1("sched %q", node.render), "graph", scheduler.toMermaid());

                        System.puts(Strings.format2("Block %d doms: %q\n", block.id, block.dominants.render));
                        if (block.prev != null) 
                            System.puts(Strings.format2("Block %d doms: %q\n", block.prev.id, block.prev.dominants.render));
                    }
                    return block;
                } else {
                    return if(block.prev != null, block.prev.schedule(node, upper_limit));
                }
            }
            branch: CFGBranch => {
                if (ready) {
                    if (branch.prev != null && CFGBranch.?(branch.prev))
                        return branch.prependCFGBlock(node); // schedule before self, but not above previous branch.
                    else if (branch.prev != null)
                        return branch.prev.schedule(node, upper_limit);
                    else
                        return branch.prependCFGBlock(node);
                } else {
                    return if(branch.prev != null, branch.prev.schedule(node, upper_limit));
                }
            }
            phi: CFGPhi => {
                var dest_block = phi.l_source.schedule(node, phi.source_branch);
                if (dest_block == null) dest_block = phi.r_source.schedule(node, phi.source_branch);
                if (dest_block == null) dest_block = phi.source_branch.schedule(node, upper_limit);
                return dest_block;
            }
            _ => return null; // unreachable
        }
    }

    def scheduleReadyPhi(node: IRNode, upper_limit: CFGNode) -> CFGNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(node)) return this;

        def phi = node;
        match (this) {
            block: CFGBlock => 
                       return if(block.prev == null || CFGBranch.?(block.prev),
                               block.prependCFGBranch(node),
                               block.prev.scheduleReadyPhi(node, upper_limit));
            cond: CFGBranch => {
                return if (cond.prev == null, cond.prependCFGBranch(node), cond.prev.scheduleReadyPhi(node, upper_limit));
            }
            phi_node: CFGPhi => {
                def phi_cond = phi.value_deps[0];
                // if (phi_node.source_branch.condition.id == phi_cond.id) {
                //     System.puts("ERROR: Fusing\n");
                //     return null;
                // } else {
                    // return phi_node.source_branch.schedule(node, upper_limit);
                    var dest_block = phi_node.l_source.schedule(node, upper_limit);
                    if (dest_block == null) dest_block = phi_node.r_source.schedule(node, upper_limit);
                    if (dest_block == null) dest_block = phi_node.source_branch.schedule(node, upper_limit);
                    return dest_block;
                // }
            }
            _ => return null; // unreachable
        }
    }

    def prependCFGBlock(node: IRNode) -> CFGBlock {
        def block = CFGBlock.new(fresh_id(), scheduler);
        if (scheduler.top_block.id == this.id) scheduler.top_block = block;

        trace_print(fun => Strings.format2("Prepending new schedule block %d to %d\n", block.id, id));

        var prev: CFGNode;
        match (this) {
            b: CFGBlock => prev = b.prev;
            b: CFGBranch => prev = b.prev;
            _ => {}
        }
        match (prev) {
            prev_block: CFGBlock => prev_block.next = block;
            prev_phi: CFGPhi => prev_phi.next = block;
            prev_branch: CFGBranch => {
                if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = block;
                if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = block;
            }
        }
        if (prev != null) prev.dominants = prev.dominants.withParent(block.dominants);

        linkPrependedBlock(block);

        block.dominants = block.dominants.withParent(dominants);
        block.dominants.addLocal(node);

        block.prims.put(node);

        trace_print(fun => Strings.format2("Block %d doms: %q\n", block.id, block.dominants.render));
        trace_print(fun => Strings.format2("Block %d doms: %q\n", id, dominants.render));

        return block;
    }

    // traverses schedule graph, reverses blocks, and removes non-live nodes
    def finalize() {
        match (this) {
            block: CFGBlock => {
                if (!block.forward) block.reverse();
                def live_prims = Vector<IRNode>.new();
                for (i < block.prims.length) {
                    def n = block.prims[i];
                    if (scheduler.live.has(n)) live_prims.put(n);
                }
                block.prims = live_prims;
                if (block.prev != null) block.prev.finalize();
            }
            branch: CFGBranch => if (branch.prev != null) branch.prev.finalize();
            phi: CFGPhi => {
                phi.source_branch.finalize();
                phi.l_source.finalize();
                phi.r_source.finalize();
            }
        }
    }

    def getSinglePrev() -> CFGNode #inline {
        match (this) {
            block: CFGBlock => return block.prev;
            branch: CFGBranch => return branch.prev;
            _ => trap();
        }
        return null;
    }

    def setSinglePrev(newPrev: CFGNode) -> this #inline {
        match (this) {
            block: CFGBlock => block.prev = newPrev;
            branch: CFGBranch => branch.prev = newPrev;
            _ => trap();
        }
    }

    def prependCFGBranch(node: IRNode) -> CFGPhi {
        //               prev
        //                |
        //              branch     (dominants all below)
        //             /      \
        //           left    right (dominants = this.dominants + phi + nodes in each branch)
        //             \      /
        //             phi_node (dominants = this.dominants)
        //                |
        //               this
        // System.puts(Strings.format1("prepending branch to %d\n", id));

        def cond = node.value_deps[0];
        cond.init_move(scheduler.sea);
        def bl = scheduler.branch_lattice_map[node];
        def branch = CFGBranch.new(fresh_id(), scheduler);
        def phi_node = CFGPhi.new(fresh_id(), scheduler);

        if (scheduler.top_block.id == this.id) scheduler.top_block = branch;

        phi_node.next = this;
        phi_node.source_branch = branch;
        branch.phi = phi_node;

        def prev = getSinglePrev();
        if (prev != null) {
            match (prev) {
                block: CFGBlock => block.next = branch;
                phi: CFGPhi => phi.next = branch;
                prev_branch: CFGBranch => {
                    if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = branch;
                    if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = branch;
                }
            }
        }

        branch.prev = prev;
        branch.condition = cond;

        setSinglePrev(phi_node);

        phi_node.dominants = phi_node.dominants.withParent(dominants);

        def left = CFGBlock.new(fresh_id(), scheduler);
        def right = CFGBlock.new(fresh_id(), scheduler);

        left.prev = right.prev = branch;
        phi_node.l_source = branch.l_branch = left;
        phi_node.r_source = branch.r_branch = right;

        branch.dominants = branch.dominants.withParent(phi_node.dominants).withParent(left.dominants).withParent(right.dominants);

        if (prev != null) prev.dominants = prev.dominants.withParent(branch.dominants);

        for (i < bl.phis.length) {
            def phi = bl.phis[i];
            phi_node.dominants.addLocal(phi);
            phi_node.phis = List.new(phi, phi_node.phis);

            left.prims.put(phi.value_deps[1]);
            right.prims.put(phi.value_deps[2]);
            left.dominants.addLocal(phi.value_deps[1]);
            right.dominants.addLocal(phi.value_deps[2]);
        }

        if (scheduler.trace_full) {
            CBDTrace.addString(scheduler.opcode, 
                            Strings.format1("sched %q", bl.phis[0].render), "graph", scheduler.toMermaid());
        }

        return phi_node;
    }

    def trace_print = scheduler.trace_print;
}

class CFGBlock(uid: int, scheduler_: SeaScheduler) extends CFGNode(uid, scheduler_) {
    var prims: Vector<IRNode> = Vector.new(); // we build these backwards, so they have to be reversed.
    var forward: bool = false;
    var prev: CFGNode = null;
    var next: CFGNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidCFGBlock(this, buf, visited);

    def toSSAD() -> SSAD {
        return toSSADWithSeaInfo(SSADSeaInfo.new());
    }

    def emitAliases(node: IRNode, primary: string, ssad: SSAD, sea_info: SSADSeaInfo) -> SSAD {
        var res = ssad;
        if (node == null || primary == null || sea_info == null) return res;
        if (!scheduler.isPrimaryClone(node)) return res;
        def root = scheduler.rootNode(node);
        def aliases = sea_info.aliasesOf(root);
        if (aliases == null) return res;
        for (j < aliases.length) {
            def alias = aliases[j];
            if (alias == null || Strings.equal(alias, primary)) continue;
            res = res.appended(SSAD.LetApp(alias, "id", [primary], SSAD.Void));
            sea_info.recordLet(alias, node);
        }
        return res;
    }

    def toSSADWithSeaInfo(sea_info: SSADSeaInfo) -> SSAD {
        var res: SSAD = SSAD.Void;
        for (i < prims.length) {
            def node = prims[i];
            match (node.op) {
                Start, Finish, Move => {}
                Intrinsic(defn) => {
                    def name = node.var_data.sourceName;
                    def args = Arrays.map(node.value_deps, fun (n: IRNode) => n.var_data.sourceName);
                    res = res.appended(SSAD.LetApp(name, defn.name, args, SSAD.Void));
                    sea_info.recordLet(name, node);
                    res = emitAliases(node, name, res, sea_info);
                }
                Lit(tipe, rep) => {
                    def name = node.var_data.sourceName;
                    res = res.appended(SSAD.LetLit(name, rep, tipe.long_str(), SSAD.Void));
                    sea_info.recordLet(name, node);
                    res = emitAliases(node, name, res, sea_info);
                }
                Phi, StatePhi => {} // error
            }
        }

        if (prev != null) return prev.toSSADWithSeaInfo(sea_info).appended(res);
        else return res;
    }

    def reverse() {
         forward = !forward;
         prims.reverse();
    }

    def linkPrependedBlock(block: CFGBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
}

class CFGBranch(uid: int, scheduler_: SeaScheduler) extends CFGNode(uid, scheduler_) {
    var condition: IRNode;
    var l_branch: CFGNode = null;
    var r_branch: CFGNode = null;
    var prev: CFGNode = null;
    var phi: CFGPhi = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidCFGBranch(this, buf, visited);

    def linkPrependedBlock(block: CFGBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }

    def toSSAD() -> SSAD {
        // the actual branch and prev is emitted by phi to ssad
        return SSAD.Void;
    }

    def toSSADWithSeaInfo(sea_info: SSADSeaInfo) -> SSAD {
        return SSAD.Void;
    }
}

class CFGPhi(uid: int, scheduler_: SeaScheduler) extends CFGNode(uid, scheduler_) {
    var source_branch: CFGBranch;
    var l_source: CFGNode = null;
    var r_source: CFGNode = null;
    var next: CFGNode = null;
    var phis: List<IRNode> = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidCFGPhi(this, buf, visited);

    def toSSAD() -> SSAD {
        return toSSADWithSeaInfo(SSADSeaInfo.new());
    }

    def canUseAlias(node: IRNode, alias: string, sea_info: SSADSeaInfo) -> bool {
        if (node == null || alias == null || sea_info == null) return false;
        if (!scheduler.isPrimaryClone(node)) return false;
        return sea_info.hasAlias(scheduler.rootNode(node), alias);
    }

    def toSSADWithSeaInfo(sea_info: SSADSeaInfo) -> SSAD {
        def cond_name = source_branch.condition.var_data.sourceName;
        var left = l_source.toSSADWithSeaInfo(sea_info);
        var right = r_source.toSSADWithSeaInfo(sea_info);

        def phi_dest_names = Strings.newMap<int>();
        for (cur = phis; cur != null; cur = cur.tail) if (IROp.Phi.?(cur.head.op))
            phi_dest_names[cur.head.var_data.sourceName] = 1;

        // Unwrap Move nodes
        def phi_vec = Vector<(string, string)>.new();
        for (cur = phis; cur != null; cur = cur.tail) if (IROp.Phi.?(cur.head.op)) {
            def phi = cur.head;
            def phi_name = phi.var_data.sourceName;
            def root_phi = scheduler.rootNode(phi);
            var l = phi.value_deps[1];
            var r = phi.value_deps[2];
            if (l != null && IROp.Move.?(l.op) && l.value_deps.length > 1) l = l.value_deps[1];
            if (r != null && IROp.Move.?(r.op) && r.value_deps.length > 1) r = r.value_deps[1];
            var l_name = if (l != null && l.var_data != null, l.var_data.sourceName, null);
            var r_name = if (r != null && r.var_data != null, r.var_data.sourceName, null);
            def pref_l = if (sea_info != null, sea_info.phiLeftSource(root_phi, l_name), l_name);
            def pref_r = if (sea_info != null, sea_info.phiRightSource(root_phi, r_name), r_name);
            if (l_name != null && phi_dest_names.has(l_name) && canUseAlias(l, pref_l, sea_info))
                l_name = pref_l;
            if (r_name != null && phi_dest_names.has(r_name) && canUseAlias(r, pref_r, sea_info))
                r_name = pref_r;

            if (l != null && l_name != null) {
                phi_vec.put((phi_name, l_name));
                sea_info.recordPhiArm(phi_name, l_name, phi, l);
            }
            if (r != null && r_name != null) {
                phi_vec.put((phi_name, r_name));
                sea_info.recordPhiArm(phi_name, r_name, phi, r);
            }
        }

        var prev_ssad = if(source_branch.prev != null, source_branch.prev.toSSADWithSeaInfo(sea_info), SSAD.Void);

        if (scheduler.reify_conds) {
            left = SSAD.LetApp("effStartIf", "startIf", [cond_name], left);
            right = SSAD.LetApp("effStartElse", "startElse", [cond_name], right);
            def end_cond: SSAD = SSAD.LetApp("effEndCond", "endCond", [cond_name], SSAD.Void);
            return left.appended(right).appended(end_cond);
        } else {
            return prev_ssad.appended(SSAD.If(cond_name, left, right, phi_vec.copy(), SSAD.Void));
        }
    }
}

class Box<T> { 
    var v: T;
    new(v) {}
}
