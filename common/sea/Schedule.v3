var sched_id: int = 0;
def fresh_id() -> int {
    sched_id += 1;
    return sched_id;
}

def trap();

def collectLiveAux(node: IRNode, sea: Sea, state: NodeSet) -> Range<IRNode> {
    state.put(node);
    return node.deps();
}

class SeaScheduler {
    var sea: Sea;
    var opcode: string = "";
    var live = NodeSet.new();
    var q: Vector<SchedulePrim>;
    var q_idx: int;

    var top_node: IRNode;
    var bottom_node: IRNode;

    var bottom_block: ScheduleNode;

    new(sea, top_node, bottom_node) {
        sea.apply(live, collectLiveAux);
        live.apply(fun (n: IRNode) => void(top_node.children.put(n)));
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        def visited = HashMap<int, void>.new(int.!<int>, int.==);
        buf.puts("graph TD").ln();
        bottom_block.toMermaid(buf, visited);
        buf.ln();
        return buf.toString();
    }

    def schedule() {
        if (opcode != null) System.puts(Strings.format1("==============%s=============\n", opcode));
        q = Vector<SchedulePrim>.new();
        q.put(SchedulePrim.new(bottom_node, this));

        q_idx = 0;
        while (q_idx < q.length) {
            def prim = q[q_idx];
            q_idx += 1;

            // traverse existing schedule, put prim in first available spot
            def dest_block = bottom_block.schedule(prim, null);
            if (dest_block != null) {
                if (prim.node.id == top_node.id) return;
                for (d in prim.node.deps()) if (live.has(d)) q.put(SchedulePrim.new(d, this));
            } else {
                q.put(prim);
            }
        }

        bottom_block.finalize();
    }
}

component Scheduler {
    def of_full_sea(sea: Sea) -> SeaScheduler {
        sea.rebuildChildren();
        def s = SeaScheduler.new(sea, sea.start, sea.finish);
        def b = ScheduleBlock.new(fresh_id(), s);
        s.bottom_block = b;
        return s;
    }
}

class ScheduleNode(id: int, scheduler: SeaScheduler) {
    var dominants: DomGraph = DomGraph.new(); // set of the IRNodes dominated by this node

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder;
    def linkPrependedBlock(block: ScheduleBlock);

    def subgraphName(buf: StringBuilder) -> StringBuilder {
        match (this) {
            block: ScheduleBlock => buf.puts("block_").putd(id);
            branch: ScheduleBranch => buf.puts("branch_").putd(id);
            phi: SchedulePhi => buf.puts("phi_").putd(id);
        }
        return buf;
    }

    def schedule(prim: SchedulePrim, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(prim.node)) return this;

        System.puts("attempting to schedule ");
        System.puts(Strings.format3("%q into %d\n\tdoms: %q\n", prim.render, id, dominants.render));

        var ready = true;
        for (i < prim.neededBefore.length) {
            def child = prim.neededBefore[i];
            def live = scheduler.live.has(child);
            if (!live) continue;
            if (child.id == prim.node.id) continue; // XXX: why does this happen?

            if ((IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op))
                && (prim.node.id == child.value_deps[1].id || prim.node.id == child.value_deps[2].id))
                continue;

            // this kind of partitions branches by subgraph,
            // this is kind of equivalent to if we'd made an entirely
            // new scheduler for branch subgraph. But it doesn't schedule
            // ancestors, which we need (TODO XXX)
            // if (upper_limit != null && !upper_limit.dominants.has(child)) continue;

            if(!dominants.has(child)) System.puts(Strings.format1("Missing: %q\n", child.render));
            else System.puts(Strings.format1("Have: %q\n", child.render));
            ready &= dominants.has(child);
        }

        if (ready) {
            System.puts(Strings.format3("%q ready in %d\n\tdoms: %q\n", prim.render, id, dominants.render));
            if (IROp.Phi.?(prim.node.op) || IROp.StatePhi.?(prim.node.op)) {
                return scheduleReadyPhi(prim, upper_limit);
            } else {
                match (this) {
                    block: ScheduleBlock => {
                        block.prims.put(prim);
                        block.dominants.addLocal(prim.node);
                        if (Strings.equal(scheduler.opcode, "IF") || Strings.equal(scheduler.opcode, "IF_ul")) {
                            System.puts(Strings.format2("Scheduled %q into %d\n\n", prim.render, block.id));
                            CBDTrace.addString(scheduler.opcode, 
                                            Strings.format1("sched %q", prim.renderSimple), "graph", scheduler.toMermaid());
                        }
                        return block;
                    }
                    cond: ScheduleBranch => {
                        def dest_block = if(cond.prev != null, 
                                        cond.prev.schedule(prim, upper_limit),
                                        cond.prependScheduleBlock(prim));
                        return dest_block;
                    }
                    phi: SchedulePhi => {
                        var dest_block = phi.l_source.schedule(prim, phi.source_branch);
                        if (dest_block == null) dest_block = phi.r_source.schedule(prim, phi.source_branch);
                        if (dest_block == null) dest_block = phi.source_branch.schedule(prim, upper_limit);
                        return dest_block;
                    }
                    _ => return null; // unreachable
                }
            }
        } else {
            System.puts(Strings.format2("%q NOT ready in %d\n\n", prim.render, id));
            match (this) {
                block: ScheduleBlock => {
                    return if(block.prev != null, block.prev.schedule(prim, upper_limit));
                }
                cond: ScheduleBranch => {
                    // dest_block remains null if schedules fail
                    return if(cond.prev != null, cond.prev.schedule(prim, upper_limit));
                }
                phi: SchedulePhi => {
                    // return phi.source_branch.schedule(prim, upper_limit);
                    var dest_block = phi.l_source.schedule(prim, phi.source_branch);
                    if (dest_block == null) dest_block = phi.r_source.schedule(prim, phi.source_branch);
                    if (dest_block == null) dest_block = phi.source_branch.schedule(prim, upper_limit);
                    return dest_block;
                }
                _ => return null; // unreachable
            }
        }
    }

    def scheduleReadyPhi(prim: SchedulePrim, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        def phi = prim.node;
        match (this) {
            block: ScheduleBlock => return if(block.prev == null || ScheduleBranch.?(block.prev), block.prependScheduleBranch(prim), block.prev.scheduleReadyPhi(prim, upper_limit));
            cond: ScheduleBranch => {
                return if (cond.prev == null, cond.prependScheduleBranch(prim), cond.prev.scheduleReadyPhi(prim, upper_limit));
            }
            phi_node: SchedulePhi => {
                def phi_cond = phi.value_deps[0];
                if (phi_node.source_branch.condition.id == phi_cond.id) {
                    return phi_node.fuseReadyPhi(prim);
                } else {
                    // return phi_node.source_branch.schedule(prim, upper_limit);
                    var dest_block = phi_node.l_source.schedule(prim, upper_limit);
                    if (dest_block == null) dest_block = phi_node.r_source.schedule(prim, upper_limit);
                    if (dest_block == null) dest_block = phi_node.source_branch.schedule(prim, upper_limit);
                    return dest_block;
                }
            }
            _ => return null; // unreachable
        }
    }

    def prependScheduleBlock(prim: SchedulePrim) -> ScheduleBlock {
        def block = ScheduleBlock.new(fresh_id(), scheduler);

        var prev: ScheduleNode;
        match (this) {
            b: ScheduleBlock => prev = b.prev;
            b: ScheduleBranch => prev = b.prev;
            _ => {}
        }
        match (prev) {
            prev_block: ScheduleBlock => prev_block.next = block;
            prev_phi: SchedulePhi => prev_phi.next = block;
            prev_branch: ScheduleBranch => {
                if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = block;
                if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = block;
            }
        }

        linkPrependedBlock(block);

        block.dominants = dominants.newPrivChild();
        block.dominants.addLocal(prim.node);

        block.prims.put(prim);
        return block;
    }

    // traverses schedule graph and reverses all blocks
    def finalize() {
        match (this) {
            block: ScheduleBlock => {
                if (!block.forward) block.reverse();
                if (block.prev != null) block.prev.finalize();
            }
            branch: ScheduleBranch => if (branch.prev != null) branch.prev.finalize();
            phi: SchedulePhi => {
                phi.source_branch.finalize();
                phi.l_source.finalize();
                phi.r_source.finalize();
            }
        }
    }

    def getSinglePrev() -> ScheduleNode {
        match (this) {
            block: ScheduleBlock => return block.prev;
            branch: ScheduleBranch => return branch.prev;
            _ => trap();
        }
        return null;
    }

    def setSinglePrev(newPrev: ScheduleNode) -> this {
        match (this) {
            block: ScheduleBlock => block.prev = newPrev;
            branch: ScheduleBranch => branch.prev = newPrev;
            _ => trap();
        }
    }

    def prependScheduleBranch(prim: SchedulePrim) -> SchedulePhi {
        //               prev
        //                |
        //              branch     (dominants all below)
        //             /      \
        //           left    right (dominants = this.dominants + phi + nodes in each branch)
        //             \      /
        //             phi_node (dominants = this.dominants)
        //                |
        //               this
        System.puts(Strings.format1("prepending branch to %d\n", id));
        def phi = prim.node;
        def cond = phi.value_deps[0], l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];
        def branch = ScheduleBranch.new(fresh_id(), scheduler);
        def phi_node = SchedulePhi.new(fresh_id(), scheduler);

        phi_node.next = this;
        phi_node.source_branch = branch;

        def prev = getSinglePrev();
        if (prev != null) {
            match (prev) {
                block: ScheduleBlock => block.next = branch;
                phi: SchedulePhi => phi.next = branch;
                prev_branch: ScheduleBranch => {
                    if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = branch;
                    if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = branch;
                }
            }
        }

        branch.prev = prev;
        branch.condition = cond;

        setSinglePrev(phi_node);

        phi_node.dominants = dominants.newPrivChild();

        def left = ScheduleBlock.new(fresh_id(), scheduler);
        def right = ScheduleBlock.new(fresh_id(), scheduler);

        left.prev = right.prev = branch;
        phi_node.l_source = branch.l_branch = left;
        phi_node.r_source = branch.r_branch = right;
        phi_node.dominants.addLocal(phi);

        left.dominants = DomGraph.new();
        right.dominants = DomGraph.new();
        branch.dominants = phi_node.dominants.newPrivChild().withParent(left.dominants).withParent(right.dominants);

        if (prev != null) prev.dominants = prev.dominants.withPrivParent(branch.dominants);

        cond.init_move();
        scheduler.live.put(cond.move_true);
        scheduler.live.put(cond.move_false);

        left.dominants.addPrivate(cond.move_true);
        right.dominants.addPrivate(cond.move_false);

        phi_node.phis = List.new(phi, phi_node.phis);

        def lca = scheduler.sea.lca2(l_branch, r_branch);
        def lsg = scheduler.sea.subgraph2(lca, l_branch).with(cond.move_true).without(lca);
        def rsg = scheduler.sea.subgraph2(lca, r_branch).with(cond.move_false).without(lca);

        // def lcas = scheduler.sea.findTop(l_branch, r_branch);
        // System.puts(Strings.format2("lcas(%q, %q): ", l_branch.render, r_branch.render));
        // for (i < lcas.length) System.puts(Strings.format1("%q, ", lcas[i].render));
        // System.puts("\n");

        // var lsg = ImmNodeSet(null);
        // for (i < lcas.length) lsg = lsg.union(scheduler.sea.subgraph2(lcas[i], l_branch));
        // for (i < lcas.length) lsg = lsg.without(lcas[i]);
        // lsg = lsg.with(cond.move_true);

        // var rsg = ImmNodeSet(null);
        // for (i < lcas.length) rsg = rsg.union(scheduler.sea.subgraph2(lcas[i], r_branch));
        // for (i < lcas.length) rsg = rsg.without(lcas[i]);
        // rsg = rsg.with(cond.move_false);

        System.puts(Strings.format3("left: %q\nright: %q\nlca: %q\n", l_branch.render, r_branch.render, lca.render));
        System.puts(Strings.format2("lsg: %q\nrsg: %q\n", lsg.render, rsg.render));

        System.puts(Strings.format2("Schedule from pre.Branch: left = %d, right = %d\n", left.id, right.id));
        left.schedule(SchedulePrim.new(l_branch, scheduler).filterSubgraph(lsg), branch);
        right.schedule(SchedulePrim.new(r_branch, scheduler).filterSubgraph(rsg), branch);
        for (n = lsg.ls; n != null; n = n.tail) if (!IROp.Move.?(n.head.op))
            left.schedule(SchedulePrim.new(n.head, scheduler).filterSubgraph(lsg), branch);
        for (n = rsg.ls; n != null; n = n.tail) if (!IROp.Move.?(n.head.op))
            right.schedule(SchedulePrim.new(n.head, scheduler).filterSubgraph(rsg), branch);

        if (Strings.equal(scheduler.opcode, "IF") || Strings.equal(scheduler.opcode, "IF_ul")) {
            System.puts(Strings.format3("Scheduled phi %q (%d) before %d\n\n", phi.render, phi_node.id, id));
            CBDTrace.addString(scheduler.opcode, 
                            Strings.format1("sched %q", phi.render), "graph", scheduler.toMermaid());
        }

        return phi_node;
    }
}

class ScheduleBlock(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var prims: Vector<SchedulePrim> = Vector.new(); // we build these backwards, so they have to be reversed.
    var forward: bool = false;
    var prev: ScheduleNode = null;
    var next: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph block_").putd(id).puts("[\"Block ").putd(id).puts("\"]").ln();
        buf.tab().puts("direction TB").ln(); // works in interactive but not with cdn
        // Render IRNodes linearly within this block
        for (i < prims.length) {
            def prim = prims[i];
            prim.node.toMermaidNode(buf, Strings.format1("b%d_", id));
        }
        // Connect prims linearly
        for (i < prims.length) {
            if (i + 1 < prims.length) {
                buf.tab();
                if (!forward) {
                    buf.puts("b").putd(id).puts("_").putd(prims[i + 1].node.id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(id).puts("_").putd(prims[i].node.id).ln();
                } else {
                    buf.puts("b").putd(id).puts("_").putd(prims[i].node.id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(id).puts("_").putd(prims[i + 1].node.id).ln();
                }
            }
        }
        buf.puts("end").ln();
        // Edge to prev
        if (prev != null) {
            prev.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via prev
        if (prev != null) prev.toMermaid(buf, visited);
        return buf;
    }

    def reverse() {
         forward = !forward;
         prims.reverse();
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
}

class ScheduleBranch(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var condition: IRNode;
    var l_branch: ScheduleNode = null;
    var r_branch: ScheduleNode = null;
    var prev: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph branch_").putd(id).puts("[\"Branch ").putd(id).puts("\"]").ln();
        // Render the condition node
        if (condition != null) {
            condition.toMermaidNode(buf, Strings.format1("br%d_", id));
        }
        buf.ln().puts("end").ln();
        // Edge to prev
        if (prev != null) {
            prev.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via prev
        if (prev != null) prev.toMermaid(buf, visited);
        return buf;
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
 }

class SchedulePhi(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var source_branch: ScheduleBranch;
    var l_source: ScheduleNode = null;
    var r_source: ScheduleNode = null;
    var next: ScheduleNode = null;
    var phis: List<IRNode> = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(id)) return buf;
        visited[id] = void;
        buf.puts("subgraph phi_").putd(id).puts("[\"Phi ").putd(id).puts("\"]").ln();
        // Render phi nodes
        for (cur = phis; cur != null; cur = cur.tail) {
            def phi = cur.head;
            phi.toMermaidNode(buf, Strings.format1("p%d_", id));
        }
        buf.puts("end").ln();
        // Edges from l_source and r_source to this phi
        if (l_source != null) {
            l_source.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        if (r_source != null) {
            r_source.subgraphName(buf);
            buf.puts(" --> ");
            this.subgraphName(buf);
            buf.ln();
        }
        // Recurse backwards via l_source and r_source
        if (l_source != null) l_source.toMermaid(buf, visited);
        if (r_source != null) r_source.toMermaid(buf, visited);
        // Also recurse via source_branch
        if (source_branch != null) source_branch.toMermaid(buf, visited);
        return buf;
    }

    def fuseReadyPhi(prim: SchedulePrim) -> this {
        def phi = prim.node;
        def cond = phi.value_deps[0], l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];

        dominants.addLocal(phi);

        cond.init_move();
        scheduler.live.put(cond.move_true);
        scheduler.live.put(cond.move_false);

        l_source.dominants.addPrivate(cond.move_true);
        r_source.dominants.addPrivate(cond.move_false);

        phis = List.new(phi, phis);

        def lca = scheduler.sea.lca2(l_branch, r_branch);
        def lsg = scheduler.sea.subgraph2(lca, l_branch).with(cond.move_true).without(lca);
        def rsg = scheduler.sea.subgraph2(lca, r_branch).with(cond.move_false).without(lca);
        // def lcas = scheduler.sea.findTop(l_branch, r_branch);

        // var lsg = ImmNodeSet(null);
        // for (i < lcas.length) lsg = lsg.union(scheduler.sea.subgraph2(lcas[i], l_branch));
        // for (i < lcas.length) lsg = lsg.without(lcas[i]);
        // lsg = lsg.with(cond.move_true);

        // var rsg = ImmNodeSet(null);
        // for (i < lcas.length) rsg = rsg.union(scheduler.sea.subgraph2(lcas[i], r_branch));
        // for (i < lcas.length) rsg = rsg.without(lcas[i]);
        // rsg = rsg.with(cond.move_false);

        l_source.schedule(SchedulePrim.new(l_branch, scheduler).filterSubgraph(lsg), source_branch);
        r_source.schedule(SchedulePrim.new(r_branch, scheduler).filterSubgraph(rsg), source_branch);
        for (n = lsg.ls; n != null; n = n.tail) if (!IROp.Move.?(n.head.op))
            l_source.schedule(SchedulePrim.new(n.head, scheduler).filterSubgraph(lsg), source_branch);
        for (n = rsg.ls; n != null; n = n.tail) if (!IROp.Move.?(n.head.op))
            r_source.schedule(SchedulePrim.new(n.head, scheduler).filterSubgraph(rsg), source_branch);
    }
}

class SchedulePrim {
    var node: IRNode;
    var neededBefore: Vector<IRNode> = Vector.new();
    var scheduler: SeaScheduler;

    new(node, scheduler) {
        for (i < node.children.length) {
            def child = node.children[i];
            def live = scheduler.live.has(child);
            if (!live) continue;
            if (child.id == node.id) continue; // XXX: why does this happen?

            if ((IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op))
                && !(node.id == child.value_deps[0].id)
                && (node.id == child.value_deps[1].id || node.id == child.value_deps[2].id)) {
                def cond = child.value_deps[0];
                cond.init_move();
                if (node.id == child.value_deps[1].id) neededBefore.put(cond.move_true);
                if (node.id == child.value_deps[2].id) neededBefore.put(cond.move_false);
            } else {
                neededBefore.put(child);
            }
        }
    }

    def filterSubgraph(subgraph: ImmNodeSet) -> this {
        def new_needs = Vector<IRNode>.new();
        for (i < neededBefore.length) {
            def n = neededBefore[i];
            if (subgraph.has(n)) new_needs.put(n);
        }
        neededBefore = new_needs;
    }

    def renderSimple = node.render;

    def render(buf: StringBuilder) -> StringBuilder {
        buf.puts("{ ").putq(node.render).puts("; ");
        buf.puts("> [");
        for (i < neededBefore.length) {
            buf.putq(neededBefore[i].render);
            if (i + 1 < neededBefore.length) buf.puts(", ");
        }
        buf.puts("] }");
        return buf;
    }
}

def dedup(arr: Array<IRNode>) -> Array<IRNode> {
    def res = Vector<IRNode>.new();
    for (n in arr) {
        if (n == null) continue;
        var dup = false;
        for (i < res.length) dup |= res[i].id == n.id;
        if (!dup) res.put(n);
    }
    return res.copy();
}
