var sched_id: int = 0;
def fresh_id() -> int {
    sched_id += 1;
    return sched_id;
}

def trap();

class BranchLattice {
    var sea: Sea;
    var condition: IRNode;
    var frontier: ImmNodeSet;
    var l_subgraph: ImmNodeSet;
    var r_subgraph: ImmNodeSet;
    var phis: Vector<IRNode>;

    new(sea, condition, frontier, l_subgraph, r_subgraph, phis) {}

    def can_merge_branches(phi: IRNode) -> bool {
        def left = phi.value_deps[1], right = phi.value_deps[2];
        for (i < phis.length)
            if (sea.isDescendant(phi, phis[i]) || sea.isDescendant(phis[i], phi)) return false;

        // TODO: check cross deps between subgraphs ?

        return true;
    }

    def add_phi(phi: IRNode, partition: BranchPartition) -> this {
        phis.put(phi);
        frontier = frontier.union(partition.frontier);
        l_subgraph = l_subgraph.union(partition.l_subgraph);
        r_subgraph = r_subgraph.union(partition.r_subgraph);
        for (f in frontier.toArray(sea)) {
            l_subgraph = l_subgraph.without(f);
            r_subgraph = r_subgraph.without(f);
        }
    }
}

class SeaScheduler {
    var sea: Sea;
    var orig_sea: Sea;
    var mapping: NodeMap<IRNode>;
    var opcode: string = "";
    var live: NodeSet;
    var q: Vector<IRNode>;
    var q_idx: int;

    var top_node: IRNode;
    var bottom_node: IRNode;

    var bottom_block: ScheduleNode;
    var top_block: ScheduleNode;

    var branch_lattices: Vector<BranchLattice> = Vector.new();
    var branch_lattice_map: NodeMap<BranchLattice> = NodeMap<BranchLattice>.new();

    var trace_full: bool = false;
    var lowBounds: NodeMap<ScheduleNode> = NodeMap<ScheduleNode>.new();

    new(orig_sea, orig_top_node: IRNode, orig_bottom_node: IRNode) {
        def clone = Seas.clone(orig_sea);
        sea = clone.0;
        mapping = clone.1;

        sea.apply(void, SeaTransforms.addMoves);

        top_node = mapping[orig_top_node];
        bottom_node = mapping[orig_bottom_node];

        live = Seas.live(sea);
        // branch_lattices = Vector.new();
        // find_branch_lattices();
    }

    def find_branch_lattices() {
        live.apply(fun (n: IRNode) {
            if (!n.is_phi()) return;
            if (branch_lattice_map[n] != null) return;
            def cond = n.value_deps[0];

            def partition = sea.branch_partition(n);
            def frontier = partition.frontier, lsg = partition.l_subgraph, rsg = partition.r_subgraph;

            var dest_bl: BranchLattice = null;
            for (i < branch_lattices.length) {
                def bl = branch_lattices[i];
                if (bl.condition.id != cond.id) continue;

                if (bl.can_merge_branches(n)) {
                    dest_bl = bl;
                    break;
                }
            }

            if (dest_bl != null) {
                dest_bl.add_phi(n, partition);
            } else {
                dest_bl = BranchLattice.new(sea, cond, frontier, lsg, rsg, Vectors.of1(n));
                branch_lattices.put(dest_bl);
            }
            branch_lattice_map[n] = dest_bl;
        });
    }

    def toMermaid() -> string => SeaRender.toMermaidScheduler(this);

    def schedule() {
        if (opcode != null) CBDTrace.addGraph(opcode, "scheduler_start", sea);
        if (opcode != null && trace_full) CBDInfo.addString(opcode, "info_start", "", SeaRender.renderScheduler(this, StringBuilder.new()).toString());
        // if (opcode != null && Strings.startsWith(opcode, "I32_DIV_S")) trace_full = true;
        untangle();
        if (opcode != null) CBDTrace.addGraph(opcode, "untangled", sea);
        if (opcode != null && trace_full) CBDInfo.addString(opcode, "info_untangled", "", SeaRender.renderSchedulerUntangled(this, StringBuilder.new()).toString());
        q = Vector<IRNode>.new();
        q.put(bottom_node);

        q_idx = 0;
        while (q_idx < q.length) {
            // max successful idx (*_DIV_S): 1053
            if (q_idx > 1500) {
                System.puts(Strings.format1("ERROR: Scheduling %s reached limit\n", opcode));
                break;
            }

            var node = q[q_idx];
            q_idx += 1;

            if (node.is_move()) {
                for (d in node.deps()) q.put(d);
                continue;
            }

            // if (node.id == top_node.id && q_idx != q.length - 1) {
            //     continue;
            // }

            if (trace_full) System.puts(Strings.format2("Prim: %q, q length: %d\n", node.render, q.length - q_idx));

            // traverse existing schedule, put node in first available spot
            def lower_bound = if(lowBounds[node] != null, lowBounds[node], bottom_block);
            def dest_block = lower_bound.schedule(node, null);
            if (dest_block != null) {
                for (d in node.deps()) {
                    lowBounds[d] = dest_block;
                    q.put(d);
                }
            } else {
                q.put(node);
            }
        }


        live = Seas.live(sea);
        bottom_block.finalize();

        // check();
        if (opcode != null && trace_full) CBDInfo.addString(opcode, "info_final", "", SeaRender.renderSchedulerFinal(this, StringBuilder.new()).toString());
    }

    def isReady(node: IRNode, schedule_node: ScheduleNode) -> bool {
        live = Seas.live(sea);
        var ready = BoxedBool.new(true);

        if (IROp.Start.?(node.op)) {
            live.apply(fun (n: IRNode) {
                if (n.id != node.id && !n.is_move()) {
                    def has = schedule_node.dominants.has(n);
                    if (trace_full) System.puts(
                            Strings.format3("%s, have %s : %s\n", 
                                Strings.format1("Block %d", schedule_node.id),
                                Strings.format2("%q (%d)", n.render, n.id),
                                if(has, "YES", "NO")
                            ));
                    ready.v &= has;
                }
            });
            return ready.v;
        }

        var children = node.children;

        // phis aren't ready until every use of branch lattice scheduled
        if (branch_lattice_map.has(node)) {
            def group = branch_lattice_map[node];
            children = Vector.new();

            for (i < group.phis.length)
                children.putv(group.phis[i].children);
        }

        for (i < children.length) {
            def child = children[i];
            def live_flag = live.has(child);
            if (trace_full) System.puts(Strings.format2("child: %q, live: %s\n", child.render, if(live_flag, "YES", "NO")));
            if (!live_flag && !IROp.Move.?(child.op)) continue;
            if (child.id == node.id) continue;

            if (false && (IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op))
                && !(node.id == child.value_deps[0].id)
                && (node.id == child.value_deps[1].id || node.id == child.value_deps[2].id)) 
            {
                def cond = child.value_deps[0];
                cond.init_move(sea);
                if (node.id == child.value_deps[1].id) {
                    def has = schedule_node.dominants.has(cond.move_true);
                    if (trace_full) System.puts(
                            Strings.format3("%s, have %s : %s\n", 
                                Strings.format1("Block %d", schedule_node.id),
                                Strings.format2("%q (%d)", child.render, child.id),
                                if(has, "YES", "NO")
                            ));
                    ready.v &= has;
                }
                if (node.id == child.value_deps[2].id) {
                    def has = schedule_node.dominants.has(cond.move_false);
                    if (trace_full) System.puts(
                            Strings.format3("%s, have %s : %s\n", 
                                Strings.format1("Block %d", schedule_node.id),
                                Strings.format2("%q (%d)", child.render, child.id),
                                if(has, "YES", "NO")
                            ));
                    ready.v &= has;
                }
            } else {
                if (child.is_move() && child.value_deps[0].id == node.id) continue;
                def canon_child = child;
                def has = schedule_node.dominants.has(canon_child);
                if (trace_full) System.puts(
                        Strings.format3("%s, have %s : %s\n", 
                            Strings.format1("Block %d", schedule_node.id),
                            Strings.format2("%q (%d)", canon_child.render, canon_child.id),
                            if(has, "YES", "NO")
                        ));
                ready.v &= has;
            }
        }
        return ready.v;
    }

    def topo_sort_lattices() -> Vector<BranchLattice> {
        def n = branch_lattices.length;
        def dep_count = Array<int>.new(n);
        def dependents = Array<Vector<int>>.new(n);
        for (i < n) dependents[i] = Vector.new();

        // Build dependency graph: A depends on B if any of B's phis are in A's l_subgraph or r_subgraph
        for (i < n) {
            def a = branch_lattices[i];
            for (j < n) {
                if (i == j) continue;
                def b = branch_lattices[j];
                var depends = false;
                for (k < b.phis.length) {
                    def phi = b.phis[k];
                    if (a.l_subgraph.has(phi) || a.r_subgraph.has(phi)) {
                        depends = true;
                        break;
                    }
                }
                if (depends) {
                    dep_count[i]++;
                    dependents[j].put(i);
                }
            }
        }

        def result = Vector<BranchLattice>.new();
        def queue = Vector<int>.new();
        for (i < n) if (dep_count[i] == 0) queue.put(i);

        var idx = 0;
        while (idx < queue.length) {
            def cur = queue[idx];
            idx++;
            result.put(branch_lattices[cur]);
            for (k < dependents[cur].length) {
                def dep = dependents[cur][k];
                dep_count[dep]--;
                if (dep_count[dep] == 0) queue.put(dep);
            }
        }

        for (i < n) if (dep_count[i] > 0) result.put(branch_lattices[i]);

        return result;
    }

    def untangle() {
        var processed_conds = NodeSet.new();

        // Compute initial lattices
        branch_lattice_map = NodeMap<BranchLattice>.new();
        branch_lattices = Vector.new();
        live = Seas.live(sea);
        sea.rebuildChildren();
        find_branch_lattices();

        while (true) {
            def sorted = topo_sort_lattices();

            // Find next unprocessed leaf lattice
            var next_bl: BranchLattice = null;
            for (i < sorted.length) {
                def cond = sorted[i].condition;
                if (!processed_conds.has(cond)) {
                    next_bl = sorted[i];
                    break;
                }
            }
            if (next_bl == null) break;

            def bl = next_bl;
            processed_conds.put(bl.condition);

            if (trace_full) {
                System.puts(Strings.format2("bl for cond %q, frontier = %q\n", bl.condition.render, bl.frontier.renderFull(_, sea)));
                System.puts(Strings.format2("lsg: %q\nrsg: %q\n", bl.l_subgraph.renderFull(_, sea), bl.r_subgraph.renderFull(_, sea)));
            }

            // Clone left and right subgraphs
            def lsg_clone = Seas.cloneSubgraph(sea, bl.l_subgraph);
            def lsg_clone_mapping = lsg_clone.1;

            def rsg_clone = Seas.cloneSubgraph(sea, bl.r_subgraph);
            def rsg_clone_mapping = rsg_clone.1;

            lsg_clone_mapping.apply(fun (old: IRNode, neu: IRNode) { mapping[old] = neu; });
            rsg_clone_mapping.apply(fun (old: IRNode, neu: IRNode) { mapping[old] = neu; });

            for (j < bl.phis.length) {
                def phi = bl.phis[j];
                def l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];

                if (lsg_clone_mapping[l_branch] != null)
                    phi.replaceDep(l_branch, lsg_clone_mapping[l_branch]);

                if (rsg_clone_mapping[r_branch] != null)
                    phi.replaceDep(r_branch, rsg_clone_mapping[r_branch]);
            }

            // Recompute lattices after each step to avoid stale subgraphs
            live = Seas.live(sea);
            sea.rebuildChildren();
        branch_lattice_map = NodeMap<BranchLattice>.new();

            branch_lattices = Vector.new();
            find_branch_lattices();
        }
    }

    def check() {
        def sc = ScheduleChecker.new(top_block, bottom_block, orig_sea, sea, mapping);
        sc.check();
        def errors = sc.errors;
        if (errors.length > 0) {
            System.puts(Strings.format1("ERROR: Invalid schedule for %s\n", opcode));
            for (i < errors.length) System.puts(Strings.format2("%d: %q\n", i, errors[i].render));
        }
    }
}

component Scheduler {
    def of_full_sea(sea: Sea) -> SeaScheduler {
        sea.rebuildChildren();
        def s = SeaScheduler.new(sea, sea.start, sea.finish);
        def b = ScheduleBlock.new(fresh_id(), s);
        s.bottom_block = b;
        s.top_block = b;
        return s;
    }
}

class ScheduleNode(id: int, scheduler: SeaScheduler) {
    var dominants: DomGraph = DomGraph.new(); // set of the IRNodes dominated by this node

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder;
    def linkPrependedBlock(block: ScheduleBlock);

    def toSSAD() -> SSAD;

    def subgraphName(buf: StringBuilder) -> StringBuilder => SeaRender.subgraphNameScheduleNode(this, buf);

    def schedule(node: IRNode, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(node)) return this;

        if (scheduler.trace_full) {
            System.puts("attempting to schedule ");
            System.puts(Strings.format3("%q into %d\n\tdoms: %q\n", node.render, id, dominants.render));
        }

        def ready = scheduler.isReady(node, this);

        if (ready) {
            if (scheduler.trace_full) System.puts(Strings.format3("%q ready in %d\n\tdoms: %q\n", node.render, id, dominants.render));
            if (IROp.Phi.?(node.op) || IROp.StatePhi.?(node.op)) {
                return scheduleReadyPhi(node, upper_limit);
            } else {
                match (this) {
                    block: ScheduleBlock => {
                        block.prims.put(node);
                        block.dominants.addLocal(node);
                        if (scheduler.trace_full) {
                            System.puts(Strings.format2("Scheduled %q into %d\n\n", node.render, block.id));
                            CBDTrace.addString(scheduler.opcode, 
                                            Strings.format1("sched %q", node.render), "graph", scheduler.toMermaid());
                        }
                        return block;
                    }
                    cond: ScheduleBranch => {
                        if (cond.prev != null)
                            return cond.prev.schedule(node, upper_limit);
                        else
                            return cond.prependScheduleBlock(node);
                    }
                    phi: SchedulePhi => {
                        // XXX: maybe we shouldn't try each branch here? because uses after phi are not dominated
                        // by either branch
                        var dest_block: ScheduleNode = null;
                        dest_block = phi.l_source.schedule(node, phi.source_branch);
                        if (dest_block == null) dest_block = phi.r_source.schedule(node, phi.source_branch);
                        if (dest_block == null) dest_block = phi.source_branch.schedule(node, upper_limit);
                        return dest_block;
                    }
                    _ => return null; // unreachable
                }
            }
        } else {
            if (scheduler.trace_full) System.puts(Strings.format2("%q NOT ready in %d\n\n", node.render, id));
            match (this) {
                block: ScheduleBlock => {
                    return if(block.prev != null, block.prev.schedule(node, upper_limit));
                }
                cond: ScheduleBranch => {
                    // dest_block remains null if schedules fail
                    return if(cond.prev != null, cond.prev.schedule(node, upper_limit));
                }
                phi: SchedulePhi => {
                    // return phi.source_branch.schedule(node, upper_limit);
                    var dest_block = phi.l_source.schedule(node, phi.source_branch);
                    if (dest_block == null) dest_block = phi.r_source.schedule(node, phi.source_branch);
                    if (dest_block == null) dest_block = phi.source_branch.schedule(node, upper_limit);
                    return dest_block;
                }
                _ => return null; // unreachable
            }
        }
    }

    def scheduleReadyPhi(node: IRNode, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(node)) return this;

        def phi = node;
        match (this) {
            block: ScheduleBlock => return if(block.prev == null || ScheduleBranch.?(block.prev), block.prependScheduleBranch(node), block.prev.scheduleReadyPhi(node, upper_limit));
            cond: ScheduleBranch => {
                return if (cond.prev == null, cond.prependScheduleBranch(node), cond.prev.scheduleReadyPhi(node, upper_limit));
            }
            phi_node: SchedulePhi => {
                def phi_cond = phi.value_deps[0];
                if (phi_node.source_branch.condition.id == phi_cond.id) {
                    System.puts("ERROR: Fusing\n");
                    return null;
                } else {
                    // return phi_node.source_branch.schedule(node, upper_limit);
                    var dest_block = phi_node.l_source.schedule(node, upper_limit);
                    if (dest_block == null) dest_block = phi_node.r_source.schedule(node, upper_limit);
                    if (dest_block == null) dest_block = phi_node.source_branch.schedule(node, upper_limit);
                    return dest_block;
                }
            }
            _ => return null; // unreachable
        }
    }

    def prependScheduleBlock(node: IRNode) -> ScheduleBlock {
        def block = ScheduleBlock.new(fresh_id(), scheduler);
        if (scheduler.top_block.id == this.id) scheduler.top_block = block;

        var prev: ScheduleNode;
        match (this) {
            b: ScheduleBlock => prev = b.prev;
            b: ScheduleBranch => prev = b.prev;
            _ => {}
        }
        match (prev) {
            prev_block: ScheduleBlock => prev_block.next = block;
            prev_phi: SchedulePhi => prev_phi.next = block;
            prev_branch: ScheduleBranch => {
                if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = block;
                if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = block;
            }
        }

        linkPrependedBlock(block);

        block.dominants = dominants.newPrivChild();
        block.dominants.addLocal(node);

        block.prims.put(node);
        return block;
    }

    // traverses schedule graph, reverses blocks, and removes non-live nodes
    def finalize() {
        match (this) {
            block: ScheduleBlock => {
                if (!block.forward) block.reverse();
                def live_prims = Vector<IRNode>.new();
                for (i < block.prims.length) {
                    def n = block.prims[i];
                    if (scheduler.live.has(n)) live_prims.put(n);
                }
                block.prims = live_prims;
                if (block.prev != null) block.prev.finalize();
            }
            branch: ScheduleBranch => if (branch.prev != null) branch.prev.finalize();
            phi: SchedulePhi => {
                phi.source_branch.finalize();
                phi.l_source.finalize();
                phi.r_source.finalize();
            }
        }
    }

    def getSinglePrev() -> ScheduleNode {
        match (this) {
            block: ScheduleBlock => return block.prev;
            branch: ScheduleBranch => return branch.prev;
            _ => trap();
        }
        return null;
    }

    def setSinglePrev(newPrev: ScheduleNode) -> this {
        match (this) {
            block: ScheduleBlock => block.prev = newPrev;
            branch: ScheduleBranch => branch.prev = newPrev;
            _ => trap();
        }
    }

    def prependScheduleBranch(node: IRNode) -> SchedulePhi {
        //               prev
        //                |
        //              branch     (dominants all below)
        //             /      \
        //           left    right (dominants = this.dominants + phi + nodes in each branch)
        //             \      /
        //             phi_node (dominants = this.dominants)
        //                |
        //               this
        // System.puts(Strings.format1("prepending branch to %d\n", id));

        def cond = node.value_deps[0];
        cond.init_move(scheduler.sea);
        def bl = scheduler.branch_lattice_map[node];
        def branch = ScheduleBranch.new(fresh_id(), scheduler);
        def phi_node = SchedulePhi.new(fresh_id(), scheduler);

        if (scheduler.top_block.id == this.id) scheduler.top_block = branch;

        phi_node.next = this;
        phi_node.source_branch = branch;
        branch.phi = phi_node;

        def prev = getSinglePrev();
        if (prev != null) {
            match (prev) {
                block: ScheduleBlock => block.next = branch;
                phi: SchedulePhi => phi.next = branch;
                prev_branch: ScheduleBranch => {
                    if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = branch;
                    if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = branch;
                }
            }
        }

        branch.prev = prev;
        branch.condition = cond;

        setSinglePrev(phi_node);

        phi_node.dominants = dominants.newPrivChild();

        def left = ScheduleBlock.new(fresh_id(), scheduler);
        def right = ScheduleBlock.new(fresh_id(), scheduler);

        left.prev = right.prev = branch;
        phi_node.l_source = branch.l_branch = left;
        phi_node.r_source = branch.r_branch = right;

        left.dominants = DomGraph.new();
        right.dominants = DomGraph.new();
        branch.dominants = phi_node.dominants.newPrivChild().withParent(left.dominants).withParent(right.dominants);

        if (prev != null) prev.dominants = prev.dominants.withPrivParent(branch.dominants);

        for (i < bl.phis.length) {
            def phi = bl.phis[i];
            phi_node.dominants.addLocal(phi);
            phi_node.phis = List.new(phi, phi_node.phis);

            left.prims.put(phi.value_deps[1]);
            right.prims.put(phi.value_deps[2]);
            left.dominants.addLocal(phi.value_deps[1]);
            right.dominants.addLocal(phi.value_deps[2]);
        }

        if (scheduler.trace_full) {
            CBDTrace.addString(scheduler.opcode, 
                            Strings.format1("sched %q", bl.phis[0].render), "graph", scheduler.toMermaid());
        }

        return phi_node;
    }
}

class ScheduleBlock(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var prims: Vector<IRNode> = Vector.new(); // we build these backwards, so they have to be reversed.
    var forward: bool = false;
    var prev: ScheduleNode = null;
    var next: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidScheduleBlock(this, buf, visited);

    def toSSAD() -> SSAD {
        var res: SSAD = SSAD.Void;
        for (i < prims.length) {
            def node = prims[i];
            match (node.op) {
                Start, Finish, Move => {}
                Intrinsic(defn) => {
                    def args = Arrays.map(node.value_deps, fun (n: IRNode) => n.var_data.sourceName);
                    res = res.appended(SSAD.LetApp(node.var_data.sourceName, defn.name, args, SSAD.Void));
                }
                Lit(tipe, rep) => {
                    res = res.appended(SSAD.LetLit(node.var_data.sourceName, rep, tipe.long_str(), SSAD.Void));
                }
                Phi, StatePhi => {} // error
            }
        }

        if (prev != null) return prev.toSSAD().appended(res);
        else return res;
    }

    def reverse() {
         forward = !forward;
         prims.reverse();
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
}

class ScheduleBranch(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var condition: IRNode;
    var l_branch: ScheduleNode = null;
    var r_branch: ScheduleNode = null;
    var prev: ScheduleNode = null;
    var phi: SchedulePhi = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidScheduleBranch(this, buf, visited);

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }

    def toSSAD() -> SSAD {
        // the actual branch and prev is emitted by phi to ssad
        return SSAD.Void;
    }
}

class SchedulePhi(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var source_branch: ScheduleBranch;
    var l_source: ScheduleNode = null;
    var r_source: ScheduleNode = null;
    var next: ScheduleNode = null;
    var phis: List<IRNode> = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidSchedulePhi(this, buf, visited);

    def toSSAD() -> SSAD {
        def cond_name = source_branch.condition.var_data.sourceName;
        def left = l_source.toSSAD();
        def right = r_source.toSSAD();

        def phi_vec = Vector<(string, string)>.new();
        for (cur = phis; cur != null; cur = cur.tail) if (IROp.Phi.?(cur.head.op)) {
            def phi = cur.head;
            // Unwrap Move nodes: addMoves wraps phi deps as Move(cond, actual_value).
            // Move nodes are skipped in ScheduleBlock.toSSAD, so we must reference
            // the actual computation node (Move.value_deps[1]) as the phi source.
            var l = phi.value_deps[1];
            var r = phi.value_deps[2];
            if (l != null && IROp.Move.?(l.op) && l.value_deps.length > 1) l = l.value_deps[1];
            if (r != null && IROp.Move.?(r.op) && r.value_deps.length > 1) r = r.value_deps[1];
            if (l != null) phi_vec.put((phi.var_data.sourceName, l.var_data.sourceName));
            if (r != null) phi_vec.put((phi.var_data.sourceName, r.var_data.sourceName));
        }

        var prev_ssad = if(source_branch.prev != null, source_branch.prev.toSSAD(), SSAD.Void);
        // Inject var declarations for phi destinations before the if, matching SearchSchedule
        // behavior. Track declared names to avoid duplicate declarations.
        def declared = Vector<string>.new();
        for (cur = phis; cur != null; cur = cur.tail) if (IROp.Phi.?(cur.head.op)) {
            def phi = cur.head;
            def phi_name = phi.var_data.sourceName;
            var already = false;
            for (i < declared.length) already |= Strings.equal(declared[i], phi_name);
            if (!already) {
                declared.put(phi_name);
                prev_ssad = prev_ssad.appended(SSAD.Injected(
                    Strings.format2("var %s: %s;", phi_name, phi.var_data.tipe.long_str()),
                    SSAD.Void));
            }
        }
        return prev_ssad.appended(SSAD.If(cond_name, left, right, phi_vec.copy(), SSAD.Void));
    }
}

class BoxedBool { 
    var v: bool;
    new(v) {}
}
