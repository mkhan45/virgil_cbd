var sched_id: int = 0;
def fresh_id() -> int {
    sched_id += 1;
    return sched_id;
}

def trap();

class BranchLattice {
    var sea: Sea;
    var condition: IRNode;
    var frontier: ImmNodeSet;
    var l_subgraph: ImmNodeSet;
    var r_subgraph: ImmNodeSet;
    var phis: Vector<IRNode>;

    var move_true: IRNode;
    var move_false: IRNode;

    new(sea, condition, frontier, l_subgraph, r_subgraph, phis) {
        condition.init_move(sea);
        move_true = condition.move_true;
        move_false = condition.move_false;
        // move_true = phis[0].value_deps[1];
        // move_false = phis[0].value_deps[2];
    }

    def can_merge_branches(phi: IRNode) -> bool {
        def left = phi.value_deps[1], right = phi.value_deps[2];
        for (i < phis.length)
            if (sea.isDescendant(phi, phis[i]) || sea.isDescendant(phis[i], phi)) return false;

        // TODO: check cross deps between subgraphs ?

        return true;
    }

    def add_phi(phi: IRNode, partition: BranchPartition) -> this {
        phis.put(phi);
        frontier = frontier.union(partition.frontier);
        l_subgraph = l_subgraph.union(partition.l_subgraph);
        r_subgraph = r_subgraph.union(partition.r_subgraph);
        for (f in frontier.toArray(sea)) {
            l_subgraph = l_subgraph.without(f);
            r_subgraph = r_subgraph.without(f);
        }

        for (d in phi.value_deps[1].deps()) move_true.value_deps = Arrays.append(d, move_true.value_deps);
        for (d in phi.value_deps[2].deps()) move_false.value_deps = Arrays.append(d, move_false.value_deps);
    }
}

class SeaScheduler {
    var sea: Sea;
    var orig_sea: Sea;
    var mapping: HashMap<IRNode, IRNode>;
    var opcode: string = "";
    var trace_full: bool = false;
    var live: NodeSet;
    var q: Vector<SchedulePrim>;
    var q_idx: int;

    var top_node: IRNode;
    var bottom_node: IRNode;

    var bottom_block: ScheduleNode;
    var top_block: ScheduleNode;

    var branch_lattices: Vector<BranchLattice> = Vector.new();
    var branch_lattice_map: HashMap<IRNode, BranchLattice> = HashMap.new(IRNode.hash, IRNode.eq);

    new(orig_sea, orig_top_node: IRNode, orig_bottom_node: IRNode) {
        def clone = Seas.clone(orig_sea);
        sea = clone.0;
        mapping = clone.1;

        // mapping.apply(fun (k: IRNode, v: IRNode) {
        //     def s1 = Strings.format2("%q (%d)", k.render, k.id);
        //     def s2 = Strings.format2("%q (%d)", v.render, v.id);
        //     System.puts(Strings.format2("mapping: %s -> %s\n", s1, s2));
        // });

        sea.apply(void, SeaTransforms.addMoves);

        top_node = mapping[orig_top_node];
        bottom_node = mapping[orig_bottom_node];

        live = Seas.live(sea);
        find_branch_lattices();
    }

    def find_branch_lattices() {
        branch_lattices = Vector.new();

        live.apply(fun (n: IRNode) {
            if (!n.is_phi()) return;
            def cond = n.value_deps[0];

            def partition = sea.branch_partition(n);
            def frontier = partition.frontier, lsg = partition.l_subgraph, rsg = partition.r_subgraph;

            var dest_bl: BranchLattice = null;
            for (i < branch_lattices.length) {
                def bl = branch_lattices[i];
                if (bl.condition.id != cond.id) continue;

                if (bl.can_merge_branches(n)) {
                    dest_bl = bl;
                    break;
                }
            }

            if (dest_bl != null) {
                dest_bl.add_phi(n, partition);
            } else {
                dest_bl = BranchLattice.new(sea, cond, frontier, lsg, rsg, Vectors.of1(n));
                branch_lattices.put(dest_bl);
            }
            branch_lattice_map[n] = dest_bl;
        });
    }

    def toMermaid() -> string => SeaRender.toMermaidScheduler(this);

    def schedule() {
        if (opcode != null) CBDTrace.addGraph(opcode, "scheduler_start", sea);
        if (opcode != null && Strings.equal(opcode, "IF_ul")) trace_full = true;
        q = Vector<SchedulePrim>.new();
        q.put(SchedulePrim.new(bottom_node, this));

        q_idx = 0;
        while (q_idx < q.length) {
            if (q_idx > 2500) {
                System.puts(Strings.format1("ERROR: Scheduling %s reached limit\n", opcode));
                break;
            }

            var prim = q[q_idx];


            prim = SchedulePrim.new(prim.node, this);
            q_idx += 1;

            // if (prim.node.id == top_node.id && q_idx != q.length - 1) {
            //     continue;
            // }

            // System.puts(Strings.format2("Prim: %q, q length: %d\n", prim.node.render, q.length - q_idx));

            // traverse existing schedule, put prim in first available spot
            def lower_bound = if(prim.lowBound != null, prim.lowBound, bottom_block);
            var upper_bound = prim.highBound;
            def dest_block = lower_bound.schedule(prim, upper_bound);
            if (dest_block != null) {
                if (prim.node.is_phi()) {
                    def bl = branch_lattice_map[prim.node];
                    bl.l_subgraph.apply(sea, fun (n: IRNode) { if (!IROp.Move.?(n.op)) {
                            System.puts(Strings.format1("adding dep from bl: %q\n", n.render));
                            q.put(SchedulePrim.new(n, this).boundLow(dest_block));  }
                    });
                    bl.r_subgraph.apply(sea, fun (n: IRNode) { if (!IROp.Move.?(n.op)) q.put(SchedulePrim.new(n, this).boundLow(dest_block)); });
                    q.put(SchedulePrim.new(bl.condition, this).boundLow(dest_block));
                } else {
                    for (d in prim.node.deps()) if (!IROp.Move.?(d.op)) q.put(SchedulePrim.new(d, this).boundLow(dest_block));
                }
            } else {
                q.put(prim);
            }
        }


        live = Seas.live(sea);
        bottom_block.finalize();

        check();
    }

    def check() {
        def sc = ScheduleChecker.new(top_block, bottom_block, orig_sea, sea, mapping);
        sc.check();
        def errors = sc.errors;
        if (errors.length > 0) {
            System.puts(Strings.format1("ERROR: Invalid schedule for %s\n", opcode));
            for (i < errors.length) System.puts(Strings.format2("%d: %q\n", i, errors[i].render));
        }
    }
}

component Scheduler {
    def of_full_sea(sea: Sea) -> SeaScheduler {
        sea.rebuildChildren();
        def s = SeaScheduler.new(sea, sea.start, sea.finish);
        def b = ScheduleBlock.new(fresh_id(), s);
        s.bottom_block = b;
        s.top_block = b;
        return s;
    }
}

class ScheduleNode(id: int, scheduler: SeaScheduler) {
    var dominants: DomGraph = DomGraph.new(); // set of the IRNodes dominated by this node

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder;
    def linkPrependedBlock(block: ScheduleBlock);

    def toSSAD() -> SSAD;

    def subgraphName(buf: StringBuilder) -> StringBuilder => SeaRender.subgraphNameScheduleNode(this, buf);

    def schedule(prim: SchedulePrim, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(prim.node)) return this;

        if (scheduler.trace_full) {
            System.puts("attempting to schedule ");
            System.puts(Strings.format3("%q into %d\n\tdoms: %q\n", prim.render, id, dominants.render));
        }

        def ready = prim.isReady(this);
        for (i < prim.neededBefore.length) {
            def entry = prim.neededBefore[i];
            if (scheduler.trace_full) {
                if (!entry.1) System.puts(Strings.format2("Missing: %q (%d)\n", entry.0.render, entry.0.id));
                else System.puts(Strings.format1("Have: %q\n", entry.0.render));
            }
        }

        if (ready) {
            if (scheduler.trace_full) System.puts(Strings.format3("%q ready in %d\n\tdoms: %q\n", prim.render, id, dominants.render));
            if (IROp.Phi.?(prim.node.op) || IROp.StatePhi.?(prim.node.op)) {
                return scheduleReadyPhi(prim, upper_limit);
            } else {
                match (this) {
                    block: ScheduleBlock => {
                        block.prims.put(prim);
                        block.dominants.addLocal(prim.node);
                        if (scheduler.trace_full) {
                            System.puts(Strings.format2("Scheduled %q into %d\n\n", prim.render, block.id));
                            CBDTrace.addString(scheduler.opcode, 
                                            Strings.format1("sched %q", prim.renderSimple), "graph", scheduler.toMermaid());
                        }
                        return block;
                    }
                    cond: ScheduleBranch => {
                        if (cond.prev != null)
                            return cond.prev.schedule(prim, upper_limit);
                        else
                            return cond.prependScheduleBlock(prim);
                    }
                    phi: SchedulePhi => {
                        // XXX: maybe we shouldn't try each branch here? because uses after phi are not dominated
                        // by either branch
                        var dest_block: ScheduleNode = null;
                        dest_block = phi.l_source.schedule(prim, phi.source_branch);
                        if (dest_block == null) dest_block = phi.r_source.schedule(prim, phi.source_branch);
                        if (dest_block == null) dest_block = phi.source_branch.schedule(prim, upper_limit);
                        return dest_block;
                    }
                    _ => return null; // unreachable
                }
            }
        } else {
            if (scheduler.trace_full) System.puts(Strings.format2("%q NOT ready in %d\n\n", prim.render, id));
            match (this) {
                block: ScheduleBlock => {
                    return if(block.prev != null, block.prev.schedule(prim, upper_limit));
                }
                cond: ScheduleBranch => {
                    // dest_block remains null if schedules fail
                    return if(cond.prev != null, cond.prev.schedule(prim, upper_limit));
                }
                phi: SchedulePhi => {
                    // return phi.source_branch.schedule(prim, upper_limit);
                    var dest_block = phi.l_source.schedule(prim, phi.source_branch);
                    if (dest_block == null) dest_block = phi.r_source.schedule(prim, phi.source_branch);
                    if (dest_block == null) dest_block = phi.source_branch.schedule(prim, upper_limit);
                    return dest_block;
                }
                _ => return null; // unreachable
            }
        }
    }

    def scheduleReadyPhi(prim: SchedulePrim, upper_limit: ScheduleNode) -> ScheduleNode {
        if (upper_limit != null && this.id == upper_limit.id) return null;
        if (dominants.has(prim.node)) return this;

        def phi = prim.node;
        match (this) {
            block: ScheduleBlock => return if(block.prev == null || ScheduleBranch.?(block.prev), block.prependScheduleBranch(prim), block.prev.scheduleReadyPhi(prim, upper_limit));
            cond: ScheduleBranch => {
                return if (cond.prev == null, cond.prependScheduleBranch(prim), cond.prev.scheduleReadyPhi(prim, upper_limit));
            }
            phi_node: SchedulePhi => {
                def phi_cond = phi.value_deps[0];
                if (phi_node.source_branch.condition.id == phi_cond.id) {
                    System.puts("ERROR: Fusing\n");
                    return null;
                } else {
                    // return phi_node.source_branch.schedule(prim, upper_limit);
                    var dest_block = phi_node.l_source.schedule(prim, upper_limit);
                    if (dest_block == null) dest_block = phi_node.r_source.schedule(prim, upper_limit);
                    if (dest_block == null) dest_block = phi_node.source_branch.schedule(prim, upper_limit);
                    return dest_block;
                }
            }
            _ => return null; // unreachable
        }
    }

    def prependScheduleBlock(prim: SchedulePrim) -> ScheduleBlock {
        def block = ScheduleBlock.new(fresh_id(), scheduler);
        if (scheduler.top_block.id == this.id) scheduler.top_block = block;

        var prev: ScheduleNode;
        match (this) {
            b: ScheduleBlock => prev = b.prev;
            b: ScheduleBranch => prev = b.prev;
            _ => {}
        }
        match (prev) {
            prev_block: ScheduleBlock => prev_block.next = block;
            prev_phi: SchedulePhi => prev_phi.next = block;
            prev_branch: ScheduleBranch => {
                if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = block;
                if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = block;
            }
        }

        linkPrependedBlock(block);

        block.dominants = dominants.newPrivChild();
        block.dominants.addLocal(prim.node);

        block.prims.put(prim);
        return block;
    }

    // traverses schedule graph, reverses blocks, and removes non-live nodes
    def finalize() {
        match (this) {
            block: ScheduleBlock => {
                if (!block.forward) block.reverse();
                def live_prims = Vector<SchedulePrim>.new();
                for (i < block.prims.length) {
                    def prim = block.prims[i];
                    if (true || scheduler.live.has(prim.node)) live_prims.put(prim);
                }
                block.prims = live_prims;
                if (block.prev != null) block.prev.finalize();
            }
            branch: ScheduleBranch => if (branch.prev != null) branch.prev.finalize();
            phi: SchedulePhi => {
                phi.source_branch.finalize();
                phi.l_source.finalize();
                phi.r_source.finalize();
            }
        }
    }

    def getSinglePrev() -> ScheduleNode {
        match (this) {
            block: ScheduleBlock => return block.prev;
            branch: ScheduleBranch => return branch.prev;
            _ => trap();
        }
        return null;
    }

    def setSinglePrev(newPrev: ScheduleNode) -> this {
        match (this) {
            block: ScheduleBlock => block.prev = newPrev;
            branch: ScheduleBranch => branch.prev = newPrev;
            _ => trap();
        }
    }

    def prependScheduleBranch(prim: SchedulePrim) -> SchedulePhi {
        //               prev
        //                |
        //              branch     (dominants all below)
        //             /      \
        //           left    right (dominants = this.dominants + phi + nodes in each branch)
        //             \      /
        //             phi_node (dominants = this.dominants)
        //                |
        //               this
        // System.puts(Strings.format1("prepending branch to %d\n", id));
        def cond = prim.node.value_deps[0];
        scheduler.find_branch_lattices();
        def bl = scheduler.branch_lattice_map[prim.node];
        def branch = ScheduleBranch.new(fresh_id(), scheduler);
        def phi_node = SchedulePhi.new(fresh_id(), scheduler);

        if (scheduler.top_block.id == this.id) scheduler.top_block = branch;

        phi_node.next = this;
        phi_node.source_branch = branch;
        branch.phi = phi_node;

        def prev = getSinglePrev();
        if (prev != null) {
            match (prev) {
                block: ScheduleBlock => block.next = branch;
                phi: SchedulePhi => phi.next = branch;
                prev_branch: ScheduleBranch => {
                    if (prev_branch.l_branch.id == this.id) prev_branch.l_branch = branch;
                    if (prev_branch.r_branch.id == this.id) prev_branch.r_branch = branch;
                }
            }
        }

        branch.prev = prev;
        branch.condition = cond;

        setSinglePrev(phi_node);

        phi_node.dominants = dominants.newPrivChild();

        def left = ScheduleBlock.new(fresh_id(), scheduler);
        def right = ScheduleBlock.new(fresh_id(), scheduler);

        left.prev = right.prev = branch;
        phi_node.l_source = branch.l_branch = left;
        phi_node.r_source = branch.r_branch = right;

        left.dominants = DomGraph.new();
        right.dominants = DomGraph.new();
        branch.dominants = phi_node.dominants.newPrivChild().withParent(left.dominants).withParent(right.dominants);

        if (prev != null) prev.dominants = prev.dominants.withPrivParent(branch.dominants);

        left.dominants.addPrivate(bl.move_true);
        // left.prims.put(SchedulePrim.new(bl.move_true, scheduler));
        right.dominants.addPrivate(bl.move_false);
        // right.prims.put(SchedulePrim.new(bl.move_false, scheduler));

        for (i < bl.phis.length) {
            def phi = bl.phis[i];
            phi_node.dominants.addLocal(phi);
            phi_node.phis = List.new(phi, phi_node.phis);
        }

        // Clone left/right subgraphs
        def lsg = bl.l_subgraph;
        def lsg_clone = Seas.cloneSubgraph(scheduler.sea, lsg);
        def lsg_clone_sg = lsg_clone.0;
        def lsg_clone_mapping = lsg_clone.1;

        def rsg = bl.r_subgraph;
        def rsg_clone = Seas.cloneSubgraph(scheduler.sea, rsg);
        def rsg_clone_sg = rsg_clone.0;
        def rsg_clone_mapping = rsg_clone.1;

        scheduler.sea.rebuildChildren();
        lsg_clone_mapping.apply(fun (k: IRNode, v: IRNode) => void(scheduler.mapping[k] = v));
        rsg_clone_mapping.apply(fun (k: IRNode, v: IRNode) => void(scheduler.mapping[k] = v));

        // rewire dependencies and add new nodes to live
        for (i < bl.phis.length) {
            def phi = bl.phis[i];
            def l_branch = phi.value_deps[1], r_branch = phi.value_deps[2];

            // System.puts(Strings.format1("HERE: replacing deps of phi %q:\n", phi.render));

            if (lsg_clone_mapping[l_branch] != null)
            for (j < l_branch.children.length) {
                def child = l_branch.children[j];
                child.replaceDep(l_branch, lsg_clone_mapping[l_branch]);
                // System.puts(Strings.format3("\tLeft Child %q: %q -> %q\n", child.render, l_branch.render, lsg_clone_mapping[l_branch].render));
            }

            if (rsg_clone_mapping[r_branch] != null)
            for (j < r_branch.children.length) {
                def child = r_branch.children[j];
                child.replaceDep(r_branch, rsg_clone_mapping[r_branch]);
            }
        }

        // rebuild metadata from scratch
        scheduler.live = Seas.live(scheduler.sea);
        scheduler.sea.rebuildChildren();

        CBDTrace.addGraph(scheduler.opcode, Strings.format1("post_surgery %d", phi_node.id), scheduler.sea);
        // System.puts(Strings.format2("lsg: %q\nrsg: %q\n", lsg.render, rsg.render));

        if (scheduler.trace_full) {
            // System.puts(Strings.format3("Scheduled phi %q (%d) before %d\n\n", phi.render, phi_node.id, id));
            CBDTrace.addString(scheduler.opcode, 
                            Strings.format1("sched %q", bl.phis[0].render), "graph", scheduler.toMermaid());
        }

        return phi_node;
    }
}

class ScheduleBlock(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var prims: Vector<SchedulePrim> = Vector.new(); // we build these backwards, so they have to be reversed.
    var forward: bool = false;
    var prev: ScheduleNode = null;
    var next: ScheduleNode = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidScheduleBlock(this, buf, visited);

    def toSSAD() -> SSAD {
        var res: SSAD = SSAD.Void;
        for (i < prims.length) {
            def node = prims[i].node;
            match (node.op) {
                Start, Finish, Move => {}
                Intrinsic(defn) => {
                    def args = Arrays.map(node.value_deps, fun (n: IRNode) => n.var_data.sourceName);
                    res = res.appended(SSAD.LetApp(node.var_data.sourceName, defn.name, args, SSAD.Void));
                }
                Lit(tipe, rep) => {
                    res = res.appended(SSAD.LetLit(node.var_data.sourceName, rep, tipe.long_str(), SSAD.Void));
                }
                Phi, StatePhi => {} // error
            }
        }

        if (prev != null) return prev.toSSAD().appended(res);
        else return res;
    }

    def reverse() {
         forward = !forward;
         prims.reverse();
    }

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }
}

class ScheduleBranch(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var condition: IRNode;
    var l_branch: ScheduleNode = null;
    var r_branch: ScheduleNode = null;
    var prev: ScheduleNode = null;
    var phi: SchedulePhi = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidScheduleBranch(this, buf, visited);

    def linkPrependedBlock(block: ScheduleBlock) {
        block.prev = prev;
        block.next = this;
        prev = block;
    }

    def toSSAD() -> SSAD {
        // the actual branch and prev is emitted by phi to ssad
        return SSAD.Void;
    }
}

class SchedulePhi(uid: int, scheduler_: SeaScheduler) extends ScheduleNode(uid, scheduler_) {
    var source_branch: ScheduleBranch;
    var l_source: ScheduleNode = null;
    var r_source: ScheduleNode = null;
    var next: ScheduleNode = null;
    var phis: List<IRNode> = null;

    def toMermaid(buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder => SeaRender.toMermaidSchedulePhi(this, buf, visited);

    def toSSAD() -> SSAD {
        def cond_name = source_branch.condition.var_data.sourceName;
        def left = l_source.toSSAD();
        def right = r_source.toSSAD();

        def phi_vec = Vector<(string, string)>.new();
        for (cur = phis; cur != null; cur = cur.tail) if (IROp.Phi.?(cur.head.op)) {
            def phi = cur.head;
            def l = phi.value_deps[1];
            def r = phi.value_deps[2];
            if (l != null) phi_vec.put((phi.var_data.sourceName, l.var_data.sourceName));
            if (r != null) phi_vec.put((phi.var_data.sourceName, r.var_data.sourceName));
        }

        def prev_ssad = if(source_branch.prev != null, source_branch.prev.toSSAD(), SSAD.Void);
        return prev_ssad.appended(SSAD.If(cond_name, left, right, phi_vec.copy(), SSAD.Void));
    }
}

class BoxedBool { 
    var v: bool;
    new(v) {}
}

class SchedulePrim {
    var node: IRNode;
    var neededBefore: Vector<(IRNode, bool)> = Vector.new();
    var scheduler: SeaScheduler;
    var lowBound: ScheduleNode;
    var highBound: ScheduleNode;

    new(n: IRNode, scheduler) {
        node = scheduler.mapping[n];
        if (node == null) node = n;
        // else {
        //     def s1 = Strings.format2("%q (%d)", n.render, n.id);
        //     def s2 = Strings.format2("%q (%d)", node.render, node.id);
        //     System.puts(Strings.format2("mapping: %s -> %s\n", s1, s2));
        // }
    }

    def boundLow(s: ScheduleNode) -> this { lowBound = s; }
    def boundHigh(s: ScheduleNode) -> this { highBound = s; }

    def isReady(schedule_node: ScheduleNode) -> bool {
        scheduler.live = Seas.live(scheduler.sea);
        neededBefore = Vector.new();
        var ready = BoxedBool.new(true);

        if (IROp.Start.?(node.op)) {
            scheduler.live.apply(fun (n: IRNode) {
                if (n.id != node.id && !IROp.Move.?(n.op)) {
                    def has = schedule_node.dominants.has(n);
                    neededBefore.put((n, has));
                    ready.v &= has;
                }
            });
            return ready.v;
        }

        var children = node.children;
        // if (scheduler.branch_lattice_map.has(node)) {
        //     def group = scheduler.branch_lattice_map[node];
        //     children = Vector.new();

        //     for (i < group.phis.length)
        //         for (j < group.phis[i].children.length) if (!IROp.Move.?(group.phis[i].children[j].op))
        //             children.put(group.phis[i].children[j]);

        //     // children.put(group.condition);
        //     // children.put(group.move_true);
        //     // children.put(group.move_false);
        // }

        for (i < children.length) {
            def child = children[i];
            def live = scheduler.live.has(child);
            if (!live && !IROp.Move.?(child.op)) continue;
            if (child.id == node.id) continue;

            if (IROp.Move.?(child.op)) {
                if (!scheduler.live.has(child.children[0])) continue;
                def branch = IROp.Move.!(child.op).val;
                def cond = child.value_deps[0];
                if (node.id == cond.id) continue;
                def canon = if(branch, cond.move_true, cond.move_false);
                def has = schedule_node.dominants.has(canon);
                neededBefore.put((canon, has));
                ready.v &= has;
            }
            else if ((IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op))
                && !(node.id == child.value_deps[0].id)
                && (node.id == child.value_deps[1].id || node.id == child.value_deps[2].id)) 
            {
                def cond = child.value_deps[0];
                cond.init_move(scheduler.sea);
                if (node.id == child.value_deps[1].id) {
                    def has = schedule_node.dominants.has(cond.move_true);
                    neededBefore.put((cond.move_true, has));
                    ready.v &= has;
                }
                if (node.id == child.value_deps[2].id) {
                    def has = schedule_node.dominants.has(cond.move_false);
                    neededBefore.put((cond.move_false, has));
                    ready.v &= has;
                }
            }
            else {
                def has = schedule_node.dominants.has(child);
                neededBefore.put((child, has));
                ready.v &= has;
            }
        }
        return ready.v;
    }

    def renderSimple(sb: StringBuilder) => SeaRender.renderSimpleSchedulePrim(this, sb);
    def render(buf: StringBuilder) -> StringBuilder => SeaRender.renderSchedulePrim(this, buf);
}
