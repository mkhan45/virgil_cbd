class NodeSet {
    var nodes: Array<IRNode> = Array.new(32);

    def has(node: IRNode) -> bool {
        if (node == null || node.id < 0 || node.id >= nodes.length) return false;
        return nodes[node.id] != null;
    }

    def put(node: IRNode) -> this {
        if (node == null || node.id < 0) return;
        if (node.id >= nodes.length) nodes = Arrays.grow(nodes, node.id * 2);
        nodes[node.id] = node;
    }

    def remove(node: IRNode) -> this {
        if (node != null && node.id >= 0 && node.id < nodes.length) nodes[node.id] = null;
    }

    def apply(f: IRNode -> void) {
        for (i < nodes.length) if (nodes[i] != null) f(nodes[i]);
    }

    def toVector() -> Vector<IRNode> {
        def buf = Vector<IRNode>.new();
        apply(fun (n: IRNode) { buf.put(n); });
        return buf;
    }

    def intersection(other: NodeSet) -> NodeSet {
        def result = NodeSet.new();
        apply(fun (node: IRNode) { if (other.has(node)) result.put(node); });
        return result;
    }
}

type ImmNodeSet(bits: Array<u64>, capacity: int) #unboxed {
    def has(n: IRNode) -> bool #inline {
        if (n.id < 0 || n.id >= capacity) return false;
        def idx = n.id >>> 6;
        def mask = 1uL << u6.view(n.id);
        return (bits[idx] & mask) != 0;
    }

    def with(n: IRNode) -> ImmNodeSet {
        if (n.id < 0) return this;
        if (has(n)) return this;

        var newCap = capacity;
        var newBits: Array<u64>;
        if (n.id >= capacity) {
            newCap = if(capacity * 2 > n.id + 1, capacity * 2, n.id + 1);
            def newLen = (newCap + 63) >>> 6;
            newBits = Array<u64>.new(newLen);
            for (i < bits.length) newBits[i] = bits[i];
        } else {
            newBits = Arrays.dup(bits);
        }

        def idx = n.id >>> 6;
        newBits[idx] = newBits[idx] | (1uL << u6.view(n.id));
        return ImmNodeSet(newBits, newCap);
    }

    def without(n: IRNode) -> ImmNodeSet {
        if (!has(n)) return this;
        def newBits = Arrays.dup(bits);
        def idx = n.id >>> 6;
        newBits[idx] = newBits[idx] & ~(1uL << u6.view(n.id));
        return ImmNodeSet(newBits, capacity);
    }

    def withoutAll(other: ImmNodeSet) -> ImmNodeSet {
        def minLen = if(bits.length < other.bits.length, bits.length, other.bits.length);
        def newBits = Arrays.dup(bits);
        for (i < minLen) newBits[i] = newBits[i] & ~other.bits[i];
        return ImmNodeSet(newBits, capacity);
    }

    def intersects(other: ImmNodeSet) -> bool #inline {
        def minLen = if(bits.length < other.bits.length, bits.length, other.bits.length);
        for (i < minLen) if ((bits[i] & other.bits[i]) != 0) return true;
        return false;
    }

    // this intersects (included - excluded)
    def intersectsDifference(included: ImmNodeSet, excluded: ImmNodeSet) -> bool #inline {
        def minLen = if(bits.length < included.bits.length, bits.length, included.bits.length);
        for (i < minLen) {
            var word = bits[i] & included.bits[i];
            if (i < excluded.bits.length) word = word & ~excluded.bits[i];
            if (word != 0uL) return true;
        }
        return false;
    }

    def intersection(other: ImmNodeSet) -> ImmNodeSet {
        def minLen = if(bits.length < other.bits.length, bits.length, other.bits.length);
        def newBits = Array<u64>.new(minLen);
        for (i < minLen) newBits[i] = bits[i] & other.bits[i];
        def newCap = if(capacity < other.capacity, capacity, other.capacity);
        return ImmNodeSet(newBits, newCap);
    }

    def union(other: ImmNodeSet) -> ImmNodeSet {
        def maxLen = if(bits.length > other.bits.length, bits.length, other.bits.length);
        def minLen = if(bits.length < other.bits.length, bits.length, other.bits.length);
        def newBits = Array<u64>.new(maxLen);

        for (i < minLen) newBits[i] = bits[i] | other.bits[i];
        for (i = minLen; i < bits.length; i++) newBits[i] = bits[i];
        for (i = minLen; i < other.bits.length; i++) newBits[i] = other.bits[i];

        def newCap = if(capacity > other.capacity, capacity, other.capacity);
        return ImmNodeSet(newBits, newCap);
    }

    def apply(sea: Sea, f: IRNode -> void) {
        for (i < bits.length) {
            var word = bits[i];
            var id = i << 6;
            while (word != 0) {
                if ((word & 1uL) != 0uL) f(sea.nodes_by_id[id]);
                word >>>= 1;
                id++;
            }
        }
    }

    def applyIds(f: int -> void) {
        for (i < bits.length) {
            var word = bits[i];
            var id = i << 6;
            while (word != 0) {
                if ((word & 1uL) != 0uL) f(id);
                word >>>= 1;
                id++;
            }
        }
    }

    def toArray(sea: Sea) -> Array<IRNode> {
        def result = Vector<IRNode>.new();
        for (i < bits.length) {
            var word = bits[i];
            var id = i << 6;
            while (word != 0) {
                if ((word & 1uL) != 0uL) result.put(sea.nodes_by_id[id]);
                word >>>= 1;
                id++;
            }
        }
        return result.extract();
    }

    def count() -> int {
        var result = 0;
        for (i < bits.length) {
            var word = bits[i];
            while (word != 0) {
                if ((word & 1uL) != 0uL) result += 1;
                word >>>= 1;
            }
        }
        return result;
    }

    def eq(rhs: ImmNodeSet) -> bool {
        def max_len = if(bits.length > rhs.bits.length, bits.length, rhs.bits.length);
        for (i < max_len) {
            def l = if(i < bits.length, bits[i], 0uL);
            def r = if(i < rhs.bits.length, rhs.bits[i], 0uL);
            if (l != r) return false;
        }
        return true;
    }

    def isEmpty() -> bool #inline {
        for (i < bits.length) if (bits[i] != 0uL) return false;
        return true;
    }

    def render(sb: StringBuilder) -> StringBuilder {
        sb.puts("{");
        var first = Array<bool>.new(1);
        first[0] = true;
        applyIds(fun (id: int) {
            if (!first[0]) sb.puts(", ");
            sb.putd(id);
            first[0] = false;
        });
        sb.puts("}");
        return sb;
    }

    def renderFull(sb: StringBuilder, sea: Sea) -> StringBuilder {
        sb.puts("{");
        var first = Array<bool>.new(1);
        first[0] = true;
        apply(sea, fun (n: IRNode) {
            if (!first[0]) sb.puts(", ");
            sb.putq(n.render);
            first[0] = false;
        });
        sb.puts("}");
        return sb;
    }
}

type MapSlot<V> #unboxed {
    case Empty;
    case Full(key: IRNode, value: V);
}

class NodeMap<V> {
    var slots: Array<MapSlot<V>> = Array<MapSlot<V>>.new(32);

    def has(node: IRNode) -> bool {
        if (node == null || node.id < 0 || node.id >= slots.length) return false;
        return MapSlot<V>.Full.?(slots[node.id]);
    }

    def [node: IRNode] -> V {
        if (node == null || node.id < 0 || node.id >= slots.length) return V.default;
        match (slots[node.id]) {
            Full(_, value) => return value;
            _ => return V.default;
        }
    }

    def [node: IRNode] = v: V {
        if (node == null || node.id < 0) return;
        if (node.id >= slots.length) slots = Arrays.grow(slots, node.id * 2);
        slots[node.id] = MapSlot<V>.Full(node, v);
    }

    def remove(node: IRNode) {
        if (node != null && node.id >= 0 && node.id < slots.length) slots[node.id] = MapSlot<V>.Empty;
    }

    def apply(f: (IRNode, V) -> void) {
        for (i < slots.length) match (slots[i]) {
            Full(key, value) => f(key, value);
            _ => ;
        }
    }
}

component ImmNodeSets {
    def DEFAULT_CAPACITY: int = 64;

    def empty() -> ImmNodeSet {
        return ImmNodeSet(Array<u64>.new((DEFAULT_CAPACITY + 63) >>> 6), DEFAULT_CAPACITY);
    }

    def withCapacity(capacity: int) -> ImmNodeSet {
        return ImmNodeSet(Array<u64>.new((capacity + 63) >>> 6), capacity);
    }

    def single(n: IRNode) -> ImmNodeSet => empty().with(n);

    def dependency_closure(seeds: Range<IRNode>, admit: (IRNode, ImmNodeSet) -> bool) -> ImmNodeSet {
        def wl = VecDeque<IRNode>.new();
        for (seed in seeds) wl.enqueue(seed);

        var closed = empty();
        while (!wl.empty()) {
            def node = wl.dequeue();
            if (node == null || closed.has(node)) continue;
            if (!admit(node, closed)) continue;

            closed = closed.with(node);
            node.applyDeps(fun (dep: IRNode) { wl.enqueue(dep); });
        }

        return closed;
    }

    def of_vec(v: Vector<IRNode>) -> ImmNodeSet {
        var s = empty();
        for (i < v.length) s = s.with(v[i]);
        return s;
    }

    def of_array(arr: Array<IRNode>) -> ImmNodeSet {
        if (arr.length == 0) return empty();
        var maxId = 0;
        for (n in arr) if (n.id > maxId) maxId = n.id;
        def cap = maxId + 1;
        def bits = Array<u64>.new((cap + 63) >>> 6);
        for (n in arr) {
            def idx = n.id >>> 6;
            bits[idx] = bits[idx] | (1uL << u6.view(n.id));
        }
        return ImmNodeSet(bits, cap);
    }

}
