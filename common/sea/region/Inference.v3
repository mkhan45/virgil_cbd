class RegionCtx {
    var boundary_values: ImmNodeSet;
    var boundary_states: Array<ImmNodeSet>; // idx = statecomp.tag
    var value_demand_map: NodeMap<ImmNodeSet>;
    var state_demand_map: NodeMap<Array<ImmNodeSet>>;
    var active: ImmNodeSet;

    new(boundary_values, boundary_states, value_demand_map, state_demand_map, active) {}

    def isEmpty() -> bool => active.isEmpty();
}

class InferredPartition {
    var phi: IRNode;
    var ctx: RegionCtx;
    var support: ImmNodeSet;
    var left: ImmNodeSet;
    var right: ImmNodeSet;
    var anchored: ImmNodeSet;
    var cloneable: ImmNodeSet;
    var left_ctx: RegionCtx;
    var right_ctx: RegionCtx;

    new(phi, ctx, support, left, right, anchored, cloneable, left_ctx, right_ctx) {}

    def overlap() -> ImmNodeSet => left.intersection(right);
}

class PartitionDiscovery {
    var root: RegionCtx;
    var partitions: Vector<InferredPartition>;

    new(root, partitions) {}
}

class SeenPartitionCtx {
    var phi: IRNode;
    var boundary_values: ImmNodeSet;
    var boundary_states: Array<ImmNodeSet>;

    new(phi, boundary_values, boundary_states) {}
}

component PartitionInference {
    def normalize(set: ImmNodeSet) -> ImmNodeSet {
        if (set.bits == null) return ImmNodeSets.empty();
        return set;
    }

    def empty_state_labels() -> Array<ImmNodeSet> {
        def out = Array<ImmNodeSet>.new(StateComponent.count);
        for (sc in StateComponent.set.all) out[sc.tag] = ImmNodeSets.empty();
        return out;
    }

    def state_label_set(states: Array<ImmNodeSet>, sc: StateComponent) -> ImmNodeSet {
        return state_label_set_idx(states, sc.tag);
    }

    def state_label_set_idx(states: Array<ImmNodeSet>, sc_tag: int) -> ImmNodeSet {
        if (states == null || sc_tag < 0 || sc_tag >= states.length) return ImmNodeSets.empty();
        return normalize(states[sc_tag]);
    }

    def copy_state_labels(states: Array<ImmNodeSet>) -> Array<ImmNodeSet> {
        def out = Array<ImmNodeSet>.new(StateComponent.count);
        for (sc in StateComponent.set.all) out[sc.tag] = state_label_set(states, sc);
        return out;
    }

    def state_labels_eq(lhs: Array<ImmNodeSet>, rhs: Array<ImmNodeSet>) -> bool {
        for (sc in StateComponent.set.all)
            if (!state_label_set(lhs, sc).eq(state_label_set(rhs, sc))) return false;
        return true;
    }

    def root_boundary_values(bottom: IRNode) -> ImmNodeSet {
        var out = ImmNodeSets.empty();
        for (i < bottom.value_deps.length) {
            def dep = bottom.value_deps[i];
            if (dep != null) out = out.with(dep.unwrapMove());
        }
        return out;
    }

    def root_boundary_states(bottom: IRNode) -> Array<ImmNodeSet> {
        def out = empty_state_labels();
        for (sc in StateComponent.set.all) {
            def dep = bottom.state_deps[sc.tag];
            if (dep != null) out[sc.tag] = out[sc.tag].with(dep.unwrapMove());
        }
        return out;
    }

    def demand_value_labels(ctx: RegionCtx, node: IRNode) -> ImmNodeSet {
        return normalize(ctx.value_demand_map[node]);
    }

    def demand_state_labels(ctx: RegionCtx, node: IRNode, sc: StateComponent) -> ImmNodeSet {
        return state_label_set(ctx.state_demand_map[node], sc);
    }

    def add_value_label(map: NodeMap<ImmNodeSet>, node: IRNode, label: IRNode) -> bool {
        def existing = normalize(map[node]);
        if (existing.has(label)) return false;
        map[node] = existing.with(label);
        return true;
    }

    def add_state_label(map: NodeMap<Array<ImmNodeSet>>, node: IRNode, sc_tag: int, label: IRNode) -> bool {
        var existing = map[node];
        if (existing == null) existing = empty_state_labels();

        def labels = state_label_set_idx(existing, sc_tag);
        if (labels.has(label)) return false;

        existing[sc_tag] = labels.with(label);
        map[node] = existing;
        return true;
    }

    def make_ctx(sea: Sea, boundary_values: ImmNodeSet, boundary_states: Array<ImmNodeSet>) -> RegionCtx {
        def vals = normalize(boundary_values);
        def states = copy_state_labels(boundary_states);

        def value_demand_map = NodeMap<ImmNodeSet>.new();
        def state_demand_map = NodeMap<Array<ImmNodeSet>>.new();
        def wl_nodes = Vector<IRNode>.new();
        def wl_labels = Vector<IRNode>.new();
        def wl_state_tags = Vector<int>.new();
        var active = ImmNodeSets.empty();

        for (label in vals.toArray(sea)) {
            if (label == null) continue;
            wl_nodes.put(label);
            wl_labels.put(label);
            wl_state_tags.put(-1);
        }

        for (sc in StateComponent.set.all) for (label in states[sc.tag].toArray(sea)) {
            if (label == null) continue;
            wl_nodes.put(label);
            wl_labels.put(label);
            wl_state_tags.put(sc.tag);
        }

        var wi = 0;
        while (wi < wl_nodes.length) {
            def node = wl_nodes[wi];
            def label = wl_labels[wi];
            def sc_tag = wl_state_tags[wi];
            wi += 1;
            if (node == null || label == null) continue;

            def added = if(sc_tag < 0,
                add_value_label(value_demand_map, node, label),
                add_state_label(state_demand_map, node, sc_tag, label));
            if (!added) continue;

            active = active.with(node);
            node.applyDeps(fun (dep: IRNode) {
                wl_nodes.put(dep);
                wl_labels.put(label);
                wl_state_tags.put(sc_tag);
            });
        }

        return RegionCtx.new(vals, states, value_demand_map, state_demand_map, active);
    }

    def make_root_ctx(sea: Sea, bottom: IRNode) -> RegionCtx {
        return make_ctx(sea, root_boundary_values(bottom), root_boundary_states(bottom));
    }

    def include_phi(node: IRNode, include_value_phis: bool, include_state_phis: bool) -> bool {
        match (node.op) {
            Phi => return include_value_phis;
            StatePhi(_) => return include_state_phis;
            _ => return false;
        }
    }

    def visible_phis(sea: Sea, ctx: RegionCtx,
                     include_value_phis: bool, include_state_phis: bool) -> Vector<IRNode> {
        def phis = Vector<IRNode>.new();
        ctx.active.apply(sea, fun (node: IRNode) {
            if (include_phi(node, include_value_phis, include_state_phis)) phis.put(node);
        });
        return phis;
    }

    def has_writes(node: IRNode) -> bool {
        match (node.op) {
            Intrinsic(defn) => {
                for (sc in defn.writes) return true;
            }
            _ => ;
        }
        return false;
    }

    def child_uses_value(child: IRNode, dep: IRNode) -> bool {
        if (child == null || dep == null) return false;
        for (i < child.value_deps.length) {
            def child_dep = child.value_deps[i];
            if (child_dep == null || child_dep.id != dep.id) continue;
            if (child.is_move() && i == 0) return false;
            match (child.op) {
                StatePhi(_) => return i == 0;
                _ => return true;
            }
        }
        return false;
    }

    def child_uses_state(child: IRNode, dep: IRNode, sc: StateComponent) -> bool {
        if (child == null || dep == null) return false;
        match (child.op) {
            StatePhi(_) => {
                if (child.value_deps.length > 1 && child.value_deps[1] != null && child.value_deps[1].id == dep.id) {
                    match (child.op) {
                        StatePhi(statecomps) => if (statecomps - sc != statecomps) return true;
                        _ => ;
                    }
                }
                if (child.value_deps.length > 2 && child.value_deps[2] != null && child.value_deps[2].id == dep.id) {
                    match (child.op) {
                        StatePhi(statecomps) => if (statecomps - sc != statecomps) return true;
                        _ => ;
                    }
                }
            }
            _ => ;
        }
        if (sc.tag >= child.state_deps.length) return false;
        def child_dep = child.state_deps[sc.tag];
        return child_dep != null && child_dep.id == dep.id;
    }

    def collect_child_boundary(sea: Sea, region: ImmNodeSet, ctx: RegionCtx) -> (ImmNodeSet, Array<ImmNodeSet>) {
        if (region.isEmpty()) return (ImmNodeSets.empty(), empty_state_labels());

        def outside = ctx.active.withoutAll(region);

        var values = ctx.boundary_values.intersection(region);
        def states = empty_state_labels();
        for (sc in StateComponent.set.all)
            states[sc.tag] = state_label_set(ctx.boundary_states, sc).intersection(region);

        for (node in region.toArray(sea)) {
            for (i < node.children.length) {
                def child = node.children[i];
                if (child == null || region.has(child) || !outside.has(child)) continue;

                if (child_uses_value(child, node)) values = values.with(node);
                for (sc in StateComponent.set.all)
                    if (child_uses_state(child, node, sc)) states[sc.tag] = states[sc.tag].with(node);
            }
        }

        return (values, states);
    }

    def has_outside_demand(ctx: RegionCtx, node: IRNode,
                           phi_value_labels: ImmNodeSet,
                           phi_state_labels: Array<ImmNodeSet>) -> bool {
        if (!demand_value_labels(ctx, node).withoutAll(phi_value_labels).isEmpty()) return true;
        for (sc in StateComponent.set.all)
            if (!demand_state_labels(ctx, node, sc).withoutAll(state_label_set(phi_state_labels, sc)).isEmpty())
                return true;
        return false;
    }

    def branch_partition_in_context(sea: Sea, phi: IRNode, ctx: RegionCtx) -> InferredPartition {
        def cond = phi.value_deps[0].unwrapMove();
        def left_arm = phi.value_deps[1].unwrapMove();
        def right_arm = phi.value_deps[2].unwrapMove();

        def cond_deps = sea.cachedTransitiveDeps(cond).intersection(ctx.active);
        def left_phi = sea.cachedTransitiveDepsPhiAware(left_arm).intersection(ctx.active);
        def right_phi = sea.cachedTransitiveDepsPhiAware(right_arm).intersection(ctx.active);
        def support = cond_deps.union(left_phi.intersection(right_phi));

        def left_full = sea.cachedTransitiveDeps(left_arm).intersection(ctx.active);
        def right_full = sea.cachedTransitiveDeps(right_arm).intersection(ctx.active);
        def shared = left_full.intersection(right_full).withoutAll(support);

        def phi_value_labels = demand_value_labels(ctx, phi);
        def phi_state_labels = ctx.state_demand_map[phi];

        def anchored_box = [ImmNodeSets.empty()];
        shared.apply(sea, fun (node: IRNode) {
            if (has_writes(node) && has_outside_demand(ctx, node, phi_value_labels, phi_state_labels))
                anchored_box[0] = anchored_box[0].with(node);
        });
        def anchored = anchored_box[0];
        def cloneable = shared.withoutAll(anchored);

        def left = left_full.withoutAll(support).withoutAll(shared).union(cloneable);
        def right = right_full.withoutAll(support).withoutAll(shared).union(cloneable);

        def left_boundary = collect_child_boundary(sea, left, ctx);
        def right_boundary = collect_child_boundary(sea, right, ctx);

        return InferredPartition.new(
            phi,
            ctx,
            support,
            left,
            right,
            anchored,
            cloneable,
            make_ctx(sea, left_boundary.0, left_boundary.1),
            make_ctx(sea, right_boundary.0, right_boundary.1)
        );
    }

    def seen_ctx(seen: Vector<SeenPartitionCtx>, phi: IRNode, ctx: RegionCtx) -> bool {
        for (i < seen.length) {
            def prev = seen[i];
            if (prev.phi.id != phi.id) continue;
            if (!prev.boundary_values.eq(ctx.boundary_values)) continue;
            if (!state_labels_eq(prev.boundary_states, ctx.boundary_states)) continue;
            return true;
        }
        return false;
    }

    def visit_ctx(sea: Sea, ctx: RegionCtx,
                  include_value_phis: bool, include_state_phis: bool,
                  out: Vector<InferredPartition>, seen: Vector<SeenPartitionCtx>) {
        def phis = visible_phis(sea, ctx, include_value_phis, include_state_phis);
        for (i < phis.length) {
            def phi = phis[i];
            if (seen_ctx(seen, phi, ctx)) continue;
            seen.put(SeenPartitionCtx.new(phi, ctx.boundary_values, ctx.boundary_states));

            def part = branch_partition_in_context(sea, phi, ctx);
            out.put(part);

            if (!part.left_ctx.isEmpty()) visit_ctx(sea, part.left_ctx, include_value_phis, include_state_phis, out, seen);
            if (!part.right_ctx.isEmpty()) visit_ctx(sea, part.right_ctx, include_value_phis, include_state_phis, out, seen);
        }
    }

    def determine_all_partitions(sea: Sea, bottom: IRNode,
                                 include_value_phis: bool, include_state_phis: bool) -> PartitionDiscovery {
        sea.rebuildChildren();
        sea.clearDepsCache();

        def root = make_root_ctx(sea, bottom);
        def out = Vector<InferredPartition>.new();
        def seen = Vector<SeenPartitionCtx>.new();
        visit_ctx(sea, root, include_value_phis, include_state_phis, out, seen);
        return PartitionDiscovery.new(root, out);
    }

    def render_set(sea: Sea, name: string, set: ImmNodeSet, buf: StringBuilder) -> StringBuilder {
        buf.puts(name).puts("=");
        normalize(set).renderFull(buf, sea);
        return buf;
    }

    def render_state_labels(sea: Sea, states: Array<ImmNodeSet>, buf: StringBuilder) -> StringBuilder {
        buf.puts("states={");
        var first = true;
        for (sc in StateComponent.set.all) {
            def labels = state_label_set(states, sc);
            if (labels.isEmpty()) continue;
            if (!first) buf.puts(", ");
            buf.puts(sc.name).puts(":");
            labels.renderFull(buf, sea);
            first = false;
        }
        buf.puts("}");
        return buf;
    }

    def render_ctx(sea: Sea, ctx: RegionCtx, buf: StringBuilder) -> StringBuilder {
        render_set(sea, "values", ctx.boundary_values, buf);
        buf.puts(" ");
        render_state_labels(sea, ctx.boundary_states, buf);
        return buf;
    }

    def render_partition(sea: Sea, idx: int, part: InferredPartition, buf: StringBuilder) -> StringBuilder {
        buf.puts("#").putd(idx).puts(" phi=").putq(part.phi.render);
        buf.puts(" cond=").putq(part.phi.value_deps[0].unwrapMove().render).puts("\n");

        buf.puts("  ctx: ");
        render_ctx(sea, part.ctx, buf).puts("\n");

        buf.puts("  ");
        render_set(sea, "support", part.support, buf).puts("\n");
        buf.puts("  ");
        render_set(sea, "left", part.left, buf).puts("\n");
        buf.puts("  ");
        render_set(sea, "right", part.right, buf).puts("\n");
        buf.puts("  ");
        render_set(sea, "cloneable", part.cloneable, buf).puts("\n");
        buf.puts("  ");
        render_set(sea, "anchored", part.anchored, buf).puts("\n");

        buf.puts("  left_ctx: ");
        render_ctx(sea, part.left_ctx, buf).puts("\n");
        buf.puts("  right_ctx: ");
        render_ctx(sea, part.right_ctx, buf).puts("\n");
        return buf;
    }
}
