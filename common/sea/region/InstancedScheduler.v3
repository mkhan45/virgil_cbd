var inst_sched_cfg_id: int = 0;
var inst_sched_partition_id: int = 0;

class SchedulerInstance {
    var id: int;
    var root: IRNode;
    var home: PartitionFrame;

    var bottom_limit: ICFGNode;
    var placed_in: ICFGNode;

    new(id, root, home, bottom_limit, placed_in) {}
}

class InstanceDep {
    var dep: SchedulerInstance;
    var role: UseRole;

    new(dep, role) {}
}

class InstanceUse {
    var user: SchedulerInstance;
    var role: UseRole;

    new(user, role) {}
}

class InstanceHomePlan {
    var root: IRNode;
    var demands: Vector<PartitionFrame> = Vector<PartitionFrame>.new();
    var homes: Vector<PartitionFrame> = Vector<PartitionFrame>.new();

    new(root) {}
}

class PartitionFrame {
    var id: int;
    var parent: PartitionFrame;
    var owner_site: SiteFrame;
    var side: SiteSide;

    var top_limit: ICFGNode;
    var default_bottom: ICFGNode;
    var entry_block: ICFGBlock = null;

    new(id, parent, owner_site, side, top_limit, default_bottom) {}
}

class SiteFrame {
    var site: BranchSite;

    var parent_partition: PartitionFrame;
    var left_partition: PartitionFrame;
    var right_partition: PartitionFrame;

    var branch_cfg: ICFGBranch;
    var merge_cfg: ICFGJoin;

    var left_children: Vector<SiteFrame> = Vector<SiteFrame>.new();
    var right_children: Vector<SiteFrame> = Vector<SiteFrame>.new();

    new(site, parent_partition, left_partition, right_partition, branch_cfg, merge_cfg) {}
}

type UseRole #unboxed {
    case Value(idx: int);
    case State(sc: StateComponent);
    case PhiCond;
    case PhiLeft;
    case PhiRight;
}

type HomeDecision {
    case StopAbove;
    case DescendLeft;
    case DescendRight;
    case DescendEither;
}

class ICFGNode(id: int) {
    def getSinglePrev() -> ICFGNode {
        match (this) {
            block: ICFGBlock => return block.prev;
            branch: ICFGBranch => return branch.prev;
            _ => return null;
        }
    }

    def setSinglePrev(new_prev: ICFGNode) -> this {
        match (this) {
            block: ICFGBlock => block.prev = new_prev;
            branch: ICFGBranch => branch.prev = new_prev;
            _ => ;
        }
    }
}

class ICFGBlock(uid: int) extends ICFGNode(uid) {
    var prev: ICFGNode = null;
    var next: ICFGNode = null;
    var prims: Vector<SchedulerInstance> = Vector<SchedulerInstance>.new();
}

class ICFGBranch(uid: int) extends ICFGNode(uid) {
    var condition: IRNode = null;
    var prev: ICFGNode = null;
    var l_branch: ICFGNode = null;
    var r_branch: ICFGNode = null;
    var join: ICFGJoin = null;
}

class ICFGJoin(uid: int) extends ICFGNode(uid) {
    var source_branch: ICFGBranch = null;
    var l_source: ICFGNode = null;
    var r_source: ICFGNode = null;
    var next: ICFGNode = null;
    var phis: Vector<IRNode> = Vector<IRNode>.new();
    var phi_instances: Vector<SchedulerInstance> = Vector<SchedulerInstance>.new();
}

class InstancedSeaScheduler {
    var sea: Sea;
    var top_node: IRNode;
    var bottom_node: IRNode;

    var discovery: PartitionDiscovery;

    var root_partition: PartitionFrame;
    var root_sites: Vector<SiteFrame>;
    var site_frames: Vector<SiteFrame>;

    var top_cfg: ICFGNode;
    var bottom_cfg: ICFGBlock;

    var instances: Vector<SchedulerInstance> = Vector<SchedulerInstance>.new();
    var instance_deps: Vector<Vector<InstanceDep>> = Vector<Vector<InstanceDep>>.new();
    var instance_users: Array<Vector<InstanceUse>> = null;
    var pending_users: Array<int> = null;

    new(sea, top_node, bottom_node, discovery,
        root_partition, root_sites, site_frames,
        top_cfg, bottom_cfg) {}

    def renderPhase0(buf: StringBuilder) -> StringBuilder {
        return ISRender.renderPhase0(this, buf);
    }

    def toMermaidICFG() -> string {
        return ISRender.toMermaidICFG(this);
    }

    def resolve_home(root: IRNode, use_partition: PartitionFrame, use_role: UseRole) -> PartitionFrame {
        return InstancedScheduler.resolve_home(this, root, use_partition, use_role);
    }

    def discover_instances() {
        InstancedScheduler.discover_instances(this);
    }

    def renderInstances(buf: StringBuilder) -> StringBuilder {
        return ISRender.renderInstances(this, buf);
    }

    def place_instances() {
        InstancedScheduler.place_instances(this);
    }

    def renderPlacement(buf: StringBuilder) -> StringBuilder {
        return ISRender.renderPlacement(this, buf);
    }
}

component InstancedScheduler {
    def fresh_cfg_id() -> int {
        inst_sched_cfg_id += 1;
        return inst_sched_cfg_id;
    }

    def fresh_partition_id() -> int {
        inst_sched_partition_id += 1;
        return inst_sched_partition_id;
    }

    def of_full_sea(sea: Sea) -> InstancedSeaScheduler {
        inst_sched_cfg_id = 0;
        inst_sched_partition_id = 0;
        def discovery = PartitionInference.determine_all_partitions(sea, sea.finish, true, true);
        def bottom_cfg = ICFGBlock.new(fresh_cfg_id());
        def root_partition = PartitionFrame.new(fresh_partition_id(), null, null, SiteSide.Root, null, bottom_cfg);
        def built = build_sites(root_partition, discovery.sites, bottom_cfg);
        def site_frames = Vector<SiteFrame>.new();
        collect_site_frames(built.1, site_frames);

        return InstancedSeaScheduler.new(sea, sea.start, sea.finish, discovery,
                                         root_partition, built.1, site_frames,
                                         built.0, bottom_cfg);
    }

    def build_sites(partition: PartitionFrame,
                    sites: Vector<BranchSite>,
                    sink: ICFGNode) -> (ICFGNode, Vector<SiteFrame>) {
        var entry = sink;
        def direct = Vector<SiteFrame>.new();

        var i = sites.length;
        while (i > 0) {
            i -= 1;
            def built = build_site(partition, sites[i], entry);
            entry = built.0;
            direct.put(built.1);
        }

        direct.reverse();
        return (entry, direct);
    }

    def collect_site_frames(frames: Vector<SiteFrame>, out: Vector<SiteFrame>) {
        for (i < frames.length) {
            def frame = frames[i];
            out.put(frame);
            collect_site_frames(frame.left_children, out);
            collect_site_frames(frame.right_children, out);
        }
    }

    def build_site(parent_partition: PartitionFrame,
                   site: BranchSite,
                   sink: ICFGNode) -> (ICFGNode, SiteFrame) {
        def prev = sink.getSinglePrev();
        def branch = ICFGBranch.new(fresh_cfg_id());
        def join = ICFGJoin.new(fresh_cfg_id());

        branch.condition = site.condition;
        branch.prev = prev;
        branch.join = join;

        rewire_prev_successor(prev, sink, branch);
        sink.setSinglePrev(join);

        join.source_branch = branch;
        join.next = sink;
        join.phis = site.phis;

        def left_leaf = ICFGBlock.new(fresh_cfg_id());
        def right_leaf = ICFGBlock.new(fresh_cfg_id());
        left_leaf.prev = branch;
        right_leaf.prev = branch;

        def left_partition = PartitionFrame.new(fresh_partition_id(), parent_partition, null, SiteSide.Left, branch, left_leaf);
        def right_partition = PartitionFrame.new(fresh_partition_id(), parent_partition, null, SiteSide.Right, branch, right_leaf);
        def frame = SiteFrame.new(site, parent_partition, left_partition, right_partition, branch, join);
        left_partition.owner_site = frame;
        right_partition.owner_site = frame;

        def left_built = build_sites(left_partition, site.left_children, left_leaf);
        def right_built = build_sites(right_partition, site.right_children, right_leaf);

        frame.left_children = left_built.1;
        frame.right_children = right_built.1;

        branch.l_branch = left_built.0;
        branch.r_branch = right_built.0;
        join.l_source = left_partition.default_bottom;
        join.r_source = right_partition.default_bottom;

        return (branch, frame);
    }

    def rewire_prev_successor(prev: ICFGNode, old_child: ICFGNode, new_child: ICFGNode) {
        if (prev == null) return;

        match (prev) {
            block: ICFGBlock => {
                if (block.next != null && block.next.id == old_child.id) block.next = new_child;
            }
            join: ICFGJoin => {
                if (join.next != null && join.next.id == old_child.id) join.next = new_child;
            }
            branch: ICFGBranch => {
                if (branch.l_branch != null && branch.l_branch.id == old_child.id) branch.l_branch = new_child;
                if (branch.r_branch != null && branch.r_branch.id == old_child.id) branch.r_branch = new_child;
            }
            _ => ;
        }
    }

    def classify_home(site: BranchSite, node_: IRNode) -> HomeDecision {
        if (node_ == null) return HomeDecision.StopAbove;
        def node = node_.unwrapMove();

        if (site.support.has(node) || site.anchored_overlap.has(node))
            return HomeDecision.StopAbove;
        if (site.left_only.has(node)) return HomeDecision.DescendLeft;
        if (site.right_only.has(node)) return HomeDecision.DescendRight;
        if (site.cloneable_overlap.has(node)) return HomeDecision.DescendEither;
        return HomeDecision.StopAbove;
    }

    def ancestor_partitions(use_partition: PartitionFrame) -> Vector<PartitionFrame> {
        def path = Vector<PartitionFrame>.new();
        var cur = use_partition;
        while (cur != null && cur.owner_site != null) {
            path.put(cur);
            cur = cur.parent;
        }
        path.reverse();
        return path;
    }

    def child_partition_for_side(site: SiteFrame, side: SiteSide) -> PartitionFrame {
        match (side) {
            Left => return site.left_partition;
            Right => return site.right_partition;
            _ => return site.parent_partition;
        }
    }

    def same_partition(lhs: PartitionFrame, rhs: PartitionFrame) -> bool {
        if (lhs == null || rhs == null) return lhs == rhs;
        return lhs.id == rhs.id;
    }

    def same_cfg_node(lhs: ICFGNode, rhs: ICFGNode) -> bool {
        if (lhs == null || rhs == null) return lhs == rhs;
        return lhs.id == rhs.id;
    }

    def partition_is_ancestor(ancestor: PartitionFrame, partition: PartitionFrame) -> bool {
        if (ancestor == null || partition == null) return false;
        var cur = partition;
        while (cur != null) {
            if (same_partition(ancestor, cur)) return true;
            cur = cur.parent;
        }
        return false;
    }

    def nearest_common_partition(lhs: PartitionFrame, rhs: PartitionFrame) -> PartitionFrame {
        if (lhs == null) return rhs;
        if (rhs == null) return lhs;

        var cur = lhs;
        while (cur != null) {
            if (partition_is_ancestor(cur, rhs)) return cur;
            cur = cur.parent;
        }
        return null;
    }

    def opposite_sides(lhs: SiteSide, rhs: SiteSide) -> bool {
        if (SiteSide.Left.?(lhs) && SiteSide.Right.?(rhs)) return true;
        if (SiteSide.Right.?(lhs) && SiteSide.Left.?(rhs)) return true;
        return false;
    }

    def partitions_path_exclusive(lhs: PartitionFrame, rhs: PartitionFrame) -> bool {
        if (lhs == null || rhs == null) return false;
        if (partition_is_ancestor(lhs, rhs) || partition_is_ancestor(rhs, lhs)) return false;

        def lhs_path = ancestor_partitions(lhs);
        def rhs_path = ancestor_partitions(rhs);
        var i = 0;
        while (i < lhs_path.length && i < rhs_path.length) {
            if (!same_partition(lhs_path[i], rhs_path[i])) break;
            i += 1;
        }

        if (i >= lhs_path.length || i >= rhs_path.length) return false;
        def lhs_step = lhs_path[i];
        def rhs_step = rhs_path[i];
        if (lhs_step.owner_site == null || rhs_step.owner_site == null) return false;
        if (lhs_step.owner_site.site.id != rhs_step.owner_site.site.id) return false;
        return opposite_sides(lhs_step.side, rhs_step.side);
    }

    def same_partition_vec(lhs: Vector<PartitionFrame>, rhs: Vector<PartitionFrame>) -> bool {
        if (lhs.length != rhs.length) return false;
        for (i < lhs.length) if (!same_partition(lhs[i], rhs[i])) return false;
        return true;
    }

    def home_demand_exists(plan: InstanceHomePlan, home: PartitionFrame) -> bool {
        for (i < plan.demands.length) if (same_partition(plan.demands[i], home)) return true;
        return false;
    }

    def insert_plan_home(homes: Vector<PartitionFrame>, requested: PartitionFrame) -> Vector<PartitionFrame> {
        var home = requested;
        var cur_homes = homes;

        while (true) {
            for (i < cur_homes.length)
                if (partition_is_ancestor(cur_homes[i], home)) return cur_homes;

            var conflict_idx = -1;
            for (i < cur_homes.length) {
                if (!partitions_path_exclusive(cur_homes[i], home)) {
                    conflict_idx = i;
                    break;
                }
            }

            if (conflict_idx < 0) {
                def out = Vector<PartitionFrame>.new();
                for (i < cur_homes.length) out.put(cur_homes[i]);
                out.put(home);
                return out;
            }

            home = nearest_common_partition(cur_homes[conflict_idx], home);
            def kept = Vector<PartitionFrame>.new();
            for (i < cur_homes.length) if (i != conflict_idx) kept.put(cur_homes[i]);
            cur_homes = kept;
        }

        return cur_homes;
    }

    def recompute_plan_homes(plan: InstanceHomePlan) -> bool {
        def old_homes = plan.homes;
        var new_homes = Vector<PartitionFrame>.new();
        for (i < plan.demands.length) new_homes = insert_plan_home(new_homes, plan.demands[i]);
        plan.homes = new_homes;
        return !same_partition_vec(old_homes, new_homes);
    }

    def find_home_plan(plans: Vector<InstanceHomePlan>, root: IRNode) -> InstanceHomePlan {
        if (root == null) return null;
        for (i < plans.length) if (plans[i].root.id == root.id) return plans[i];
        return null;
    }

    def add_plan_demand(scheduler: InstancedSeaScheduler,
                        plans: Vector<InstanceHomePlan>,
                        root_: IRNode,
                        home_: PartitionFrame) -> bool {
        if (root_ == null) return false;
        def root = root_.unwrapMove();
        def home = if(home_ != null, home_, scheduler.root_partition);

        var plan = find_home_plan(plans, root);
        if (plan == null) {
            plan = InstanceHomePlan.new(root);
            plans.put(plan);
        }

        if (home_demand_exists(plan, home)) return false;
        plan.demands.put(home);
        return recompute_plan_homes(plan);
    }

    def add_resolved_plan_demand(scheduler: InstancedSeaScheduler,
                                 plans: Vector<InstanceHomePlan>,
                                 root: IRNode,
                                 use_partition: PartitionFrame,
                                 role: UseRole) -> bool {
        if (root == null) return false;
        def home = scheduler.resolve_home(root, use_partition, role);
        return add_plan_demand(scheduler, plans, root, home);
    }

    def resolve_home(scheduler: InstancedSeaScheduler,
                     root_: IRNode,
                     use_partition: PartitionFrame,
                     use_role: UseRole) -> PartitionFrame {
        if (root_ == null) return scheduler.root_partition;
        def root = root_.unwrapMove();
        def path = ancestor_partitions(use_partition);
        var cur = scheduler.root_partition;

        for (i < path.length) {
            def step = path[i];
            def site_frame = step.owner_site;
            if (site_frame == null) return cur;

            def decision = classify_home(site_frame.site, root);
            match (decision) {
                StopAbove => return cur;
                DescendLeft => {
                    if (!SiteSide.Left.?(step.side)) return cur;
                    cur = site_frame.left_partition;
                }
                DescendRight => {
                    if (!SiteSide.Right.?(step.side)) return cur;
                    cur = site_frame.right_partition;
                }
                DescendEither => cur = child_partition_for_side(site_frame, step.side);
            }
        }

        return cur;
    }

    def intern_instance(scheduler: InstancedSeaScheduler,
                        root_: IRNode,
                        home: PartitionFrame) -> SchedulerInstance {
        if (root_ == null) return null;
        def root = root_.unwrapMove();
        def resolved_home = if(home != null, home, scheduler.root_partition);

        for (i < scheduler.instances.length) {
            def inst = scheduler.instances[i];
            if (inst.root.id == root.id && inst.home.id == resolved_home.id) return inst;
        }

        def inst = SchedulerInstance.new(scheduler.instances.length, root, resolved_home, null, null);
        scheduler.instances.put(inst);
        scheduler.instance_deps.put(Vector<InstanceDep>.new());
        return inst;
    }

    def add_instance_dep(scheduler: InstancedSeaScheduler,
                         user: SchedulerInstance,
                         dep: SchedulerInstance,
                         role: UseRole) {
        if (user == null || dep == null) return;
        scheduler.instance_deps[user.id].put(InstanceDep.new(dep, role));
    }

    def add_dependency_demand(scheduler: InstancedSeaScheduler,
                              user: SchedulerInstance,
                              dep_root: IRNode,
                              use_partition: PartitionFrame,
                              role: UseRole) {
        if (dep_root == null) return;
        def dep = find_covering_instance(scheduler, dep_root, scheduler.resolve_home(dep_root, use_partition, role));
        if (dep != null && user.id != dep.id) add_instance_dep(scheduler, user, dep, role);
    }

    def seed_finish_plan_demands(scheduler: InstancedSeaScheduler,
                                 plans: Vector<InstanceHomePlan>) -> bool {
        var changed = false;
        def finish = scheduler.bottom_node;
        for (i < finish.value_deps.length)
            if (finish.value_deps[i] != null)
                changed |= add_resolved_plan_demand(scheduler, plans, finish.value_deps[i], scheduler.root_partition, UseRole.Value(i));

        for (sc in StateComponent.set.all)
            if (finish.state_deps[sc.tag] != null)
                changed |= add_resolved_plan_demand(scheduler, plans, finish.state_deps[sc.tag], scheduler.root_partition, UseRole.State(sc));
        return changed;
    }

    def site_frame_has_phi(frame: SiteFrame, phi: IRNode) -> bool {
        if (frame == null || phi == null) return false;
        for (i < frame.site.phis.length) if (frame.site.phis[i].id == phi.id) return true;
        return false;
    }

    def find_site_frame_for_phi_home(scheduler: InstancedSeaScheduler,
                                     phi: IRNode,
                                     home: PartitionFrame) -> SiteFrame {
        for (i < scheduler.site_frames.length) {
            def frame = scheduler.site_frames[i];
            if (!site_frame_has_phi(frame, phi)) continue;
            if (same_partition(frame.parent_partition, home)) return frame;
        }
        return null;
    }

    def expand_phi_plan_home(scheduler: InstancedSeaScheduler,
                             plans: Vector<InstanceHomePlan>,
                             phi: IRNode,
                             home: PartitionFrame) -> bool {
        def frame = find_site_frame_for_phi_home(scheduler, phi, home);
        if (frame == null) return false;

        var changed = false;
        if (phi.value_deps.length > 0 && phi.value_deps[0] != null)
            changed |= add_resolved_plan_demand(scheduler, plans, phi.value_deps[0], frame.parent_partition, UseRole.PhiCond);
        if (phi.value_deps.length > 1 && phi.value_deps[1] != null)
            changed |= add_resolved_plan_demand(scheduler, plans, phi.value_deps[1], frame.left_partition, UseRole.PhiLeft);
        if (phi.value_deps.length > 2 && phi.value_deps[2] != null)
            changed |= add_resolved_plan_demand(scheduler, plans, phi.value_deps[2], frame.right_partition, UseRole.PhiRight);
        return changed;
    }

    def expand_plan_home(scheduler: InstancedSeaScheduler,
                         plans: Vector<InstanceHomePlan>,
                         root: IRNode,
                         home: PartitionFrame) -> bool {
        if (root == null || root.is_move()) return false;
        if (root.is_phi()) return expand_phi_plan_home(scheduler, plans, root, home);

        var changed = false;
        for (i < root.value_deps.length)
            changed |= add_resolved_plan_demand(scheduler, plans, root.value_deps[i], home, UseRole.Value(i));

        for (sc in StateComponent.set.all)
            changed |= add_resolved_plan_demand(scheduler, plans, root.state_deps[sc.tag], home, UseRole.State(sc));

        return changed;
    }

    def discover_home_plans(scheduler: InstancedSeaScheduler) -> Vector<InstanceHomePlan> {
        def plans = Vector<InstanceHomePlan>.new();
        seed_finish_plan_demands(scheduler, plans);

        var changed = true;
        while (changed) {
            changed = false;
            var pidx = 0;
            while (pidx < plans.length) {
                def plan = plans[pidx];
                pidx += 1;
                for (hidx < plan.homes.length)
                    changed |= expand_plan_home(scheduler, plans, plan.root, plan.homes[hidx]);
            }
        }

        return plans;
    }

    def materialize_instances(scheduler: InstancedSeaScheduler,
                              plans: Vector<InstanceHomePlan>) {
        scheduler.instances = Vector<SchedulerInstance>.new();
        scheduler.instance_deps = Vector<Vector<InstanceDep>>.new();

        for (i < plans.length) {
            def plan = plans[i];
            for (j < plan.homes.length) intern_instance(scheduler, plan.root, plan.homes[j]);
        }
    }

    def find_covering_instance(scheduler: InstancedSeaScheduler,
                               root_: IRNode,
                               requested_home: PartitionFrame) -> SchedulerInstance {
        if (root_ == null) return null;
        def root = root_.unwrapMove();
        def home = if(requested_home != null, requested_home, scheduler.root_partition);

        for (i < scheduler.instances.length) {
            def inst = scheduler.instances[i];
            if (inst.root.id != root.id) continue;
            if (partition_is_ancestor(inst.home, home)) return inst;
        }
        return null;
    }

    def add_phi_instance_deps(scheduler: InstancedSeaScheduler,
                              inst: SchedulerInstance) {
        def phi = inst.root;
        def frame = find_site_frame_for_phi_home(scheduler, phi, inst.home);
        if (frame == null) return;

        if (phi.value_deps.length > 0 && phi.value_deps[0] != null)
            add_dependency_demand(scheduler, inst, phi.value_deps[0], frame.parent_partition, UseRole.PhiCond);
        if (phi.value_deps.length > 1 && phi.value_deps[1] != null)
            add_dependency_demand(scheduler, inst, phi.value_deps[1], frame.left_partition, UseRole.PhiLeft);
        if (phi.value_deps.length > 2 && phi.value_deps[2] != null)
            add_dependency_demand(scheduler, inst, phi.value_deps[2], frame.right_partition, UseRole.PhiRight);
    }

    def discover_instance_deps(scheduler: InstancedSeaScheduler,
                               inst: SchedulerInstance) {
        def node = inst.root;
        if (node == null || node.is_move()) return;
        if (node.is_phi()) {
            add_phi_instance_deps(scheduler, inst);
            return;
        }

        for (i < node.value_deps.length)
            add_dependency_demand(scheduler, inst, node.value_deps[i], inst.home, UseRole.Value(i));

        for (sc in StateComponent.set.all)
            add_dependency_demand(scheduler, inst, node.state_deps[sc.tag], inst.home, UseRole.State(sc));
    }

    def discover_instances(scheduler: InstancedSeaScheduler) {
        def plans = discover_home_plans(scheduler);
        materialize_instances(scheduler, plans);
        for (i < scheduler.instances.length) discover_instance_deps(scheduler, scheduler.instances[i]);
    }

    def clear_block_placement(node: ICFGNode) {
        if (node == null) return;
        match (node) {
            block: ICFGBlock => block.prims = Vector<SchedulerInstance>.new();
            _ => ;
        }
    }

    def clear_join_placement(join: ICFGJoin) {
        if (join == null) return;
        join.phi_instances = Vector<SchedulerInstance>.new();
    }

    def clear_placements(scheduler: InstancedSeaScheduler) {
        clear_block_placement(scheduler.bottom_cfg);
        clear_block_placement(scheduler.root_partition.entry_block);
        for (i < scheduler.site_frames.length) {
            def frame = scheduler.site_frames[i];
            clear_block_placement(frame.left_partition.entry_block);
            clear_block_placement(frame.right_partition.entry_block);
            clear_block_placement(frame.left_partition.default_bottom);
            clear_block_placement(frame.right_partition.default_bottom);
            clear_join_placement(frame.merge_cfg);
        }

        for (i < scheduler.instances.length) {
            def inst = scheduler.instances[i];
            inst.bottom_limit = null;
            inst.placed_in = null;
        }
    }

    def compute_instance_users(scheduler: InstancedSeaScheduler) {
        def n = scheduler.instances.length;
        scheduler.instance_users = Array<Vector<InstanceUse>>.new(n);
        scheduler.pending_users = Array<int>.new(n);
        for (i < n) {
            scheduler.instance_users[i] = Vector<InstanceUse>.new();
            scheduler.pending_users[i] = 0;
        }

        for (i < n) {
            def user = scheduler.instances[i];
            def deps = scheduler.instance_deps[user.id];
            for (j < deps.length) {
                def dep = deps[j].dep;
                if (dep == null) continue;
                scheduler.instance_users[dep.id].put(InstanceUse.new(user, deps[j].role));
                scheduler.pending_users[dep.id] += 1;
            }
        }
    }

    def should_emit_in_block(inst: SchedulerInstance) -> bool {
        if (inst == null || inst.root == null) return false;
        match (inst.root.op) {
            Start, Finish, Move, Phi, StatePhi => return false;
            _ => return true;
        }
    }

    def partition_first_node(scheduler: InstancedSeaScheduler, partition: PartitionFrame) -> ICFGNode {
        if (partition == null || partition.owner_site == null) return scheduler.top_cfg;
        def branch = partition.owner_site.branch_cfg;
        match (partition.side) {
            Left => return branch.l_branch;
            Right => return branch.r_branch;
            _ => return scheduler.top_cfg;
        }
    }

    def set_partition_first_node(scheduler: InstancedSeaScheduler,
                                 partition: PartitionFrame,
                                 node: ICFGNode) {
        if (partition == null || partition.owner_site == null) {
            scheduler.top_cfg = node;
            return;
        }

        def branch = partition.owner_site.branch_cfg;
        match (partition.side) {
            Left => branch.l_branch = node;
            Right => branch.r_branch = node;
            _ => scheduler.top_cfg = node;
        }
    }

    def partition_entry_block(scheduler: InstancedSeaScheduler,
                              partition_: PartitionFrame) -> ICFGBlock {
        def partition = if(partition_ != null, partition_, scheduler.root_partition);
        if (partition.entry_block != null) return partition.entry_block;

        def old_first = partition_first_node(scheduler, partition);
        def block = ICFGBlock.new(fresh_cfg_id());
        block.next = old_first;
        block.prev = if(partition.owner_site != null, partition.owner_site.branch_cfg, null);
        if (old_first != null) old_first.setSinglePrev(block);
        set_partition_first_node(scheduler, partition, block);
        partition.entry_block = block;
        return block;
    }

    def instance_has_users(scheduler: InstancedSeaScheduler, inst: SchedulerInstance) -> bool {
        if (scheduler.instance_users == null || inst == null) return false;
        return scheduler.instance_users[inst.id].length > 0;
    }

    def instance_requires_entry(scheduler: InstancedSeaScheduler, inst: SchedulerInstance) -> bool {
        if (!instance_has_users(scheduler, inst)) return false;
        def bottom = if(inst.home != null, inst.home.default_bottom, scheduler.bottom_cfg);
        def uses = scheduler.instance_users[inst.id];

        for (i < uses.length) {
            def use = uses[i];
            match (use.role) {
                PhiCond => return true;
                _ => ;
            }
            if (use.user != null && use.user.placed_in != null &&
                !same_cfg_node(use.user.placed_in, bottom)) return true;
        }

        return false;
    }

    def place_instance(scheduler: InstancedSeaScheduler, inst: SchedulerInstance) {
        if (inst == null || inst.placed_in != null) return;

        if (inst.root != null && inst.root.is_phi()) {
            def frame = find_site_frame_for_phi_home(scheduler, inst.root, inst.home);
            if (frame != null) {
                frame.merge_cfg.phi_instances.put(inst);
                inst.placed_in = frame.merge_cfg;
                return;
            }
        }

        def dest = if(instance_requires_entry(scheduler, inst),
                      partition_entry_block(scheduler, inst.home),
                      if(inst.home != null, inst.home.default_bottom, scheduler.bottom_cfg));
        inst.placed_in = dest;
        match (dest) {
            block: ICFGBlock => if (should_emit_in_block(inst)) block.prims.put(inst);
            _ => ;
        }
    }

    def place_instances(scheduler: InstancedSeaScheduler) {
        if (scheduler.instances.length == 0) discover_instances(scheduler);
        clear_placements(scheduler);
        compute_instance_users(scheduler);

        def ready = Vector<SchedulerInstance>.new();
        for (i < scheduler.instances.length)
            if (scheduler.pending_users[i] == 0) ready.put(scheduler.instances[i]);

        var idx = 0;
        while (idx < ready.length) {
            def inst = ready[idx];
            idx += 1;
            if (inst.placed_in != null) continue;

            place_instance(scheduler, inst);

            def deps = scheduler.instance_deps[inst.id];
            for (j < deps.length) {
                def dep = deps[j].dep;
                if (dep == null) continue;
                if (dep.bottom_limit == null) dep.bottom_limit = inst.placed_in;
                scheduler.pending_users[dep.id] -= 1;
                if (scheduler.pending_users[dep.id] == 0) ready.put(dep);
            }
        }

        // Cycles should not occur, but keep inspection output total while the
        // checker phase is still under construction.
        for (i < scheduler.instances.length)
            if (scheduler.instances[i].placed_in == null) place_instance(scheduler, scheduler.instances[i]);
    }

}
