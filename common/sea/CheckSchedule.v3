type ScheduleError {
    case BadOrdering(want_fst: IRNode, want_snd: IRNode);

    def render(sb: StringBuilder) -> StringBuilder {
        match (this) {
            BadOrdering(fst, snd) =>
                sb.puts("Scheduled ").putq(fst.render).puts(" not dominating child ").putq(snd.render);
        }

        return sb;
    }
}

class ScheduleChecker {
    var errors: Vector<ScheduleError> = Vector.new();

    var cfg_bottom: ScheduleNode;
    var orig_sea: Sea;
    var orig_to_new: HashMap<IRNode, IRNode>;
    new(cfg_bottom, orig_sea, orig_to_new) {
    }

    def check() {
        orig_sea.rebuildChildren();
        check_ordering(cfg_bottom, ImmNodeSets.empty());
    }

    // returns dominants after check
    def check_ordering(cfg_node: ScheduleNode, dominants: ImmNodeSet) -> ImmNodeSet {
        match (cfg_node) {
            block: ScheduleBlock => {
                // iterate backwards through `prims`, updating `d` and checking
                // that all uses are dominated
                var d = dominants;
                for (i = block.prims.length - 1; i >= 0; i--) {
                    def prim = block.prims[i];
                    def node = prim.node;
                    check_uses_dominated(node, d);
                    d = d.with(node);
                }

                return if (block.prev != null, check_ordering(block.prev, d), d);
            }
            branch: ScheduleBranch => {
                // just check prev; phi checked branches
                // no-op, this is already checked by phi, and will already be encountered
                // when traversing l/r branches
                return dominants;
            }
            phi: SchedulePhi => {
                // Check phi uses are dominated
                // Check l and r source, dominating moves and phi node,
                // check source_branch, dominating nodes in each branch
                var phi_set = ImmNodeSet(null);
                for (cur = phi.phis; cur != null; cur = cur.tail) {
                    def phi_node = cur.head;
                    check_uses_dominated(phi_node, dominants);
                    phi_set = phi_set.with(phi_node);
                }

                def move_true = phi.source_branch.condition.move_true;
                def move_false = phi.source_branch.condition.move_false;

                def l_doms = check_ordering(phi.l_source, dominants.with(move_true));
                def r_doms = check_ordering(phi.r_source, dominants.with(move_false));

                return check_ordering(phi.source_branch.prev, l_doms.union(r_doms).without(move_true).without(move_false).union(phi_set));
            }
            _ => return dominants; // unreachable
        }
    }

    def check_uses_dominated(node: IRNode, dominants: ImmNodeSet) -> bool {
        def prev_err_len = errors.length;

        def children = node.children;
        for (i < children.length) {
            def child = children[i];
            if (child.id == node.id) continue;

            if ((IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op))
                && !(node.id == child.value_deps[0].id)
                && (node.id == child.value_deps[1].id || node.id == child.value_deps[2].id)) 
            {
                def cond = child.value_deps[0];
                if (node.id == child.value_deps[1].id && !dominants.has(cond.move_true))
                    errors.put(ScheduleError.BadOrdering(node, cond.move_true));
                else if (node.id == child.value_deps[2].id && !dominants.has(cond.move_false))
                    errors.put(ScheduleError.BadOrdering(node, cond.move_false));
            } else if (!dominants.has(child)) {
                errors.put(ScheduleError.BadOrdering(node, child));
            }
        }

        return errors.length == prev_err_len;
    }
}
