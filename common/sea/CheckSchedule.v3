type ScheduleError {
    case BadOrdering(want_fst: IRNode, want_snd: IRNode);
    case UnsatNeed(user: IRNode, needed: IRNode);
    case GraphDiff(diff: DiffResult);

    def render(sb: StringBuilder) -> StringBuilder => SeaRender.renderScheduleError(this, sb);
}

class ScheduleChecker {
    var errors: Vector<ScheduleError> = Vector.new();

    var cfg_top: ScheduleNode;
    var cfg_bottom: ScheduleNode;
    var orig_sea: Sea;
    var new_sea: Sea;
    var orig_to_new: HashMap<IRNode, IRNode>;
    new(cfg_top, cfg_bottom, orig_sea, new_sea, orig_to_new) { }

    def check() {
        orig_sea.rebuildChildren();
        new_sea.rebuildChildren();
        check_top_down(cfg_top, ImmNodeSets.empty());
        def graph_diff = new_sea.finish.graph_eq(orig_sea.finish);
        if (!DiffResult.GraphsEqual.?(graph_diff)) errors.put(ScheduleError.GraphDiff(graph_diff));
    }

    // returns scope
    def check_top_down(cfg_node: ScheduleNode, scope: ImmNodeSet) -> ImmNodeSet {
        match (cfg_node) {
            block: ScheduleBlock => {
                // iterate forwards through `prims`, updating s
                var s = scope;
                for (i < block.prims.length) {
                    def prim = block.prims[i];
                    def node = prim.node;
                    check_deps_in_scope(node, s);
                    s = s.with(node);
                }

                return if (block.next != null, check_top_down(block.next, s), s);
            }
            branch: ScheduleBranch => {
                check_deps_in_scope(branch.condition, scope);
                check_top_down(branch.l_branch, scope);
                check_top_down(branch.r_branch, scope);
                return check_top_down(branch.phi, scope);
            }
            phi: SchedulePhi => {
                var s = scope;
                for (p = phi.phis; p != null; p = p.tail) s = s.with(p.head);
                return if (phi.next != null, check_top_down(phi.next, s), s);
            }
            _ => return scope; // unreachable
        }
    }

    def check_deps_in_scope(node: IRNode, scope: ImmNodeSet) -> bool {
        def prev_err_len = errors.length;

        def deps = node.deps();
        for (i < deps.length) {
            def dep = deps[i];
            if (dep.id == node.id) continue;
            if (!scope.has(dep)) errors.put(ScheduleError.UnsatNeed(node, dep));
        }

        return errors.length == prev_err_len;
    }
}
