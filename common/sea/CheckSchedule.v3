type ScheduleError {
    case BadOrdering(want_fst: IRNode, want_snd: IRNode);
    case UnsatNeed(user: IRNode, needed: IRNode);
    case GraphDiff(diff: DiffResult);
    case PathEffectMismatch(path: Array<(IRNode, bool)>, sc: StateComponent, graph_only: Array<IRNode>, cfg_only: Array<IRNode>);

    def render(sb: StringBuilder) -> StringBuilder => SeaRender.renderScheduleError(this, sb);
}

class ScheduleChecker {
    var errors: Vector<ScheduleError> = Vector.new();

    var cfg_top: ScheduleNode;
    var cfg_bottom: ScheduleNode;
    var orig_sea: Sea;
    var new_sea: Sea;
    var orig_to_new: HashMap<IRNode, IRNode>;
    new(cfg_top, cfg_bottom, orig_sea, new_sea, orig_to_new) { }

    def check() {
        orig_sea.rebuildChildren();
        new_sea.rebuildChildren();
        check_top_down(cfg_top, ImmNodeSets.empty());
        def graph_diff = new_sea.finish.graph_eq(orig_sea.finish);
        if (!DiffResult.GraphsEqual.?(graph_diff)) errors.put(ScheduleError.GraphDiff(graph_diff));
        check_path_effects();
    }

    def check_top_down(cfg_node: ScheduleNode, scope: ImmNodeSet) -> ImmNodeSet {
        match (cfg_node) {
            block: ScheduleBlock => {
                var s = scope;
                for (i < block.prims.length) {
                    def prim = block.prims[i];
                    def node = prim.node;
                    check_deps_in_scope(node, s);
                    s = s.with(node);
                }
                return if (block.next != null, check_top_down(block.next, s), s);
            }
            branch: ScheduleBranch => {
                check_deps_in_scope(branch.condition, scope);
                check_top_down(branch.l_branch, scope);
                check_top_down(branch.r_branch, scope);
                return check_top_down(branch.phi, scope);
            }
            phi: SchedulePhi => {
                var s = scope;
                for (p = phi.phis; p != null; p = p.tail) s = s.with(p.head);
                return if (phi.next != null, check_top_down(phi.next, s), s);
            }
            _ => return scope;
        }
    }

    def check_deps_in_scope(node: IRNode, scope: ImmNodeSet) -> bool {
        def prev_err_len = errors.length;
        def deps = node.deps();
        for (i < deps.length) {
            def dep = deps[i];
            if (dep.id == node.id) continue;
            if (!scope.has(dep)) errors.put(ScheduleError.UnsatNeed(node, dep));
        }
        return errors.length == prev_err_len;
    }

    def check_path_effects() {
        def conditions = Vector<IRNode>.new();
        def seen = NodeSet.new();
        for (i < new_sea.nodes_by_id.length) {
            def node = new_sea.nodes_by_id[i];
            if (node != null && node.is_phi() && node.value_deps.length >= 3) {
                def cond = node.value_deps[0];
                if (cond != null && !seen.has(cond)) {
                    seen.put(cond);
                    conditions.put(cond);
                }
            }
        }
        if (conditions.length == 0) return;

        def n = conditions.length;
        var combo: byte = 0;
        def limit: byte = byte.!(1) << byte.!(n);
        while (combo < limit) {
            def assignment = Array<(IRNode, bool)>.new(n);
            for (i < n) assignment[i] = (conditions[i], ((combo >> byte.!(i)) & 1) != 0);

            for (sc in StateComponent.set.all) {
                def graph_effs = NodeSet.new();
                def visited = NodeSet.new();
                walk_graph_chain(new_sea.finish.state_deps[sc.tag], sc, assignment, graph_effs, visited);

                def cfg_effs = NodeSet.new();
                walk_cfg_chain(cfg_top, sc, assignment, cfg_effs);

                def graph_only = Vector<IRNode>.new();
                def cfg_only = Vector<IRNode>.new();
                graph_effs.apply(fun (node: IRNode) { if (!cfg_effs.has(node)) graph_only.put(node); });
                cfg_effs.apply(fun (node: IRNode) { if (!graph_effs.has(node)) cfg_only.put(node); });

                if (graph_only.length > 0 || cfg_only.length > 0) {
                    errors.put(ScheduleError.PathEffectMismatch(
                        assignment, sc, graph_only.extract(), cfg_only.extract()));
                }
            }
            combo++;
        }
    }

    def walk_graph_chain(node: IRNode, sc: StateComponent, assignment: Array<(IRNode, bool)>,
                         effects: NodeSet, visited: NodeSet) {
        if (node == null || visited.has(node)) return;
        visited.put(node);
        match (node.op) {
            Start => return;
            StatePhi(statecomps) => {
                if (sc < statecomps) {
                    def cond = node.value_deps[0];
                    def chosen = if(lookup_cond(cond, assignment), node.value_deps[1], node.value_deps[2]);
                    walk_graph_chain(chosen, sc, assignment, effects, visited);
                } else {
                    walk_graph_chain(node.state_deps[sc.tag], sc, assignment, effects, visited);
                }
            }
            Intrinsic(defn) => {
                if (sc < defn.writes) effects.put(node);
                walk_graph_chain(node.state_deps[sc.tag], sc, assignment, effects, visited);
            }
            _ => {
                if (sc.tag < node.state_deps.length)
                    walk_graph_chain(node.state_deps[sc.tag], sc, assignment, effects, visited);
            }
        }
    }

    def walk_cfg_chain(cfg_node: ScheduleNode, sc: StateComponent,
                       assignment: Array<(IRNode, bool)>, effects: NodeSet) {
        if (cfg_node == null) return;
        match (cfg_node) {
            block: ScheduleBlock => {
                for (i < block.prims.length) {
                    def node = block.prims[i].node;
                    if (IROp.Intrinsic.?(node.op) && sc < IROp.Intrinsic.!(node.op).defn.writes)
                        effects.put(node);
                }
                walk_cfg_chain(block.next, sc, assignment, effects);
            }
            branch: ScheduleBranch => {
                def val = lookup_cond(branch.condition, assignment);
                if (val) walk_cfg_chain(branch.l_branch, sc, assignment, effects);
                else walk_cfg_chain(branch.r_branch, sc, assignment, effects);
                walk_cfg_chain(branch.phi, sc, assignment, effects);
            }
            phi: SchedulePhi => {
                walk_cfg_chain(phi.next, sc, assignment, effects);
            }
            _ => ;
        }
    }

    def lookup_cond(cond: IRNode, assignment: Array<(IRNode, bool)>) -> bool {
        for (i < assignment.length) {
            if (assignment[i].0.id == cond.id) return assignment[i].1;
        }
        return true;
    }
}
