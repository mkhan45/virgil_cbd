class NodeSet {
    var m: HashMap<IRNode, void>;
    new() {
        m = HashMap<IRNode, void>.new(IRNode.hash, IRNode.eq);
    }

    def has(node: IRNode) -> bool => m.has(node);
    def put(node: IRNode) -> this { m[node] = void; }
    def remove(node: IRNode) -> this { if (node != null && m.has(node)) m.remove(node); }
    def apply(f: IRNode -> void) => void(m.apply(fun (k, v) => f(k)));
    def toVector() -> Vector<IRNode> {
        def buf = Vector<IRNode>.new();
        apply(fun (n: IRNode) => void(buf.put(n)));
        return buf;
    }
    def intersection(other: NodeSet) -> NodeSet {
        def result = NodeSet.new();
        m.apply(fun (k: IRNode, v: void) {
            if (other.has(k)) result.put(k);
        });
        return result;
    }
}

type ImmNodeSet(ls: List<IRNode>) {
    def with(n: IRNode) => if(has(n), this, ImmNodeSet(List.new(n, ls)));

    def without(n: IRNode) -> ImmNodeSet {
        var new_ls: List<IRNode> = null;
        for (cur = ls; cur != null; cur = cur.tail) 
            if (cur.head.id != n.id) new_ls = List.new(cur.head, new_ls);

        return ImmNodeSet(new_ls);
    }

    def has(n: IRNode) -> bool {
        for (cur = ls; cur != null; cur = cur.tail) 
            if (cur.head.id == n.id) return true;

        return false;
    }

    def intersection(other: ImmNodeSet) -> ImmNodeSet {
        var res = ImmNodeSet(null);
        for (cur = ls; cur != null; cur = cur.tail) 
            if (other.has(cur.head)) res = res.with(cur.head);

        return res;
    }

    def union(other: ImmNodeSet) -> ImmNodeSet {
        var res = ImmNodeSet(null);
        for (cur = ls; cur != null; cur = cur.tail) res = res.with(cur.head);
        for (cur = other.ls; cur != null; cur = cur.tail) res = res.with(cur.head);
        return res;
    }

    def render(sb: StringBuilder) -> StringBuilder {
        for (cur = ls; cur != null; cur = cur.tail) sb.putq(cur.head.render).puts(", ");
        return sb;
    }
}

component ImmNodeSets {
    def empty() => ImmNodeSet(null);
    def single(n: IRNode) => ImmNodeSet(List.new(n, null));
}

def uidl = SSAD_IR.uidl;
def intrinsic(name: string) -> IntrinsicTypedef {
    def defn = IntrinsicTypes.intrinsic_types[name];
    if (defn != null) 
        return defn;
    else
        return IntrinsicTypedef.new(name, null, null, CBDEffect.None);
}

type SearchNode(node: IRNode, path: SSAD, available: ImmNodeSet, depth: int) {
    def dbg() {
        System.puts(Strings.format1("Node: %q", node.render));
        System.ln();
        System.puts("available: ");
        for (cur = available.ls; cur != null; cur = cur.tail) {
            System.puts(Strings.format1("%q ", cur.head.render));
        }
        System.ln();
        System.puts("path:\n");
        System.puts(path.toString(1));
        System.ln();
    }
}
type SearchRes(success: bool, point: SearchNode);

class Sea {
    var start: IRNode;
    var finish: IRNode;
    var void_node: IRNode;
    var nodes: NodeSet;
    var id_count: int;

    var var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
    var lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

    new() {
        initEmpty();
        initDefault();
    }

    def initEmpty() {
        nodes = NodeSet.new();
        id_count = 0;
        var_nodes = Strings.newMap<IRNode>();
        lit_nodes = Strings.newMap<IRNode>();
    }

    def initDefault() {
        var max_state_tag = 0;
        for (sc in StateComponent.set.all) max_state_tag = if(sc.tag > max_state_tag, sc.tag, max_state_tag);
        def state_vars = Array<IRNode>.new(max_state_tag + 1);

        start = mkNode(IROp.Start, Array.new(state_vars.length), []);

        for (i < state_vars.length) state_vars[i] = start;
        finish = mkNode(IROp.Finish, Arrays.dup(state_vars), []);

        def void_node = mkNode(IROp.Lit(TypeVar.Bot("void"), "(void)"), Arrays.dup(state_vars), []);
        void_node.var_data = VarData.new("void", TypeVar.Bot("void"), Stage.VALIDATE);
        var_nodes["void"] = void_node;
    }

    def mkNode(op: IROp, state_deps: Array<IRNode>, value_deps: Array<IRNode>) -> IRNode {
        def node = IRNode.new(op, id_count);
        node.state_deps = state_deps;
        node.value_deps = value_deps;
        id_count += 1;

        if (!IROp.Lit.?(op))
            for (dep in node.deps()) dep.children.put(node);

        return node;
    }

    def project(parent: IRNode, val: bool) -> IRNode {
        def node = IRNode.new(IROp.Proj(val), 0);
        node.state_deps = Array<IRNode>.new(finish.state_deps.length);
        node.value_deps = [parent];

        for (dep in node.deps()) dep.children.put(node);

        return node;
    }

    def dupNode(node: IRNode) -> IRNode {
        def n = mkNode(node.op, node.state_deps, node.value_deps);
        if(node.var_data != null) n.var_data = VarData.new(uidl(node.var_data.sourceName), node.var_data.tipe, node.var_data.stage);
        return n;
    }

    def isAncestor(high: IRNode, low: IRNode) -> bool {
        if (high == low) return true;
        if (high == null || low == null) return false;
        return low.transitiveDepsSet().has(high);
    }

    def isDescendant(low: IRNode, high: IRNode) => isAncestor(high, low);

    def lowestCommonAncestor(a: IRNode, b: IRNode) -> IRNode {
        // Collect ancestors of a
        def a_ancestors = a.transitiveDepsSet();
        a_ancestors.put(a);

        // BFS from b to find first intersection
        def wl = Vector<IRNode>.new();
        def visited = NodeSet.new();
        wl.put(b);
        var idx = 0;
        while (idx < wl.length) {
            def node = wl[idx];
            idx += 1;
            if (node == null || visited.has(node)) continue;
            if (a_ancestors.has(node)) return node;
            visited.put(node);
            for (dep in node.deps()) wl.put(dep);
        }

        return start;
    }

    def lca2(a: IRNode, b: IRNode) -> IRNode {
        var a_lca: IRNode = a;
        if (IROp.Phi.?(a.op) || IROp.StatePhi.?(a.op)) a_lca = lca2(a.value_deps[1], a.value_deps[2]);

        var b_lca: IRNode = b;
        if (IROp.Phi.?(b.op) || IROp.StatePhi.?(b.op)) b_lca = lca2(b.value_deps[1], b.value_deps[2]);

        return lowestCommonAncestor(a_lca, b_lca);
    }

    def findTop(left: IRNode, right: IRNode) -> Vector<IRNode> {
        def leftDeps = left.transitiveDepsSet().put(left);
        def rightDeps = right.transitiveDepsSet().put(right);

        def common = leftDeps.intersection(rightDeps);
        def commonVec = common.toVector();

        def results = Vector<IRNode>.new();
        for (i < commonVec.length) {
            def cn = commonVec[i];
            var isRoot = true;
            for (i < cn.children.length) {
                if (common.has(cn.children[i])) {
                    isRoot = false;
                    break;
                }
            }
            if (isRoot) return results.put(cn);
        }

        return results;
    }

    def findTop2(a: IRNode, b: IRNode) -> Vector<IRNode> {
        var a_lca: IRNode = a;
        if (IROp.Phi.?(a.op) || IROp.StatePhi.?(a.op)) a_lca = lca2(a.value_deps[1], a.value_deps[2]);

        var b_lca: IRNode = b;
        if (IROp.Phi.?(b.op) || IROp.StatePhi.?(b.op)) b_lca = lca2(b.value_deps[1], b.value_deps[2]);

        return findTop(a_lca, b_lca);
    }

    def highestCommonDescendant(a: IRNode, b: IRNode) -> IRNode {
        // BFS from a to collect descendants
        def a_descendants = NodeSet.new();
        def wl = Vector<IRNode>.new();
        wl.put(a);
        var idx = 0;
        while (idx < wl.length) {
            def node = wl[idx];
            idx += 1;
            if (node == null || a_descendants.has(node)) continue;
            a_descendants.put(node);
            for (i < node.children.length) wl.put(node.children[i]);
        }

        // BFS from b to find first intersection
        def b_wl = Vector<IRNode>.new();
        def b_visited = NodeSet.new();
        b_wl.put(b);
        idx = 0;
        while (idx < b_wl.length) {
            def node = b_wl[idx];
            idx += 1;
            if (node == null || b_visited.has(node)) continue;
            if (a_descendants.has(node)) return node;
            b_visited.put(node);
            for (i < node.children.length) b_wl.put(node.children[i]);
        }

        return finish;
    }

    def addSSAD(ssad: SSAD, state_vars: Array<IRNode>, deps: List<IRNode>) {
        match (ssad) {
            LetApp(n, f, args, rest) => {
                def arg_nodes: Array<IRNode> = Arrays.map(args, fun (a: string) => var_nodes[a]);
                var intrinsic_def = intrinsic(f);

                def state_deps = Array<IRNode>.new(state_vars.length);
                for (sc in intrinsic_def.reads | intrinsic_def.writes)
                    state_deps[sc.tag] = state_vars[sc.tag];

                def op = IROp.Intrinsic(intrinsic_def);
                def node = var_nodes[n] = mkNode(op, state_deps, arg_nodes);

                for (sc in intrinsic_def.writes) state_vars[sc.tag] = node;

                def tipe = if(intrinsic_def.return_type != null, intrinsic_def.return_type.primitive, TypeVar.Bot("bot"));
                var stage = if(intrinsic_def.return_type != null, intrinsic_def.return_type.stage, Stage.VALIDATE);
                for (arg in arg_nodes) {
                    if (stage != Stage.INTERPRET && arg.var_data.stage == Stage.INTERPRET) stage = Stage.INTERPRET;
                    if (stage == Stage.VALIDATE && arg.var_data.stage == Stage.COMPILE) stage = Stage.COMPILE;
                }
                node.var_data = VarData.new(n, tipe, stage);

                addSSAD(rest, state_vars, deps);
            }
            LetLit(n, l, t, rest) => {
                var node: IRNode;
                if (lit_nodes.has(l)) {
                    node = var_nodes[n] = lit_nodes[l];
                } else {
                    def tp = TypeUtil.fromString(t);
                    def op = IROp.Lit(tp, l);
                    def node = var_nodes[n] = mkNode(op, start.state_deps, []);
                    lit_nodes[l] = node;
                    node.var_data = VarData.new(n, tp, Stage.VALIDATE);
                }

                addSSAD(rest, state_vars, deps);
            }
            If(cond, then, els, phis, rest) => {
                def else_phis = Strings.newMap<IRNode>();

                def else_state = Arrays.dup(state_vars);
                addSSAD(els, else_state, deps);
                for (phi in phis) {
                    if (var_nodes.has(phi.1))
                        else_phis[phi.0] = var_nodes[phi.1]; // take from else branch
                    else if (!else_phis.has(phi.0))
                        else_phis[phi.0] = var_nodes[phi.0]; // default to prev val
                }

                def then_phis = Strings.newMap<IRNode>();
                def then_state = Arrays.dup(state_vars);
                addSSAD(then, then_state, deps);
                for (phi in phis) {
                    if (!else_phis.has(phi.1) && var_nodes.has(phi.1))
                        then_phis[phi.0] = var_nodes[phi.1];
                }

                def cond_node = var_nodes[cond];

                def phi_map = Strings.newMap<IRNode>();
                for (phi in phis) {
                    def phi_var = phi.0;
                    if (!phi_map.has(phi_var)) {
                        def left = then_phis[phi_var], right = else_phis[phi_var];
                        right.var_data.sourceName = uidl(phi_var);
                        def node = mkNode(IROp.Phi, Array.new(state_vars.length), [cond_node, left, right]);
                        var_nodes[phi_var] = node;
                        var stage = cond_node.var_data.stage;
                        if (left.var_data.stage == Stage.INTERPRET) stage = Stage.INTERPRET;
                        if (right.var_data.stage == Stage.INTERPRET) stage = Stage.INTERPRET;
                        node.var_data = VarData.new(phi_var, left.var_data.tipe, stage);
                        phi_map[phi_var] = node;
                    }
                }

                // we merge state phis if they have the same left/right sources
                def state_phis = Vector<(IRNode, IRNode, StateComponent.set)>.new();
                for (sc in StateComponent.set.all) {
                    def left_sv = then_state[sc.tag], right_sv = else_state[sc.tag];
                    if (left_sv.id != right_sv.id) {
                        var idx = -1;
                        for (i < state_phis.length) {
                            def sp = state_phis[i];
                            if (sp.0.id == left_sv.id && sp.1.id == right_sv.id) {
                                idx = i;
                                break;
                            }
                        }
                        if (idx == -1) state_phis.put((left_sv, right_sv, sc));
                        else state_phis[idx] = (left_sv, right_sv, state_phis[idx].2 | sc);
                    }
                }

                for (i < state_phis.length) {
                    def left = state_phis[i].0, right = state_phis[i].1, scs = state_phis[i].2;
                    def phi_state_deps = Array<IRNode>.new(state_vars.length);
                    def node = mkNode(IROp.StatePhi(scs), phi_state_deps, [cond_node, left, right]);

                    for (sc in scs) state_vars[sc.tag] = node;
                }

                addSSAD(rest, state_vars, deps);
            }
            Match => {}
            Void => {}
            Injected => {}
            Final => {}
        }
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        buf.puts("---").ln();
        buf.puts("config:").ln();
        buf.puts("  layout: elk").ln();
        buf.puts("---").ln();
        buf.puts("graph TD").ln();

        return toMermaidExt("", buf).toString();
    }

    def toMermaidExt(tag: string, buf: StringBuilder) -> StringBuilder {
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        wl.push(finish);

        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n)) continue;
            visited.put(n);
            n.toMermaidNode(buf, tag);

            for (arg in n.value_deps) {
                buf.tab().puts(tag).putd(arg.id).puts(" --> ").puts(tag).putd(n.id).ln();
            }
            def state_set = Vector<(IRNode, StateComponent.set)>.new();
            for (sc in StateComponent.set.all) if (n.state_deps[sc.tag] != null) {
                def dep = n.state_deps[sc.tag];
                var idx = -1;
                for (i < state_set.length) {
                    if (state_set[i].0.id == dep.id) {
                        idx = i;
                        break;
                    }
                }
                if (idx == -1) state_set.put((dep, sc));
                else state_set[idx] = (dep, state_set[idx].1 | sc);
            }
            for (i < state_set.length) {
                def dep = state_set[i].0, scs = state_set[i].1;
                buf.tab().puts(tag).putd(dep.id).puts(" -. ");
                for (sc in scs) {
                    buf.puts(sc.name).puts(" ");
                }
                buf.puts(".-> ").puts(tag).putd(n.id).ln();
            }

            for (i < n.schedule_children.length) {
                def child = n.schedule_children[i];
                buf.tab().puts(tag).putd(n.id).puts(" ==> ").puts(tag).putd(child.id).ln();
            }

            // for (dep in n.ctl_deps()) {
            //     buf.tab().puts(tag).putd(dep.id).puts(".-> ").puts(tag).putd(n.id).ln();
            // }

            for (dep in n.deps()) {
                wl.push(dep);
            }
        }

        return buf;
    }

    def apply<T>(init: T, f: (IRNode, Sea, T) -> Range<IRNode>) {
        def wl: Vector<IRNode> = Vector.new();
        var q_idx = 0;
        wl.put(finish);

        var completed = NodeSet.new();

        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;

            if (completed.has(node)) continue;
            completed.put(node);

            def next = f(node, this, init);
            for (arg in next) {
                wl.put(arg);
            }
        }
    }

    def subgraph(bottom: IRNode, top: IRNode) -> Sea {
        def sub_sea = Sea.new();
        sub_sea.finish = bottom;
        sub_sea.start = top;
        return sub_sea;
    }

    def subgraph2(top: IRNode, bot: IRNode, stop_at_phis: bool) -> ImmNodeSet {
        if (top == null || bot == null) return ImmNodeSets.empty();
        if (top.id == bot.id) return ImmNodeSets.single(top);
        
        def visited = NodeSet.new();
        return collectPaths(top, bot, top, visited, stop_at_phis);
    }

    // TODO: stopping at phis here is not completely good
    def collectPaths(top: IRNode, bot: IRNode, node: IRNode, visited: NodeSet, stop_at_phis: bool) -> ImmNodeSet {
        if (visited.has(node)) return ImmNodeSets.empty();
        
        visited.put(node);
        
        if (node.id == bot.id) {
            visited.remove(node);
            return ImmNodeSets.single(node);
        }
        
        var result = ImmNodeSets.empty();
        for (i < node.children.length) {
            def child = node.children[i];
            if (stop_at_phis && (IROp.Phi.?(child.op) || IROp.StatePhi.?(child.op))) continue;
            def childPaths = collectPaths(top, bot, child, visited, stop_at_phis);
            if (childPaths.ls != null) {
                result = result.with(node).union(childPaths);
            }
        }
        
        return result;
    }

    def rebuildChildren() {
        def allNodes = Vector<IRNode>.new();
        def visited = NodeSet.new();
        def wl = Vector<IRNode>.new();
        wl.put(finish);
        var idx = 0;

        while (idx < wl.length) {
            def node = wl[idx];
            idx += 1;
            if (node == null || visited.has(node)) continue;
            visited.put(node);
            allNodes.put(node);
            node.children = Vector.new();
            for (dep in node.deps()) wl.put(dep);
        }

        for (i < allNodes.length) {
            def node = allNodes[i];
            if (IROp.Lit.?(node.op)) continue;
            for (dep in node.deps()) dep.children.put(node);
        }
    }

    def schedule() -> SSAD {
        var available = ImmNodeSets.single(start);
        var path: SSAD = SSAD.Void;
        def startPoint = SearchNode(finish, path, available, 0);
        def res = scheduleNodes(startPoint);
        return res.point.path;
    }

    // DFS scheduler, but it has to figure out control
    // dependencies from StatePhis
    def scheduleNodes(point: SearchNode) -> SearchRes {
        def node = point.node;
        var path = point.path;
        var available = point.available;
        var depth = point.depth;

        // point.dbg();

        // If a node is used as a condition for any phis, we
        // use it to also schedule a branch.
        // So first we schedule the actual bool condition evaluation,
        // and then create an If for any branch children that are ready.
        // Bool conditions are potentially visited more than once until
        // all of the branches are scheduled, but its actual evaluation
        // is only scheduled once.

        // record if the current node is a conditional for any phis
        // that have not already been scheduled
        var phis: List<IRNode> = null;
        var state_phis: List<IRNode> = null;
        if (node.var_data != null) for (i < node.children.length) {
            def child = node.children[i];
            if (!(IROp.Phi.?(child.op) || IROp.StatePhi.?(child.op))) continue; 
            if (available.has(child)) continue;
            def ctl_deps = child.ctl_deps();
            var child_ready = true;
            for (dep in ctl_deps) {
                child_ready &= available.has(dep.value_deps[0]);
                def branch_deps = Vector<IRNode>.new();
                for (td in dep.value_deps[0].transitiveDeps(start)) child_ready &= available.has(td);
                def left = dep.value_deps[1], right = dep.value_deps[2];
                def leftDeps = left.transitiveDeps(node), rightDeps = right.transitiveDeps(node);
                for (l in leftDeps) for (r in rightDeps) if (l.id == r.id) branch_deps.put(l);
            }
            if (!child_ready) continue;
            if (IROp.Phi.?(child.op) && child.value_deps[0].id == node.id) phis = List.new(child, phis);
            if (IROp.StatePhi.?(child.op) && child.value_deps[0].id == node.id) state_phis = List.new(child, state_phis);
        }
        if (available.has(node) && phis == null && state_phis == null) return SearchRes(true, point);

        var deps: Array<IRNode>;
        match (node.op) {
            StatePhi(scs) => deps = [node.value_deps[0]];
            Phi => deps = [node.value_deps[0]];
            _ => {
                if (phis == null && state_phis == null) {
                    deps = node.deps();
                } else {
                    def res = Vector<IRNode>.new();
                    for (phi = phis; phi != null; phi = phi.tail) {
                        def left = phi.head.value_deps[1], right = phi.head.value_deps[2];
                        def leftDeps = left.transitiveDeps(node), rightDeps = right.transitiveDeps(node);
                        for (l in leftDeps) for (r in rightDeps) if (l.id == r.id) res.put(l);
                    }
                    for (phi = state_phis; phi != null; phi = phi.tail) {
                        def left = phi.head.value_deps[1], right = phi.head.value_deps[2];
                        def leftDeps = left.transitiveDeps(node), rightDeps = right.transitiveDeps(node);
                        for (l in leftDeps) for (r in rightDeps) if (l.id == r.id) res.put(l);
                    }
                    def filter_res = Vector<IRNode>.new();
                    def cond_transdeps = node.transitiveDeps(start);
                    for (i < res.length) {
                        var high = false;
                        for (j < cond_transdeps.length) high |= (cond_transdeps[j].id == res[i].id);
                        if (!high) filter_res.put(res[i]);
                    }
                    filter_res.puta(node.deps());
                    deps = dedup(filter_res.copy());
                }
            }
        }

        var curPoint = point;
        for (dep in deps) {
            def depPoint = SearchNode(dep, curPoint.path, curPoint.available, curPoint.depth);
            def depRes = scheduleNodes(depPoint);
            if (!depRes.success) return depRes;

            curPoint = depRes.point;
        }
        path = curPoint.path;
        available = curPoint.available;

        var newPath = path;

        if (!available.has(node)) {
            match (node.op) {
                Intrinsic(defn) => {
                    def args = Arrays.map(node.value_deps, fun (n: IRNode) => n.var_data.sourceName);
                    newPath = newPath.appended(SSAD.LetApp(node.var_data.sourceName, defn.name, args, SSAD.Void));
                }
                Lit(tipe, rep) => {
                    newPath = newPath.appended(SSAD.LetLit(node.var_data.sourceName, rep, tipe.long_str(), SSAD.Void));
                }
                _ => {}
            }
        }
        var availableAfter = available.with(node);

        if (phis == null && state_phis == null) {
            def nextPoint = SearchNode(node, newPath, availableAfter, depth);
            return SearchRes(true, nextPoint);
        } else {
            var needed_left = ImmNodeSets.empty();
            var needed_right = ImmNodeSets.empty();
            for (cur = phis; cur != null; cur = cur.tail) {
                def left = cur.head.value_deps[1];
                def right = cur.head.value_deps[2];
                if (!available.has(left)) needed_left = needed_left.with(left);
                if (!available.has(right)) needed_right = needed_right.with(right);
                availableAfter = availableAfter.with(cur.head);
            }
            for (cur = state_phis; cur != null; cur = cur.tail) {
                needed_left = needed_left.with(cur.head.value_deps[1]);
                needed_right = needed_right.with(cur.head.value_deps[2]);
                availableAfter = availableAfter.with(cur.head);
            }

            var leftPoint = SearchNode(node, SSAD.Void, availableAfter, depth + 1);
            for (l = needed_left.ls; l != null; l = l.tail) {
                def phi_point = SearchNode(l.head, leftPoint.path, leftPoint.available, depth + 1);
                def phi_search = scheduleNodes(phi_point);
                if (!phi_search.success) return phi_search;
                leftPoint = phi_search.point;
            }
            var rightPoint = SearchNode(node, SSAD.Void, availableAfter, depth + 1);
            for (r = needed_right.ls; r != null; r = r.tail) {
                def phi_point = SearchNode(r.head, rightPoint.path, rightPoint.available, depth + 1);
                def phi_search = scheduleNodes(phi_point);
                if (!phi_search.success) return phi_search;
                rightPoint = phi_search.point;
            }
            availableAfter = availableAfter.union(leftPoint.available.intersection(rightPoint.available));

            def phi_vec = Vector<(string, string)>.new();
            for (cur = phis; cur != null; cur = cur.tail) {
                def phi = cur.head;
                def left = phi.value_deps[1];
                def right = phi.value_deps[2];
                if (left != null) phi_vec.put((phi.var_data.sourceName, left.var_data.sourceName));
                if (right != null) phi_vec.put((phi.var_data.sourceName, right.var_data.sourceName));
                newPath = newPath.appended(SSAD.Injected(Strings.format2("var %s: %s;", phi.var_data.sourceName, phi.var_data.tipe.long_str()), SSAD.Void));
            }

            newPath = newPath.appended(SSAD.If(node.var_data.sourceName, leftPoint.path, rightPoint.path, phi_vec.copy(), SSAD.Void));

            def nextPoint = SearchNode(node, newPath, availableAfter, depth);
            return SearchRes(true, nextPoint);
        }
    }

    def scheduleExp() {
        def wl = Vector<IRNode>.new();
        wl.put(finish);

        def completed = Vector<IRNode>.new();

        var q_idx = 0;
        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;
            if (node.schedule_parent != null) continue;

            def parent = scheduleIntoTree(node, start, ImmNodeSets.single(start));
            if (parent == null) {
                for (d in node.deps()) if (d.schedule_parent == null && d.id != start.id) wl.put(d);
                wl.put(node);
            } else {
                completed.put(node);
            }
        }
    }

    def scheduleIntoTree(node: IRNode, tree: IRNode, available: ImmNodeSet) -> IRNode {
        if (node.schedule_parent != null) return node.schedule_parent;

        var ready = true;
        var deps: Array<IRNode>;
        match (node.op) {
            StatePhi(scs) => deps = [node.value_deps[0]];
            Phi => deps = [node.value_deps[0]];
            _ => deps = node.deps();
        }
        for (d in deps) ready &= available.has(d);

        if (ready) {
            tree.schedule_children.put(node);
            node.schedule_parent = tree;
            return tree;
        } else {
            for (i < tree.schedule_children.length) {
                def child = tree.schedule_children[i];
                def res = scheduleIntoTree(node, child, available.with(child));
                if (res != null) return res;
            }
            return null;
        }
    }
}

component Seas {
    def ofSSAD(node: SSAD) -> Sea {
        def sea = Sea.new();

        def state_vars = sea.finish.state_deps;
        sea.addSSAD(node, state_vars, List.new(sea.start, null));
        return sea;
    }

    def cloneSubgraph(sea: Sea, subgraph: ImmNodeSet) -> (ImmNodeSet, HashMap<IRNode, IRNode>) {
        def mapping = HashMap<IRNode, IRNode>.new(IRNode.hash, IRNode.eq);

        // clone all nodes in the subgraph
        for (cur = subgraph.ls; cur != null; cur = cur.tail) {
            def old_node = cur.head;
            def new_node = IRNode.new(old_node.op, sea.id_count);
            sea.id_count += 1;

            new_node.state_deps = Array<IRNode>.new(old_node.state_deps.length);
            new_node.value_deps = Array<IRNode>.new(old_node.value_deps.length);

            if (old_node.var_data != null) {
                new_node.var_data = VarData.new(
                    uidl(old_node.var_data.sourceName),
                    old_node.var_data.tipe,
                    old_node.var_data.stage
                );
            }

            mapping[old_node] = new_node;
            sea.nodes.put(new_node);
        }

        // Fix edges, remap internal deps but leave external ones
        for (cur = subgraph.ls; cur != null; cur = cur.tail) {
            def old_node = cur.head;
            def new_node = mapping[old_node];

            for (j < old_node.value_deps.length) {
                def dep = old_node.value_deps[j];
                if (dep != null) {
                    new_node.value_deps[j] = if(subgraph.has(dep), mapping[dep], dep);
                }
            }

            for (j < old_node.state_deps.length) {
                def dep = old_node.state_deps[j];
                if (dep != null) {
                    new_node.state_deps[j] = if(subgraph.has(dep), mapping[dep], dep);
                }
            }
        }

        var result = ImmNodeSets.empty();
        for (cur = subgraph.ls; cur != null; cur = cur.tail)
            result = result.with(mapping[cur.head]);

        return (result, mapping);
    }

    def clone(sea: Sea) -> Sea {
        // Phase 1: Create empty Sea
        def new_sea = Sea.new();
        sea.rebuildChildren();
        new_sea.initEmpty();
        def mapping = HashMap<IRNode, IRNode>.new(IRNode.hash, IRNode.eq);

        // Phase 2: Create cloned nodes using existing nodes set
        sea.nodes.apply(fun (old_node: IRNode) {
            def new_node = IRNode.new(old_node.op, new_sea.id_count);
            new_sea.id_count += 1;
            new_node.state_deps = Array<IRNode>.new(old_node.state_deps.length);
            new_node.value_deps = Array<IRNode>.new(old_node.value_deps.length);
            mapping[old_node] = new_node;
            new_sea.nodes.put(new_node);
        });

        // Phase 3: Rewire edges and clone VarData
        sea.nodes.apply(fun (old_node: IRNode) {
            def new_node = mapping[old_node];

            for (j < old_node.value_deps.length) {
                if (old_node.value_deps[j] != null) {
                    new_node.value_deps[j] = mapping[old_node.value_deps[j]];
                }
            }
            for (j < old_node.state_deps.length) {
                if (old_node.state_deps[j] != null) {
                    new_node.state_deps[j] = mapping[old_node.state_deps[j]];
                }
            }

            if (old_node.var_data != null) {
                new_node.var_data = VarData.new(
                    old_node.var_data.sourceName,
                    old_node.var_data.tipe,
                    old_node.var_data.stage
                );
            }
        });

        // Phase 4: Set Sea references and rebuild children
        new_sea.start = mapping[sea.start];
        new_sea.finish = mapping[sea.finish];
        new_sea.rebuildChildren();

        return new_sea;
    }
}

def dedup(arr: Array<IRNode>) -> Array<IRNode> {
    def res = Vector<IRNode>.new();
    for (n in arr) {
        if (n == null) continue;
        var dup = false;
        for (i < res.length) dup |= res[i].id == n.id;
        if (!dup) res.put(n);
    }
    return res.copy();
}

class IRNode {
    var op: IROp;
    var id: int;
    var var_data: VarData;

    var value_deps: Array<IRNode>;
    var state_deps: Array<IRNode>; // idx = statecomp.tag
    var children: Vector<IRNode>;

    var schedule_children: Vector<IRNode>;
    var schedule_parent: IRNode;

    var ctl_dep: IRNode;
    var move_true: IRNode;
    var move_false: IRNode;

    new(op, id) {
        children = Vector.new();
        schedule_children = Vector.new();
        ctl_dep = null;
    }

    def deps() -> Array<IRNode> {
        return dedup(Arrays.concat(value_deps, state_deps));
    }

    def ctl_deps() -> Array<IRNode> {
        def res = Vector<IRNode>.new();
        for (i < children.length) {
            def child = children[i];
            if (IROp.StatePhi.?(child.op) || IROp.Phi.?(child.op)) {
                def left = child.value_deps[1], right = child.value_deps[2];
                if (id == left.id || id == right.id) res.put(child);
            }
        }
        return dedup(res.copy());
    }

    def transitiveDeps(limit: IRNode) -> Array<IRNode> {
        def res = Vector<IRNode>.new();
        match (op) {
            Phi, StatePhi => {
                def cond = value_deps[0], left = value_deps[1], right = value_deps[2];
                def leftDeps = left.transitiveDeps(limit), rightDeps = right.transitiveDeps(limit);
                for (l in leftDeps) for (r in rightDeps) if (l.id == r.id && l.id != limit.id) res.put(l);
                res.put(cond);
                if (cond.id != limit.id) res.puta(cond.transitiveDeps(limit));
            }
            _ => {
                for (d in deps()) {
                    res.put(d);
                    if (d.id != limit.id) res.puta(d.transitiveDeps(limit));
                }
            }
        }
        return dedup(res.copy());
    }

    def transitiveDepsAux(buf: NodeSet) {
        for (dep in deps()) if (dep != null) {
            buf.put(dep);
            dep.transitiveDepsAux(buf);
        }
    }

    def transitiveDepsSet() -> NodeSet {
        def buf = NodeSet.new();
        transitiveDepsAux(buf);
        return buf;
    }

    def replaceDep(from: IRNode, to: IRNode) -> this {
        for (i < value_deps.length)
            if (value_deps[i] == from) value_deps[i] = to;

        for (i < state_deps.length)
            if (state_deps[i] == from) state_deps[i] = to;
    }

    def init_move() -> bool {
        if (move_true == null) {
            move_true = IRNode.new(IROp.Move(true), -id*2);
            move_true.value_deps = [];
            move_true.state_deps = Array.new(state_deps.length);
            move_false = IRNode.new(IROp.Move(false), -id*2-1);
            move_false.value_deps = [];
            move_false.state_deps = Array.new(state_deps.length);
            return false;
        }
        return true;
    }

    def hash() -> int => id;
    def eq(rhs: IRNode) -> bool => id == rhs.id;

    def render(sb: StringBuilder) -> StringBuilder {
        match (op) {
            Intrinsic(defn) => {
                sb.puts(defn.name);
                if (var_data != null && var_data.sourceName != null) {
                    sb.sp().putc('[').puts(var_data.sourceName).putc(']');
                }
            }
            Lit(tipe, rep) => sb.puts(rep);
            Start => sb.puts("Start");
            Finish => sb.puts("Finish");
            Phi => sb.puts("Phi");
            StatePhi => sb.puts("StatePhi [").putq(value_deps[0].render).putc(']');
            // MatchPhi => sb.puts("MatchPhi");
            Proj(val) => sb.puts(if(val, "|True|", "|False|"));
            Move(val) => sb.puts(if(val, "|True|", "|False|"));
        }

        return sb;
    }

    def toMermaidNode(buf: StringBuilder, tag: string) -> StringBuilder {
        buf.tab().puts(tag).putd(id);
        match (op) {
            Start => buf.puts("[/\"");
            Finish => buf.puts("[\\\\\"");
            Phi => buf.puts("{\"");
            StatePhi => buf.puts("{{\"");
            _ => buf.puts("[\"");
        }
        if (var_data != null && var_data.sourceName != null) buf.puts(var_data.sourceName).puts(" ");
        match (op) {
            Start => buf.puts("Start");
            Finish => buf.puts("Finish");
            Intrinsic(defn) => buf.puts(defn.name);
            Lit(_, rep) => buf.puts(rep);
            Phi => buf.puts("ϕ");
            StatePhi(scs) => {
                buf.puts("Sϕ ");
                for (sc in scs) buf.puts(sc.name).puts(" ");
            }
            Proj(val) => buf.puts(if(val, "|True|", "|False|"));
            Move(val) => buf.puts(if(val, "|True|", "|False|"));
        }
        match (op) {
            Start => buf.puts("\"\\\\]").ln();
            Finish => buf.puts("\"/]").ln();
            Phi => buf.puts("\"}").ln();
            StatePhi => buf.puts("\"}}").ln();
            _ => buf.puts("\"]").ln();
        }
        return buf;
    }

    def become(other: IRNode) -> this {
        op = other.op;
        var_data = other.var_data;
        value_deps = other.value_deps;
        state_deps = other.state_deps;
        for (i < children.length) {
            def child = children[i];
            for (j < child.value_deps.length) if (child.value_deps[j] == this) child.value_deps[j] = other;
            for (j < child.state_deps.length) if (child.state_deps[j] == this) child.state_deps[j] = other;
        }
        children = other.children;
        schedule_children = other.schedule_children;
        schedule_parent = other.schedule_parent;
    }

    def id_propagate(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn) => {
                if (Strings.equal(defn.name, "id")) {
                    become(value_deps[0]);
                }
                return deps();
            }
            _ => return deps();
        }
    }

    def removeViews(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn) => {
                if (Strings.endsWith(defn.name, ".view")) become(value_deps[0]);
            }
            _ => {}
        }
        return deps();
    }

    
    def overloadOps(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn) => {
                def op_spl = IntrinsicTypes.split_op(defn.name);
                def op_fn = op_spl.1;
                def is_rt = var_data.stage != Stage.VALIDATE;
                if (op_fn != null && is_rt) {
                    def tp = value_deps[0].var_data.tipe;
                    def prefix = tp.rt_str();
                    def new_f = Strings.format2("%s_%s", prefix, op_fn);
                    def intrinsic_def = intrinsic(new_f);
                    op = IROp.Intrinsic(intrinsic_def);
                    if (intrinsic_def.return_type != null) var_data.tipe = intrinsic_def.return_type.primitive;
                }
            }
            _ => {}
        }
        return deps();
    }

    def addAbstractions(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn) => {
                if (defn.args == null) return deps(); // unknown intrinsic
                def args = value_deps;
                def unchanged_args = Vector<IRNode>.new();
                for (i < args.length) {
                    if (i >= defn.args.length) {
                        unchanged_args.put(args[i]);
                        continue;
                    }
                    def is_rt = args[i].var_data.stage != Stage.VALIDATE;
                    def should_be_runtime = !defn.args[i].isStatic();
                    if (!is_rt && should_be_runtime) {
                        def tp = if(defn.args[i].primitive.is_bot(), args[i].var_data.tipe, defn.args[i].primitive);
                        def abstract_fn = Strings.format1("lift_%s", tp.long_str());

                        def it = IntrinsicType.new(tp, var_data.stage);
                        def ot = IntrinsicType.new(tp, Stage.INTERPRET);
                        def abstraction_op = IROp.Intrinsic(IntrinsicTypedef.new(abstract_fn, [it], ot, CBDEffect.None));

                        def abstraction_node = sea.mkNode(abstraction_op, Array.new(state_deps.length), [args[i]]);
                        abstraction_node.var_data = VarData.new(uidl("abs"), tp, Stage.INTERPRET);
                        abstraction_node.children = Vectors.of1(this);

                        value_deps[i] = abstraction_node;
                    } else {
                        unchanged_args.put(args[i]);
                    }
                }
                return unchanged_args.copy();
            }
            _ => return deps();
        }
    }

    def mergeEffsAI(sea: Sea, left: IRNode, right: IRNode) -> IRNode {
        def nstates = sea.start.state_deps.length;
        if (IROp.Intrinsic.?(left.op) && IROp.Intrinsic.?(right.op)) {
            def l_defn = IROp.Intrinsic.!(left.op).defn, r_defn = IROp.Intrinsic.!(right.op).defn;
            if (Strings.startsWith(l_defn.name, "push") && Strings.startsWith(r_defn.name, "push")) {
                // TODO: should recursively merge effs from state deps
                if (left.value_deps.length == 1) {
                    // no typevar
                    def l_push = left.value_deps[0], r_push = right.value_deps[0];
                    def merge_fn = Strings.format1("merge_%s", l_push.var_data.tipe.short_str());
                    def merge = sea.mkNode(IROp.Intrinsic(intrinsic(merge_fn)), Arrays.dup(l_push.state_deps), [l_push, r_push]);
                    merge.var_data = VarData.new(uidl("merge"), l_push.var_data.tipe, Stage.INTERPRET);
                    def push = sea.mkNode(left.op, left.state_deps, [merge]);
                    push.var_data = VarData.new(uidl("eff_push"), TypeVar.Bot("void"), Stage.INTERPRET);
                    return push;
                } else {
                    // has typevar
                    def l_push = left.value_deps[1], r_push = right.value_deps[1], tv = left.value_deps[0];
                    def merge = sea.mkNode(IROp.Intrinsic(intrinsic("merge_Val")), Arrays.dup(l_push.state_deps), [tv, l_push, r_push]);
                    merge.var_data = VarData.new(uidl("merge"), l_push.var_data.tipe, Stage.INTERPRET);
                    def push = sea.mkNode(left.op, left.state_deps, [tv, merge]);
                    push.var_data = VarData.new(uidl("push"), TypeVar.Bot("void"), Stage.INTERPRET);
                    return push;
                }
            }
        }

        // default case, run both
        return mergeEffsValidator(sea, left, right);
    }

    def mergeEffsValidator(sea: Sea, left: IRNode, right: IRNode) -> IRNode {
        def nstates = sea.start.state_deps.length;
        if (left.var_data == null) left.var_data = VarData.new(uidl("l_state"), TypeVar.Bot("void"), Stage.INTERPRET);
        if (right.var_data == null) right.var_data = VarData.new(uidl("r_state"), TypeVar.Bot("void"), Stage.INTERPRET);
        def new_left = sea.mkNode(IROp.Intrinsic(intrinsic("merge")), Array.new(nstates), [left, right]);
        new_left.var_data = VarData.new(uidl("eff_merge"), left.var_data.tipe, Stage.INTERPRET);
        return new_left;
    }

    def unLEM(sea: Sea, state: HashMap<IRNode, (IRNode, Vector<IRNode>)>) -> Range<IRNode> {
        match (op) {
            Phi, StatePhi => {
                def nstates = sea.start.state_deps.length;
                def cond = value_deps[0], left = value_deps[1], right = value_deps[2];

                if (cond.var_data.stage == Stage.VALIDATE) return deps();

                var new_cond: IRNode;
                var merged_effs: Vector<IRNode>;
                if (state.has(cond)) {
                    new_cond = state[cond].0;
                    merged_effs = state[cond].1;
                    if (new_cond.id == cond.id) return [];
                } else {
                    def tp = cond.var_data.tipe;
                    def maybeTrueI = intrinsic(Strings.format1("%s_maybeTrue", tp.rt_str()));
                    def maybeFalseI = intrinsic(Strings.format1("%s_maybeFalse", tp.rt_str()));
                    def andI = intrinsic("bool.&&");
                    
                    def maybeTrue = sea.mkNode(IROp.Intrinsic(maybeTrueI), Array.new(nstates), [cond]);
                    maybeTrue.var_data = VarData.new(uidl("mt"), TypeVar.Bot("bool"), Stage.INTERPRET);
                    def maybeFalse = sea.mkNode(IROp.Intrinsic(maybeFalseI), Array.new(nstates), [cond]);
                    maybeFalse.var_data = VarData.new(uidl("mf"), TypeVar.Bot("bool"), Stage.INTERPRET);
                    def and = sea.mkNode(IROp.Intrinsic(andI), Array.new(nstates), [maybeTrue, maybeFalse]);
                    and.var_data = VarData.new(uidl("mb"), TypeVar.Bot("bool"), Stage.INTERPRET);

                    state[cond] = (and, Vector.new());
                    new_cond = state[cond].0;
                    merged_effs = state[cond].1;
                }

                def maybeTrue = new_cond.value_deps[0];
                def innerPhi = sea.mkNode(op, Array.new(nstates), [maybeTrue, left, right]);

                value_deps[0] = new_cond;
                new_cond.children.put(this);

                var new_left: IRNode;
                match (op) {
                    Phi => {
                        new_left = sea.mkNode(IROp.Intrinsic(intrinsic("merge")), Array.new(nstates), [left, right]);
                        new_left.var_data = VarData.new(uidl("merge"), left.var_data.tipe, Stage.INTERPRET);
                        merged_effs.put(left).put(right);
                    }
                    StatePhi => {
                        var left_dup = false, right_dup = false;
                        for (i < merged_effs.length) {
                            left_dup |= merged_effs[i].id == left.id;
                            right_dup |= merged_effs[i].id == right.id;
                        }
                        var merge_left = left, merge_right = right;
                        if (left_dup) {
                            merge_left = sea.mkNode(IROp.Intrinsic(intrinsic("nop")), Array.new(nstates), []);
                            merge_left.var_data = VarData.new(uidl("eff_nop"), TypeVar.Bot("void"), Stage.INTERPRET);
                        }
                        if (right_dup) {
                            merge_right = sea.mkNode(IROp.Intrinsic(intrinsic("nop")), Array.new(nstates), []);
                            merge_right.var_data = VarData.new(uidl("eff_nop"), TypeVar.Bot("void"), Stage.INTERPRET);
                        }
                        merged_effs.put(left).put(right);
                        new_left = mergeEffsAI(sea, merge_left, merge_right);
                    }
                    _ => {}
                }
                var new_right = innerPhi;

                value_deps[1] = new_left;
                new_left.children.put(this);
                value_deps[2] = new_right;
                new_right.children.put(this);
                return [left, right];
            }
            _ => {
                return deps();
            }
        }
    }

    def constUnLEM(sea: Sea) -> Range<IRNode> {
        match (op) {
            Phi, StatePhi => {
                def cond = value_deps[0], then = value_deps[1], els = value_deps[2];

                if (IROp.Intrinsic.?(cond.op)) {
                    def intrinsic = IROp.Intrinsic.!(cond.op);
                    if (Strings.equal(intrinsic.defn.name, "bool.&&")) {
                        def left = cond.value_deps[0], right = cond.value_deps[1];
                        if (IROp.Intrinsic.?(left.op) && IROp.Intrinsic.?(right.op)) {
                            def l_defn = IROp.Intrinsic.!(left.op).defn, r_defn = IROp.Intrinsic.!(right.op).defn;
                            if (Strings.endsWith(l_defn.name, "maybeTrue") && Strings.endsWith(r_defn.name, "maybeFalse")) {
                                become(then);
                            }
                        }
                    }
                }
            }
            _ => {}
        }
        return deps();
    }

    def reifyConds(sea: Sea, state: HashMap<IRNode, (IRNode, IRNode, IRNode)>) -> Range<IRNode> {
        def nstates = sea.start.state_deps.length;
        match (op) {
            Phi, StatePhi => {
                def cond = value_deps[0], then = value_deps[1], els = value_deps[2];
                if (cond.var_data.stage == Stage.VALIDATE) return deps();

                var start_if: IRNode, start_else: IRNode, end: IRNode;
                if (state.has(cond)) {
                    start_if = state[cond].0;
                    start_else = state[cond].1;
                    end = state[cond].2;
                } else {
                    start_if = sea.mkNode(IROp.Intrinsic(intrinsic("startIf")), Array.new(nstates), [cond]);
                    start_else = sea.mkNode(IROp.Intrinsic(intrinsic("startElse")), Array.new(nstates), [cond]);
                    end = sea.mkNode(IROp.Intrinsic(intrinsic("end")), Array.new(nstates), [cond]);
                    state[cond] = (start_if, start_else, end);
                }

                then.state_deps[StateComponent.Extra.tag] = start_if;
                els.state_deps[StateComponent.Extra.tag] = start_else;
                end.state_deps[StateComponent.Extra.tag] = this;
            }
            _ => {}
        }
        return deps();
    }

    def chooseMerge(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn) => {
                if (Strings.startsWith(defn.name, "merge_")) {
                    become(value_deps[0]);
                }
            }
            _ => {}
        }
        return deps();
    }
}

class VarData {
    var tipe: TypeVar;
    var stage: Stage;
    var sourceName: string; // var name in source def, preserved for generating nice code

    new(sourceName, tipe, stage) {}
}

type IROp {
    case Start;
    case Finish;
    case Intrinsic(defn: IntrinsicTypedef);
    case Lit(tipe: TypeVar, rep: string);
    case Phi;
    case StatePhi(statecomps: StateComponent.set);
    // case MatchPhi(subj: IRNode, end: IRNode, cases: Array<IRNode>);

    case Proj(val: bool);
    case Move(val: bool); // child should be statephi?
}
