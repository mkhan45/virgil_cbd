// Rendering and visualization methods for Sea of Nodes data structures.

component SeaRender {
    // === ImmNodeSet ===
    def renderImmNodeSet(ns: ImmNodeSet, sb: StringBuilder) -> StringBuilder {
        return ns.render(sb);
    }

    // === Sea ===
    def toMermaidSea(sea: Sea) -> string {
        def buf = StringBuilder.new();
        buf.puts("---").ln();
        buf.puts("config:").ln();
        buf.puts("  layout: elk").ln();
        buf.puts("---").ln();
        buf.puts("graph TD").ln();

        return toMermaidExtSea(sea, "", buf).toString();
    }

    def toMermaidExtSea(sea: Sea, tag: string, buf: StringBuilder) -> StringBuilder {
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        wl.push(sea.finish);

        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n)) continue;
            visited.put(n);
            toMermaidNodeIRNode(n, buf, tag);

            var arg_idx = 0;
            for (arg in n.value_deps) {
                if (arg == null) System.puts(Strings.format2("HERE: arg %d of %q null\n", arg_idx, n.render));
                arg_idx += 1;
                buf.tab().puts(tag).putd(arg.id).puts(" --> ").puts(tag).putd(n.id).ln();
            }
            def state_set = Vector<(IRNode, StateComponent.set)>.new();
            for (sc in StateComponent.set.all) if (n.state_deps[sc.tag] != null) {
                def dep = n.state_deps[sc.tag];
                var idx = -1;
                for (i < state_set.length) {
                    if (state_set[i].0.id == dep.id) {
                        idx = i;
                        break;
                    }
                }
                if (idx == -1) state_set.put((dep, sc));
                else state_set[idx] = (dep, state_set[idx].1 | sc);
            }
            for (i < state_set.length) {
                def dep = state_set[i].0, scs = state_set[i].1;
                buf.tab().puts(tag).putd(dep.id).puts(" -. ");
                for (sc in scs) {
                    buf.puts(sc.name).puts(" ");
                }
                buf.puts(".-> ").puts(tag).putd(n.id).ln();
            }

            for (dep in n.deps()) {
                wl.push(dep);
            }
        }

        return buf;
    }

    // === IRNode ===
    def renderIRNode(node: IRNode, sb: StringBuilder) -> StringBuilder {
        match (node.op) {
            Intrinsic(defn) => {
                sb.puts(defn.name);
                if (node.var_data != null && node.var_data.sourceName != null) {
                    sb.sp().putc('[').puts(node.var_data.sourceName).putc(']');
                }
            }
            Lit(tipe, rep) => sb.puts(rep);
            Start => sb.puts("Start");
            Finish => sb.puts("Finish");
            Phi => sb.puts("Phi");
            StatePhi => sb.puts("StatePhi [").putq(renderIRNode(node.value_deps[0], _)).putc(']');
            Move(val) => sb.puts(if(val, "|True|", "|False|"));
        }

        return sb;
    }

    def toMermaidNodeIRNode(node: IRNode, buf: StringBuilder, tag: string) -> StringBuilder {
        buf.tab().puts(tag).putd(node.id);
        match (node.op) {
            Start => buf.puts("[/\"");
            Finish => buf.puts("[\\\\\"");
            Phi => buf.puts("{\"");
            StatePhi => buf.puts("{{\"");
            _ => buf.puts("[\"");
        }
        if (node.var_data != null && node.var_data.sourceName != null) buf.puts(node.var_data.sourceName).puts(" ");
        match (node.op) {
            Start => buf.puts("Start");
            Finish => buf.puts("Finish");
            Intrinsic(defn) => buf.puts(defn.name);
            Lit(_, rep) => buf.puts(rep);
            Phi => buf.puts("ϕ");
            StatePhi(scs) => {
                buf.puts("Sϕ ");
                for (sc in scs) buf.puts(sc.name).puts(" ");
            }
            Move(val) => buf.puts(if(val, "|True| ", "|False| ")).sp().putc('[').putq(node.value_deps[0].render).putc(']');
        }
        match (node.op) {
            Start => buf.puts("\"\\\\]").ln();
            Finish => buf.puts("\"/]").ln();
            Phi => buf.puts("\"}").ln();
            StatePhi => buf.puts("\"}}").ln();
            _ => buf.puts("\"]").ln();
        }
        return buf;
    }

    // === DiffResult ===
    def renderDiffResult(diff: DiffResult, sb: StringBuilder) -> StringBuilder {
        match (diff) {
            GraphsEqual => return sb.puts("Graphs Equal");
            OpDiff(lhs, rhs) => return sb.puts("OpDiff: ").putq(renderIRNode(lhs, _)).puts(", ").putq(renderIRNode(rhs, _));
            OneNull(lhs, rhs) => return sb.puts("One Null");
            ValueDepLen(lhs, rhs) => return sb.puts("ValueDepLen difference: ").putq(renderIRNode(lhs, _)).puts(", ").putq(renderIRNode(rhs, _));
            StateDepLen(lhs, rhs) => return sb.puts("StateDepLen difference: ").putq(renderIRNode(lhs, _)).puts(", ").putq(renderIRNode(rhs, _));
            ValueDiff(lhs, rhs, idx, reason) => 
                return sb.puts("ValueDiff between ").putq(renderIRNode(lhs, _)).puts(" and ").putq(renderIRNode(rhs, _)).puts(" at idx ").putd(idx)
                         .puts(": ").putq(renderDiffResult(reason, _));
            StateDiff(lhs, rhs, sc, reason) =>
                return sb.puts("StateDiff between ").putq(renderIRNode(lhs, _)).puts(" and ").putq(renderIRNode(rhs, _)).puts(" for statecomp ").puts(sc.name)
                         .puts(": ").putq(renderDiffResult(reason, _));
        }
    }

    // === SeaScheduler ===
    def toMermaidScheduler(scheduler: SeaScheduler) -> string {
        def buf = StringBuilder.new();
        def visited = HashMap<int, void>.new(int.!<int>, int.==);
        buf.puts("graph TD").ln();
        toMermaidScheduleNode(scheduler.bottom_block, buf, visited);
        buf.ln();
        return buf.toString();
    }

    // === ScheduleNode (polymorphic dispatch) ===
    def toMermaidScheduleNode(node: ScheduleNode, buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        match (node) {
            block: ScheduleBlock => return toMermaidScheduleBlock(block, buf, visited);
            branch: ScheduleBranch => return toMermaidScheduleBranch(branch, buf, visited);
            phi: SchedulePhi => return toMermaidSchedulePhi(phi, buf, visited);
        }
        return buf;
    }

    def subgraphNameScheduleNode(node: ScheduleNode, buf: StringBuilder) -> StringBuilder {
        match (node) {
            block: ScheduleBlock => buf.puts("block_").putd(node.id);
            branch: ScheduleBranch => buf.puts("branch_").putd(node.id);
            phi: SchedulePhi => buf.puts("phi_").putd(node.id);
        }
        return buf;
    }

    // === ScheduleBlock ===
    def toMermaidScheduleBlock(block: ScheduleBlock, buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(block.id)) return buf;
        visited[block.id] = void;
        buf.puts("subgraph block_").putd(block.id).puts("[\"Block ").putd(block.id).puts("\"]").ln();
        buf.tab().puts("direction TB").ln();
        for (i < block.prims.length) {
            def node = block.prims[i];
            toMermaidNodeIRNode(node, buf, Strings.format1("b%d_", block.id));
        }
        for (i < block.prims.length) {
            if (i + 1 < block.prims.length) {
                buf.tab();
                if (!block.forward) {
                    buf.puts("b").putd(block.id).puts("_").putd(block.prims[i + 1].id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(block.id).puts("_").putd(block.prims[i].id).ln();
                } else {
                    buf.puts("b").putd(block.id).puts("_").putd(block.prims[i].id);
                    buf.puts(" --> ");
                    buf.puts("b").putd(block.id).puts("_").putd(block.prims[i + 1].id).ln();
                }
            }
        }
        buf.puts("end").ln();
        if (block.prev != null) {
            subgraphNameScheduleNode(block.prev, buf);
            buf.puts(" --> ");
            subgraphNameScheduleNode(block, buf);
            buf.ln();
        }
        if (block.prev != null) toMermaidScheduleNode(block.prev, buf, visited);
        return buf;
    }

    // === ScheduleBranch ===
    def toMermaidScheduleBranch(branch: ScheduleBranch, buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(branch.id)) return buf;
        visited[branch.id] = void;
        buf.puts("subgraph branch_").putd(branch.id).puts("[\"Branch ").putd(branch.id).puts("\"]").ln();
        if (branch.condition != null) {
            toMermaidNodeIRNode(branch.condition, buf, Strings.format1("br%d_", branch.id));
        }
        buf.ln().puts("end").ln();
        if (branch.prev != null) {
            subgraphNameScheduleNode(branch.prev, buf);
            buf.puts(" --> ");
            subgraphNameScheduleNode(branch, buf);
            buf.ln();
        }
        if (branch.prev != null) toMermaidScheduleNode(branch.prev, buf, visited);
        return buf;
    }

    // === SchedulePhi ===
    def toMermaidSchedulePhi(phi: SchedulePhi, buf: StringBuilder, visited: HashMap<int, void>) -> StringBuilder {
        if (visited.has(phi.id)) return buf;
        visited[phi.id] = void;
        buf.puts("subgraph phi_").putd(phi.id).puts("[\"Phi ").putd(phi.id).puts("\"]").ln();
        for (cur = phi.phis; cur != null; cur = cur.tail) {
            def p = cur.head;
            toMermaidNodeIRNode(p, buf, Strings.format1("p%d_", phi.id));
        }
        buf.puts("end").ln();
        if (phi.l_source != null) {
            subgraphNameScheduleNode(phi.l_source, buf);
            buf.puts(" --> ");
            subgraphNameScheduleNode(phi, buf);
            buf.ln();
        }
        if (phi.r_source != null) {
            subgraphNameScheduleNode(phi.r_source, buf);
            buf.puts(" --> ");
            subgraphNameScheduleNode(phi, buf);
            buf.ln();
        }
        if (phi.l_source != null) toMermaidScheduleNode(phi.l_source, buf, visited);
        if (phi.r_source != null) toMermaidScheduleNode(phi.r_source, buf, visited);
        if (phi.source_branch != null) toMermaidScheduleNode(phi.source_branch, buf, visited);
        return buf;
    }

    // === ScheduleError ===
    def renderScheduleError(err: ScheduleError, sb: StringBuilder) -> StringBuilder {
        match (err) {
            BadOrdering(fst, snd) =>
                sb.puts("Scheduled ").putq(renderIRNode(fst, _)).puts(" not dominating child ").putq(renderIRNode(snd, _));
            UnsatNeed(user, needed) =>
                sb.puts("Scheduled ").putq(renderIRNode(user, _)).puts(" without ").putq(renderIRNode(needed, _));
            GraphDiff(diff) =>
                sb.puts("GraphDiff: ").putq(renderDiffResult(diff, _));
            PathEffectMismatch(path, graph_only, cfg_only) => {
                sb.puts("PathEffectMismatch path=[");
                for (i < path.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(path[i].0, _));
                    sb.puts(if(path[i].1, "=T", "=F"));
                }
                sb.puts("] graph_only=[");
                for (i < graph_only.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(graph_only[i], _));
                }
                sb.puts("] cfg_only=[");
                for (i < cfg_only.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(cfg_only[i], _));
                }
                sb.puts("]");
            }
            EffectCountMismatch(path, orig_effs, new_effs) => {
                sb.puts("EffectCountMismatch path=[");
                for (i < path.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(path[i].0, _));
                    sb.puts(if(path[i].1, "=T", "=F"));
                }
                sb.puts("] orig(").putd(orig_effs.length).puts(")=[");
                for (i < orig_effs.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(orig_effs[i], _));
                }
                sb.puts("] new(").putd(new_effs.length).puts(")=[");
                for (i < new_effs.length) {
                    if (i > 0) sb.puts(", ");
                    sb.putq(renderIRNode(new_effs[i], _));
                }
                sb.puts("]");
            }
            UnscheduledPhi(phi) =>
                sb.puts("UnscheduledPhi ").putq(renderIRNode(phi, _));
        }

        return sb;
    }

    // === Compact text rendering helpers ===

    // Writes n spaces to buf.
    def putIndent(buf: StringBuilder, n: int) {
        for (i < n) buf.sp();
    }

    // Renders a short node reference: #id <IRNode.render>
    def renderNodeRef(node: IRNode, buf: StringBuilder) -> StringBuilder {
        buf.puts("#").putd(node.id).sp();
        renderIRNode(node, buf);
        return buf;
    }

    // Renders one Sea node as a compact text line:
    //   #id <render>(#dep,...) {StateComp:#dep,...}
    def renderSeaNodeLine(node: IRNode, buf: StringBuilder) -> StringBuilder {
        buf.puts("  ");
        renderNodeRef(node, buf);
        if (node.value_deps.length > 0) {
            buf.puts("(");
            for (i < node.value_deps.length) {
                if (i > 0) buf.puts(",");
                def dep = node.value_deps[i];
                if (dep != null) renderNodeRef(dep, buf);
                else buf.puts("?");
            }
            buf.puts(")");
        }
        // Group state deps by source node.
        def state_set = Vector<(IRNode, StateComponent.set)>.new();
        for (sc in StateComponent.set.all) if (node.state_deps[sc.tag] != null) {
            def dep = node.state_deps[sc.tag];
            var idx = -1;
            for (i < state_set.length) {
                if (state_set[i].0.id == dep.id) { idx = i; break; }
            }
            if (idx == -1) state_set.put((dep, sc));
            else state_set[idx] = (dep, state_set[idx].1 | sc);
        }
        if (state_set.length > 0) {
            buf.puts(" {");
            for (i < state_set.length) {
                if (i > 0) buf.puts(",");
                for (sc in state_set[i].1) buf.puts(sc.name);
                buf.puts(":");
                renderNodeRef(state_set[i].0, buf);
            }
            buf.puts("}");
        }
        return buf;
    }

    // Renders all live nodes in a Sea as compact text, start→finish order.
    def renderSeaText(sea: Sea, buf: StringBuilder) -> StringBuilder {
        def live = Seas.live(sea);
        def ordered = Vector<IRNode>.new();
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        wl.push(sea.finish);
        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n) || !live.has(n)) continue;
            visited.put(n);
            ordered.put(n);
            for (dep in n.deps()) wl.push(dep);
        }
        var i = ordered.length - 1;
        while (i >= 0) {
            renderSeaNodeLine(ordered[i], buf);
            buf.ln();
            i -= 1;
        }
        return buf;
    }

    // Renders local+private dominants for a CFG node (one line, no parent recursion).
    def renderDominantsFlat(dg: DomGraph, indent: int, buf: StringBuilder) {
        def nodes = Vector<IRNode>.new();
        dg.local_nodes.apply(fun n => void(nodes.put(n)));
        if (nodes.length == 0) return;
        putIndent(buf, indent);
        buf.puts("doms:");
        for (i < nodes.length) {
            buf.sp();
            renderNodeRef(nodes[i], buf);
        }
        buf.ln();
    }

    // Renders a CFG node and its successors top-down with indentation.
    def renderCFGNode(node: ScheduleNode, buf: StringBuilder, indent: int, visited: HashMap<int, void>) {
        if (node == null || visited.has(node.id)) return;
        visited[node.id] = void;
        match (node) {
            block: ScheduleBlock => {
                putIndent(buf, indent);
                buf.puts("Block #").putd(block.id).puts(":").ln();
                if (block.prims.length > 0) {
                    putIndent(buf, indent + 2);
                    buf.puts("nodes:");
                    for (i < block.prims.length) {
                        buf.sp();
                        renderNodeRef(block.prims[i], buf);
                    }
                    buf.ln();
                }
                renderDominantsFlat(block.dominants, indent + 2, buf);
                if (block.next != null) renderCFGNode(block.next, buf, indent, visited);
            }
            branch: ScheduleBranch => {
                putIndent(buf, indent);
                buf.puts("Branch #").putd(branch.id);
                if (branch.condition != null) {
                    buf.puts(" cond=");
                    renderNodeRef(branch.condition, buf);
                }
                buf.puts(":").ln();
                renderDominantsFlat(branch.dominants, indent + 2, buf);
                putIndent(buf, indent + 2); buf.puts("if-true:").ln();
                if (branch.l_branch != null) renderCFGNode(branch.l_branch, buf, indent + 4, visited);
                putIndent(buf, indent + 2); buf.puts("if-false:").ln();
                if (branch.r_branch != null) renderCFGNode(branch.r_branch, buf, indent + 4, visited);
                if (branch.phi != null) renderCFGNode(branch.phi, buf, indent, visited);
            }
            phi: SchedulePhi => {
                putIndent(buf, indent);
                buf.puts("Phi #").putd(phi.id).puts("(");
                var first = true;
                for (cur = phi.phis; cur != null; cur = cur.tail) {
                    if (!first) buf.puts(", ");
                    first = false;
                    renderNodeRef(cur.head, buf);
                }
                buf.puts("):").ln();
                renderDominantsFlat(phi.dominants, indent + 2, buf);
                if (phi.next != null) renderCFGNode(phi.next, buf, indent, visited);
            }
        }
    }

    // === ScheduleNode text rendering (public entry point) ===
    def renderScheduleNode(node: ScheduleNode, buf: StringBuilder) -> StringBuilder {
        def visited = HashMap<int, void>.new(int.!<int>, int.==);
        renderCFGNode(node, buf, 0, visited);
        return buf;
    }

    // === SeaScheduler text rendering ===
    // Renders the branch lattices section.
    def renderBranchLattices(scheduler: SeaScheduler, buf: StringBuilder) -> StringBuilder {
        buf.puts("=== branch_lattices (").putd(scheduler.branch_lattices.length).puts(") ===").ln();
        for (i < scheduler.branch_lattices.length) {
            def bl = scheduler.branch_lattices[i];
            buf.puts("[").putd(i).puts("] cond: ");
            renderNodeRef(bl.condition, buf);
            buf.ln();
            buf.puts("    phis: ");
            for (j < bl.phis.length) {
                if (j > 0) buf.puts(", ");
                renderNodeRef(bl.phis[j], buf);
            }
            buf.ln();
            buf.puts("    frontier: "); bl.frontier.render(buf); buf.ln();
            buf.puts("    lsg: ");      bl.l_subgraph.render(buf); buf.ln();
            buf.puts("    rsg: ");      bl.r_subgraph.render(buf); buf.ln();
        }
        return buf;
    }

    // info_start: orig_sea only (never changes after this point).
    def renderScheduler(scheduler: SeaScheduler, buf: StringBuilder) -> StringBuilder {
        buf.puts("=== orig_sea ===").ln();
        renderSeaText(scheduler.orig_sea, buf);
        return buf;
    }

    // info_untangled: sea and branch lattices, which stabilise after untangle().
    def renderSchedulerUntangled(scheduler: SeaScheduler, buf: StringBuilder) -> StringBuilder {
        buf.puts("=== sea ===").ln();
        renderSeaText(scheduler.sea, buf);
        buf.ln();
        renderBranchLattices(scheduler, buf);
        return buf;
    }

    // info_final: CFG only, which is complete after scheduling.
    def renderSchedulerFinal(scheduler: SeaScheduler, buf: StringBuilder) -> StringBuilder {
        buf.puts("=== CFG ===").ln();
        def visited = HashMap<int, void>.new(int.!<int>, int.==);
        renderCFGNode(scheduler.top_block, buf, 0, visited);
        return buf;
    }

    // === DomGraph ===
    def renderDomGraph(dg: DomGraph, buf: StringBuilder) -> StringBuilder {
        buf.puts("[");
        def nodes = Vector<IRNode>.new();
        dg.local_nodes.apply(fun n => void(nodes.put(n)));
        for (i < nodes.length) {
            def node = nodes[i];
            if (i > 0) buf.puts(", ");
            buf.putq(renderIRNode(node, _)).put1(" (%d)", node.id);
        }

        for (i < dg.parents.length) {
            buf.puts("; ");
            renderDomGraph(dg.parents[i], buf);
        }

        buf.puts("]");

        return buf;
    }
}
