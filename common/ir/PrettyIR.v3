type PrettyIR {
    case Let(n: string, rhs: PrettyExpr, stage: Stage, rest: PrettyIR);
    case If(cond: PrettyExpr, then: PrettyIR, els: PrettyIR, phis: Array<(string, string)>, stage: Stage, rest: PrettyIR);
    case Match(subj: PrettyExpr, branches: Array<(string, PrettyIR)>, stage: Stage, rest: PrettyIR);
    case Exec(e: PrettyExpr, stage: Stage, effect: CBDEffect, rest: PrettyIR);
    case Void;
    case Injected(inj: string, stage: Stage, rest: PrettyIR);

    def toString(indent: int, ctx: SSADCtx) -> string {
        def buf = StringBuilder.new();
        this.buildString(buf, [], indent, ctx);
        return buf.toString();
    }

    def buildString(buf: StringBuilder, phi_scopes: Array<Array<(string, string)>>, indent: int, ctx: SSADCtx) {
        match (this) {
            Let(n, rhs, stage, rest) => {
                for (i < indent) buf.tab();
                var has_phi = false;
                for (p in ctx.phis) {
                    if (Strings.equal(p.0, n)) {
                        has_phi = true;
                        break;
                    }
                }
                def is_phi_for = resolvePhiDest(n, phi_scopes);

                if (is_phi_for == null && has_phi) {
                    buf.puts("var ").puts(n).puts(" = ");
                } else if (is_phi_for != null) {
                    buf.puts(is_phi_for).puts(" = ");
                } else {
                    buf.puts("def ").puts(n).puts(" = ");
                }
                rhs.buildString(buf);
                buf.puts(";\n");
                rest.buildString(buf, phi_scopes, indent, ctx);
            }
            If(cond, then, els, if_phis, stage, rest) => {
                def child_scopes = Array<Array<(string, string)>>.new(phi_scopes.length + 1);
                for (i < phi_scopes.length) child_scopes[i] = phi_scopes[i];
                child_scopes[phi_scopes.length] = if_phis;
                def declared_phis = Vector<string>.new();
                for (p in if_phis) {
                    def resolved = resolvePhiDest(p.0, phi_scopes);
                    if (resolved != null && !Strings.equal(resolved, p.0)) continue;
                    var declared = false;
                    for (i < declared_phis.length) declared |= Strings.equal(declared_phis[i], p.0);

                    if (!declared) {
                        declared_phis.put(p.0);
                        for (i < indent) buf.tab();
                        buf.puts("var ").puts(p.0);
                        def pt = inferPhiTypeStr(p.0, if_phis, ctx);
                        if (pt != null) buf.puts(": ").puts(pt);
                        buf.puts(";\n");
                    }
                }
                for (i < indent) buf.tab();
                buf.puts("if (");
                cond.buildString(buf);
                buf.puts(") {\n");
                then.buildString(buf, child_scopes, indent + 1, ctx);
                for (i < indent) buf.tab();
                if (els != PrettyIR.Void) {
                    buf.puts("} else {\n");
                    els.buildString(buf, child_scopes, indent + 1, ctx);
                    for (i < indent) buf.tab();
                    buf.puts("}\n");
                } else {
                    buf.puts("}\n");
                }
                rest.buildString(buf, phi_scopes, indent, ctx);
            }
            Match(subj, branches, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts("match (");
                subj.buildString(buf);
                buf.puts(") {\n");
                for (b in branches) {
                    for (i < indent + 1) buf.tab();
                    buf.puts(b.0).puts(" => {\n");
                    b.1.buildString(buf, phi_scopes, indent + 2, ctx);
                    for (i < indent + 1) buf.tab();
                    buf.puts("}\n");
                }
                for (i < indent + 1) buf.tab();
                buf.puts("_ => trapUnreachable();\n");
                for (i < indent) buf.tab();
                buf.puts("}\n");
                rest.buildString(buf, phi_scopes, indent, ctx);
            }
            Void => {
                return;
            }
            Exec(e, stage, effect, rest) => {
                for (i < indent) buf.tab();
                e.buildString(buf);
                buf.puts(";\n");
                // buf.puts("; // ").puts(effect.toString()).puts("\n");
                rest.buildString(buf, phi_scopes, indent, ctx);
            }
            Injected(inj, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts(inj).ln();
                rest.buildString(buf, phi_scopes, indent, ctx);
            }
        }
    }

    def toStringCol(indent: int) -> string {
        def buf = StringBuilder.new();
        this.buildStringCol(buf, indent);
        return buf.toString();
    }

    def buildStringCol(buf: StringBuilder, indent: int) {
        match (this) {
            Let(n, rhs, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage));
                buf.puts("def ").puts(n).puts(" = ");
                rhs.buildString(buf);
                buf.puts(";\x1b[0m\n");
                rest.buildStringCol(buf, indent);
            }
            If(cond, then, els, phis, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage));
                buf.puts("if (");
                cond.buildString(buf);
                buf.puts(") {\x1b[0m\n");
                then.buildStringCol(buf, indent + 1);
                for (i < indent) buf.tab();
                if (els != PrettyIR.Void) {
                    buf.puts(getStageColor(stage)).puts("} else {\x1b[0m\n");
                    els.buildStringCol(buf, indent + 1);
                    for (i < indent) buf.tab();
                    buf.puts(getStageColor(stage)).puts("}\x1b[0m\n");
                } else {
                    buf.puts(getStageColor(stage)).puts("}\x1b[0m\n");
                }
                rest.buildStringCol(buf, indent);
            }
            Match(subj, branches, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage));
                buf.puts("match (");
                subj.buildString(buf);
                buf.puts(") {\x1b[0m\n");
                for (b in branches) {
                    for (i < indent + 1) buf.tab();
                    buf.puts(getStageColor(stage)).puts(b.0).puts(" => {\x1b[0m\n");
                    b.1.buildStringCol(buf, indent + 2);
                    for (i < indent + 1) buf.tab();
                    buf.puts(getStageColor(stage)).puts("}\x1b[0m\n");
                }
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage)).puts("}\x1b[0m\n");
                rest.buildStringCol(buf, indent);
            }
            Void => {
                return;
            }
            Exec(e, stage, effect, rest) => {
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage));
                e.buildString(buf);
                buf.puts(";\x1b[0m\n");
                rest.buildStringCol(buf, indent);
            }
            Injected(inj, stage, rest) => {
                for (i < indent) buf.tab();
                buf.puts(getStageColor(stage));
                buf.puts(inj).puts("\x1b[0m\n");
                rest.buildStringCol(buf, indent);
            }
        }
    }

    def getStageColor(stage: Stage) -> string {
        match (stage) {
            VALIDATE => return "\x1b[32m";    // green
            COMPILE => return "\x1b[31m";     // red
            INTERPRET => return "\x1b[36m";   // cyan
        }
    }

    def resolvePhiDest(name: string, phi_scopes: Array<Array<(string, string)>>) -> string {
        var cur = name;
        var found = false;
        for (scope_i = phi_scopes.length - 1; scope_i >= 0; scope_i -= 1) {
            def phis = phi_scopes[scope_i];
            var next: string = null;
            for (i < phis.length) {
                if (Strings.equal(phis[i].1, cur)) next = phis[i].0;
            }
            if (next != null && !Strings.equal(next, cur)) {
                cur = next;
                found = true;
            }
        }
        return if(found, cur, null);
    }

    def inferPhiTypeStr(dest: string, if_phis: Array<(string, string)>, ctx: SSADCtx) -> string {
        if (ctx.sea_info == null) return null;
        return ctx.sea_info.phiDeclType(dest, if_phis);
    }
}

type PrettyExpr {
    case Var(v: string);
    case Lit(l: string);
    case App(f: string, args: Array<PrettyExpr>);

    def toString() -> string {
        def buf = StringBuilder.new();
        this.buildString(buf);
        return buf.toString();
    }

    def buildString(buf: StringBuilder) {
        match (this) {
            Var(v) => buf.puts(v);
            Lit(l) => buf.puts(l);
            App(f, args) => {
                def fn = if(Strings.equal(f, "id"), "", f);
                buf.puts(fn);
                buf.puts("(");
                for (i < args.length) {
                    args[i].buildString(buf);
                    if (i != args.length - 1) buf.puts(", ");
                }
                buf.puts(")");
            }
        }
    }
}

component Pretty_IR {
    var no_inline_functions: Array<string> = ["f_getLabel"];
    def fromSSAD(s: SSAD, ctx: SSADCtx) -> PrettyIR {
        match (s) {
            LetApp(n, f, args, rest) => {
                def argExprs: Array<PrettyExpr> = Arrays.map(args, PrettyExpr.Var);
                def rhs = PrettyExpr.App(f, argExprs);
                def stage = if(Strings.equal(f, "id"), Stage.VALIDATE, IntrinsicTypes.intrinsic_stage(f));
                return PrettyIR.Let(n, rhs, stage, fromSSAD(rest, ctx));
            }
            LetLit(n, l, t, rest) => {
                def rhs = PrettyExpr.Lit(l);
                return PrettyIR.Let(n, rhs, Stage.VALIDATE, fromSSAD(rest, ctx));
            }
            If(cond, then, els, phis, rest) => {
                def condExpr = PrettyExpr.Var(cond);
                def thenPretty = fromSSAD(then, ctx);
                def elsPretty = fromSSAD(els, ctx);
                def restPretty = fromSSAD(rest, ctx);
                def stage = if(ctx.static[cond], Stage.COMPILE, Stage.INTERPRET);
                return PrettyIR.If(condExpr, thenPretty, elsPretty, phis, stage, restPretty);
            }
            Match(subj, branches, rest) => {
                def subjExpr = PrettyExpr.Var(subj);
                def prettyBranches = Array<(string, PrettyIR)>.new(branches.length);
                for (i < branches.length) {
                    prettyBranches[i] = (branches[i].0, fromSSAD(branches[i].1, ctx));
                }
                def restPretty = fromSSAD(rest, ctx);
                def stage = if(ctx.static[subj], Stage.COMPILE, Stage.INTERPRET);
                return PrettyIR.Match(subjExpr, prettyBranches, stage, restPretty);
            }
            Void => return PrettyIR.Void;
            Injected(inj, rest) => {
                return PrettyIR.Injected(inj, Stage.VALIDATE, fromSSAD(rest, ctx));
            }
            Final(v) => {
                return PrettyIR.Void;
            }
        }
    }

    def inlineLets(
        n: PrettyIR, pred: (PrettyIR, SSADCtx) -> bool, ctx: SSADCtx, var_exprs: HashMap<string, PrettyExpr>
    ) -> PrettyIR {
        match (n) {
            Let(name, rhs, stage, rest) => {
                def inlined_rhs = inlineExpr(rhs, var_exprs);
                var has_phi = false;
                var is_phi = false;
                for (p in ctx.phis) {
                    if (Strings.equal(p.0, name)) {
                        has_phi = true;
                        break;
                    }
                    if (Strings.equal(p.1, name)) {
                        is_phi = true;
                        break;
                    }
                }
                if (!is_phi && !has_phi && pred(n, ctx) && exprSize(inlined_rhs) < 7) {
                    var_exprs[name] = inlineExpr(rhs, var_exprs);
                    return inlineLets(rest, pred, ctx, var_exprs);
                } else {
                    def inlined_rhs = inlineExpr(rhs, var_exprs);
                    def inlined_rest = inlineLets(rest, pred, ctx, var_exprs);
                    return PrettyIR.Let(name, inlined_rhs, stage, inlined_rest);
                }
            }
            If(cond, then, els, phis, stage, rest) => {
                def inlined_cond = inlineExpr(cond, var_exprs);
                for (p in phis) {
                    var_exprs[p.0] = PrettyExpr.Var(p.0);
                }
                def inlined_then = inlineLets(then, pred, ctx, var_exprs);
                def inlined_els = inlineLets(els, pred, ctx, var_exprs);
                def inlined_rest = inlineLets(rest, pred, ctx, var_exprs);
                return PrettyIR.If(inlined_cond, inlined_then, inlined_els, phis, stage, inlined_rest);
            }
            Match(subj, branches, stage, rest) => {
                def inlined_subj = inlineExpr(subj, var_exprs);
                def inlined_branches = Array<(string, PrettyIR)>.new(branches.length);
                for (i < branches.length) {
                    inlined_branches[i] = (branches[i].0, inlineLets(branches[i].1, pred, ctx, var_exprs));
                }
                def inlined_rest = inlineLets(rest, pred, ctx, var_exprs);
                return PrettyIR.Match(inlined_subj, inlined_branches, stage, inlined_rest);
            }
            Exec(e, stage, effect, rest) => {
                def inlined_e = inlineExpr(e, var_exprs);
                def inlined_rest = inlineLets(rest, pred, ctx, var_exprs);
                return PrettyIR.Exec(inlined_e, stage, effect, inlined_rest);
            }
            Injected(inj, stage, rest) => {
                def inlined_rest = inlineLets(rest, pred, ctx, var_exprs);
                return PrettyIR.Injected(inj, stage, inlined_rest);
            }
            Void => return PrettyIR.Void;
        }
    }

    def inlineExpr(expr: PrettyExpr, var_exprs: HashMap<string, PrettyExpr>) -> PrettyExpr {
        match (expr) {
            Var(v) => {
                return if(var_exprs.has(v), var_exprs[v], expr);
            }
            App(f, args) => {
                def inlined_args = Arrays.map(args, fun(arg: PrettyExpr) => inlineExpr(arg, var_exprs));
                return PrettyExpr.App(f, inlined_args);
            }
            Lit(l) => return expr;
        }
    }

    def removeUselessAssigns(n: PrettyIR, ctx: SSADCtx) -> PrettyIR {
        match (n) {
            Let(name, rhs, stage, rest) => {
                if (Strings.startsWith(name, "eff") || 
                    Strings.startsWith(name, "ret"))
                {
                    def effect = ctx.effects[name];
                    return PrettyIR.Exec(rhs, stage, effect, removeUselessAssigns(rest, ctx));
                } else {
                    return PrettyIR.Let(name, rhs, stage, removeUselessAssigns(rest, ctx));
                }
            }
            If(cond, then, els, phis, stage, rest) => {
                return PrettyIR.If(
                    cond, 
                    removeUselessAssigns(then, ctx),
                    removeUselessAssigns(els, ctx),
                    phis,
                    stage,
                    removeUselessAssigns(rest, ctx)
                );
            }
            Match(subj, branches, stage, rest) => {
                def newBranches = Array<(string, PrettyIR)>.new(branches.length);
                for (i < branches.length) {
                    newBranches[i] = (branches[i].0, removeUselessAssigns(branches[i].1, ctx));
                }
                return PrettyIR.Match(
                    subj,
                    newBranches,
                    stage,
                    removeUselessAssigns(rest, ctx)
                );
            }
            Exec(e, stage, effect, rest) => {
                return PrettyIR.Exec(e, stage, effect, removeUselessAssigns(rest, ctx));
            }
            Injected(inj, stage, rest) => {
                return PrettyIR.Injected(inj, stage, removeUselessAssigns(rest, ctx));
            }
            Void => return PrettyIR.Void;
        }
    }

    def defaultInlinePredicate(n: PrettyIR, ctx: SSADCtx) -> bool {
        match (n) {
            Let(name, rhs, stage, rest) => {
                match (rhs) {
                    Lit(l) => return true; // Always inline literals
                    App(f, args) => {
                        if (f.length > 10) return false;
                        for (no_inline in no_inline_functions) {
                            if (Strings.equal(f, no_inline)) return false;
                        }
                        
                        // Inline functions with no effect
                        def effect = IntrinsicTypes.intrinsic_effect(f);
                        return effect == CBDEffect.None;
                    }
                    Var(v) => return true; // Always inline variable assignments
                }
            }
            _ => return false;
        }
    }

    def exprSize(n: PrettyExpr) -> int {
        match (n) {
            Var(_) => return 1;
            Lit(_) => return 1;
            App(f, args) => {
                var res = 1;
                for (arg in args) res += exprSize(arg);
                return res;
            }
        }
    }

    def simplifyVarNums(n: PrettyIR, used_varnums: HashMap<string, int>, var_map: HashMap<string, string>, ctx: SSADCtx) -> PrettyIR {
        match (n) {
            Let(name, rhs, stage, rest) => {
                if (!var_map.has(name)) {
                    var_map[name] = freshVarName(name, used_varnums);
                }
                def newName = var_map[name];
                
                def newRhs = substExprVars(rhs, var_map);
                def newRest = simplifyVarNums(rest, used_varnums, var_map, ctx);
                return PrettyIR.Let(newName, newRhs, stage, newRest);
            }
            If(cond, then, els, phis, stage, rest) => {
                def newCond = substExprVars(cond, var_map);
                def new_phis: Array<(string, string)> = Array.new(phis.length);
                // Pre-compute dest names before any source mappings to avoid
                // corruption when a phi source name coincides with another phi's
                // dest name (e.g. from literal merging).
                def dest_names = Array<string>.new(phis.length);
                def phi_dests = Strings.newMap<bool>();
                for (i < phis.length) {
                    if (!var_map.has(phis[i].0)) var_map[phis[i].0] = phis[i].0;
                    dest_names[i] = var_map[phis[i].0];
                    phi_dests[phis[i].0] = true;
                }
                // Phi source aliases are branch-local. Keep them out of var_map
                // so they cannot leak into sibling branches or the outer rest.
                def branch_seed = copyVarMap(var_map);
                for (i < phis.length) {
                    def new_dest = dest_names[i];
                    if (Strings.equal(phis[i].1, phis[i].0)) {
                        // Identity: source == dest, keep the same name.
                        new_phis[i] = (new_dest, new_dest);
                    } else if (phi_dests.has(phis[i].1)) {
                        // Source name is also a dest name in this If — don't add
                        // a var_map entry that would corrupt the dest mapping.
                        def existing = if(branch_seed.has(phis[i].1), branch_seed[phis[i].1], phis[i].1);
                        new_phis[i] = (new_dest, existing);
                    } else {
                        def new_src = if(branch_seed.has(phis[i].1), branch_seed[phis[i].1], phis[i].1);
                        branch_seed[phis[i].1] = new_src;
                        new_phis[i] = (new_dest, new_src);
                    }
                }
                def newThen = simplifyVarNums(then, used_varnums, copyVarMap(branch_seed), ctx);
                def newEls = simplifyVarNums(els, used_varnums, copyVarMap(branch_seed), ctx);
                def newRest = simplifyVarNums(rest, used_varnums, var_map, ctx);
                return PrettyIR.If(newCond, newThen, newEls, new_phis, stage, newRest);
            }
            Match(subj, branches, stage, rest) => {
                def newSubj = substExprVars(subj, var_map);
                def newBranches = Array<(string, PrettyIR)>.new(branches.length);
                for (i < branches.length) {
                    newBranches[i] = (branches[i].0, simplifyVarNums(branches[i].1, used_varnums, var_map, ctx));
                }
                def newRest = simplifyVarNums(rest, used_varnums, var_map, ctx);
                return PrettyIR.Match(newSubj, newBranches, stage, newRest);
            }
            Exec(e, stage, effect, rest) => {
                def newE = substExprVars(e, var_map);
                def newRest = simplifyVarNums(rest, used_varnums, var_map, ctx);
                return PrettyIR.Exec(newE, stage, effect, newRest);
            }
            Injected(inj, stage, rest) => {
                def newRest = simplifyVarNums(rest, used_varnums, var_map, ctx);
                return PrettyIR.Injected(inj, stage, newRest);
            }
            Void => return PrettyIR.Void;
        }
    }

    def substExprVars(expr: PrettyExpr, var_map: HashMap<string, string>) -> PrettyExpr {
        match (expr) {
            Var(v) => {
                return if(var_map.has(v), PrettyExpr.Var(var_map[v]), expr);
            }
            App(f, args) => {
                def newArgs = Arrays.map(args, fun(arg: PrettyExpr) => substExprVars(arg, var_map));
                return PrettyExpr.App(f, newArgs);
            }
            Lit(l) => return expr;
        }
    }

    def copyVarMap(var_map: HashMap<string, string>) -> HashMap<string, string> {
        def out = Strings.newMap<string>();
        for (n = Maps.keyList(var_map); n != null; n = n.tail) {
            def k = n.head;
            out[k] = var_map[k];
        }
        return out;
    }

    def freshVarName(name: string, used_varnums: HashMap<string, int>) -> string {
        def baseName = getBaseName(name);
        def nextNum = if(used_varnums.has(baseName), used_varnums[baseName], 0);
        used_varnums[baseName] = nextNum + 1;
        return if(nextNum == 0, baseName, Strings.format2("%s%d", baseName, nextNum));
    }

    def recordVarUsage(varname: string, used_varnums: HashMap<string, int>) {
        def baseName = getBaseName(varname);
        def count = if(used_varnums.has(baseName), used_varnums[baseName] + 1, 0);
        used_varnums[baseName] = count;
    }

    def isDigit(c: byte) => c >= '0' && c <= '9';
    def getBaseName(varname: string) -> string {
        def len = varname.length;
        var i = len - 1;
        
        while (i >= 0 && isDigit(varname[i])) i--;
        if (varname[i] == '_' && varname[i-1] == '_') 
            return getBaseName(Arrays.range(varname, 0, i - 1));
        else 
            return varname;
    }
}
