class NodeSet {
    var m: HashMap<IRNode, void>;
    new() {
        m = HashMap<IRNode, void>.new(fun n => n.id, fun (l, r) => (l == null && r == null) || ((l != null && r != null) && l.id == r.id));
    }

    def has(node: IRNode) -> bool => m.has(node);
    def put(node: IRNode) { m[node] = void; }
    def remove(node: IRNode) { if (node != null && m.has(node)) m.remove(node); }
    def apply(f: IRNode -> void) { m.apply(fun (k, v) => f(k)); }
}

class Sea {
    var roots: NodeSet;
    var id_count: int;

    var var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
    var lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

    new() {
        roots = NodeSet.new();
        id_count = 0;
    }

    def mkNode(op: IROp) -> IRNode {
        def node = IRNode.new(op, id_count);
        id_count += 1;

        roots.put(node);
        def args = node.args();
        for (arg in args) roots.remove(arg);

        return node;
    }

    def toSSAD(node: IRNode, res: SSAD, visited: NodeSet) -> SSAD {
        if (visited.has(node)) return res;

        var working_res = res;
        for (arg in node.args()) {
            working_res = toSSAD(arg, working_res, visited);
        }

        visited.put(node);
        match (node.op) {
            Intrinsic(defn, args, deps) => {
                // instantiate LetApp, append to working_res
            }
            Lit => {
            }
            If => {
            }
            Else => {
            }
            Phi(cond, left, right) => {
                // append If to working_res 
            }
            MatchPhi(subj, cases) => {
                // append match to working_res
            }
            StatePhi => {
            }
        }

        return working_res;
    }

    def addSSAD(ssad: SSAD, state_vars: Array<IRNode>, deps: List<IRNode>) -> IRNode {
        match (ssad) {
            LetApp(n, f, args, rest) => {
                def arg_nodes: Array<IRNode> = Arrays.map(args, fun (a: string) => var_nodes[a]);
                var intrinsic_def = IntrinsicTypes.intrinsic_types[f];
                if (intrinsic_def == null) intrinsic_def = IntrinsicTypedef.new(f, null, null, CBDEffect.None);

                var node_deps = deps;
                for (sc in intrinsic_def.reads) if (state_vars[sc.tag] != null) 
                    node_deps = List.new(state_vars[sc.tag], node_deps);

                def op = IROp.Intrinsic(intrinsic_def, arg_nodes, Lists.toArray<IRNode>(node_deps));
                def node = var_nodes[n] = mkNode(op);

                for (sc in intrinsic_def.writes) state_vars[sc.tag] = node;

                node.data = NodeData.new();
                node.data.sourceName = n;

                addSSAD(rest, state_vars, deps);
                return node;
            }
            LetLit(n, l, t, rest) => {
                if (lit_nodes.has(l)) {
                    def node = var_nodes[n] = lit_nodes[l];
                    return node;
                }
                def tp = TypeUtil.fromString(t);
                def op = IROp.Lit(tp, l);
                def node = var_nodes[n] = mkNode(op);

                addSSAD(rest, state_vars, deps);
                return node;
            }
            If(cond, then, els, phis, rest) => {
                def cond_node = var_nodes[cond];
                def start_if = mkNode(IROp.If(cond_node));
                def start_else = mkNode(IROp.Else(cond_node));

                // which node to choose for var if cond is not taken,
                // might be the starting node for var if the els doesn't assign it
                def else_phis: HashMap<string, IRNode> = Strings.newMap();
                def e_state_vars = Arrays.dup(state_vars);
                def t_state_vars = Arrays.dup(state_vars);

                def e_node = addSSAD(els, e_state_vars, List.new(start_else, deps));
                for (phi in phis) {
                    if (var_nodes.has(phi.1)) 
                        else_phis[phi.0] = var_nodes[phi.1]; // take node from els branch
                    else
                        else_phis[phi.0] = var_nodes[phi.0]; // take default starting node
                }

                def t_node = addSSAD(then, t_state_vars, List.new(start_if, deps));

                for (phi in phis) {
                    def phi_op = IROp.Phi(cond_node, var_nodes[phi.1], else_phis[phi.0]);
                    var_nodes[phi.0] = mkNode(phi_op);
                }

                for (sc in StateComponent.set.all) {
                    def esv = e_state_vars[sc.tag];
                    def tsv = t_state_vars[sc.tag];
                    if (esv != tsv) {
                        def state_phi_op = IROp.StatePhi(cond_node, tsv, esv, sc);
                        def state_phi = mkNode(state_phi_op);
                        state_vars[sc.tag] = state_phi;
                    }
                }

                addSSAD(rest, state_vars, deps);
                return start_if;
            }
            Match => return null;
            Void => return null;
            Injected => return null;
            Final => return null;
        }
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        roots.apply(wl.push);

        buf.puts("graph TD").ln();
        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n)) continue;
            visited.put(n);
            buf.tab().putd(n.id);
            buf.puts("[").ln();
            if (n.data != null && n.data.sourceName != null) buf.tab().puts(n.data.sourceName).ln();
            match (n.op) {
                Intrinsic(defn, _, _) => buf.tab().puts(defn.name).ln();
                Lit(_, rep) => buf.tab().puts(rep).ln();
                If(c) => buf.tab().puts("if").ln();
                Else(c) => buf.tab().puts("else").ln();
                Phi(c, l, r) => buf.tab().puts("phi").ln();
                StatePhi(c, l, r, sc) => buf.tab().puts("state phi ").puts(sc.name).ln();
                _ => {}
            }
            buf.tab().puts("]").ln();
            for (arg in n.args()) if (arg != null) {
                buf.tab().putd(arg.id).puts(" --> ").putd(n.id).ln();
                wl.push(arg);
            }
        }

        return buf.toString();
    }
}

component Seas {
    def ofSSAD(node: SSAD) -> Sea {
        def sea = Sea.new();
        def var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
        def lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

        var max_state_tag = 0;
        for (sc in StateComponent.set.all) max_state_tag = if(sc.tag > max_state_tag, sc.tag, max_state_tag);
        def state_vars = Array<IRNode>.new(max_state_tag + 1);
        sea.addSSAD(node, state_vars, null);

        return sea;
    }
}

class IRNode {
    var op: IROp;
    def id: int;
    var data: NodeData;

    new(op, id) {
    }

    def args() -> Array<IRNode> => op.immediatePredecessors();

    def pushPredecessors(buf: Vector<IRNode>) -> Vector<IRNode> {
        // infinite loops if cyclic
        for (a in args()) {
            buf.put(a);
            a.pushPredecessors(buf);
        }

        return buf;
    }

    def predecessors() -> Vector<IRNode> {
        def buf = Vector<IRNode>.new();
        return pushPredecessors(buf);
    }
}

class NodeData {
    var typ: TypeVar;
    var eff: CBDEffect;
    var stage: Stage;
    var sourceName: string; // var name in source def, preserved for generating nice code
}

type IROp {
    case Intrinsic(defn: IntrinsicTypedef, args: Array<IRNode>, deps: Array<IRNode>);
    case Lit(tipe: TypeVar, rep: string);
    case If(cond: IRNode);
    case Else(cond: IRNode);
    case Phi(cond: IRNode, left: IRNode, right: IRNode);
    case MatchPhi(subj: IRNode, cases: Array<IRNode>);
    case StatePhi(cond: IRNode, left: IRNode, right: IRNode, statecomp: StateComponent);

    def immediatePredecessors() -> Array<IRNode> {
        match (this) {
            Intrinsic(defn, args, deps) => return Arrays.concat(args, deps);
            Lit(tipe, rep) => return [];
            If(c) => return [c];
            Else(c) => return [c];
            Phi(cond, left, right) => return [cond, left, right];
            MatchPhi(subj, cases) => return Arrays.prepend(subj, cases);
            StatePhi(cond, left, right, sc) => return [cond, left, right];
        }
    }
}
