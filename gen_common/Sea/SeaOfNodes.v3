class NodeSet {
    var m: HashMap<IRNode, void>;
    new() {
        m = HashMap<IRNode, void>.new(IRNode.hash, IRNode.eq);
    }

    def has(node: IRNode) -> bool => m.has(node);
    def put(node: IRNode) { m[node] = void; }
    def remove(node: IRNode) { if (node != null && m.has(node)) m.remove(node); }
    def apply(f: IRNode -> void) { m.apply(fun (k, v) => f(k)); }

    // immutable ops
    def with(node: IRNode) -> NodeSet {
        def new_set = NodeSet.new();
        apply(new_set.put);
        new_set.put(node);
        return new_set;
    }
    def dup() -> NodeSet {
        def new_set = NodeSet.new();
        apply(new_set.put);
        return new_set;
    }
}

def uidl = SSAD_IR.uidl;
def intrinsic(name: string) -> IntrinsicTypedef {
    def defn = IntrinsicTypes.intrinsic_types[name];
    if (defn != null) 
        return defn;
    else
        return IntrinsicTypedef.new(name, null, null, CBDEffect.None);
}

class Sea {
    var roots: NodeSet;
    var leaves: NodeSet;
    var nodes: NodeSet;
    var id_count: int;

    var var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
    var lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

    new() {
        roots = NodeSet.new();
        leaves = NodeSet.new();
        nodes = NodeSet.new();
        id_count = 0;

        def void_node = IRNode.new(IROp.Lit(TypeVar.Bot("void"), "(void)"), -1);
        void_node.data = NodeData.new(TypeVar.Bot("void"), CBDEffect.None, Stage.VALIDATE);
        void_node.data.sourceName = "void";
        var_nodes["void"] = void_node;
    }

    def mkNode(op: IROp) -> IRNode {
        def node = IRNode.new(op, id_count);
        id_count += 1;

        roots.put(node);
        nodes.put(node);
        def args = node.args();
        for (arg in args) {
            roots.remove(arg);
            arg.children.put(node);
        }
        if (args.length == 0) leaves.put(node);

        return node;
    }

    def schedule() -> SSAD {
        def wl: Vector<IRNode> = Vector.new();
        var q_idx = 0;

        def conditionals: HashMap<IRNode, (SSAD, SSAD, NodeSet)> = HashMap.new(IRNode.hash, IRNode.eq);

        roots.apply(fun r => void(wl.put(r)));

        var completed = NodeSet.new();
        var res: SSAD = SSAD.Void;
        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;

            if (completed.has(node)) continue;

            var ready = true;
            def deps = node.args();
            for (i = deps.length - 1; i >= 0; i -= 1) {
                // reversed just for consistency with original code
                def dep = deps[i];
                ready &= completed.has(dep);
                if (!completed.has(dep)) wl.put(dep);
            }

            if (!ready) {
                wl.put(node);
                continue;
            }

            completed.put(node);
            match (node.op) {
                Intrinsic(defn, args) => {
                    if (node.data == null) {
                        node.data = NodeData.new(TypeVar.Bot("void"), CBDEffect.None, Stage.INTERPRET);
                        node.data.sourceName = uidl("eff");
                    }
                    res = res.appended(SSAD.LetApp(node.data.sourceName, defn.name, Arrays.map(args, fun (n: IRNode) => n.data.sourceName), SSAD.Void));
                }
                Lit(tipe, rep) => {
                    res = res.appended(SSAD.LetLit(node.data.sourceName, rep, tipe.long_str(), SSAD.Void));
                }
                If(c, regions) => {
                    conditionals[c] = (res, SSAD.Void, completed.dup());
                    res = SSAD.Void;
                }
                Else(c, _) => {
                    def ctl = conditionals[c];
                    def prev = ctl.0;
                    def then_ssa = res;
                    def completed_before_if = ctl.2;
                    completed = completed_before_if;
                    conditionals[c] = (prev, then_ssa, completed_before_if);
                    res = SSAD.Void;
                }
                End(c, _, phis) => {
                    def ctl = conditionals[c];
                    def prev = ctl.0;
                    def then_ssa = ctl.1;
                    def else_ssa = res;
                    def completed_before_if = ctl.2;
                    def phi_vec = Vector<(string, string)>.new();
                    for (i < phis.length) {
                        // could also be a statephi, in which case do nothing
                        def phi = phis[i];
                        if (IROp.Phi.?(phi.op)) {
                            def phi_op = IROp.Phi.!(phi.op);
                            if (phi_op.left != null) phi_vec.put((phi.data.sourceName, phi_op.left.data.sourceName));
                            if (phi_op.right != null) phi_vec.put((phi.data.sourceName, phi_op.right.data.sourceName));
                        }
                    }
                    def if_ssa = SSAD.If(c.data.sourceName, then_ssa, else_ssa, phi_vec.copy(), SSAD.Void);
                    res = prev.appended(if_ssa);
                }
                Phi(c, end, l, r) => {
                    // node.data = l.data;
                    // let SSAD take care of the actual phi translation by populating the phis array in the SSAD.If node
                    // res = res.appended(SSAD.LetApp(node.data.sourceName, "if", [c.data.sourceName, l.data.sourceName, r.data.sourceName], SSAD.Void));
                }
                StatePhi(c, end, l, r, sc) => {
                }
                _ => {}
            }
        }

        return res;
    }

    def addSSAD(ssad: SSAD, state_vars: Array<IRNode>, deps: List<IRNode>) -> IRNode {
        match (ssad) {
            LetApp(n, f, args, rest) => {
                def arg_nodes: Array<IRNode> = Arrays.map(args, fun (a: string) => var_nodes[a]);
                var intrinsic_def = intrinsic(f);

                var node_deps = deps;
                for (sc in intrinsic_def.reads | intrinsic_def.writes) if (state_vars[sc.tag] != null) 
                    node_deps = List.new(state_vars[sc.tag], node_deps);

                def op = IROp.Intrinsic(intrinsic_def, arg_nodes);
                def node = var_nodes[n] = mkNode(op);
                node.pathDeps = node_deps;

                for (sc in intrinsic_def.writes) state_vars[sc.tag] = node;

                def tipe = if(intrinsic_def.return_type != null, intrinsic_def.return_type.primitive, TypeVar.Bot("bot"));
                def eff = intrinsic_def.effect;
                var stage = if(intrinsic_def.return_type != null, intrinsic_def.return_type.stage, Stage.VALIDATE);
                for (arg in arg_nodes) {
                    if (stage != Stage.INTERPRET && arg.data.stage == Stage.INTERPRET) stage = Stage.INTERPRET;
                    if (stage == Stage.VALIDATE && arg.data.stage == Stage.COMPILE) stage = Stage.COMPILE;
                }
                node.data = NodeData.new(tipe, eff, stage);
                node.data.sourceName = n;

                addSSAD(rest, state_vars, deps);
                return node;
            }
            LetLit(n, l, t, rest) => {
                var node: IRNode;
                if (lit_nodes.has(l)) {
                    node = var_nodes[n] = lit_nodes[l];
                } else {
                    def tp = TypeUtil.fromString(t);
                    def op = IROp.Lit(tp, l);
                    def node = var_nodes[n] = mkNode(op);
                    lit_nodes[l] = node;
                    node.data = NodeData.new(tp, CBDEffect.None, Stage.VALIDATE);
                    node.data.sourceName = n;
                }

                addSSAD(rest, state_vars, deps);
                return node;
            }
            If(cond, then, els, phis, rest) => {
                def cond_node = var_nodes[cond];
                def then_region_ends = Vector<IRNode>.new();
                def if_regions = IfRegions.new();
                def start_if = mkNode(IROp.If(cond_node, if_regions));
                def start_else = mkNode(IROp.Else(cond_node, then_region_ends));

                def else_region_ends = Vectors.of1<IRNode>(start_else);
                def phi_vec = Vector<IRNode>.new();
                def end_node = mkNode(IROp.End(cond_node, else_region_ends, phi_vec));

                if_regions.els = start_else;
                if_regions.end = end_node;

                // which node to choose for var if cond is not taken,
                // might be the starting node for var if the els doesn't assign it
                def else_phis: HashMap<string, IRNode> = Strings.newMap();
                def e_state_vars = Arrays.dup(state_vars);
                def t_state_vars = Arrays.dup(state_vars);

                // TODO: probably doesn't account for if there is a phi assign in the else but not if
                def e_node = addSSAD(els, e_state_vars, List.new(start_else, deps));
                for (phi in phis) {
                    if (var_nodes.has(phi.1)) 
                        else_phis[phi.0] = var_nodes[phi.1]; // take node from els branch
                    else
                        else_phis[phi.0] = var_nodes[phi.0]; // take default starting node
                }

                def t_node = addSSAD(then, t_state_vars, List.new(start_if, deps));

                for (phi in phis) {
                    if (var_nodes[phi.1] != null) then_region_ends.put(var_nodes[phi.1]);
                    if (else_phis[phi.0] != null) else_region_ends.put(else_phis[phi.0]);

                    def phi_op = IROp.Phi(cond_node, end_node, var_nodes[phi.1], else_phis[phi.0]);
                    def node = mkNode(phi_op);
                    def tipe = var_nodes[phi.0].data.tipe;
                    node.data = NodeData.new(tipe, CBDEffect.None, cond_node.data.stage);
                    node.data.sourceName = phi.0;
                    var_nodes[phi.0] = node;
                    phi_vec.put(node);
                }

                for (sc in StateComponent.set.all) {
                    def esv = e_state_vars[sc.tag];
                    def tsv = t_state_vars[sc.tag];
                    if (tsv != null) then_region_ends.put(tsv);
                    if (esv != null) else_region_ends.put(esv);
                    if (esv != tsv) {
                        def state_phi_op = IROp.StatePhi(cond_node, end_node, tsv, esv, sc);
                        def state_phi = mkNode(state_phi_op);
                        state_vars[sc.tag] = state_phi;
                        phi_vec.put(state_phi);
                    }
                }

                addSSAD(rest, state_vars, deps);
                return start_if;
            }
            Match => return null;
            Void => return null;
            Injected => return null;
            Final => return null;
        }
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        roots.apply(wl.push);

        buf.puts("---").ln();
        buf.puts("config:").ln();
        buf.puts("  layout: elk").ln();
        buf.puts("---").ln();
        // buf.puts("%%{ init: { \"flowchart\": { \"defaultRenderer\": \"elk\" } } }%%");
        buf.puts("graph TD").ln();
        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n)) continue;
            visited.put(n);
            buf.tab().putd(n.id);
            buf.puts("[\"").ln();
            if (n.data != null && n.data.sourceName != null) buf.tab().puts(n.data.sourceName).ln();
            match (n.op) {
                Intrinsic(defn, _) => buf.tab().puts(defn.name).ln();
                Lit(_, rep) => buf.tab().puts(rep).ln();
                If(c, _) => buf.tab().puts("if").ln();
                Else(c, region_ends) => buf.tab().puts("else").ln();
                End(c, region_ends, _) => buf.tab().puts("end").ln();
                Phi(c, end, l, r) => buf.tab().puts("phi").ln();
                StatePhi(c, end, l, r, sc) => buf.tab().puts("state phi ").puts(sc.name).ln();
                _ => {}
            }
            buf.tab().puts("\"]").ln();
            for (arg in n.args()) if (arg != null) {
                buf.tab().putd(arg.id).puts(" --> ").putd(n.id).ln();
                wl.push(arg);
            }
        }

        return buf.toString();
    }

    def apply(f: (IRNode, Sea) -> Range<IRNode>) {
        def wl: Vector<IRNode> = Vector.new();
        var q_idx = 0;
        roots.apply(fun r => void(wl.put(r)));

        var completed = NodeSet.new();

        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;

            if (completed.has(node)) continue;
            completed.put(node);

            def next = f(node, this);
            for (arg in next) {
                wl.put(arg);
            }
        }
    }
}

component Seas {
    def ofSSAD(node: SSAD) -> Sea {
        def sea = Sea.new();
        def var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
        def lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

        var max_state_tag = 0;
        for (sc in StateComponent.set.all) max_state_tag = if(sc.tag > max_state_tag, sc.tag, max_state_tag);
        def state_vars = Array<IRNode>.new(max_state_tag + 1);
        sea.addSSAD(node, state_vars, null);

        return sea;
    }
}

class IRNode {
    var op: IROp;
    var id: int;
    var data: NodeData;
    var pathDeps: List<IRNode>;
    var children: Vector<IRNode>;

    new(op, id) {
        children = Vector.new();
    }

    def become(other: IRNode) {
        op = other.op;
        // id = other.id;
        data = other.data;
        children = other.children;
        pathDeps = other.pathDeps;
    }

    def args() -> Array<IRNode> {
        def res = op.immediatePredecessors();
        return Arrays.concat(res, Lists.toArray(pathDeps));
    }

    def hash() -> int => id;
    def eq(rhs: IRNode) -> bool => id == rhs.id;

    def removeViews(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                if (Strings.endsWith(defn.name, ".view")) become(args[0]);
            }
            _ => {}
        }
        return args();
    }

    def overloadOps(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                def op_spl = IntrinsicTypes.split_op(defn.name);
                def op_fn = op_spl.1;
                def is_rt = data.stage != Stage.VALIDATE;
                if (op_fn != null && is_rt) {
                    var tp = data.tipe;
                    if (tp.is_bot() && args.length > 0) tp = args[0].data.tipe;
                    def prefix = tp.rt_str();
                    def new_f = Strings.format2("%s_%s", prefix, op_fn);
                    def intrinsic_def = intrinsic(new_f);
                    op = IROp.Intrinsic(intrinsic_def, args);
                }
            }
            _ => {}
        }
        return args();
    }

    def addAbstractions(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                if (defn.args == null) return this.args(); // unknown intrinsic
                def new_args = Array<IRNode>.new(args.length);
                def unchanged_args = Vector<IRNode>.new();
                for (i < args.length) {
                    if (i >= defn.args.length) {
                        new_args[i] = args[i];
                        unchanged_args.put(args[i]);
                        continue;
                    }
                    def is_rt = args[i].data.stage != Stage.VALIDATE;
                    def should_be_runtime = !defn.args[i].isStatic();
                    if (!is_rt && should_be_runtime) {
                        def tp = if(defn.args[i].primitive.is_bot(), args[i].data.tipe, defn.args[i].primitive);
                        def abstract_fn = Strings.format1("rtcast_%s", tp.long_str());

                        def it = IntrinsicType.new(tp, data.stage);
                        def ot = IntrinsicType.new(tp, Stage.INTERPRET);
                        def abstraction_op = IROp.Intrinsic(IntrinsicTypedef.new(abstract_fn, [it], ot, CBDEffect.None), [args[i]]);

                        def abstraction_node = sea.mkNode(abstraction_op);
                        abstraction_node.data = NodeData.new(tp, CBDEffect.None, Stage.INTERPRET);
                        abstraction_node.data.sourceName = uidl("abs");

                        new_args[i] = abstraction_node;
                    } else {
                        new_args[i] = args[i];
                        unchanged_args.put(args[i]);
                    }
                }
                op = IROp.Intrinsic(defn, new_args);
                return Arrays.concat(unchanged_args.copy(), Lists.toArray(pathDeps));
            }
            _ => {
                return args();
            }
        }
    }

    def unLEM(sea: Sea) -> Range<IRNode> {
        match (op) {
            If(cond, regions) => {
                if (cond.data.stage == Stage.VALIDATE) return [];

                def it = IntrinsicType.new(cond.data.tipe, cond.data.stage);
                def ifTrue = intrinsic("maybeTrue");
                def ifFalse = intrinsic("maybeFalse");
                def and = intrinsic("bool.&&");
                def merge = intrinsic("nop");

                def ifTrueOp = IROp.Intrinsic(ifTrue, [cond]);
                def ifFalseOp = IROp.Intrinsic(ifFalse, [cond]);

                def ifTrueNode = sea.mkNode(ifTrueOp);
                ifTrueNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                ifTrueNode.data.sourceName = uidl("ift");

                def ifFalseNode = sea.mkNode(ifFalseOp);
                ifFalseNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                ifFalseNode.data.sourceName = uidl("iff");

                def andOp = IROp.Intrinsic(and, [ifTrueNode, ifFalseNode]);
                def andNode = sea.mkNode(andOp);
                andNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                andNode.data.sourceName = uidl("and");

                def right_phis = IROp.End.!(regions.end.op).phis;
                def else_region_ends = Vector<IRNode>.new();

                def newRegions = IfRegions.new();
                def newIf = sea.mkNode(IROp.If(andNode, newRegions));
                newIf.pathDeps = pathDeps;
                newIf.children = children;

                def newElse = newRegions.els = sea.mkNode(IROp.Else(andNode, Vector.new()));

                def newRight = this;
                else_region_ends.put(newRight);
                newRight.pathDeps = List.new(newElse, null);

                def newPhis = Vector<IRNode>.new();
                def newEnd = newRegions.end = sea.mkNode(IROp.End(andNode, right_phis, else_region_ends));
                newEnd.pathDeps = List.new(newRight, null);
                for (i < right_phis.length) {
                    def inner_phi = right_phis[i];
                    match (inner_phi.op) {
                        Phi => {}
                        StatePhi(_, _, left, right, statecomp) => {
                            def mergeNode = sea.mkNode(IROp.Intrinsic(merge, []));
                            newElse.pathDeps = List.new(mergeNode, newElse.pathDeps);

                            if (left != null) {
                                def newLeft = sea.mkNode(left.op);
                                newLeft.pathDeps = List.new(newIf, null);
                                mergeNode.pathDeps = List.new(newLeft, mergeNode.pathDeps);
                            }

                            if (right != null) {
                                def newRight = sea.mkNode(right.op);
                                newRight.pathDeps = List.new(newIf, null);
                                mergeNode.pathDeps = List.new(newRight, mergeNode.pathDeps);
                            }
                        }
                        _ => {}
                    }
                }

                return [];
            }
            _ => {
                // return args();
                return [];
            }
        }
    }
}

class NodeData {
    var tipe: TypeVar;
    var eff: CBDEffect;
    var stage: Stage;
    var sourceName: string; // var name in source def, preserved for generating nice code

    new(tipe, eff, stage) {}
}

class IfRegions {
    var els: IRNode;
    var end: IRNode;
}

type IROp {
    case Intrinsic(defn: IntrinsicTypedef, args: Array<IRNode>);
    case Lit(tipe: TypeVar, rep: string);
    case If(cond: IRNode, regions: IfRegions);
    case Else(cond: IRNode, region_ends: Vector<IRNode>);
    case End(cond: IRNode, region_ends: Vector<IRNode>, phis: Vector<IRNode>);
    case Phi(cond: IRNode, end: IRNode, left: IRNode, right: IRNode);
    case MatchPhi(subj: IRNode, end: IRNode, cases: Array<IRNode>);
    case StatePhi(cond: IRNode, end: IRNode, left: IRNode, right: IRNode, statecomp: StateComponent.set);

    def immediatePredecessors() -> Array<IRNode> {
        match (this) {
            Intrinsic(defn, args) => return args;
            Lit(tipe, rep) => return [];
            If(c, regions) => return [c];
            Else(c, region_ends) => return Arrays.prepend(c, region_ends.copy());
            End(c, region_ends, phis) => return Arrays.prepend(c, region_ends.copy());
            Phi(cond, end, left, right) => {
                def buf = Vector<IRNode>.new();
                for (dep in [cond, end, left, right]) if (dep != null) buf.put(dep);
                return buf.copy();
            }
            MatchPhi(subj, end, cases) => {
                def buf = Vector<IRNode>.new();
                for (dep in Arrays.concat([subj, end], cases)) if (dep != null) buf.put(dep);
                return buf.copy();
            }
            StatePhi(cond, end, left, right, sc) => {
                def buf = Vector<IRNode>.new();
                for (dep in [cond, end, left, right]) if (dep != null) buf.put(dep);
                return buf.copy();
            }
        }
    }
}
