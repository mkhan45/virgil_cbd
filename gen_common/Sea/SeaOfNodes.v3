    def addSSAD(ssad: SSAD, state_vars: Array<IRNode>, deps: List<IRNode>) -> IRNode {
        match (ssad) {
            LetApp(n, f, args, rest) => {
                def arg_nodes: Array<IRNode> = Arrays.map(args, fun (a: string) => var_nodes[a]);
                var intrinsic_def = intrinsic(f);

                var node_deps = deps;
                for (sc in intrinsic_def.reads | intrinsic_def.writes) if (state_vars[sc.tag] != null) 
                    node_deps = List.new(state_vars[sc.tag], node_deps);

                def op = IROp.Intrinsic(intrinsic_def, arg_nodes);
                def node = var_nodes[n] = mkNode(op);
                node.pathDeps = node_deps;

                for (sc in intrinsic_def.writes) state_vars[sc.tag] = node;

                def tipe = if(intrinsic_def.return_type != null, intrinsic_def.return_type.primitive, TypeVar.Bot("bot"));
                def eff = intrinsic_def.effect;
                var stage = if(intrinsic_def.return_type != null, intrinsic_def.return_type.stage, Stage.VALIDATE);
                for (arg in arg_nodes) {
                    if (stage != Stage.INTERPRET && arg.data.stage == Stage.INTERPRET) stage = Stage.INTERPRET;
                    if (stage == Stage.VALIDATE && arg.data.stage == Stage.COMPILE) stage = Stage.COMPILE;
                }
                node.data = NodeData.new(tipe, eff, stage);
                node.data.sourceName = n;
                if (eff != CBDEffect.None) node.pathDeps = deps;

                addSSAD(rest, state_vars, deps);
                return node;
            }
            LetLit(n, l, t, rest) => {
                var node: IRNode;
                if (lit_nodes.has(l)) {
                    node = var_nodes[n] = lit_nodes[l];
                } else {
                    def tp = TypeUtil.fromString(t);
                    def op = IROp.Lit(tp, l);
                    def node = var_nodes[n] = mkNode(op);
                    lit_nodes[l] = node;
                    node.data = NodeData.new(tp, CBDEffect.None, Stage.VALIDATE);
                    node.data.sourceName = n;
                    node.pathDeps = List.new(this.start, null);
                }

                addSSAD(rest, state_vars, deps);
                return node;
            }
            If(cond, then, els, phis, rest) => {
                def cond_node = var_nodes[cond];
                def then_region_ends = Vector<IRNode>.new();
                def if_regions = IfRegions.new();
                def start_if = mkNode(IROp.If(cond_node, if_regions));
                def start_else = mkNode(IROp.Else(cond_node, then_region_ends));

                def else_region_ends = Vectors.of1<IRNode>(start_else);
                def phi_vec = Vector<IRNode>.new();
                def end_node = mkNode(IROp.End(cond_node, else_region_ends, phi_vec));
                end_node.pathDeps = List.new(start_else, deps);

                if_regions.els = start_else;
                if_regions.end = end_node;

                // which node to choose for var if cond is not taken,
                // might be the starting node for var if the els doesn't assign it
                def else_phis: HashMap<string, IRNode> = Strings.newMap();
                def e_state_vars = Arrays.dup(state_vars);
                def t_state_vars = Arrays.dup(state_vars);

                // TODO: probably doesn't account for if there is a phi assign in the else but not if
                def e_node = addSSAD(els, e_state_vars, List.new(start_else, deps));
                for (phi in phis) {
                    if (var_nodes.has(phi.1)) 
                        else_phis[phi.0] = var_nodes[phi.1]; // take node from els branch
                    else
                        else_phis[phi.0] = var_nodes[phi.0]; // take default starting node
                }

                def t_node = addSSAD(then, t_state_vars, List.new(start_if, deps));

                for (phi in phis) {
                    if (var_nodes[phi.1] != null) then_region_ends.put(var_nodes[phi.1]);
                    if (else_phis[phi.0] != null) else_region_ends.put(else_phis[phi.0]);

                    def phi_op = IROp.Phi(cond_node, end_node, var_nodes[phi.1], else_phis[phi.0]);
                    def node = mkNode(phi_op);
                    def tipe = var_nodes[phi.0].data.tipe;
                    node.data = NodeData.new(tipe, CBDEffect.None, cond_node.data.stage);
                    node.data.sourceName = phi.0;
                    var_nodes[phi.0] = node;
                    phi_vec.put(node);
                }

                // (then, else, statephi)
                def existing_phis = Vector<(IRNode, IRNode, IRNode)>.new();
                for (sc in StateComponent.set.all) {
                    def tsv = t_state_vars[sc.tag];
                    def esv = e_state_vars[sc.tag];
                    var inserted = false;
                    for (i < existing_phis.length) {
                        def p = existing_phis[i];
                        if (tsv != null && esv != null && p.0.id == tsv.id && p.1.id == esv.id) {
                            def sp_op = IROp.StatePhi.!(p.2.op);
                            state_vars[sc.tag] = p.2;
                            p.2.op = IROp.StatePhi(cond_node, end_node, tsv, esv, sp_op.statecomps | sc);
                            inserted = true;
                            break;
                        }
                    }

                    if (!inserted) {
                        if (tsv != null) then_region_ends.put(tsv);
                        if (esv != null) else_region_ends.put(esv);
                        if (esv != tsv) {
                            def state_phi_op = IROp.StatePhi(cond_node, end_node, tsv, esv, sc);
                            def state_phi = mkNode(state_phi_op);
                            state_vars[sc.tag] = state_phi;
                            phi_vec.put(state_phi);
                            if (tsv != null && esv != null) existing_phis.put((tsv, esv, state_phi));
                        }
                    }
                }

                start_if.pathDeps = deps;
                addSSAD(rest, state_vars, deps);
                return start_if;
            }
            Match => return null;
            Void => return null;
            Injected => return null;
            Final => return null;
        }
    }

    def toMermaid() -> string {
        def buf = StringBuilder.new();
        def wl = ArrayStack<IRNode>.new();
        def visited = NodeSet.new();
        wl.push(finish);

        buf.puts("---").ln();
        buf.puts("config:").ln();
        buf.puts("  layout: elk").ln();
        buf.puts("---").ln();
        // buf.puts("%%{ init: { \"flowchart\": { \"defaultRenderer\": \"elk\" } } }%%");
        buf.puts("graph TD").ln();
        while (!wl.empty()) {
            def n = wl.pop();
            if (n == null || visited.has(n)) continue;
            visited.put(n);
            buf.tab().putd(n.id);
            buf.puts("[\"").ln();
            if (n.data != null && n.data.sourceName != null) buf.tab().puts(n.data.sourceName).ln();
            match (n.op) {
                Start => buf.tab().puts("Start").ln();
                Finish(_) => buf.tab().puts("Finish").ln();
                Intrinsic(defn, _) => buf.tab().puts(defn.name).ln();
                Lit(_, rep) => buf.tab().puts(rep).ln();
                If(c, _) => buf.tab().puts("if").ln();
                Else(c, region_ends) => buf.tab().puts("else").ln();
                End(c, region_ends, _) => buf.tab().puts("end").ln();
                Phi(c, end, l, r) => buf.tab().puts("phi").ln();
                StatePhi(c, end, l, r, scs) => {
                    buf.tab().puts("state phi ");
                    for (sc in scs) {
                        buf.puts(sc.name).puts(" ");
                    }
                }
                _ => {}
            }
            buf.tab().puts("\"]").ln();
            for (arg in n.args()) if (arg != null) {
                buf.tab().putd(arg.id).puts(" --> ").putd(n.id).ln();
                wl.push(arg);
            }
        }

        return buf.toString();
    }

    def apply(f: (IRNode, Sea) -> Range<IRNode>) {
        def wl: Vector<IRNode> = Vector.new();
        var q_idx = 0;
        wl.put(finish);

        var completed = NodeSet.new();

        while (q_idx < wl.length) {
            def node = wl[q_idx];
            q_idx += 1;

            if (completed.has(node)) continue;
            completed.put(node);

            def next = f(node, this);
            for (arg in next) {
                wl.put(arg);
            }
        }
    }
}

component Seas {
    def ofSSAD(node: SSAD) -> Sea {
        def sea = Sea.new();

        def state_vars = IROp.Finish.!(sea.finish.op).state_vars;
        sea.addSSAD(node, state_vars, List.new(sea.start, null));
        return sea;
    }
}

class IRNode {
    var op: IROp;
    var id: int;
    var data: NodeData;
    var pathDeps: List<IRNode>;
    var children: Vector<IRNode>;

    new(op, id) {
        children = Vector.new();
    }

    def become(other: IRNode) {
        op = other.op;
        // id = other.id;
        data = other.data;
        children = other.children;
        pathDeps = other.pathDeps;
    }

    def args() -> Array<IRNode> {
        def res = op.immediatePredecessors();
        if (pathDeps != null) return Arrays.append(pathDeps.head, res);
        else return res;
    }

    def hash() -> int => id;
    def eq(rhs: IRNode) -> bool => id == rhs.id;

    def render(sb: StringBuilder) -> StringBuilder {
        match (op) {
            Intrinsic(defn, args) => {
                sb.puts(defn.name);
                if (data != null && data.sourceName != null) {
                    sb.sp().putc('[').puts(data.sourceName).putc(']');
                }
            }
            Lit(tipe, rep) => sb.puts(rep);
            If => sb.puts("if");
            Else => sb.puts("else");
            End => sb.puts("end");
            Start => sb.puts("Start");
            Finish => sb.puts("Finish");
            Phi => sb.puts("Phi");
            StatePhi => sb.puts("StatePhi");
            MatchPhi => sb.puts("MatchPhi");
        }

        return sb;
    }

    def removeViews(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                if (Strings.endsWith(defn.name, ".view")) become(args[0]);
            }
            _ => {}
        }
        return args();
    }

    def overloadOps(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                def op_spl = IntrinsicTypes.split_op(defn.name);
                def op_fn = op_spl.1;
                def is_rt = data.stage != Stage.VALIDATE;
                if (op_fn != null && is_rt) {
                    var tp = data.tipe;
                    if (tp.is_bot() && args.length > 0) tp = args[0].data.tipe;
                    def prefix = tp.rt_str();
                    def new_f = Strings.format2("%s_%s", prefix, op_fn);
                    def intrinsic_def = intrinsic(new_f);
                    op = IROp.Intrinsic(intrinsic_def, args);
                }
            }
            _ => {}
        }
        return args();
    }

    def addAbstractions(sea: Sea) -> Range<IRNode> {
        match (op) {
            Intrinsic(defn, args) => {
                if (defn.args == null) return this.args(); // unknown intrinsic
                def new_args = Array<IRNode>.new(args.length);
                def unchanged_args = Vector<IRNode>.new();
                for (i < args.length) {
                    if (i >= defn.args.length) {
                        new_args[i] = args[i];
                        unchanged_args.put(args[i]);
                        continue;
                    }
                    def is_rt = args[i].data.stage != Stage.VALIDATE;
                    def should_be_runtime = !defn.args[i].isStatic();
                    if (!is_rt && should_be_runtime) {
                        def tp = if(defn.args[i].primitive.is_bot(), args[i].data.tipe, defn.args[i].primitive);
                        def abstract_fn = Strings.format1("rtcast_%s", tp.long_str());

                        def it = IntrinsicType.new(tp, data.stage);
                        def ot = IntrinsicType.new(tp, Stage.INTERPRET);
                        def abstraction_op = IROp.Intrinsic(IntrinsicTypedef.new(abstract_fn, [it], ot, CBDEffect.None), [args[i]]);

                        def abstraction_node = sea.mkNode(abstraction_op);
                        abstraction_node.data = NodeData.new(tp, CBDEffect.None, Stage.INTERPRET);
                        abstraction_node.data.sourceName = uidl("abs");

                        new_args[i] = abstraction_node;
                    } else {
                        new_args[i] = args[i];
                        unchanged_args.put(args[i]);
                    }
                }
                op = IROp.Intrinsic(defn, new_args);
                return Arrays.append(pathDeps.head, unchanged_args.copy());
            }
            _ => {
                return args();
            }
        }
    }

    def unLEM(sea: Sea) -> Range<IRNode> {
        match (op) {
            If(cond, regions) => {
                if (cond.data.stage == Stage.VALIDATE) return [];

                def it = IntrinsicType.new(cond.data.tipe, cond.data.stage);
                def maybeTrue = intrinsic("maybeTrue");
                def maybeFalse = intrinsic("maybeFalse");
                def and = intrinsic("bool.&&");

                def maybeTrueOp = IROp.Intrinsic(maybeTrue, [cond]);
                def maybeFalseOp = IROp.Intrinsic(maybeFalse, [cond]);

                def maybeTrueNode = sea.mkNode(maybeTrueOp);
                maybeTrueNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                maybeTrueNode.data.sourceName = uidl("ift");

                def maybeFalseNode = sea.mkNode(maybeFalseOp);
                maybeFalseNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                maybeFalseNode.data.sourceName = uidl("iff");

                def andOp = IROp.Intrinsic(and, [maybeTrueNode, maybeFalseNode]);
                def andNode = sea.mkNode(andOp);
                andNode.data = NodeData.new(it.primitive, CBDEffect.None, Stage.INTERPRET);
                andNode.data.sourceName = uidl("and");

                def oldElseNode = regions.els, oldEndNode = regions.end;
                def oldElseOp = IROp.Else.!(oldElseNode.op), oldEndOp = IROp.End.!(oldEndNode.op);
                def oldPhis = oldEndOp.phis;

                def newRegions = IfRegions.new();
                def newIf = sea.mkNode(IROp.If(andNode, newRegions));
                newIf.pathDeps = pathDeps;
                newIf.children = children;

                // def newThen = ...

                def thenRegionEnds = Vector<IRNode>.new();
                // def thenRegionEnds = oldElseOp.region_ends;
                // for (i < thenRegionEnds.length) {
                //     thenRegionEnds[i] = sea.mkNode(thenRegionEnds[i].op);
                //     thenRegionEnds[i].pathDeps = List.new(newIf, pathDeps);
                // }
                def newElse = newRegions.els = sea.mkNode(IROp.Else(andNode, thenRegionEnds));

                def rightRegions = IfRegions.new();
                rightRegions.els = oldElseNode;
                rightRegions.els.op = IROp.Else(andNode, oldElseOp.region_ends);
                rightRegions.end = oldEndNode;
                rightRegions.end.op = IROp.End(andNode, oldEndOp.region_ends, oldEndOp.phis);
                // def newRight = sea.mkNode(IROp.If(maybeTrueNode, rightRegions));
                def newRight = this;
                newRight.op = IROp.If(maybeTrueNode, rightRegions);
                newRight.pathDeps = List.new(newElse, pathDeps);

                def newPhis = Vector<IRNode>.new();
                def elseRegionEnds = Vectors.of1<IRNode>(rightRegions.end);
                def newEnd = newRegions.end = sea.mkNode(IROp.End(andNode, newPhis, elseRegionEnds));

                def effPool = NodeSet.new();
                for (i < oldPhis.length) {
                    def innerPhi = oldPhis[i];
                    match (innerPhi.op) {
                        Phi => {}
                        StatePhi(_, _, left, right, statecomps) => {
                            var newLeft = left;
                            if (left != null && !effPool.has(left) && !IROp.Start.?(left.op)) {
                                effPool.put(left);
                                newLeft = sea.mkNode(left.op);
                                newLeft.pathDeps = List.new(newIf, null);
                                thenRegionEnds.put(newLeft);
                            }

                            var newRight = right;
                            if (right != null && !effPool.has(right) && !IROp.Start.?(left.op)) {
                                effPool.put(right);
                                newRight = sea.mkNode(right.op);
                                newRight.pathDeps = List.new(newIf, null);
                                thenRegionEnds.put(newRight);
                            }

                            innerPhi.op = IROp.StatePhi(maybeTrueNode, oldEndNode, newLeft, newRight, statecomps);
                        }
                        _ => {}
                    }
                }

                return [];
            }
            _ => {
                return args();
                // return [];
            }
        }
    }
}

class NodeData {
    var tipe: TypeVar;
    var eff: CBDEffect;
    var stage: Stage;
    var sourceName: string; // var name in source def, preserved for generating nice code

    new(tipe, eff, stage) {}
}

class IfRegions {
    var els: IRNode;
    var end: IRNode;
}

def dedup(arr: Array<IRNode>) -> Array<IRNode> {
    def res_vec = Vector<IRNode>.new();
    for (v in arr) {
        var dup = false;
        for (i < res_vec.length) dup |= res_vec[i].id == v.id;
        if (!dup) res_vec.put(v);
    }
    return res_vec.copy();
}

type IROp {
    case Start;
    case Finish(state_vars: Array<IRNode>);
    case Intrinsic(defn: IntrinsicTypedef, args: Array<IRNode>);
    case Lit(tipe: TypeVar, rep: string);
    case If(cond: IRNode, regions: IfRegions);
    case Else(cond: IRNode, region_ends: Vector<IRNode>);
    case End(cond: IRNode, region_ends: Vector<IRNode>, phis: Vector<IRNode>);
    case Phi(cond: IRNode, end: IRNode, left: IRNode, right: IRNode);
    case MatchPhi(subj: IRNode, end: IRNode, cases: Array<IRNode>);
    case StatePhi(cond: IRNode, end: IRNode, left: IRNode, right: IRNode, statecomps: StateComponent.set);

    def immediatePredecessors() -> Array<IRNode> {
        match (this) {
            Start => return [];
            Finish(state_vars) => return dedup(state_vars);
            Intrinsic(defn, args) => return args;
            Lit(tipe, rep) => return [];
            If(c, regions) => return [c];
            Else(c, region_ends) => return dedup(Arrays.prepend(c, region_ends.copy()));
            End(c, region_ends, phis) => return dedup(Arrays.prepend(c, region_ends.copy()));
            Phi(cond, end, left, right) => {
                def buf = Vector<IRNode>.new();
                for (dep in [cond, end, left, right]) if (dep != null) buf.put(dep);
                return buf.copy();
            }
            MatchPhi(subj, end, cases) => {
                def buf = Vector<IRNode>.new();
                for (dep in Arrays.concat([subj, end], cases)) if (dep != null) buf.put(dep);
                return buf.copy();
            }
            StatePhi(cond, end, left, right, sc) => {
                def buf = Vector<IRNode>.new();
                for (dep in [cond, end, left, right]) if (dep != null) buf.put(dep);
                return buf.copy();
            }
        }
    }
}
