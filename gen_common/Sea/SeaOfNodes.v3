class NodeSet {
    var m: HashMap<IRNode, void>;
    new() {
        m = HashMap<IRNode, void>.new(IRNode.hash, IRNode.eq);
    }

    def has(node: IRNode) -> bool => m.has(node);
    def put(node: IRNode) { m[node] = void; }
    def remove(node: IRNode) { if (node != null && m.has(node)) m.remove(node); }
    def apply(f: IRNode -> void) { m.apply(fun (k, v) => f(k)); }

    // immutable ops
    def with(node: IRNode) -> NodeSet {
        def new_set = NodeSet.new();
        apply(new_set.put);
        new_set.put(node);
        return new_set;
    }
    def dup() -> NodeSet {
        def new_set = NodeSet.new();
        apply(new_set.put);
        return new_set;
    }
}

type ImmNodeSet(ls: List<IRNode>) {
    def with(n: IRNode) => ImmNodeSet(List.new(n, ls));
    def without(n: IRNode) -> ImmNodeSet {
        var new_ls: List<IRNode> = null;
        for (cur = ls; cur != null; cur = cur.tail) {
            if (cur.head.id != n.id) new_ls = List.new(cur.head, new_ls);
        }
        return ImmNodeSet(new_ls);
    }

    def has(n: IRNode) -> bool {
        for (cur = ls; cur != null; cur = cur.tail) {
            if (cur.head.id == n.id) return true;
        }

        return false;
    }

    def intersection(other: ImmNodeSet) -> ImmNodeSet {
        var res = ImmNodeSet(null);
        for (cur = ls; cur != null; cur = cur.tail) if (other.has(cur.head)) {
            res = res.with(cur.head);
        }

        return res;
    }

    def union(other: ImmNodeSet) -> ImmNodeSet {
        var res = ImmNodeSet(null);
        for (cur = ls; cur != null; cur = cur.tail) if (!res.has(cur.head)) {
            res = res.with(cur.head);
        }
        for (cur = other.ls; cur != null; cur = cur.tail) if (!res.has(cur.head)) {
            res = res.with(cur.head);
        }

        return res;
    }

    def render(sb: StringBuilder) -> StringBuilder {
        for (cur = ls; cur != null; cur = cur.tail) {
            sb.putd(cur.head.id).puts(" ");
        }
        return sb;
    }
}

component ImmNodeSets {
    def empty() => ImmNodeSet(null);
}

def uidl = SSAD_IR.uidl;
def intrinsic(name: string) -> IntrinsicTypedef {
    def defn = IntrinsicTypes.intrinsic_types[name];
    if (defn != null) 
        return defn;
    else
        return IntrinsicTypedef.new(name, null, null, CBDEffect.None);
}

type SearchNode(remaining: ImmNodeSet, path: SSAD, available: ImmNodeSet);

class Sea {
    var start: IRNode;
    var finish: IRNode;
    var nodes: NodeSet;
    var id_count: int;

    var var_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>();
    var lit_nodes: HashMap<string, IRNode> = Strings.newMap<IRNode>(); // assume that lits have unique rep across types

    new() {
        nodes = NodeSet.new();
        id_count = 0;

        start = mkNode(IROp.Start);
        var max_state_tag = 0;
        for (sc in StateComponent.set.all) max_state_tag = if(sc.tag > max_state_tag, sc.tag, max_state_tag);
        def state_vars = Array<IRNode>.new(max_state_tag + 1);
        for (i < state_vars.length) state_vars[i] = start;
        finish = mkNode(IROp.Finish(state_vars));

        def void_node = IRNode.new(IROp.Lit(TypeVar.Bot("void"), "(void)"), -1);
        void_node.data = NodeData.new(TypeVar.Bot("void"), CBDEffect.None, Stage.VALIDATE);
        void_node.data.sourceName = "void";
        var_nodes["void"] = void_node;
    }

    def mkNode(op: IROp) -> IRNode {
        def node = IRNode.new(op, id_count);
        id_count += 1;

        for (dep in node.args()) {
            dep.children.put(node);
        }

        return node;
    }

    def schedule() -> SSAD {
        var remaining = ImmNodeSets.empty().with(finish);
        var available = ImmNodeSets.empty().with(start);
        var path: SSAD = SSAD.Void;
        def startPoint = SearchNode(remaining, path, available);
        def res = scheduleNodes(startPoint);
        return res.1;
    }

    def scheduleNodes(point: SearchNode) -> (bool, SSAD) {
        def remaining = point.remaining;
        def path = point.path;
        def available = point.available;

        System.puts("====\n");
        System.puts("remaining: ");
        for (cur = remaining.ls; cur != null; cur = cur.tail) {
            System.puts(Strings.format1("%q ", cur.head.render));
        }
        System.ln();
        System.puts("available: ");
        for (cur = available.ls; cur != null; cur = cur.tail) {
            System.puts(Strings.format1("%q ", cur.head.render));
        }
        System.ln();
        System.puts("path:\n");
        System.puts(path.toString(1));
        System.ln();
     
        if (remaining.ls == null) return (true, path);

        for (cur = remaining.ls; cur != null; cur = cur.tail) {
            def node = cur.head;

            if (available.has(node)) {
                continue;
            }

            var ready = true;
            var remainingArgs: List<IRNode> = null;
            for (arg in node.args()) if (!available.has(arg)) {
                ready = false;
                remainingArgs = List.new(arg, remainingArgs);
            }

            if (remainingArgs != null) {
                for (arg = remainingArgs; arg != null; arg = arg.tail) {
                    def nextPoint = SearchNode(remaining.with(arg.head), path, available);
                    def res = scheduleNodes(nextPoint);
                    if (res.0) return res;
                }
            } else {
                var remainingAfter = remaining.without(node);
                var newPath = path;
                var availableAfter = available;
                match (node.op) {
                    Intrinsic(defn, args) => {
                        if (node.data == null) {
                            node.data = NodeData.new(TypeVar.Bot("void"), CBDEffect.None, Stage.INTERPRET);
                            node.data.sourceName = uidl("eff");
                        }
                        newPath = path.appended(SSAD.LetApp(node.data.sourceName, defn.name, Arrays.map(args, fun (n: IRNode) => n.data.sourceName), SSAD.Void));
                        availableAfter = available.with(node);
                    }
                    Lit(tipe, rep) => {
                        newPath = path.appended(SSAD.LetLit(node.data.sourceName, rep, tipe.long_str(), SSAD.Void));
                        availableAfter = available.with(node);
                    }
                    If(c, regions) => {
                        def els = regions.els;
                        def end = regions.end;

                        def then_search = SearchNode(ImmNodeSets.empty().with(els), SSAD.Void, available.with(node));
                        def then_sched = scheduleNodes(then_search);
                        def else_search = SearchNode(ImmNodeSets.empty().with(end), SSAD.Void, available.with(els));
                        def else_sched = scheduleNodes(else_search);

                        if (!then_sched.0 || !else_sched.0) return (false, path);

                        def phi_vec = Vector<(string, string)>.new();
                        for (phi in IROp.End.!(end.op).phis.copy()) {
                            availableAfter = availableAfter.with(phi);
                            // could also be a statephi, in which case do nothing
                            if (IROp.Phi.?(phi.op)) {
                                def phi_op = IROp.Phi.!(phi.op);
                                if (phi_op.left != null) phi_vec.put((phi.data.sourceName, phi_op.left.data.sourceName));
                                if (phi_op.right != null) phi_vec.put((phi.data.sourceName, phi_op.right.data.sourceName));
                            }
                        }

                        remainingAfter = remainingAfter.without(els).without(end);
                        for (r in IROp.Else.!(els.op).region_ends.copy()) remainingAfter = remainingAfter.without(r);
                        for (r in IROp.End.!(end.op).region_ends.copy()) remainingAfter = remainingAfter.without(r);
                        availableAfter = availableAfter.with(end);
                        newPath = path.appended(SSAD.If(c.data.sourceName, then_sched.1, else_sched.1, phi_vec.copy(), SSAD.Void));
                    }
                    _ => {
                        availableAfter = available.with(node);
                    }
                }
                def nextPoint = SearchNode(remainingAfter, newPath, availableAfter);
                def res = scheduleNodes(nextPoint);
                if (res.0) return res;
            }
        }

        return (true, path);
    }

