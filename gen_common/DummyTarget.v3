    def limit_memory_size_64 = 30000u;
    def limit_memory_size = 30000u;
	def newMemory(decl: MemoryDecl) -> Memory {
        return null;
    }
	def newWasmStack() -> WasmStack => null;

	def forceGC();
	def ticksNs() -> u64;
	def rdtsc() -> u64;
	def getRdtsc() -> (void -> u64) { return rdtsc; }
	def pregenIntoFile(filename: string) -> ErrorBuilder;

	def getTestTiers() -> List<(string, ExecutionStrategy)>;
