type SSAD {
    case LetApp(n: string, f: string, args: Array<string>, rest: SSAD);
    case LetLit(n: string, l: string, t: string, rest: SSAD);
    case If(cond: string, then: SSAD, els: SSAD, phis: Array<(string, string)>, rest: SSAD);
    // treat each case match as a boolean var
    case Match(subj: string, branches: Array<(string, SSAD)>, rest: SSAD);
    case Void;
    case Injected(inj: string, rest: SSAD);
    case Final(v: string);

    def toString(indent: int) -> string {
        def buf = StringBuilder.new();
        SSAD_IR.buildString(this, buf, [], indent);
        return buf.toString();
    }

    def appended(rhs: SSAD) -> SSAD {
        match (this) {
            LetApp(n, f, args, rest) => return SSAD.LetApp(n, f, args, rest.appended(rhs));
            LetLit(n, l, t, rest) => return SSAD.LetLit(n, l, t, rest.appended(rhs));
            If(cond, then, els, phis, rest) => return SSAD.If(cond, then, els, phis, rest.appended(rhs));
            Match(subj, branches, rest) => return SSAD.Match(subj, branches, rest.appended(rhs));
            Void => return rhs;
            Injected(inj, rest) => return SSAD.Injected(inj, rest.appended(rhs));
            Final(v) => return rhs;
        }
    }

    def filter(pred: SSAD -> bool) -> SSAD {
    	def node = this;
    	match (node) {
            Void => return SSAD.Void;
            Final(_) => return if(pred(node), node, SSAD.Void);
            Injected(inj, rest) => {
                def r = rest.filter(pred);
                return if(pred(node), r, SSAD.Injected(inj, r));
            }
            LetApp(n, f, args, rest) => {
                def r = rest.filter(pred);
                return if(pred(node), SSAD.LetApp(n, f, args, r), r);
            }
            LetLit(n, l, t, rest) => {
                def r = rest.filter(pred);
                return if(pred(node), SSAD.LetLit(n, l, t, r), r);
            }
            If(c, t, e, phis, rest) => {
                def r = rest.filter(pred);
                return if(pred(node), SSAD.If(c, t.filter(pred), e.filter(pred), phis, r), r);
            }
            Match(subj, branches, rest) => {
                def r = rest.filter(pred);
                if (pred(node)) {
                    def new_branches = Array<(string, SSAD)>.new(branches.length);
                    for (i < branches.length) {
                        new_branches[i] = (branches[i].0, branches[i].1.filter(pred));
                    }
                    return SSAD.Match(subj, new_branches, r);
                } else {
                    return r;
                }
            }
        }
    }

}

type TB<A, B>(f: (A, SSATransformer) -> B) {
    def then<C>(r: (B, SSATransformer) -> C) => TB<A, C>(SSAT.then<A, B, C>(f, r));
}

component SSAT {
    def then<A, B, C>(l: (A, SSATransformer) -> B, r: (B, SSATransformer) -> C) -> ((A, SSATransformer) -> C) {
        return fun(node: A, transformer: SSATransformer) => r(l(node, transformer), transformer);
    }
    
    def sequenced<T>(fns: Array<(T, SSATransformer) -> T>) -> ((T, SSATransformer) -> T) {
        return fun(node: T, transformer: SSATransformer) -> T {
            var result = node;
            for (i = 0; i < fns.length; i++) {
                result = fns[i](result, transformer);
            }
            return result;
        };
    }

    def transformChildren(node: SSAD, transformer: SSATransformer) -> SSAD {
        return transformer.transformChildren(node);
    }
}

class SSATransformer(ctx: SSADCtx) {
    var onLetApp: (SSAD.LetApp, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onLetLit: (SSAD.LetLit, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onIf: (SSAD.If, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onMatch: (SSAD.Match, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onVoid: (SSAD.Void, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onInjected: (SSAD.Injected, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    var onFinal: (SSAD.Final, SSATransformer) -> SSAD = fun (n, t) => t.transformChildren(n);
    
    def transform(ssa: SSAD) -> SSAD {
        match (ssa) {
            LetApp(_, _, _, _) => return onLetApp(SSAD.LetApp.!(ssa), this);
            LetLit(_, _, _, _) => return onLetLit(SSAD.LetLit.!(ssa), this);
            If(_, _, _, _, _) => return onIf(SSAD.If.!(ssa), this);
            Match(_, _, _) => return onMatch(SSAD.Match.!(ssa), this);
            Void => return onVoid(SSAD.Void .!(ssa), this);
            Injected(_, _) => return onInjected(SSAD.Injected.!(ssa), this);
            Final(_) => return onFinal(SSAD.Final.!(ssa), this);
        }
    }
    
    def transformChildren(ssa: SSAD) -> SSAD {
        ctx.getTypes(ssa);
        match (ssa) {
            LetApp(n, f, args, rest) => return SSAD.LetApp(n, f, args, transform(rest));
            LetLit(n, l, t, rest) => return SSAD.LetLit(n, l, t, transform(rest));
            If(cond, then, els, phis, rest) => return SSAD.If(cond, transform(then), transform(els), phis, transform(rest));
            Match(subj, branches, rest) => {
                def new_branches = Array<(string, SSAD)>.new(branches.length);
                for (i < branches.length) {
                    new_branches[i] = (branches[i].0, transform(branches[i].1));
                }
                return SSAD.Match(subj, new_branches, transform(rest));
            }
            Void => return ssa;
            Injected(inj, rest) => return SSAD.Injected(inj, transform(rest));
            Final(v) => return ssa;
        }
    }
}

component SSAD_IR {
    var counter = 0;
    var substs = HashMap<string, string>.new(Strings.hash, Strings.equal);
    var assign_substs = HashMap<string, Vector<string>>.new(Strings.hash, Strings.equal);

    def subst(s: string) -> string {
        return if(substs[s] == null, s, substs[s]);
    }

    def uid() -> string {
        def res = Strings.format1("var%i", counter);
        counter += 1;
        return res;
    }
    def uidl(l: string) -> string {
        def res = Strings.format2("%s__%d", l, counter);
        counter += 1;
        return res;
    }
    def assign_uid(l: string) -> string {
        def res = Strings.format2("%s__%d", l, counter);
        counter += 1;
        if (!assign_substs.has(l)) assign_substs[l] = Vector.new();
        assign_substs[l].put(res);
        return res;
    }

    def from_virgil_aux(stmt: VirgilStmt, rest: SSAD) -> SSAD {
        match (stmt) {
            Block(ss) => {
                var res = rest;
                for (i = ss.length - 1; i >= 0; i -= 1) {
                    def s = ss[i];
                    res = from_virgil_aux(s, res);
                }
                return res;
            }
            Expr(e) => {
                def v = uidl("eff");
                return from_virgil_expr(v, e, rest);
            }
            Return(e) => {
                // skips rest
                def n = uidl("ret");
                return from_virgil_expr(n, e, SSAD.Final(n));
            }
            Local(v, e, st, rtc) => {
                return from_virgil_expr(v, e, rest);
            }
            If(c, t, e) => {
                def c_var = uidl("cond");
                def phis = Vector<(string, string)>.new();
                assign_substs = Strings.newMap();
                def t_ssa = from_virgil(t);
                def e_ssa = from_virgil(e);
                def assigned_vars = Maps.keyList(assign_substs);
                for (n = assigned_vars; n != null; n = n.tail) {
                    def v = n.head;
                    def asns = assign_substs[v];
                    for (i < asns.length) phis.put((v, asns[i]));
                }
                return from_virgil_expr(c_var, c, SSAD.If(c_var, t_ssa, e_ssa, phis.copy(), rest));
            }
            Match(subj, branches) => {
                def c_var = uidl("cond");
                def ir_branches = Array<(string, SSAD)>.new(branches.length);
                for (i < branches.length) {
                    def b = MatchCase.Variant.!(branches[i]); // XXX
                    ir_branches[i] = (b.variant_tag, from_virgil(b.body));
                }

                return from_virgil_expr(c_var, subj, SSAD.Match(c_var, ir_branches, rest));
            }
            Assign(v, e) => {
                return from_virgil_expr(assign_uid(v), e, rest);
            }
            _ => return SSAD.Void; // TODO
        }
    }

    def from_virgil(stmt: VirgilStmt) -> SSAD {
        return from_virgil_aux(stmt, SSAD.Void);
    }

    def from_virgil_expr(name: string, expr: VirgilExpr, rest: SSAD) -> SSAD {
        match (expr) {
            AppExpr(f, args) => {
                def arg_names = Arrays.map(args, fun (a: VirgilExpr) => uidl("arg"));
                var res: SSAD = SSAD.LetApp(name, f, arg_names, rest);
                for (a < args.length) {
                    res = from_virgil_expr(arg_names[a], args[a], res);
                }
                return res;
            }
            BinOpExpr(o, l, r) => {
                def ln = uidl("left");
                def rn = uidl("right");
                return from_virgil_expr(ln, l, 
                        from_virgil_expr(rn, r,
                            SSAD.LetApp(name, o, [ln, rn], rest)));
            }
            Literal(tipe, string_rep) => {
                return SSAD.LetLit(name, string_rep, tipe, rest);
            }
            VarExpr(v) => {
                return SSAD.LetApp(name, "id", [v], rest);
            }
            IfExpr(c, t, e) => {
                def cn = uidl("cond");
                def tv = uidl("tv");
                def ev = uidl("ev");
                def t_ssa = from_virgil_expr(tv, t, SSAD.Final(tv));
                def e_ssa = from_virgil_expr(ev, e, SSAD.Final(ev));
                return from_virgil_expr(cn, c, SSAD.If(cn, t_ssa, e_ssa, [], rest));
            }
        }
    }

    def ssa(ir: SSAD) -> SSAD {
        match (ir) {
            LetApp(n, f, a, r) => {
                def fresh = uidl(n);
                substs[n] = fresh;
                def args = Arrays.map(a, fun (v : string) => subst(v));
                return SSAD.LetApp(fresh, f, args, ssa(r));
            }
            LetLit(n, l, t, r) => {
                def fresh = uidl(n);
                substs[n] = fresh;
                return SSAD.LetLit(fresh, l, t, ssa(r));
            }
            If(c, t, e, ps, r) => {
                return SSAD.If(subst(c), ssa(t), ssa(e), ps, ssa(r));
            }
            Match(subj, branches, rest) => {
                def new_branches = Array<(string, SSAD)>.new(branches.length);
                for (i < branches.length) {
                    new_branches[i] = (branches[i].0, ssa(branches[i].1));
                }
                return SSAD.Match(subst(subj), new_branches, ssa(rest)); // TODO: branches
            }
            Void => return ir;
            Injected(inj, r) => return SSAD.Injected(inj, ssa(r));
            Final(v) => return SSAD.Final(subst(v));
        }
    }

    def buildString(ir: SSAD, buf: StringBuilder, phis: Array<(string, string)>, indent: int) {
        match (ir) {
            LetApp(n, f, a, r) => {
                for (i < indent) buf.tab();
                def fn = if(Strings.equal(f, "id"), "", f);
                var has_phi = false;
                var is_phi = false;
                for (i < phis.length) {
                    if (Strings.equal(phis[i].0, n)) has_phi = true;
                    if (Strings.equal(phis[i].1, n)) is_phi = true;
                }

                buf.puts(if(has_phi, "var ", "def ")).puts(n).puts(" = ");
                buf.puts(fn); buf.puts("(");
                for (i < a.length) {
                    buf.puts(a[i]);
                    if (i != a.length - 1) buf.puts(", ");
                }
                buf.puts(");\n");
                buildString(r, buf, phis, indent);
            }
            LetLit(n, l, t, r) => {
                for (i < indent) buf.tab();
                buf.puts("def ").puts(n).puts(" : ").puts(t).puts(" = ");
                buf.puts(l).puts(";\n");
                buildString(r, buf, phis, indent);
            }
            Void => {
                return;
            }
            Final(v) => {
                // for (i < indent) buf.tab();
                // buf.puts(v).puts(";\n");
            }
            If(c, t, e, ps, r) => {
                for (i < indent) buf.tab();
                buf.puts("if (").puts(c).puts(") {\n");
                buildString(t, buf, ps, indent + 1);
                for (i < indent) buf.tab();
                if (e != SSAD.Void) {
                    buf.puts("} else {\n");
                    buildString(e, buf, ps, indent + 1);
                    for (i < indent) buf.tab();
                    buf.puts("}\n");
                    buildString(r, buf, ps, indent);
                } else {
                    buf.puts("}\n");
                }
                buf.puts("// phis: ");
                for (p in ps) {
                    buf.puts(p.0).puts(" <- ").puts(p.1).puts("; ");
                }
                buf.puts("\n");
                buildString(r, buf, ps, indent);
            }
            Match(subj, branches, rest) => {
                // TODO
            }
            Injected(inj, r) => {
                for (i < indent) buf.tab();
                buf.puts(inj).ln();
                buildString(r, buf, phis, indent);
            }
        }
    }

    // Transformation functions with exact variant types
    def removeViews(node: SSAD.LetApp, transformer: SSATransformer) -> SSAD.LetApp {
        if (Strings.endsWith(node.f, ".view")) {
            return SSAD.LetApp(node.n, "id", node.args, node.rest);
        }
        return node;
    }

    def overloadOps(node: SSAD.LetApp, transformer: SSATransformer) -> SSAD.LetApp {
        def op_spl = IntrinsicTypes.split_op(node.f);
        def op_fn = op_spl.1;
        def is_rt = !transformer.ctx.static[node.n];
        if (op_fn != null && is_rt) {
            var tp = op_spl.0;
            if (tp.is_bot() && node.args.length > 0) tp = transformer.ctx.types[node.args[0]];
            def prefix = tp.rt_str();
            def new_f = Strings.format2("%s_%s", prefix, op_fn);
            return SSAD.LetApp(node.n, new_f, node.args, node.rest);
        } else {
            return node;
        }
    }

    def addCasts(node: SSAD.LetApp, transformer: SSATransformer) -> SSAD {
        def intrinsic_static = IntrinsicTypes.intrinsic_static(node.f);
        def intrinsic_type = IntrinsicTypes.intrinsic_type(node.f);
        def args_static = intrinsic_static.0;
        def args_types = intrinsic_type.0;
        var rtcasts: SSAD = SSAD.Void;
        def new_args = Arrays.dup(node.args);
        if (args_static != null) {
            for (i < args_static.length) {
                def is_runtime = !transformer.ctx.static[node.args[i]];
                def should_be_runtime = !args_static[i];
                if (!is_runtime && should_be_runtime) {
                    def fv = SSAD_IR.uidl("rtcast");
                    def tp = if(args_types[i].is_bot(), args_types[i], transformer.ctx.types[node.args[i]]);
                    def rtcast_f = Strings.format1("rtcast_%s", tp.long_str());
                    transformer.ctx.static[fv] = false;
                    transformer.ctx.types[fv] = transformer.ctx.types[node.args[i]];
                    transformer.ctx.effects[fv] = CBDEffect.None;
                    new_args[i] = fv;
                    rtcasts = SSAD.LetApp(fv, rtcast_f, [node.args[i]], rtcasts);
                }
            }
        }
        return rtcasts.appended(SSAD.LetApp(node.n, node.f, new_args, node.rest));
    }

    def pushPhis(node: SSAD, buf: Vector<(string, string)>) -> Vector<(string, string)> {
        match (node) {
            LetApp(_, _, _, rest) => return pushPhis(rest, buf);
            LetLit(_, _, _, rest) => return pushPhis(rest, buf);
            If(_, t, e, phis, rest) => {
                for (p in phis) buf.put(p);
                pushPhis(t, buf);
                pushPhis(e, buf);
                return pushPhis(rest, buf);
            }
            Match(_, branches, rest) => {
                for (b in branches) pushPhis(b.1, buf);
                return pushPhis(rest, buf);
            }
            Injected(_, rest) => return pushPhis(rest, buf);
            Void => return buf;
            Final => return buf;
        }
    }
}
