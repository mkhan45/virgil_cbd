def transformSSA(ssa: SSAD, ctx: SSADCtx) -> SSAD {
    match (ssa) {
        Void => return ssa;
        Final(_) => return ssa;
        Injected(inj, rest) => return SSAD.Injected(inj, transformSSA(rest, ctx));
        LetLit(n, l, t, rest) => return SSAD.LetLit(n, l, t, transformSSA(rest, ctx));
        LetApp(n, f, args, rest) => {
            var is_op = false;
            if (!Strings.startsWith(f, "Emit")) for (c in f) if (c == '.') is_op = true;
            def is_rt = !ctx.static[n];
            if (is_op && is_rt) {
                var op_tp_end = -1;
                for (i < f.length) if (f[i] == '.') {
                    op_tp_end = i;
                    break;
                }
                var tp = TypeUtil.fromString(Arrays.range(f, 0, op_tp_end));
                if (tp == ValueType.BOTTOM && args.length > 0) tp = ctx.types[args[0]];
                def tp_str = Strings.render(tp.render);
                var prefix: string;
                match (tp) {
                    BOTTOM => prefix = "V";
                    _ => prefix = Arrays.replace<u8>(tp_str, 0, tp_str[0] - 32u8);
                }

                var op: string = Strings.format1("UNHANDLED_OP_%s", f);
                if (Strings.endsWith(f, "==")) op = "equals";
                if (Strings.endsWith(f, "!=")) op = "not_equals";
                if (Strings.endsWith(f, "/")) op = "div";
                if (Strings.endsWith(f, "&&")) op = "and";
                if (Strings.endsWith(f, "&")) op = "and";
                if (Strings.endsWith(f, "+")) op = "plus";
                if (Strings.endsWith(f, "-")) op = "minus";
                if (Strings.endsWith(f, "<")) op = "lt";
                if (Strings.endsWith(f, "<=")) op = "lte";
                if (Strings.endsWith(f, ">")) op = "gt";
                if (Strings.endsWith(f, "*")) op = "times";

                def new_f = Strings.format2("EmitOp%s.%s", prefix, op);
                ctx.effects[n] = CBDEffect.Emit;
                return transformSSA(SSAD.LetApp(n, new_f, args, rest), ctx);
            }

            def intrinsic_static = IntrinsicTypes.intrinsic_static(f);
            def intrinsic_type = IntrinsicTypes.intrinsic_type(f);
            def args_static = intrinsic_static.0;
            def args_types = intrinsic_type.0;
            var lifts: SSAD = SSAD.Void;
            def new_args = Arrays.dup(args);
            if (args_static != null) {
                for (i < args_static.length) {
                    def is_runtime = !ctx.static[args[i]];
                    def should_be_runtime = !args_static[i];
                    if (!is_runtime && should_be_runtime) {
                        def fv = SSAD_IR.uidl("lift");
                        def tp = if(args_types[i] != ValueType.BOTTOM, args_types[i], ctx.types[args[i]]);
                        def lift_f = Strings.format1("lift_%s", Strings.render(tp.render));
                        ctx.static[fv] = false;
                        ctx.types[fv] = ctx.types[args[i]];
                        ctx.effects[fv] = CBDEffect.None;
                        new_args[i] = fv;
                        lifts = SSAD.LetApp(fv, lift_f, [args[i]], lifts);
                    }
                }
            }

            return lifts.appended(SSAD.LetApp(n, f, new_args, transformSSA(rest, ctx)));
        }
        If(c, t, e, phis, rest) => {
            def tfx = Vector<CBDEffect>.new();
            def efx = Vector<CBDEffect>.new();
            ctx.collectEffects(t, tfx);
            ctx.collectEffects(e, efx);

            def t_res = CBDEffects.run_fx(tfx);
            def e_res = CBDEffects.run_fx(efx);
            // assert t_res.stack_delta == e_res.stack_delta

            // forward declare phis stack vars and then emit "pops" into the fwd declared phis
            // which assign the phis to whichever branch ran
            // could possibly be improved by intercepting pushes with assignments

            // let phi1 = emit_fwd_i32();
            // emitIf(...)
            // ...
            // emitPopAssign(phi1);
            // emitElse()
            // ...
            // emitPopAssign(phi1);
            // emitEnd()

            def n_stack_phis = t_res.stack_delta;
            var fwd_decl_code: SSAD = SSAD.Void;
            var thenPops: SSAD = SSAD.Void; // thenPops and elsePops are the same but different uids
            var elsePops: SSAD = SSAD.Void;
            var phi_pushes: SSAD = SSAD.Void;
            if (n_stack_phis >= 0) {
                def fwd_decls = Array<string>.new(n_stack_phis);
                for (i < n_stack_phis) {
                    def phi_name = SSAD_IR.uidl("stack_phi");
                    fwd_decls[i] = phi_name;
                    fwd_decl_code = SSAD.LetApp(phi_name, "emitFwdI32", [], fwd_decl_code);
                    thenPops = SSAD.LetApp(SSAD_IR.uidl("eff_phi_pop"), "emitPopAssign", [fwd_decls[n_stack_phis - i - 1]], thenPops);
                    elsePops = SSAD.LetApp(SSAD_IR.uidl("eff_phi_pop"), "emitPopAssign", [fwd_decls[n_stack_phis - i - 1]], elsePops);
                    phi_pushes = SSAD.LetApp(SSAD_IR.uidl("eff_phi_push"), "push_i32", [fwd_decls[i]], phi_pushes);
                }
            }

            def emit_if_fn = if(ctx.static[c], "emitIfStatic", "emitIf");
            return fwd_decl_code.appended(
                    SSAD.LetApp(SSAD_IR.uidl("eff_if_"), emit_if_fn, [c],
                        transformSSA(t, ctx).appended(thenPops).appended(
                            SSAD.LetApp(SSAD_IR.uidl("eff_else_"), "emitElse", [],
                                transformSSA(e, ctx).appended(elsePops).appended(
                                    SSAD.LetApp(SSAD_IR.uidl("eff_endBrace"), "emitEnd", [],
                                        phi_pushes.appended(transformSSA(rest, ctx)))))))
                    );
        }
    }
}

def transformDef(opcode: string, stmt: VirgilStmt) -> CBDDef {
    def ir = SSAD_IR.from_virgil(stmt);
    SSAD_IR.counter = 0;
    def ssa = SSAD_IR.ssa(ir);
    def analysis = SSADCtx.new(ssa);
    def transformed = transformSSA(ssa, analysis);
    def processed = analysis.DCE(analysis.id_propagate(transformed, HashMap<string, string>.new(Strings.hash, Strings.equal)));

    def sb = StringBuilder.new();
    // def vars = Maps.keyList(analysis.static);
    // for (v = vars; v != null; v = v.tail) {
    //     sb.puts("// ").puts(v.head).puts(" -- ");
    //     sb.puts("static: ").puts(if(analysis.static[v.head], "yes", "no")).puts(", ");
    //     sb.puts("type: ").putq(analysis.types[v.head].render).puts(", ");
    //     sb.puts("effect: ").puts(analysis.effects[v.head].toString());
    //     sb.ln();
    // }
    // def instSsa = SSAD.Injected(sb.toString(), processed);
    def instSsa = processed;

    return CBDDef.new(opcode, instSsa);
}

def main(args: Array<string>) {
    def sexpr_file = args[0];
    def v3file = args[1];

    IntrinsicTypes.init(IntrinsicTypes.TYPE_DEF_FILE);
    def ai_intrinsics = IntrinsicTypes.getIntrinsicTypes("compiler/Intrinsics.v3");
    ai_intrinsics.apply(IntrinsicTypes.add_def);

    def defs: Array<CBDDef> = TierGen.extractDefsFromFile(v3file, sexpr_file, transformDef);
    def dispatch_table = TierGen.buildDispatch(defs, CBDDef.!<CBDDef>(_));

    def template_filename = args[2];
    def template_code = System.fileLoad(template_filename);
    if (template_code == null) {
        System.puts("Error reading ");
        System.puts(template_filename);
        System.ln();
    }

    def final_code_builder = StringBuilder.new();
    final_code_builder.puts("// GENERATED BY CompilerGen.v3\n");
    final_code_builder.puts(dispatch_table);
    final_code_builder.puts(template_code);

    System.puts(final_code_builder.toString());
}
