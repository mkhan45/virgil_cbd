def BR_IF() {
	// ret68 -- static: yes, type: <bottom>, effect: ctl
// arg95 -- static: no, type: i32, effect: none
// ret89 -- static: yes, type: <bottom>, effect: ctl
// cond3 -- static: no, type: i32, effect: pop
// cond56 -- static: no, type: i32, effect: emit
// rtcast10 -- static: no, type: i32, effect: none
// arg104 -- static: yes, type: i32, effect: none
