// depth0 -- static: yes, type: i32, effect: read
// arg111 -- static: yes, type: i32, effect: none
// arg77 -- static: yes, type: <bottom>, effect: none

	def depth = imm_readILEB32();
	def label = f_getLabel(depth);
	def cond = pop_i32();
	def cond1 = EmitOpI32.not_equals(cond, rtcast_i32(0));
	emitIf(cond1);
	doBranch(label);
	emitElse();
	doFallthru();
	emitEnd();
}
