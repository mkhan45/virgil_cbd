// arg97 -- static: no, type: f32, effect: none
// cond114 -- static: no, type: i32, effect: emit
// ret125 -- static: yes, type: <bottom>, effect: ctl
// rtcast11 -- static: no, type: f32, effect: none
// r8 -- static: no, type: f32, effect: emit
// arg106 -- static: no, type: f32, effect: none
// eff710 -- static: no, type: <bottom>, effect: push
// a1 -- static: no, type: f32, effect: pop
// arg89 -- static: no, type: f32, effect: none
// arg133 -- static: no, type: f32, effect: none
// b0 -- static: no, type: f32, effect: pop

	def b = pop_f32();
	def a = pop_f32();
	def cond = EmitOpI32.equals(b, rtcast_f32(0.0f));
	emitIf(cond);
	trapDivideByZero();
	emitElse();
	emitEnd();
	def r = EmitOpF32.div(a, b);
	push_f32(r);
}
def F32_EQ() {
	// arg175 -- static: yes, type: i32, effect: none
// arg197 -- static: yes, type: i32, effect: none
// rtcast16 -- static: no, type: i32, effect: none
// rtcast14 -- static: no, type: i32, effect: none
