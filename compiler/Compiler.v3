def doBranch(label: int) {
    def ctl_idx = ctl_stack.elems[ctl_stack.top - 1 - label];
    var label_name: string;
    match (ctls[ctl_idx]) {
        Block(_, ln) => label_name = ln;
        Loop(_, _, ln) => label_name = ln;
        _ => label_name = null;
    }
    code_builder.puts("goto ").puts(label_name).puts(";").ln();
}

