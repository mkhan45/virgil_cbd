var DISPATCH_TABLE: Array<void -> void> = build_dispatch_table();
var local_types: Vector<TypeVar>; // local varnames are just local_$i
var stack: ArrayStack<(string, TypeVar)>;

var code_builder: StringBuilder;
var cnt: int = 0;

def uidl(l: string) -> string {
    def r = Strings.format2<string, int>("%s_%d", l, cnt);
    cnt += 1;
    return r;
}

def assert(b: bool) {
    if (!b) {
        System.puts("assert fail :(\n");
	return [][1];
    }
}

type CompilerCtlEntry {
    case Block(end_pc: int, label_name: string);
    case Loop(start_pc: int, end_pc: int, label_name: string);
    case None;
}
var ctls: Array<CompilerCtlEntry>;
var ctl_stack: ArrayStack<int>;

// Constants
def HAS_MEM_INDEX = 0x40u8;

// Types.
// class Object { }
def binopG<L, R, O>(
    op_mnemonic: string, op_str: string, tp_str: string, tv: O
) -> ((string, L), (string, R)) -> (string, O) {
    def inner(lhs: (string, L), rhs: (string, R)) -> (string, O) {
        def new_var = uidl(Strings.format3("%s_%s_%s", lhs.0, op_mnemonic, rhs.0));
        def expr = Strings.format3("%s %s %s", lhs.0, op_str, rhs.0);
        code_builder.puts(Strings.format3("%s %s = %s;\n", tp_str, new_var, expr));
        return (new_var, tv);
    }
    return inner;
}
def binop<T>(op_mn: string, op_str: string, tp_str: string, tv: T) => binopG<T, T, T>(op_mn, op_str, tp_str, tv);
component EmitOpI32 {
    def plus = binop("plus", "+", "int", TypeVar.I32);
    def minus = binop("minus", "-", "int", TypeVar.I32);
    def times = binop("times", "*", "int", TypeVar.I32);
    def div = binop("div", "/", "int", TypeVar.I32);
    def equals = binop("eq", "==", "int", TypeVar.I32);
    def not_equals = binop("neq", "!=", "int", TypeVar.I32);
    def lt = binop("lt", "<", "int", TypeVar.I32);
    def lte = binop("lte", "<=", "int", TypeVar.I32);
    def gt = binop("gt", ">", "int", TypeVar.I32);
    def and = binop("and", "&", "int", TypeVar.I32);
}
component EmitOpF32 {
    def plus = binop("plus", "+", "float", TypeVar.F32);
    def minus = binop("minus", "-", "float", TypeVar.F32);
    def times = binop("times", "*", "float", TypeVar.F32);
    def div = binop("div", "/", "float", TypeVar.F32);
    def equals = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("eq", "==", "int", TypeVar.I32);
    def not_equals = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("neq", "!=", "int", TypeVar.I32);
    def lt = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("lt", "<", "int", TypeVar.I32);
    def lte = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("lte", "<=", "int", TypeVar.I32);
    def gt = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("gt", ">", "int", TypeVar.I32);
    def gte = binopG<TypeVar.F32, TypeVar.F32, TypeVar.I32>("gte", ">=", "int", TypeVar.I32);
}
component EmitOpV {
    // def and = binop<TypeVar>("and", "&&", TypeVar.Bot);
}
def rtcast_i32(x: i32) -> (string, TypeVar.I32) {
    def var_name = uidl("rtcast");
    code_builder.puts(Strings.format2("int %s = %d;\n", var_name, x));
    return (var_name, TypeVar.I32);
}
def rtcast_f32(x: float) -> (string, TypeVar.F32) {
    def var_name = uidl("rtcast");
    code_builder.puts(Strings.format2("float %s = %d;\n", var_name, x));
    return (var_name, TypeVar.F32);
}
def f32_reinterpret_i32(x: (string, TypeVar.I32)) -> (string, TypeVar.F32) {
    def var_name = uidl("float_reinterp");
    code_builder.puts(Strings.format2("float %s = (float) (%s)", var_name, x.0));
    return (var_name, TypeVar.F32);
}
def emitFwdI32() -> (string, TypeVar.I32) {
    def new_var = uidl("fwd_i32");
    code_builder.puts(Strings.format1("int %s;\n", new_var));
    return (new_var, TypeVar.I32);
}
def emitPopAssign(fwd_var: (string, TypeVar.I32)) {
    def sp = stack.pop();
    code_builder.puts(Strings.format2("%s = %s;\n", fwd_var.0, sp.0));
}
def emitIf(v: (string, TypeVar)) {
    code_builder.puts(Strings.format1("if (%s) {\n", v.0));
}
def emitIfStatic(v: bool) {
    code_builder.puts(Strings.format1("if (%z) {\n", v));
}
def emitElse() {
    code_builder.puts("} else {\n");
}
def emitEnd() {
    code_builder.puts("}\n");
}

def imm_readULEB32() -> u32 {
    return codeptr.read_uleb32();
}

def imm_readILEB32() -> i32 {
    return codeptr.read_sleb32();
}

def imm_readULEB64() -> u64 {
    return codeptr.read_uleb64();
}

def imm_readILEB64() -> i64 {
    return i64.!(codeptr.read_uleb64());
}

def imm_readU8() -> u8 {
    return codeptr.read1();
}

def imm_readBlockType() -> () {
    def bt = codeptr.read_BlockTypeCode();
    return ();
}

def pop_i32() -> (string, TypeVar.I32) {
    def sp = stack.pop();
    def var_name = sp.0;
    def var_type = sp.1;
    return (var_name, TypeVar.I32);
}
def pop_i64() -> (string, TypeVar.I64);
def pop_f32() -> (string, TypeVar.F32);
def pop_f64() -> double;
def pop_v128() -> v128;
def pop_Object() -> Object;
def pop_Value(tv: TypeVar) -> (string, TypeVar) {
    def sp = stack.pop();
    // assert(tv == sp.1);
    return sp;
}

def push_i32(v: (string, TypeVar.I32)) {
    stack.push(v);
}
def push_i64(v: i64);
def push_f32(v: (string, TypeVar.F32));
def push_f64(v: double);
def push_v128(v: v128);
def push_Object(v: Object);
def push_Value(tv: TypeVar, v: (string, TypeVar)) {
    stack.push(v);
}

// Local variables.
def getLocal(tv: TypeVar, index: int) -> (string, TypeVar) {
    return stack.elems[index];
}
def setLocal(tv: TypeVar, index: int, v: (string, TypeVar)) {
    // TODO: assert that v has tv
    code_builder.puts(Strings.format2("local_%d = %s;\n", int.!(index), v.0));
    stack.elems[index] = v;
}

// Global variables.
def getGlobal(tv: TypeVar, index: int) -> (string, TypeVar);
def setGlobal(tv: TypeVar, index: int, v: (string, TypeVar));

// Function context.
def f_getLabel(depth: int) -> int {
    return int.!(depth);
}

def f_getLocalType(index: int) -> TypeVar {
    return local_types[int.!(index)];
}
def f_getTopOfStackType() -> TypeVar {
    return stack.peek().1;
}

