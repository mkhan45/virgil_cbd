// eff166 -- static: yes, type: <bottom>, effect: push
// eff188 -- static: yes, type: <bottom>, effect: push
// b0 -- static: no, type: f32, effect: pop

	def b = pop_f32();
	def a = pop_f32();
	def cond = EmitOpI32.equals(a, b);
	def stack_phi = emitFwdI32();
	emitIf(cond);
	push_i32(rtcast_i32(1));
	emitPopAssign(stack_phi);
	emitElse();
	push_i32(rtcast_i32(0));
	emitPopAssign(stack_phi);
	emitEnd();
	push_i32(stack_phi);
}
